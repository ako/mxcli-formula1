/*
 * Live-service tests. These need nothing but the CSVs, so they run under
 * `mxcli test --local` on its scratch database.
 */

/**
 * @test Live service: the drivers CSV has 917 rows
 * @expect $result = 917
 */
$result = CALL MICROFLOW Formula1Backend.Count_Live_Drivers();
/

/**
 * @test Live service: 77 seasons
 * @expect $result = 77
 */
$result = CALL MICROFLOW Formula1Backend.Count_Live_Seasons();
/

/**
 * @test Live service: 1171 races
 * @expect $result = 1171
 */
$result = CALL MICROFLOW Formula1Backend.Count_Live_Races();
/

/**
 * Since pushdown the live service serves the whole result set a page at a
 * time, so it can be counted — it could not be before.
 *
 * @test Live service: 27533 race results are reachable from the CSVs
 * @expect $result = 27533
 */
$result = CALL MICROFLOW Formula1Backend.Count_Live_RaceResults();
/
