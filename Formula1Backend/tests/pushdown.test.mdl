/*
 * Unit tests for the OData -> SQL translation.
 *
 * These call the Java actions directly rather than going over HTTP, because
 * Mendix validates field names against the published metadata before a read
 * microflow ever runs. Going through the service would only ever exercise the
 * happy path; the whitelist and the rejection behaviour need testing here.
 *
 * Runs under `--local` — nothing here needs a loaded cache.
 */

/**
 * @test No query options: default order, bounded by MaxTop
 * @expect $result = ' ORDER BY name ASC LIMIT 500'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers');
/

/**
 * A datagrid showing rows 80-100 sorted by name — the case that started this.
 *
 * @test $skip + $top + $orderby become OFFSET / LIMIT / ORDER BY
 * @expect $result = ' ORDER BY name ASC LIMIT 20 OFFSET 80'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers?$skip=80&$top=20&$orderby=name');
/

/**
 * @test An exposed name maps to its real CSV column, and desc is honoured
 * @expect $result = ' ORDER BY totalRaceWins DESC LIMIT 10'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers?$orderby=raceWins desc&$top=10');
/

/**
 * @test Multi-column sort
 * @expect $result = ' ORDER BY totalRaceWins DESC, name ASC LIMIT 500'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers?$orderby=raceWins desc,name asc');
/

/**
 * A $top larger than MaxTop must not let a client ask for everything.
 *
 * @test $top is clamped to MaxTop
 * @expect $result = ' ORDER BY name ASC LIMIT 500'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers?$top=99999');
/

/**
 * A sort on a column outside the whitelist is dropped, not injected — the
 * request still succeeds, just in the default order.
 *
 * @test A non-whitelisted sort column falls back to the default order
 * @expect $result = ' ORDER BY name ASC LIMIT 500'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_OrderLimit(Uri = '/odata/f1-live/Drivers?$orderby=id;DROP TABLE x--');
/

/**
 * @test No $filter yields no WHERE clause
 * @expect $result = ''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Where(Uri = '/odata/f1-live/Drivers?$top=5');
/

/**
 * @test contains() becomes ILIKE with the column from the whitelist
 * @expect $result = ' WHERE name ILIKE ''%Verstappen%'''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Where(Uri = '/odata/f1-live/Drivers?$filter=contains(name,''Verstappen'')');
/

/**
 * @test A numeric comparison maps to the real column
 * @expect $result = ' WHERE totalRaceWins > 50'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Where(Uri = '/odata/f1-live/Drivers?$filter=raceWins gt 50');
/

/**
 * @test Two terms joined by and
 * @expect $result = ' WHERE totalRaceWins > 50 AND name ILIKE ''Ver%'''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Where(Uri = '/odata/f1-live/Drivers?$filter=raceWins gt 50 and startswith(name,''Ver'')');
/

/**
 * A quote in the value must be escaped, not closed.
 *
 * @test A single quote in a filter value survives as one escaped quote
 * @expect $result = ' WHERE name ILIKE ''%O''''Brien%'''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Where(Uri = '/odata/f1-live/Drivers?$filter=contains(name,''O''''Brien'')');
/

/**
 * Unlike $orderby, an unknown FILTER column must fail loudly — silently
 * dropping it would return more rows than the client asked for.
 *
 * @test A non-whitelisted filter column is rejected, not ignored
 * @expect $result = true
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_WhereIsRejected(Uri = '/odata/f1-live/Drivers?$filter=secret eq ''x''');
/

/**
 * @test A filter shape we cannot translate is rejected rather than dropped
 * @expect $result = true
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_WhereIsRejected(Uri = '/odata/f1-live/Drivers?$filter=name eq ''a'' or name eq ''b''');
/

/**
 * $top and $skip as values, for the resources that pass them to a bound LIMIT
 * rather than building SQL. FINDINGS §43.
 *
 * @test No $top means the whole list, not a default page
 * @expect $result = 1000000
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Top(Uri = '/odata/f1-live/Seasons');
/

/**
 * @test $top is read and clamped to what the resource will serve
 * @expect $result = 20
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Top(Uri = '/odata/f1-live/Seasons?$top=20');
/

/**
 * @test An over-large $top is clamped rather than honoured
 * @expect $result = 500
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Top(Uri = '/odata/f1-live/Seasons?$top=99999');
/

/**
 * @test $skip is read
 * @expect $result = 40
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Skip(Uri = '/odata/f1-live/Seasons?$top=20&$skip=40');
/

/**
 * @test A junk $skip is 0, not an error and not SQL
 * @expect $result = 0
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_Skip(Uri = '/odata/f1-live/Seasons?$skip=drop%20table');
/

/**
 * $orderby as a whitelisted name and a direction, for the resources that order
 * by a bound CASE. FINDINGS §44.
 *
 * @test No $orderby leaves the query's own order alone
 * @expect $result = ''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortColumn(Uri = '/odata/f1-live/Seasons');
/

/**
 * @test A whitelisted column comes back as its exposed name, which is what the CASE matches
 * @expect $result = 'raceCount'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortColumn(Uri = '/odata/f1-live/Seasons?$orderby=raceCount desc');
/

/**
 * @test A column outside the whitelist sorts by nothing rather than reaching the query
 * @expect $result = ''
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortColumn(Uri = '/odata/f1-live/Seasons?$orderby=1;drop table asc');
/

/**
 * @test Only the first term is honoured
 * @expect $result = 'year'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortColumn(Uri = '/odata/f1-live/Seasons?$orderby=year asc,name desc');
/

/**
 * @test Descending is read
 * @expect $result = 'D'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortDirection(Uri = '/odata/f1-live/Seasons?$orderby=year DESC');
/

/**
 * @test Anything else is ascending
 * @expect $result = 'A'
 */
$result = CALL MICROFLOW Formula1Backend.TestSupport_SortDirection(Uri = '/odata/f1-live/Seasons?$orderby=year');
/
