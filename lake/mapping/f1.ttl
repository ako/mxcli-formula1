  rr:predicateObjectMap [ rr:predicate f1:demonym ;
      rr:objectMap [ rr:column "demonym" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:continent ;
      rr:objectMap [ rr:template "http://data.formula1.local/continent/{continentId}" ] ] .

