<#PitLaneVisit52>
  rr:logicalTable [ rr:sqlQuery """SELECT p.*, d.driver_id AS driverId,
                row_number() OVER (PARTITION BY p.session_key, p.driver_number ORDER BY p.lap_number) AS visit
            FROM timing.pits p LEFT JOIN timing.session_drivers d USING (session_key, driver_number)""" ] ;
  rr:subjectMap [ rr:template "http://data.formula1.local/openf1/session/{session_key}/pit/{driver_number}/{visit}" ; rr:class f1:PitLaneVisit ] ;
  rr:predicateObjectMap [ rr:predicate f1:session ;
      rr:objectMap [ rr:template "http://data.formula1.local/openf1/session/{session_key}" ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:carNumber ;
      rr:objectMap [ rr:column "driver_number" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:lap ;
      rr:objectMap [ rr:column "lap_number" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:laneDuration ;
      rr:objectMap [ rr:column "lane_duration" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:driver ;
      rr:objectMap [ rr:template "http://data.formula1.local/driver/{driverId}" ] ] ;
  rr:predicateObjectMap [ rr:predicate f1:visit ;
      rr:objectMap [ rr:column "visit" ; rr:datatype xsd:integer ] ] .

