# The F1 vocabulary of the graph (lake/mapping/f1.ttl): classes and their
# hierarchy, labels and comments for the catalog, MCP and agents, and the ranges
# that make links OData navigation properties. The lake applies subClassOf,
# domain/range, inverseOf and symmetric properties to queries, so a query for
# f1:SessionResult finds every kind of result, and f1:raceRecord lists what was
# recorded for a race.
#
# GENERATED by scripts/datalake/build-graph.py; edit the script, not this file.

@prefix f1:   <http://formula1.local/ns#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

f1:Continent a owl:Class ;
  rdfs:label "Continent" ;
  rdfs:comment "A continent, as f1db groups countries." .

f1:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "A country: where a circuit is, what nationality a driver holds, where a team is based." .

f1:Circuit a owl:Class ;
  rdfs:label "Circuit" ;
  rdfs:comment "A circuit that has held a championship race." .

f1:CircuitLayout a owl:Class ;
  rdfs:label "Circuit layout" ;
  rdfs:comment "One configuration of a circuit, in use from a given year, with its length and number of turns." .

f1:GrandPrix a owl:Class ;
  rdfs:label "Grand Prix" ;
  rdfs:comment "A Grand Prix as a recurring event (the British Grand Prix), across seasons." .

f1:Season a owl:Class ;
  rdfs:label "Season" ;
  rdfs:comment "A championship season, named by its year." .

f1:Race a owl:Class ;
  rdfs:label "Race" ;
  rdfs:comment "One Grand Prix of one season: a round of the championship, and the weekend of sessions around it." .

f1:Driver a owl:Class ;
  rdfs:label "Driver" ;
  rdfs:comment "A person who entered at least one Formula One World Championship race." .

f1:Constructor a owl:Class ;
  rdfs:label "Constructor" ;
  rdfs:comment "A team that built and entered cars in the championship." .

f1:EngineManufacturer a owl:Class ;
  rdfs:label "Engine manufacturer" ;
  rdfs:comment "A company that supplied engines to championship teams." .

f1:TyreManufacturer a owl:Class ;
  rdfs:label "Tyre manufacturer" ;
  rdfs:comment "A company that supplied tyres to championship teams." .

f1:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "One engine design of an engine manufacturer." .

f1:Chassis a owl:Class ;
  rdfs:label "Chassis" ;
  rdfs:comment "One car design of a constructor." .

f1:Entrant a owl:Class ;
  rdfs:label "Entrant" ;
  rdfs:comment "The organisation that entered cars in a season, under its entry name." .

f1:FamilyRelationship a owl:Class ;
  rdfs:label "Family relationship" ;
  rdfs:comment "How one driver is related to another (parent, sibling, ...), as f1db records it." .

f1:ConstructorLineageEntry a owl:Class ;
  rdfs:label "Constructor lineage entry" ;
  rdfs:comment "One step in a team's history: which constructor raced under it, from which year to which." .

f1:SeasonEntrant a owl:Class ;
  rdfs:label "Season entrant" ;
  rdfs:comment "An entrant in one season, with the country it entered under." .

f1:Entry a owl:Class ;
  rdfs:label "Entry" ;
  rdfs:comment "An entrant's entry in one season with one constructor and engine manufacturer: the team as it raced, with its chassis, engines and tyres." .

f1:EntryDriver a owl:Class ;
  rdfs:label "Entry driver" ;
  rdfs:comment "A driver of an entry, for the rounds the entry used them." .

f1:SeasonParticipant a owl:Class ;
  rdfs:label "Season record" ;
  rdfs:comment "How a driver, constructor or supplier did over one season." .

f1:SeasonDriver a owl:Class ;
  rdfs:label "Season driver" ;
  rdfs:comment "A driver's season: championship position, starts, wins, points." ;
  rdfs:subClassOf f1:SeasonParticipant .

f1:SeasonConstructor a owl:Class ;
  rdfs:label "Season constructor" ;
  rdfs:comment "A constructor's season." ;
  rdfs:subClassOf f1:SeasonParticipant .

f1:SeasonEngineManufacturer a owl:Class ;
  rdfs:label "Season engine manufacturer" ;
  rdfs:comment "An engine manufacturer's season." ;
  rdfs:subClassOf f1:SeasonParticipant .

f1:SeasonTyreManufacturer a owl:Class ;
  rdfs:label "Season tyre manufacturer" ;
  rdfs:comment "A tyre manufacturer's season." ;
  rdfs:subClassOf f1:SeasonParticipant .

f1:Standing a owl:Class ;
  rdfs:label "Standing" ;
  rdfs:comment "A place in a championship table." .

f1:DriverStanding a owl:Class ;
  rdfs:label "Driver standing" ;
  rdfs:comment "A place in the drivers' championship at the end of a season." ;
  rdfs:subClassOf f1:Standing .

f1:ConstructorStanding a owl:Class ;
  rdfs:label "Constructor standing" ;
  rdfs:comment "A place in the constructors' championship at the end of a season." ;
  rdfs:subClassOf f1:Standing .

f1:RaceDriverStanding a owl:Class ;
  rdfs:label "Driver standing after a race" ;
  rdfs:comment "A place in the drivers' championship after a race." ;
  rdfs:subClassOf f1:Standing .

f1:RaceConstructorStanding a owl:Class ;
  rdfs:label "Constructor standing after a race" ;
  rdfs:comment "A place in the constructors' championship after a race." ;
  rdfs:subClassOf f1:Standing .

f1:SessionResult a owl:Class ;
  rdfs:label "Session result" ;
  rdfs:comment "A car's result in one session of a race weekend: practice, qualifying, the grid, the race, or a record of it such as a pit stop." .

f1:RaceResult a owl:Class ;
  rdfs:label "Race result" ;
  rdfs:comment "A car's classification in the race." ;
  rdfs:subClassOf f1:SessionResult .

f1:SprintRaceResult a owl:Class ;
  rdfs:label "Sprint result" ;
  rdfs:comment "A car's classification in the sprint race." ;
  rdfs:subClassOf f1:SessionResult .

f1:QualifyingResult a owl:Class ;
  rdfs:label "Qualifying result" ;
  rdfs:comment "A car's place in qualifying, with its Q1, Q2 and Q3 times." ;
  rdfs:subClassOf f1:SessionResult .

f1:Qualifying1Result a owl:Class ;
  rdfs:label "First qualifying result" ;
  rdfs:comment "A car's place in the first of two qualifying sessions (older formats)." ;
  rdfs:subClassOf f1:SessionResult .

f1:Qualifying2Result a owl:Class ;
  rdfs:label "Second qualifying result" ;
  rdfs:comment "A car's place in the second of two qualifying sessions (older formats)." ;
  rdfs:subClassOf f1:SessionResult .

f1:PreQualifyingResult a owl:Class ;
  rdfs:label "Pre-qualifying result" ;
  rdfs:comment "A car's place in pre-qualifying (late 1980s and early 1990s)." ;
  rdfs:subClassOf f1:SessionResult .

f1:SprintQualifyingResult a owl:Class ;
  rdfs:label "Sprint qualifying result" ;
  rdfs:comment "A car's place in sprint qualifying (sprint shootout)." ;
  rdfs:subClassOf f1:SessionResult .

f1:PracticeResult a owl:Class ;
  rdfs:label "Practice result" ;
  rdfs:comment "A car's place in a free practice session." ;
  rdfs:subClassOf f1:SessionResult .

f1:FirstPracticeResult a owl:Class ;
  rdfs:label "FP1 result" ;
  rdfs:comment "A car's place in the first free practice." ;
  rdfs:subClassOf f1:PracticeResult .

f1:SecondPracticeResult a owl:Class ;
  rdfs:label "FP2 result" ;
  rdfs:comment "A car's place in the second free practice." ;
  rdfs:subClassOf f1:PracticeResult .

f1:ThirdPracticeResult a owl:Class ;
  rdfs:label "FP3 result" ;
  rdfs:comment "A car's place in the third free practice." ;
  rdfs:subClassOf f1:PracticeResult .

f1:FourthPracticeResult a owl:Class ;
  rdfs:label "FP4 result" ;
  rdfs:comment "A car's place in a fourth free practice (some older weekends)." ;
  rdfs:subClassOf f1:PracticeResult .

f1:WarmUpResult a owl:Class ;
  rdfs:label "Warm-up result" ;
  rdfs:comment "A car's place in the race-morning warm-up (until 2002)." ;
  rdfs:subClassOf f1:SessionResult .

f1:GridPosition a owl:Class ;
  rdfs:label "Grid position" ;
  rdfs:comment "A car's place on the starting grid of the race, after penalties." ;
  rdfs:subClassOf f1:SessionResult .

f1:SprintGridPosition a owl:Class ;
  rdfs:label "Sprint grid position" ;
  rdfs:comment "A car's place on the starting grid of the sprint." ;
  rdfs:subClassOf f1:SessionResult .

f1:FastestLap a owl:Class ;
  rdfs:label "Fastest lap" ;
  rdfs:comment "A car's fastest lap of the race, ranked." ;
  rdfs:subClassOf f1:SessionResult .

f1:PitStop a owl:Class ;
  rdfs:label "Pit stop" ;
  rdfs:comment "One pit stop of a car in the race." ;
  rdfs:subClassOf f1:SessionResult .

f1:DriverOfTheDayVote a owl:Class ;
  rdfs:label "Driver of the Day vote" ;
  rdfs:comment "A driver's share of the fans' Driver of the Day vote." ;
  rdfs:subClassOf f1:SessionResult .

f1:LapPosition a owl:Class ;
  rdfs:label "Lap position" ;
  rdfs:comment "A driver's position and lap time at the end of a lap of a race (Jolpica, the seasons fetched)." .

f1:Session a owl:Class ;
  rdfs:label "Session" ;
  rdfs:comment "A session as OpenF1 timed it (practice, qualifying, sprint, race), linked to its f1db race weekend." .

f1:SessionEntry a owl:Class ;
  rdfs:label "Session entry" ;
  rdfs:comment "A car in an OpenF1 session: number, code, team, and the f1db driver it is." .

f1:SessionLap a owl:Class ;
  rdfs:label "Session lap" ;
  rdfs:comment "A car's state at the end of a lap of an OpenF1 session: position, gap, lap and sector times, tyre." .

f1:Stint a owl:Class ;
  rdfs:label "Stint" ;
  rdfs:comment "A run on one set of tyres in an OpenF1 session." .

f1:PitLaneVisit a owl:Class ;
  rdfs:label "Pit lane visit" ;
  rdfs:comment "A car's trip through the pit lane in an OpenF1 session." .

f1:RaceControlMessage a owl:Class ;
  rdfs:label "Race control message" ;
  rdfs:comment "A message from race control: flags, safety car, penalties, track limits." .

f1:WeatherObservation a owl:Class ;
  rdfs:label "Weather observation" ;
  rdfs:comment "The weather at the track at a moment of an OpenF1 session." .

f1:LapForecast a owl:Class ;
  rdfs:label "Lap forecast" ;
  rdfs:comment "The race forecaster's call for a car at a lap of a race: how it would have finished, from the laps run until then (replay.forecast)." .

