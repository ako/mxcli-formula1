# Root-level ignores for the Formula1 solution.
# Each app folder has its own .gitignore (written by 'mxcli init') covering the
# Mendix build artefacts; this one covers what lives at the solution root.

# The mxcli binary (~85 MB, hardlinked into both app folders). Rebuilt from
# ako/mxcli main by .claude/bootstrap-mxcli.sh on session start.
/mxcli
/mxcli.exe

# Checkout of ako/mxcli used to build the binary.
/.mxcli-src/

# The F1 CSV dataset (~25 MB, 47 files). Re-fetched by scripts/fetch-f1-data.sh.
/data/f1db/

# Wikipedia summaries fetched by scripts/fetch-f1-facts.sh. Derived third-party
# content (CC BY-SA 4.0), re-fetchable, and re-fetched by the bootstrap hook —
# so the script is committed and the data is not, same as the f1db CSVs.
/data/facts/

# Lap-by-lap traces fetched by scripts/fetch-f1-laps.sh from Jolpica-F1. Third
# party, re-fetchable, ~26k rows a season — script committed, data not.
/data/laps/

# Near-live snapshots from OpenF1 (scripts/fetch-f1-live.sh). Stale the moment
# they are written — the script is the artefact, not the data.
/data/live/

# DuckDB scratch files, if any are ever materialised next to the CSVs.
*.duckdb
*.duckdb.wal

# The harness module 'mxcli test' injects into an app to run .test.mdl files.
# It writes itself in and removes itself on the way out, so what is left after
# an interrupted run is scaffolding, not source.
/Formula1Backend/javasource/mxtest/
/Formula1Frontend/javasource/mxtest/
/Formula1Backend/themesource/mxtest/
/Formula1Frontend/themesource/mxtest/

# Claude Code local overrides
.claude/settings.local.json

# OS
.DS_Store

# Managed Java dependencies resolved by 'mxcli sync-java-deps' (and by
# 'run --local' before boot). The DuckDB JDBC driver alone is 82 MB.
/Formula1Backend/vendorlib/
/Formula1Frontend/vendorlib/
/Formula1Backend/userlib/*.jar
/Formula1Frontend/userlib/*.jar
/Formula1Backend/out.mda
/Formula1Frontend/out.mda

# Semantic fingerprints from scripts/fingerprint.sh — a local before/after
# comparison, not an artefact worth versioning.
/fingerprint/

# Runtime observation output from scripts/run-observed.sh — collected spans,
# the collector's own log and each app's boot log. Minutes of browsing is tens
# of MB of JSONL, and it describes one run of one machine.
/.mxcli-obs/

# Vega widget: the pack's source is committed, its dependencies and build
# output are not. The built .mpk is a different matter — it lands in
# Formula1Frontend/widgets/ and IS committed, because a gitignored widgets/
# folder makes every other clone of this repo unbuildable: the project
# references a widget nobody else has, and the error names a missing widget
# rather than a missing file.
/.claude/skills/*/node_modules/
/.claude/skills/*/*/node_modules/
/.claude/skills/*/widget/dist/
# SSH access to the devcontainer. authorized_keys.local is the public half and
# is re-installed by .devcontainer/post-start.sh on every start, so it survives
# a rebuild; it is yours, not the repo's, hence ignored. The private key is only
# here so you can copy it to the machine you connect FROM — move it out and
# delete it, and it will never be regenerated behind your back.
/.devcontainer/authorized_keys.local
/.devcontainer/id_ed25519_devcontainer
/.devcontainer/id_ed25519_devcontainer.pub

# Pinned sshd host keys, restored by post-start.sh so the container keeps one
# identity across rebuilds and your client stops reporting a changed host key.
# PRIVATE host keys — never commit these: a shared host key would let anyone
# holding the repo impersonate someone else's container.
/.devcontainer/ssh_host_keys/

# Build and run byproducts of `mxcli test` / `mxcli docker`, not deliverables.
# .docker/build is a full unpacked runtime (400MB+) and .docker/.env carries a
# generated admin password.
/Formula1Backend/.docker/
/Formula1Frontend/.docker/

# Circuit outlines, traced from OpenStreetMap by scripts/fetch-circuit-outlines.py.
# Fetched rather than authored, like data/f1db and data/live, and regenerated by
# re-running the script; .cache/ holds the raw Overpass responses.
/data/circuits/
