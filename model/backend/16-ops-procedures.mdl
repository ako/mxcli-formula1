/*
 * Service 5 of 5 — F1OpsApi: an existing database's stored procedures, over OData.
 *
 * Everything else in this app reads flat files. This one exists to answer a
 * different question: you have been handed a database with the logic already
 * inside it — procedures, functions, packages — and asked to put an OData
 * surface on it without touching any of that. It is the case ODataPushdown's
 * bind style was built for, and it cannot be demonstrated against a CSV.
 *
 * The database is `f1ops`, a real Postgres schema created by
 * scripts/create-f1ops-db.sh, holding the same F1 data plus two routines of
 * deliberately different kinds:
 *
 *   f1ops.driver_form(p_driver_id, p_last_n)     a table-valued FUNCTION.
 *     Read-only, returns rows, reached with SELECT * FROM. plpgsql with a loop
 *     and a running average, so it is procedural rather than a view in a hat —
 *     the sort of thing that is in the warehouse because it was awkward to
 *     express any other way, which is exactly the sort you cannot lift out.
 *
 *   f1ops.record_prediction(...)                 a PROCEDURE with INOUT
 *     parameters. It writes, and it validates before it writes, because that
 *     is the other reason logic sits in a database: the rule lives next to the
 *     data and every caller gets it. Reached with CALL, which in Postgres
 *     answers with one row carrying the INOUT values.
 *
 *
 * THE SECOND ONE IS AN ODATA ACTION
 *
 * A procedure that changes something wants to be an action, not an entity set:
 * `POST /odata/f1-ops/RecordPrediction` with the arguments in the body and an
 * ActionImport in $metadata.
 *
 * When this file was first written MDL could not declare one. `create odata
 * service` took `publish entity` blocks and nothing else, and neither writer
 * had a single reference to PublishedMicroflow — so the procedure shipped as an
 * entity set with an insert microflow, which cost the operation's name, turned
 * its parameters into attributes of the result, and answered 201 to a request
 * the domain had rejected. That was FINDINGS §47.1, filed as the top open gap.
 *
 * mxcli `715bac5` closed it:
 *
 *   publish microflow Formula1Backend.RecordPrediction as 'RecordPrediction'
 *     expose ( DriverId as 'driverId', ... );
 *
 * Parameter types and the return type are not restated — they are read off the
 * microflow, which already declares them, so the two cannot drift. The
 * workaround is gone and the microflow underneath is unchanged, which is what
 * it was designed for. FINDINGS §48.
 *
 * `Predictions` stays, read-only: an action records a prediction, and the
 * entity set is how you read one back.
 */

-- ---------------------------------------------------------------- the caller

/*
 * Who is calling, without hashing a password to find out.
 *
 * A shared key in a header, compared against a private constant, and the API
 * user returned on a match. Returning empty denies the request — Mendix answers
 * 401 and the read microflow never runs.
 *
 * A shared key is the right shape for machine-to-machine here and the wrong
 * shape for anything with human users: it does not expire, it does not identify
 * a caller, and it is only as good as the channel. A real deployment puts a
 * token check here instead — the point of the microflow is that WHAT gets
 * checked is now yours to decide, which is what basic authentication does not
 * allow.
 */
-- Override per environment with MX_Formula1Backend_ApiKey; never a real secret
-- in source.
create or modify constant Formula1Backend.ApiKey type string
  default 'f1-ops-key-2f8a1c' PRIVATE;

CREATE OR REPLACE MICROFLOW Formula1Backend.AuthenticateApiClient (
  $Headers: List of System.HttpHeader
)
  RETURNS System.User AS $User
BEGIN
  DECLARE $Presented String = '';
  LOOP $H IN $Headers BEGIN
    IF toLowerCase($H/Key) = 'x-api-key' THEN
      SET $Presented = $H/Value;
    END IF;
  END LOOP;

  IF $Presented != @Formula1Backend.ApiKey THEN
    RETURN empty;
  END IF;

  RETRIEVE $User FROM System.User WHERE Name = 'f1api' LIMIT 1;
  RETURN $User;
END;

-- ---------------------------------------------------------------- the database

create or modify constant Formula1Backend.OpsDbUrl type string
  default 'jdbc:postgresql://127.0.0.1:5432/f1ops'
  comment 'The existing RDBMS this app does not own. scripts/create-f1ops-db.sh builds it.';

create or modify constant Formula1Backend.OpsDbUser type string default 'mendix';
create or modify constant Formula1Backend.OpsDbPassword type string default 'mendix' PRIVATE;

/*
 * Type PostgreSQL rather than BYOD: Mendix ships the Postgres driver, so unlike
 * DuckDB there is no jar to declare and no vendorlib entry to sync.
 *
 * Both queries are written with bound parameters and NO string building, which
 * is the whole argument for putting a routine behind a resource this way. A
 * WHERE clause has to be assembled as text because its shape comes from the
 * client; a routine call's shape is fixed by the routine, so every value can be
 * bound and none of it can carry SQL. ODataPushdown.CallStatement renders the
 * same two statements for whichever engine you are on — see the tests in
 * tests/pushdown.test.mdl; here they are written out so the mapping can be read
 * next to them.
 */
create or modify database connection Formula1Backend.F1Ops
type 'PostgreSQL'
connection string @Formula1Backend.OpsDbUrl
username @Formula1Backend.OpsDbUser
password @Formula1Backend.OpsDbPassword
begin
  /*
   * The table function. Both arguments bound; the cast is there because every
   * Mendix query parameter is a string and the routine's second argument is an
   * integer.
   *
   * Paging and ordering are NOT pushed into this one. A routine decides its own
   * result — `p_last_n` is the page — so wrapping it in a LIMIT would be asking
   * the same question twice. That is a real difference from the CSV resources,
   * and it is why this resource declares its own contract below.
   */
  query CallDriverForm
    sql 'SELECT f.*, {driverId} AS driver_id, CAST({lastN} AS INTEGER) AS last_n
         FROM f1ops.driver_form({driverId}, CAST({lastN} AS INTEGER)) f'
    parameter driverId: string
    parameter lastN: string
    returns Formula1Backend.Stg_DriverForm
    map ( form_key as FormKey, driver_id as DriverId, last_n as LastN,
          race_id as RaceId, year as Year, round as Round,
          race_name as RaceName, finish_position as FinishPosition,
          position_text as PositionText, grid_position as GridPosition,
          points as Points, places_gained as PlacesGained,
          rolling_avg as RollingAvg );

  /*
   * The procedure — reached through a one-line wrapper function, and that
   * indirection is not a style choice.
   *
   * The call this wants to be is
   *
   *   CALL f1ops.record_prediction({driverId}, ..., NULL, NULL, NULL)
   *
   * with the three trailing NULLs standing in for the INOUT slots, which
   * Postgres fills on the way out and returns as one row. It is correct SQL and
   * `ODataPushdown.CallStatement(..., 'procedure', ..., 'postgresql')` renders
   * exactly it. Mendix cannot run it: the External Database Connector inspects
   * the statement, sends a CALL down JDBC executeUpdate
   * (QueryDispatcher:153 -> JdbcConnector.executeStatement:118), and the driver
   * then refuses with "A result was returned when none was expected". There is
   * no `execute database statement` activity to reach for instead — the only
   * door is `execute database query`, and it wants a SELECT.
   *
   * So the database also exposes `record_prediction_fn`, which does nothing but
   * CALL the procedure and return its row. The procedure is untouched and is
   * still what runs; the wrapper only makes the invocation start with SELECT.
   * FINDINGS §47.
   */
  query CallRecordPrediction
    sql 'SELECT * FROM f1ops.record_prediction_fn({driverId},
                                                  CAST({raceId} AS INTEGER),
                                                  CAST({position} AS INTEGER),
                                                  {submittedBy})'
    parameter driverId: string
    parameter raceId: string
    parameter position: string
    parameter submittedBy: string
    returns Formula1Backend.Stg_ProcedureResult
    map ( prediction_id as PredictionId, accepted as Accepted,
          message as Message );

  /*
   * Reading back what the procedure wrote.
   *
   * A resource you can POST to is a resource a client will then re-read by key,
   * and a key lookup that cannot be answered is the failure in FINDINGS §37 —
   * `mxcli check` (MDL-ODATA02) flags exactly this shape. The predictions are
   * in a table, so the lookup is answerable; the empty key means "the whole
   * list", which for this resource is the caller's own submissions.
   */
  query GetPredictions
    sql 'SELECT CAST(p.id AS VARCHAR)    AS prediction_key,
                p.driver_id              AS driver_id,
                p.race_id                AS race_id,
                p.finish_position        AS finish_position,
                p.submitted_by           AS submitted_by,
                true                     AS accepted,
                ''stored''               AS message
         FROM   f1ops.prediction p
         WHERE  ({keyFilter} = '''' OR CAST(p.id AS VARCHAR) = {keyFilter})
         ORDER  BY p.id DESC
         LIMIT  200'
    parameter keyFilter: string
    returns Formula1Backend.Ops_Prediction
    map ( prediction_key as PredictionKey, driver_id as DriverId,
          race_id as RaceId, finish_position as Position,
          submitted_by as SubmittedBy, accepted as Accepted,
          message as Message );
end;

-- ---------------------------------------------------------------- row shapes

/*
 * The function's result set, one row per race — plus the two arguments it was
 * called with, echoed back on every row.
 *
 * That echo is not decoration, and it is the sharpest thing this file has to
 * say about the missing OData action. A routine's ARGUMENTS are not columns of
 * its RESULT, but Mendix validates $filter against the published metadata
 * before the read microflow runs: `?$filter=driverId eq 'ayrton-senna'` on a
 * resource with no `driverId` attribute is answered `400 Could not map
 * 'driverId' to attribute or association`, and the microflow never sees it.
 *
 * So a parameterised resource has to carry its own parameters as attributes.
 * An OData action would take them as parameters and need none of this. Every
 * one of these resources pays the same tax. FINDINGS §47.
 */
@Position(100, 1400)
create or modify non-persistent entity Formula1Backend.Stg_DriverForm (
  FormKey: string(80),
  DriverId: string(60),
  LastN: long,
  RaceId: long,
  Year: long,
  Round: long,
  RaceName: string(200),
  FinishPosition: long,
  PositionText: string(20),
  GridPosition: long,
  Points: decimal,
  PlacesGained: long,
  RollingAvg: decimal
);

/*
 * The procedure's INOUT row. Separate from the entity a client posts, because
 * the two are different things: this is what the database said, that is what
 * the caller asked for.
 */
@Position(400, 1400)
create or modify non-persistent entity Formula1Backend.Stg_ProcedureResult (
  PredictionId: long,
  Accepted: boolean default false,
  Message: string(500)
);

/*
 * A prediction: the arguments, the key it was stored under, and how it went.
 *
 * `accepted` and `message` look like they belong to a submission rather than to
 * a record, and they were nearly split out — but Mendix requires an action's
 * return type to be an entity published by the same service (CE7244
 * "Published microflow 'RecordPrediction' returns
 * 'Formula1Backend.Stg_ProcedureResult', but that entity is not published in
 * this service"). Splitting them would have meant inventing a second entity set
 * to hold outcomes, which is a worse lie than one entity carrying both. So this
 * is one resource: the action returns it, and a GET reads it back with
 * accepted=true, message='stored'. FINDINGS §48.
 */
@Position(700, 1400)
create or modify non-persistent entity Formula1Backend.Ops_Prediction (
  PredictionKey: string(40),
  DriverId: string(60),
  RaceId: long,
  Position: long,
  SubmittedBy: string(60),
  Accepted: boolean default false,
  Message: string(500)
);

-- ---------------------------------------------------------------- microflows

/*
 * The function, behind a read.
 *
 * Its two arguments come off `$filter` — `driverId eq 'ayrton-senna'` and
 * `lastN eq 5` — which is the module's Key and FilterNumber, the same two
 * readers the fan resources use. No driver, no rows: a form chart with no
 * driver is a bug, not a request for all 917.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_DriverForm (
  $Request: System.HttpRequest
)
  RETURNS List of Formula1Backend.Stg_DriverForm AS $Rows
BEGIN
  $DriverId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'driverId');
  $LastN = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'lastN', Fallback = 5);

  -- The routine caps its own page, so this only stops a caller asking for the
  -- whole career and calling it a form guide.
  DECLARE $N Long = $LastN;
  IF $N < 1 OR $N > 50 THEN
    SET $N = 5;
  END IF;

  $Rows = execute database query Formula1Backend.F1Ops.CallDriverForm
    (driverId = $DriverId, lastN = toString($N));

  RETURN $Rows;
END;

/*
 * The procedure, as an OData action.
 *
 * Its parameters are the procedure's arguments and nothing else — no entity to
 * post, no attributes standing in for arguments, no key to invent for a row
 * that may never be written. The return is the procedure's own INOUT row, so
 * the caller gets the id, the verdict and the database's message.
 *
 * Rejections come back as accepted=false carrying the procedure's own message
 * rather than as an exception, because they are answers and not failures: the
 * routine validated the request and said no. A 500 would lose the reason.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.RecordPrediction (
  $DriverId: String,
  $RaceId: Long,
  $Position: Long,
  $SubmittedBy: String
)
  RETURNS Formula1Backend.Ops_Prediction AS $Answer
BEGIN
  -- The answer starts as a refusal, echoing back what was asked, and is
  -- overwritten by whatever the routine says. Built this way round because MDL
  -- cannot declare an object variable up front (MDL043/CE0053), so a CREATE
  -- inside a branch would leave $Answer assigned on one path only — which
  -- MDL005 rightly warns about.
  $Answer = CREATE Formula1Backend.Ops_Prediction (
    DriverId = $DriverId,
    RaceId = $RaceId,
    Position = $Position,
    SubmittedBy = $SubmittedBy,
    Accepted = false,
    Message = 'the procedure returned no row'
  );

  $Result = execute database query Formula1Backend.F1Ops.CallRecordPrediction
    (driverId = $DriverId,
     raceId = toString($RaceId),
     position = toString($Position),
     submittedBy = $SubmittedBy);

  $Found = HEAD($Result);
  IF $Found != empty THEN
    CHANGE $Answer (
      PredictionKey = toString($Found/PredictionId),
      Accepted = $Found/Accepted,
      Message = $Found/Message
    );
  END IF;
  RETURN $Answer;
END;

-- ---------------------------------------------------------------- the service

/*
 * Two resources, and their contracts differ in a way worth reading.
 *
 * DriverForm declares TopSupported and SkipSupported No, and it means it: a
 * routine decides its own result set, `p_last_n` is the page, and paging on top
 * of that would be asking the same question twice. Countable is No for the same
 * reason — there is no total to count that is not the answer itself.
 *
 * That declaration is usable here and was not on the live service (FINDINGS
 * §42), because nothing generates external entities from this one. The moment
 * something does, `cmd_contract.go:1214` hardcodes both back to true and Mendix
 * refuses the consumer with CE6630.
 *
 * Predictions is POST-and-read-back. The read exists because a resource a
 * client can create in is a resource that client will then re-read by key, and
 * a key lookup that cannot be answered is FINDINGS §37 — `mxcli check` flags
 * exactly this shape (MDL-ODATA02), correctly, and the fix is to answer it
 * rather than to drop the KEY, which Mendix requires anyway (CE6585).
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Predictions (
  $Request: System.HttpRequest
)
  RETURNS List of Formula1Backend.Ops_Prediction AS $Rows
BEGIN
  $Key = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'predictionKey');

  -- The query returns the published shape directly. Mapping it through a second
  -- entity would need a loop that appends to a list, and MDL has no list append
  -- (CE7247: a list is not a primitive, so SET cannot build one) — but the
  -- mapping was never needed: `accepted` and `message` are the answer to a
  -- submission, so for a stored row the SQL supplies the constants.
  $Rows = execute database query Formula1Backend.F1Ops.GetPredictions
    (keyFilter = $Key);

  RETURN $Rows;
END;

/*
 * Custom authentication, which is the fix for the BCrypt cost rather than a
 * shrinking of it.
 *
 * Basic authentication hashes the presented password with BCrypt on EVERY
 * request. §31 measured it at 60-80% of a cached page turn, and §40's answer
 * was to drop the work factor from 12 to 8 — faster, and a deliberate
 * weakening. Custom authentication removes the hash instead: the microflow is
 * handed the request's headers and returns a user, so there is no password to
 * verify per request.
 *
 * MDL could not express it. `authentication microflow` parsed, the microflow
 * name was silently dropped, and the build then failed CE0333 "Please select a
 * microflow to use for authentication" — so the type was reachable and useless.
 * mxcli `715bac5` carries the name through, and `mxcli check` gained
 * MDL-ODATA04 for the unnamed form. FINDINGS §40, §48.
 *
 * All five services use it now. The microflow lives here because this is the
 * file that introduced it; 02, 05, 14 and 15 name it too, and their clients in
 * the frontend send the key as a header instead of a password. With no password
 * verified per request, `BcryptCost` goes back to the Mendix default of 12 —
 * see 07-demo-users.mdl, where the downgrade used to be.
 */
create or modify odata service Formula1Backend.F1OpsApi (
  path: 'odata/f1-ops/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Formula1Backend.Ops'
)
authentication microflow Formula1Backend.AuthenticateApiClient
{
  publish entity Formula1Backend.Stg_DriverForm as 'DriverForm' (
    ReadMode: microflow Formula1Backend.Read_DriverForm,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: No, TopSupported: No, SkipSupported: No
  )
  expose (
    FormKey as 'formKey' (KEY, Filterable),
    DriverId as 'driverId' (Filterable),
    LastN as 'lastN' (Filterable),
    RaceId as 'raceId' (Filterable),
    Year as 'year' (Filterable),
    Round as 'round' (Filterable),
    RaceName as 'raceName',
    FinishPosition as 'finishPosition',
    PositionText as 'positionText',
    GridPosition as 'gridPosition',
    Points as 'points',
    PlacesGained as 'placesGained',
    RollingAvg as 'rollingAvg'
  );

  publish entity Formula1Backend.Ops_Prediction as 'Predictions' (
    ReadMode: microflow Formula1Backend.Read_Predictions,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: No, TopSupported: No, SkipSupported: No
  )
  expose (
    PredictionKey as 'predictionKey' (KEY),
    DriverId as 'driverId',
    RaceId as 'raceId',
    Position as 'position',
    SubmittedBy as 'submittedBy',
    Accepted as 'accepted',
    Message as 'message'
  );

  /*
   * The procedure itself, invocable. An ActionImport in $metadata, so a client
   * discovers it rather than being told which entity set to POST to.
   *
   * No types here: mxcli reads them off the microflow. That is the difference
   * between a declaration and a second copy of one.
   */
  publish microflow Formula1Backend.RecordPrediction as 'RecordPrediction'
    expose (
      DriverId as 'driverId',
      RaceId as 'raceId',
      Position as 'position',
      SubmittedBy as 'submittedBy'
    );
};

/*
 * Granted once. This used to need repeating after every service modify, because
 * the modelsdk writer dropped AllowedModuleRoles — `28ce821` fixed the .mpr
 * writer and missed this one. `715bac5` fixed it. FINDINGS §41, §48.
 */
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1OpsApi TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverForm  TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Predictions TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.RecordPrediction TO Formula1Backend.ApiUser;

GRANT Formula1Backend.ApiUser ON Formula1Backend.Stg_DriverForm      (read *);
GRANT Formula1Backend.ApiUser ON Formula1Backend.Stg_ProcedureResult (read *);
GRANT Formula1Backend.ApiUser ON Formula1Backend.Ops_Prediction      (create, read *, write *);
