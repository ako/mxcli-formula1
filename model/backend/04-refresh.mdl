/*
 * Service 2 of 2, part B — the load job.
 *
 * Runs the same DuckDB queries the live service runs per request, once, and
 * writes the results into the persistent entities. This is the whole cost of
 * the cached service: a step that has to happen, and data that can be stale
 * between runs.
 *
 * Order matters — Seasons, Circuits, Constructors and Drivers first, because
 * Races and the standings link to them by natural key.
 *
 * Each Refresh_X clears its table first, so the job is idempotent and a
 * re-run after a dataset update replaces rather than duplicates.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Refresh_Seasons ()
  RETURNS Long AS $Count
BEGIN
  RETRIEVE $Existing FROM Formula1Backend.Season;
  LOOP $Old IN $Existing BEGIN
    DELETE $Old;
  END LOOP;
  $Rows = execute database query Formula1Backend.F1Warehouse.GetSeasons
    (dataDir = @Formula1Backend.DataDir);
  LOOP $Row IN $Rows BEGIN
    $New = CREATE Formula1Backend.Season (
      Year = $Row/Year,
      ChampionDriverName = $Row/ChampionDriverName,
      ChampionConstructorName = $Row/ChampionConstructorName,
      RaceCount = $Row/RaceCount
    ) COMMIT;
  END LOOP;
  $Count = COUNT($Rows);
  LOG INFO NODE 'F1Refresh' 'Seasons loaded';
  RETURN $Count;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Refresh_Circuits ()
  RETURNS Long AS $Count
BEGIN
  RETRIEVE $Existing FROM Formula1Backend.Circuit;
  LOOP $Old IN $Existing BEGIN
    DELETE $Old;
  END LOOP;
  $Rows = execute database query Formula1Backend.F1Warehouse.GetCircuits
    (dataDir = @Formula1Backend.DataDir);
  LOOP $Row IN $Rows BEGIN
    $New = CREATE Formula1Backend.Circuit (
      CircuitId = $Row/CircuitId,
      Name = $Row/Name,
      FullName = $Row/FullName,
      PlaceName = $Row/PlaceName,
      Country = $Row/Country,
      Latitude = $Row/Latitude,
      Longitude = $Row/Longitude,
      Length = $Row/Length,
      Turns = $Row/Turns,
      RacesHeld = $Row/RacesHeld
    ) COMMIT;
  END LOOP;
  $Count = COUNT($Rows);
  LOG INFO NODE 'F1Refresh' 'Circuits loaded';
  RETURN $Count;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Refresh_Constructors ()
  RETURNS Long AS $Count
BEGIN
  RETRIEVE $Existing FROM Formula1Backend.Constructor;
  LOOP $Old IN $Existing BEGIN
