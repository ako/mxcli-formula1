/*
 * Formula1Backend — the DuckDB read layer.
 *
 * Everything both OData services stand on: the connection to the CSV folder,
 * the non-persistable row shapes the connector maps results into, and one
 * query per resource.
 *
 * The CSVs are read in place. `read_csv({dataDir} || '/f1db-x.csv')` binds the
 * folder as a query parameter, so nothing absolute is baked into the model and
 * DataDir can be overridden per environment with MX_Formula1Backend_DataDir.
 */

create or modify constant Formula1Backend.DataDir type string
  default '/home/user/mxcli-formula1/data/f1db'
  comment 'Folder holding the f1db CSVs. Override per environment.';

create or modify constant Formula1Backend.DuckDbUrl type string
  default 'jdbc:duckdb:'
  comment 'In-memory DuckDB — no database file; read_csv() reads the CSVs per query.';

create or modify constant Formula1Backend.DuckDbUser type string default '';
create or modify constant Formula1Backend.DuckDbPassword type string default '' PRIVATE;

/* ---------------------------------------------------------------------------
 * Row shapes. Non-persistable, because that is what the External Database
 * Connector maps query results into. Flat: every join happens in DuckDB, so
 * there are no associations to resolve on the Mendix side.
 *
 * Whole numbers are `long`, not `integer`, on purpose. Mendix publishes a
 * Mendix `Integer` as Edm.Int64, but mxcli writes Edm.Int32 for it, and the
 * build then fails with "has type Integer, but is published as Edm.Int32" on
 * every such attribute. `long` maps to Edm.Int64 on both sides. See
 * FINDINGS.md §16.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_Season (
  Year: long,
  ChampionDriverName: string(120),
  ChampionConstructorName: string(120),
  RaceCount: long
);

create or modify non-persistent entity Formula1Backend.Stg_Circuit (
  CircuitId: string(60),
  Name: string(120),
  FullName: string(200),
  PlaceName: string(120),
  Country: string(60),
  Latitude: decimal,
  Longitude: decimal,
  Length: decimal,
  Turns: long,
  RacesHeld: long
);

create or modify non-persistent entity Formula1Backend.Stg_Constructor (
  ConstructorId: string(60),
  Name: string(120),
  FullName: string(200),
  Country: string(60),
  ChampionshipWins: long,
  RaceStarts: long,
  RaceWins: long,
  Podiums: long,
  Points: decimal,
  PolePositions: long
);

create or modify non-persistent entity Formula1Backend.Stg_Driver (
  DriverId: string(60),
  Name: string(120),
  FullName: string(200),
  Abbreviation: string(10),
  PermanentNumber: string(10),
  DateOfBirth: datetime,
  PlaceOfBirth: string(120),
  Nationality: string(60),
  ChampionshipWins: long,
  RaceStarts: long,
  RaceWins: long,
  Podiums: long,
  Points: decimal,
  PolePositions: long
);

create or modify non-persistent entity Formula1Backend.Stg_Race (
  RaceId: long,
  Year: long,
  Round: long,
  RaceDate: datetime,
  OfficialName: string(200),
  GrandPrixId: string(60),
  CircuitId: string(60),
  CircuitName: string(120),
  Laps: long,
  Distance: decimal
);

create or modify non-persistent entity Formula1Backend.Stg_RaceResult (
  RaceId: long,
  Year: long,
  Round: long,
  PositionOrder: long,
  PositionNumber: long,
  PositionText: string(20),
  DriverId: string(60),
  DriverName: string(120),
  ConstructorId: string(60),
  ConstructorName: string(120),
  DriverNumber: string(10),
  Laps: long,
  TimeText: string(60),
  Gap: string(60),
  ReasonRetired: string(120),
  Points: decimal,
  GridPosition: long,
  PositionsGained: long,
  FastestLap: boolean,
  PolePosition: boolean
);

/*
 * The standings carry a synthetic key because the natural one is not unique:
 * a driver appears once per season, so `driverId` alone identifies up to 77
 * rows. A published entity must have a key, and a key that matches many rows is
 * worse than none — the client re-reads a row it holds, gets the newest match,
 * and silently swaps one season for another. `<year>-<driverId>` is the pair
 * that actually identifies a standing. FINDINGS §37, §42.
 */
create or modify non-persistent entity Formula1Backend.Stg_DriverStanding (
  StandingKey: string(80),
  Year: long,
  PositionOrder: long,
  PositionNumber: long,
  PositionText: string(20),
  DriverId: string(60),
  DriverName: string(120),
  Points: decimal,
  ChampionshipWon: boolean
);

create or modify non-persistent entity Formula1Backend.Stg_ConstructorStanding (
  StandingKey: string(80),
  Year: long,
  PositionOrder: long,
  EngineManufacturer: string(60),
  PositionNumber: long,
  PositionText: string(20),
  ConstructorId: string(60),
  ConstructorName: string(120),
  Points: decimal,
  ChampionshipWon: boolean
);

/*
 * A row shape for count queries. The connector maps every result into an
 * entity, so "SELECT count(*)" needs one too. Used by the pushdown read
 * microflows to answer $count over the filtered set rather than the page.
 */
create or modify non-persistent entity Formula1Backend.Stg_Count (
  Total: long
);

/* ---------------------------------------------------------------------------
 * The fan-facing shapes. Everything above is a table; these five are questions.
 *
 * They exist because a browsing UI does not want rows, it wants an answer:
 * what did this driver's career look like, how did a season unfold, where does
 * this team keep breaking. Each one is a query DuckDB can answer in a single
 * pass over the CSVs, so none of it is materialised either.
 *
 * Each carries a synthesised key, because a grouped result has no natural id
 * and OData needs one per row.
 * ------------------------------------------------------------------------- */

/* One row per season a driver started, which is the spine of a career page. */
create or modify non-persistent entity Formula1Backend.Stg_DriverSeason (
  SeasonKey: string(80),
  DriverId: string(60),
  Year: long,
  Constructors: string(300),
  StandingPosition: string(20),
  StandingOrder: long,
  Points: decimal,
  Starts: long,
  Wins: long,
  Podiums: long,
  Poles: long,
  BestFinish: long,
  AvgQualifying: decimal,
  AvgFinish: decimal,
  Retirements: long
);

/*
 * One row per race a driver entered, carrying every session: three practices,
 * qualifying, the grid slot and the finish. Practice results only exist from
 * the era each session was timed, so the early columns are empty for most of
 * the sport's history — which is itself the answer to "how did they practise".
 */
create or modify non-persistent entity Formula1Backend.Stg_DriverRace (
  RaceKey: string(80),
  DriverId: string(60),
  Year: long,
  Round: long,
  RaceName: string(200),
  ConstructorName: string(120),
  Fp1Position: long,
  Fp2Position: long,
  Fp3Position: long,
  QualifyingPosition: long,
  GridPosition: long,
  FinishPosition: long,
  PositionText: string(20),
  PositionsGained: long,
  Points: decimal,
  ReasonRetired: string(120)
);

/*
 * A season's title fight as a chart: one row per round, carrying the running
 * points total of the five drivers who finished the championship on top.
 *
 * Wide rather than long — five name columns and five points columns — because
 * a Mendix chart series binds one Y attribute at author time. Long data would
 * need a series per driver created per season, which a static page cannot do.
 */
create or modify non-persistent entity Formula1Backend.Stg_SeasonProgress (
  ProgressKey: string(40),
  Year: long,
  Round: long,
  RaceName: string(200),
  D1Name: string(120),
  D2Name: string(120),
  D3Name: string(120),
  D4Name: string(120),
  D5Name: string(120),
  D1Points: decimal,
  D2Points: decimal,
  D3Points: decimal,
  D4Points: decimal,
  D5Points: decimal
);

/* Why a team's cars stopped, and how often. One row per constructor-reason. */
create or modify non-persistent entity Formula1Backend.Stg_Retirement (
  RetirementKey: string(200),
  ConstructorId: string(60),
  ConstructorName: string(120),
  ReasonRetired: string(120),
  Retirements: long,
  Entries: long,
  SharePercent: decimal,
  FirstYear: long,
  LastYear: long
);

/*
 * Prose, which no CSV in f1db has. Fetched from Wikipedia by
 * scripts/fetch-f1-facts.sh into data/facts/f1db-facts.csv and read the same
 * way as everything else. The licence and source URL travel with every row
 * because CC BY-SA requires attribution wherever the text is shown.
 */
create or modify non-persistent entity Formula1Backend.Stg_Fact (
  FactKey: string(80),
  Scope: string(20),
  EntityId: string(60),
  Title: string(200),
  Extract: string(4000),
  SourceUrl: string(300),
  License: string(60)
);

/* ---------------------------------------------------------------------------
 * The race weekend, and the lap traces behind it.
 *
 * f1db carries every session's result — three practices, qualifying, the race,
 * the fastest lap, every pit stop — with times and gaps. What it does not carry
 * is a row per driver per lap; that is fetched from Jolpica (the Ergast
 * successor) into data/laps/ and read the same way.
 *
 * The two chart shapes are wide on purpose, for the reason the season
 * progression is: a Mendix chart series binds its Y attribute when the page is
 * authored, so ten drivers means ten columns, not ten rows.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_RaceWeekend (
  WeekendKey: string(40),
  RaceId: long,
  Year: long,
  Round: long,
  RoundLabel: string(40),
  Name: string(200),
  CircuitName: string(120),
  CircuitId: string(60),
  RaceDate: datetime,
  Laps: long,
  Distance: decimal,
  WinnerName: string(120),
  WinnerTeam: string(120),
  PoleName: string(120),
  PoleTime: string(30),
  FastestLapName: string(120),
  FastestLapTime: string(30),
  Fp1LeaderName: string(120),
  Fp1LeaderTime: string(30),
  Fp2LeaderName: string(120),
  Fp2LeaderTime: string(30),
  Fp3LeaderName: string(120),
  Fp3LeaderTime: string(30)
);

/*
 * One row per driver per weekend, every session side by side, with each gap
 * expressed in seconds off that session's best — which is what makes the pace
 * chart comparable across sessions run in different conditions.
 */
create or modify non-persistent entity Formula1Backend.Stg_RaceSession (
  SessionKey: string(80),
  RaceId: long,
  Year: long,
  Round: long,
  DriverId: string(60),
  DriverName: string(120),
  Abbreviation: string(10),
  ConstructorName: string(120),
  Fp1Position: long,
  Fp1Time: string(30),
  Fp1Gap: decimal,
  Fp2Position: long,
  Fp2Time: string(30),
  Fp2Gap: decimal,
  Fp3Position: long,
  Fp3Time: string(30),
  Fp3Gap: decimal,
  QualPosition: long,
  QualTime: string(30),
  QualGap: decimal,
  Q1: string(30),
  Q2: string(30),
  Q3: string(30),
  GridPosition: long,
  FinishPosition: long,
  PositionText: string(20),
  PositionsGained: long,
  Points: decimal,
  ReasonRetired: string(120),
  BestLapTime: string(30),
  BestLapGap: decimal,
  BestLapRank: long,
  PitStops: long
);

/* The championship calendar: one row per round, with who won it. */
create or modify non-persistent entity Formula1Backend.Stg_Calendar (
  CalendarKey: string(40),
  RaceId: long,
  Year: long,
  Round: long,
  Code: string(10),
  Name: string(200),
  CircuitName: string(120),
  RaceDate: datetime,
  WinnerName: string(120),
  WinnerTeam: string(120)
);

/* Position across the weekend: five rows (FP1, FP2, FP3, Quali, Race), ten
 * drivers wide. */
create or modify non-persistent entity Formula1Backend.Stg_WeekendShape (
  ShapeKey: string(40),
  RaceId: long,
  SessionIndex: long,
  SessionLabel: string(20),
  S1Name: string(120),
  S2Name: string(120),
  S3Name: string(120),
  S4Name: string(120),
  S5Name: string(120),
  S6Name: string(120),
  S7Name: string(120),
  S8Name: string(120),
  S9Name: string(120),
  S10Name: string(120),
  S1Value: long,
  S2Value: long,
  S3Value: long,
  S4Value: long,
  S5Value: long,
  S6Value: long,
  S7Value: long,
  S8Value: long,
  S9Value: long,
  S10Value: long
);

/* Race position by lap, from the Jolpica traces: one row per lap, ten wide. */
create or modify non-persistent entity Formula1Backend.Stg_LapChart (
  LapKey: string(40),
  Year: long,
  Round: long,
  Lap: long,
  S1Name: string(120),
  S2Name: string(120),
  S3Name: string(120),
  S4Name: string(120),
  S5Name: string(120),
  S6Name: string(120),
  S7Name: string(120),
  S8Name: string(120),
  S9Name: string(120),
  S10Name: string(120),
  S1Value: long,
  S2Value: long,
  S3Value: long,
  S4Value: long,
  S5Value: long,
  S6Value: long,
  S7Value: long,
  S8Value: long,
  S9Value: long,
  S10Value: long
);

/* ---------------------------------------------------------------------------
 * Near-live timing, from OpenF1.
 *
 * A different source with a different contract: f1db is a file that changes
 * when someone publishes a release, OpenF1 is a service that changes during a
 * race. scripts/fetch-f1-live.sh snapshots one session into data/live/ and the
 * page reads whatever the last snapshot holds — so "live" here means "as fresh
 * as the last fetch", which on a race Sunday means running it on a timer.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_LiveEntry (
  EntryKey: string(40),
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  DriverName: string(120),
  Team: string(120),
  TeamColour: string(10),
  Position: long,
  GapToLeader: string(20),
  Interval: string(20),
  LapNumber: long,
  LastLapSeconds: decimal,
  Sector1: decimal,
  Sector2: decimal,
  Sector3: decimal,
  SpeedTrap: long,
  Compound: string(20),
  TyreAge: long,
  PitStops: long
);

create or modify non-persistent entity Formula1Backend.Stg_LiveMessage (
  MessageKey: string(60),
  SessionKey: string(20),
  At: string(20),
  Category: string(40),
  Flag: string(30),
  Scope: string(30),
  Lap: long,
  Message: string(500)
);

create or modify non-persistent entity Formula1Backend.Stg_LiveSession (
  SessionKey: string(20),
  SessionName: string(60),
  SessionType: string(40),
  Location: string(120),
  CountryName: string(120),
  CircuitName: string(120),
  DateStart: string(40),
  Year: long,
  DriverCount: long,
  LeadLap: long,
  FetchedAt: string(40),
  AirTemperature: decimal,
  TrackTemperature: decimal,
  Humidity: decimal,
  Rainfall: decimal,
  WindSpeed: decimal
);

/* ---------------------------------------------------------------------------
 * The connection. Type 'BYOD' is Studio Pro's "Other" — bring your own driver.
 * It skips the driver-presence check, which is the only reason a JDBC driver
 * Mendix has no picker entry for can be used at all.
 *
 * Every query takes dataDir so the CSV folder stays a constant, not a literal.
 * ------------------------------------------------------------------------- */

create or modify database connection Formula1Backend.F1Warehouse
type 'BYOD'
connection string @Formula1Backend.DuckDbUrl
username @Formula1Backend.DuckDbUser
password @Formula1Backend.DuckDbPassword
begin
  /*
   * `keyFilter` is how this resource answers a lookup by its own key.
   *
   * A client holding one of these rows re-reads it by key on its own, and a
   * read that ignores the request answers with the whole collection instead —
   * whereupon the client adopts the first row as that object's identity and
   * keeps it. The guard is written as an OR so one query serves both callers:
   * empty means "the collection", anything else means "that row". Bound, not
   * interpolated, so it cannot carry SQL. FINDINGS §37, §42.
   */
  query GetSeasons
    sql 'SELECT * FROM (
           SELECT s.year AS year,
                  COALESCE(d.name, ''—'') AS championDriverName,
                  COALESCE(c.name, ''—'') AS championConstructorName,
                  (SELECT count(*) FROM read_csv({dataDir} || ''/f1db-races.csv'') r
                     WHERE r.year = s.year) AS raceCount
           FROM read_csv({dataDir} || ''/f1db-seasons.csv'') s
           LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
                  ON ds.year = s.year AND ds.championshipWon = true
           LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = ds.driverId
           LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-constructor-standings.csv'') cs
                  ON cs.year = s.year AND cs.championshipWon = true
           LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = cs.constructorId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.year AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.year AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.year DESC'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_Season
    map ( year as Year, championDriverName as ChampionDriverName,
          championConstructorName as ChampionConstructorName, raceCount as RaceCount );

  query GetCircuits
    sql 'SELECT * FROM (
           SELECT id, name, fullName, placeName, countryId, latitude, longitude,
                  length, turns, totalRacesHeld
           FROM read_csv({dataDir} || ''/f1db-circuits.csv'')
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.name'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_Circuit
    map ( id as CircuitId, name as Name, fullName as FullName, placeName as PlaceName,
          countryId as Country, latitude as Latitude, longitude as Longitude,
          length as Length, turns as Turns, totalRacesHeld as RacesHeld );

  query GetConstructors
    sql 'SELECT * FROM (
           SELECT id, name, fullName, countryId, totalChampionshipWins, totalRaceStarts,
                  totalRaceWins, totalPodiums, totalPoints, totalPolePositions
           FROM read_csv({dataDir} || ''/f1db-constructors.csv'')
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.name'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_Constructor
    map ( id as ConstructorId, name as Name, fullName as FullName, countryId as Country,
          totalChampionshipWins as ChampionshipWins, totalRaceStarts as RaceStarts,
          totalRaceWins as RaceWins, totalPodiums as Podiums, totalPoints as Points,
          totalPolePositions as PolePositions );

  query GetDrivers
    sql 'SELECT id, name, fullName, abbreviation, permanentNumber, dateOfBirth,
                placeOfBirth, nationalityCountryId, totalChampionshipWins,
                totalRaceStarts, totalRaceWins, totalPodiums, totalPoints,
                totalPolePositions
         FROM read_csv({dataDir} || ''/f1db-drivers.csv'') ORDER BY name'
    parameter dataDir: string
    returns Formula1Backend.Stg_Driver
    map ( id as DriverId, name as Name, fullName as FullName, abbreviation as Abbreviation,
          permanentNumber as PermanentNumber, dateOfBirth as DateOfBirth,
          placeOfBirth as PlaceOfBirth, nationalityCountryId as Nationality,
          totalChampionshipWins as ChampionshipWins, totalRaceStarts as RaceStarts,
          totalRaceWins as RaceWins, totalPodiums as Podiums, totalPoints as Points,
          totalPolePositions as PolePositions );

  query GetRaces
    sql 'SELECT * FROM (
           SELECT r.id, r.year, r.round, r.date, r.officialName, r.grandPrixId,
                  r.circuitId, c.name AS circuitName, r.laps, r.distance
           FROM read_csv({dataDir} || ''/f1db-races.csv'') r
           LEFT JOIN read_csv({dataDir} || ''/f1db-circuits.csv'') c ON c.id = r.circuitId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.year DESC, t.round'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_Race
    map ( id as RaceId, year as Year, round as Round, date as RaceDate,
          officialName as OfficialName, grandPrixId as GrandPrixId,
          circuitId as CircuitId, circuitName as CircuitName, laps as Laps,
          distance as Distance );

  -- Every race result, 27533 rows. The cached service materialises all of it;
  -- the live service overrides this SQL per season so a request stays bounded.
  query GetRaceResults
    sql 'SELECT rr.raceId, rr.year, rr.round, rr.positionDisplayOrder, rr.positionNumber,
                rr.positionText, rr.driverId, d.name AS driverName,
                rr.constructorId, c.name AS constructorName, rr.driverNumber,
                rr.laps, rr.time, rr.gap, rr.reasonRetired, rr.points,
                rr.gridPositionNumber, rr.positionsGained, rr.fastestLap, rr.polePosition
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         ORDER BY rr.year DESC, rr.round, rr.positionDisplayOrder'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceResult
    map ( raceId as RaceId, year as Year, round as Round,
          positionDisplayOrder as PositionOrder, positionNumber as PositionNumber,
          positionText as PositionText, driverId as DriverId, driverName as DriverName,
          constructorId as ConstructorId, constructorName as ConstructorName,
          driverNumber as DriverNumber, laps as Laps, time as TimeText, gap as Gap,
          reasonRetired as ReasonRetired, points as Points,
          gridPositionNumber as GridPosition, positionsGained as PositionsGained,
          fastestLap as FastestLap, polePosition as PolePosition );

  -- Count queries. The SQL here is a placeholder: callers override it with
  -- `dynamic` so the WHERE clause matches the page query.
  query GetDriverCount
    sql 'SELECT count(*) AS total FROM read_csv({dataDir} || ''/f1db-drivers.csv'')'
    parameter dataDir: string
    returns Formula1Backend.Stg_Count
    map ( total as Total );

  query GetRaceResultCount
    sql 'SELECT count(*) AS total FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'')'
    parameter dataDir: string
    returns Formula1Backend.Stg_Count
    map ( total as Total );

  query GetDriverStandings
    sql 'SELECT * FROM (
           SELECT ds.year || ''-'' || ds.driverId AS standingKey,
                  ds.year, ds.positionDisplayOrder, ds.positionNumber, ds.positionText,
                  ds.driverId, d.name AS driverName, ds.points, ds.championshipWon
           FROM read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
           LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = ds.driverId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.standingKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.standingKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.year DESC, t.positionDisplayOrder'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_DriverStanding
    map ( standingKey as StandingKey, year as Year,
          positionDisplayOrder as PositionOrder,
          positionNumber as PositionNumber, positionText as PositionText,
          driverId as DriverId, driverName as DriverName, points as Points,
          championshipWon as ChampionshipWon );

  query GetConstructorStandings
    sql 'SELECT * FROM (
           SELECT cs.year || ''-'' || cs.constructorId AS standingKey,
                  cs.year, cs.positionDisplayOrder, cs.positionNumber, cs.positionText,
                  cs.constructorId, c.name AS constructorName, cs.engineManufacturerId,
                  cs.points, cs.championshipWon
           FROM read_csv({dataDir} || ''/f1db-seasons-constructor-standings.csv'') cs
           LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = cs.constructorId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.standingKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.standingKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.year DESC, t.positionDisplayOrder'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_ConstructorStanding
    map ( standingKey as StandingKey, year as Year,
          positionDisplayOrder as PositionOrder,
          positionNumber as PositionNumber, positionText as PositionText,
          constructorId as ConstructorId, constructorName as ConstructorName,
          engineManufacturerId as EngineManufacturer,
          points as Points, championshipWon as ChampionshipWon );

  /* -------------------------------------------------------------------------
   * The fan-page queries.
   *
   * The SQL below is the shape, not the query that runs: every one of these is
   * answered for a single driver, season or team, and the read microflow builds
   * the real statement with `dynamic`. What is written here fixes the column
   * list the connector maps, so it stays in step with the map clause; `LIMIT 1`
   * keeps the placeholder from scanning 27533 rows at build time.
   * ---------------------------------------------------------------------- */

  query GetDriverSeasons
    sql 'SELECT rr.year || ''-'' || rr.driverId AS seasonKey, rr.driverId AS driverId,
                rr.year AS year,
                COALESCE(string_agg(DISTINCT c.name, '', ''), ''-'') AS constructors,
                COALESCE(max(ds.positionText), ''-'') AS standingPosition,
                COALESCE(max(ds.positionDisplayOrder), 999) AS standingOrder,
                COALESCE(max(ds.points), sum(COALESCE(rr.points, 0))) AS points,
                count(*) AS starts,
                sum(CASE WHEN rr.positionNumber = 1 THEN 1 ELSE 0 END) AS wins,
                sum(CASE WHEN rr.positionNumber <= 3 THEN 1 ELSE 0 END) AS podiums,
                sum(CASE WHEN rr.polePosition THEN 1 ELSE 0 END) AS poles,
                min(rr.positionNumber) AS bestFinish,
                round(avg(rr.qualificationPositionNumber), 1) AS avgQualifying,
                round(avg(rr.positionNumber), 1) AS avgFinish,
                sum(CASE WHEN rr.positionNumber IS NULL THEN 1 ELSE 0 END) AS retirements
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
                ON ds.year = rr.year AND ds.driverId = rr.driverId
         GROUP BY rr.year, rr.driverId
         ORDER BY rr.year DESC
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_DriverSeason
    map ( seasonKey as SeasonKey, driverId as DriverId, year as Year,
          constructors as Constructors, standingPosition as StandingPosition,
          standingOrder as StandingOrder, points as Points, starts as Starts,
          wins as Wins, podiums as Podiums, poles as Poles, bestFinish as BestFinish,
          avgQualifying as AvgQualifying, avgFinish as AvgFinish,
          retirements as Retirements );

  query GetDriverRaces
    sql 'SELECT rr.raceId || ''-'' || rr.driverId AS raceKey, rr.driverId AS driverId,
                rr.year AS year, rr.round AS round,
                COALESCE(r.officialName, ''Round '' || rr.round) AS raceName,
                COALESCE(c.name, ''-'') AS constructorName,
                fp1.positionNumber AS fp1Position,
                fp2.positionNumber AS fp2Position,
                fp3.positionNumber AS fp3Position,
                rr.qualificationPositionNumber AS qualifyingPosition,
                rr.gridPositionNumber AS gridPosition,
                rr.positionNumber AS finishPosition,
                rr.positionText AS positionText,
                rr.positionsGained AS positionsGained,
                rr.points AS points,
                rr.reasonRetired AS reasonRetired
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-races.csv'') r ON r.id = rr.raceId
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-1-results.csv'') fp1
                ON fp1.raceId = rr.raceId AND fp1.driverId = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-2-results.csv'') fp2
                ON fp2.raceId = rr.raceId AND fp2.driverId = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-3-results.csv'') fp3
                ON fp3.raceId = rr.raceId AND fp3.driverId = rr.driverId
         ORDER BY rr.year DESC, rr.round
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_DriverRace
    map ( raceKey as RaceKey, driverId as DriverId, year as Year, round as Round,
          raceName as RaceName, constructorName as ConstructorName,
          fp1Position as Fp1Position, fp2Position as Fp2Position, fp3Position as Fp3Position,
          qualifyingPosition as QualifyingPosition, gridPosition as GridPosition,
          finishPosition as FinishPosition, positionText as PositionText,
          positionsGained as PositionsGained, points as Points,
          reasonRetired as ReasonRetired );

  query GetSeasonProgress
    sql 'SELECT ''0-0'' AS progressKey, 0 AS year, 0 AS round, '''' AS raceName,
                '''' AS d1Name, '''' AS d2Name, '''' AS d3Name, '''' AS d4Name, '''' AS d5Name,
                0.0 AS d1Points, 0.0 AS d2Points, 0.0 AS d3Points,
                0.0 AS d4Points, 0.0 AS d5Points
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_SeasonProgress
    map ( progressKey as ProgressKey, year as Year, round as Round, raceName as RaceName,
          d1Name as D1Name, d2Name as D2Name, d3Name as D3Name, d4Name as D4Name,
          d5Name as D5Name, d1Points as D1Points, d2Points as D2Points,
          d3Points as D3Points, d4Points as D4Points, d5Points as D5Points );

  query GetRetirements
    sql 'SELECT rr.constructorId || ''|'' || COALESCE(rr.reasonRetired, ''Unknown'') AS retirementKey,
                rr.constructorId AS constructorId,
                COALESCE(c.name, rr.constructorId) AS constructorName,
                COALESCE(rr.reasonRetired, ''Unknown'') AS reasonRetired,
                count(*) AS retirements, 0 AS entries, 0.0 AS sharePercent,
                min(rr.year) AS firstYear, max(rr.year) AS lastYear
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         WHERE rr.positionNumber IS NULL
         GROUP BY rr.constructorId, c.name, rr.reasonRetired
         ORDER BY count(*) DESC
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Retirement
    map ( retirementKey as RetirementKey, constructorId as ConstructorId,
          constructorName as ConstructorName, reasonRetired as ReasonRetired,
          retirements as Retirements, entries as Entries, sharePercent as SharePercent,
          firstYear as FirstYear, lastYear as LastYear );

  /*
   * Facts. The file is written by scripts/fetch-f1-facts.sh and can legitimately
   * be header-only when the fetch could not reach Wikipedia, so the column types
   * are declared rather than sniffed: read_csv infers nothing from an empty file
   * and would fail on the column names instead of returning no rows.
   */
  query GetFacts
    sql 'SELECT scope || ''-'' || entityId AS factKey, scope AS scope,
                entityId AS entityId, title AS title, extract AS extract,
                sourceUrl AS sourceUrl, license AS license
         FROM read_csv({dataDir} || ''/../facts/f1db-facts.csv'', header = true,
                       columns = {''scope'': ''VARCHAR'', ''entityId'': ''VARCHAR'',
                                  ''title'': ''VARCHAR'', ''extract'': ''VARCHAR'',
                                  ''sourceUrl'': ''VARCHAR'', ''license'': ''VARCHAR''})
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Fact
    map ( factKey as FactKey, scope as Scope, entityId as EntityId, title as Title,
          extract as Extract, sourceUrl as SourceUrl, license as License );


  /* -------------------------------------------------------------------------
   * The weekend queries. Placeholders again: every one is answered for a single
   * race and built with `dynamic` by the read microflow. What is fixed here is
   * the column list the connector maps.
   * ---------------------------------------------------------------------- */

  query GetRaceWeekend
    sql 'SELECT '''' AS weekendKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS roundLabel, '''' AS name, '''' AS circuitName,
                '''' AS circuitId, CAST(NULL AS TIMESTAMP) AS raceDate,
                0 AS laps, 0.0 AS distance,
                '''' AS winnerName, '''' AS winnerTeam,
                '''' AS poleName, '''' AS poleTime,
                '''' AS fastestLapName, '''' AS fastestLapTime,
                '''' AS fp1LeaderName, '''' AS fp1LeaderTime,
                '''' AS fp2LeaderName, '''' AS fp2LeaderTime,
                '''' AS fp3LeaderName, '''' AS fp3LeaderTime
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceWeekend
    map ( weekendKey as WeekendKey, raceId as RaceId, year as Year, round as Round,
          roundLabel as RoundLabel, name as Name, circuitName as CircuitName,
          circuitId as CircuitId, raceDate as RaceDate, laps as Laps,
          distance as Distance, winnerName as WinnerName, winnerTeam as WinnerTeam,
          poleName as PoleName, poleTime as PoleTime,
          fastestLapName as FastestLapName, fastestLapTime as FastestLapTime,
          fp1LeaderName as Fp1LeaderName, fp1LeaderTime as Fp1LeaderTime,
          fp2LeaderName as Fp2LeaderName, fp2LeaderTime as Fp2LeaderTime,
          fp3LeaderName as Fp3LeaderName, fp3LeaderTime as Fp3LeaderTime );

  query GetRaceSessions
    sql 'SELECT '''' AS sessionKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS driverId, '''' AS driverName, '''' AS abbreviation,
                '''' AS constructorName,
                0 AS fp1Position, '''' AS fp1Time, 0.0 AS fp1Gap,
                0 AS fp2Position, '''' AS fp2Time, 0.0 AS fp2Gap,
                0 AS fp3Position, '''' AS fp3Time, 0.0 AS fp3Gap,
                0 AS qualPosition, '''' AS qualTime, 0.0 AS qualGap,
                '''' AS q1, '''' AS q2, '''' AS q3,
                0 AS gridPosition, 0 AS finishPosition, '''' AS positionText,
                0 AS positionsGained, 0.0 AS points, '''' AS reasonRetired,
                '''' AS bestLapTime, 0.0 AS bestLapGap, 0 AS bestLapRank,
                0 AS pitStops
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceSession
    map ( sessionKey as SessionKey, raceId as RaceId, year as Year, round as Round,
          driverId as DriverId, driverName as DriverName, abbreviation as Abbreviation,
          constructorName as ConstructorName,
          fp1Position as Fp1Position, fp1Time as Fp1Time, fp1Gap as Fp1Gap,
          fp2Position as Fp2Position, fp2Time as Fp2Time, fp2Gap as Fp2Gap,
          fp3Position as Fp3Position, fp3Time as Fp3Time, fp3Gap as Fp3Gap,
          qualPosition as QualPosition, qualTime as QualTime, qualGap as QualGap,
          q1 as Q1, q2 as Q2, q3 as Q3,
          gridPosition as GridPosition, finishPosition as FinishPosition,
          positionText as PositionText, positionsGained as PositionsGained,
          points as Points, reasonRetired as ReasonRetired,
          bestLapTime as BestLapTime, bestLapGap as BestLapGap,
          bestLapRank as BestLapRank, pitStops as PitStops );

  query GetCalendar
    sql 'SELECT '''' AS calendarKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS code, '''' AS name, '''' AS circuitName,
                CAST(NULL AS TIMESTAMP) AS raceDate,
                '''' AS winnerName, '''' AS winnerTeam
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Calendar
    map ( calendarKey as CalendarKey, raceId as RaceId, year as Year, round as Round,
          code as Code, name as Name, circuitName as CircuitName,
          raceDate as RaceDate, winnerName as WinnerName, winnerTeam as WinnerTeam );

  query GetWeekendShape
    sql 'SELECT '''' AS shapeKey, 0 AS raceId, 0 AS sessionIndex, '''' AS sessionLabel,
                '''' AS s1name,
                '''' AS s2name,
                '''' AS s3name,
                '''' AS s4name,
                '''' AS s5name,
                '''' AS s6name,
                '''' AS s7name,
                '''' AS s8name,
                '''' AS s9name,
                '''' AS s10name,
                0 AS s1value,
                0 AS s2value,
                0 AS s3value,
                0 AS s4value,
                0 AS s5value,
                0 AS s6value,
                0 AS s7value,
                0 AS s8value,
                0 AS s9value,
                0 AS s10value
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_WeekendShape
    map ( shapeKey as ShapeKey, raceId as RaceId, sessionIndex as SessionIndex,
          sessionLabel as SessionLabel,
          s1name as S1Name, s2name as S2Name, s3name as S3Name, s4name as S4Name, s5name as S5Name, s6name as S6Name, s7name as S7Name, s8name as S8Name, s9name as S9Name, s10name as S10Name,
          s1value as S1Value, s2value as S2Value, s3value as S3Value, s4value as S4Value, s5value as S5Value, s6value as S6Value, s7value as S7Value, s8value as S8Value, s9value as S9Value, s10value as S10Value );

  query GetLapChart
    sql 'SELECT '''' AS lapKey, 0 AS year, 0 AS round, 0 AS lap,
                '''' AS s1name,
                '''' AS s2name,
                '''' AS s3name,
                '''' AS s4name,
                '''' AS s5name,
                '''' AS s6name,
                '''' AS s7name,
                '''' AS s8name,
                '''' AS s9name,
                '''' AS s10name,
                0 AS s1value,
                0 AS s2value,
                0 AS s3value,
                0 AS s4value,
                0 AS s5value,
                0 AS s6value,
                0 AS s7value,
                0 AS s8value,
                0 AS s9value,
                0 AS s10value
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_LapChart
    map ( lapKey as LapKey, year as Year, round as Round, lap as Lap,
          s1name as S1Name, s2name as S2Name, s3name as S3Name, s4name as S4Name, s5name as S5Name, s6name as S6Name, s7name as S7Name, s8name as S8Name, s9name as S9Name, s10name as S10Name,
          s1value as S1Value, s2value as S2Value, s3value as S3Value, s4value as S4Value, s5value as S5Value, s6value as S6Value, s7value as S7Value, s8value as S8Value, s9value as S9Value, s10value as S10Value );


  /* -------------------------------------------------------------------------
   * The live snapshot. Columns are declared rather than sniffed: these files
   * are legitimately header-only before the first fetch, and read_csv infers
   * nothing from an empty file.
   * ---------------------------------------------------------------------- */

  query GetLiveOrder
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || driverNumber AS entryKey, sessionKey, driverNumber,
                  code, driverName, team, teamColour, position, gapToLeader, interval,
                  lapNumber, lastLapSeconds, sector1, sector2, sector3, speedTrap,
                  compound, tyreAge, pitStops
           FROM read_csv({dataDir} || ''/../live/live-order.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''driverNumber'': ''BIGINT'',
                                    ''code'': ''VARCHAR'', ''driverName'': ''VARCHAR'',
                                    ''team'': ''VARCHAR'', ''teamColour'': ''VARCHAR'',
                                    ''position'': ''BIGINT'', ''gapToLeader'': ''VARCHAR'',
                                    ''interval'': ''VARCHAR'', ''lapNumber'': ''BIGINT'',
                                    ''lastLapSeconds'': ''DOUBLE'', ''sector1'': ''DOUBLE'',
                                    ''sector2'': ''DOUBLE'', ''sector3'': ''DOUBLE'',
                                    ''speedTrap'': ''BIGINT'', ''compound'': ''VARCHAR'',
                                    ''tyreAge'': ''BIGINT'', ''pitStops'': ''BIGINT''})
           ORDER BY position
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.entryKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.entryKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY t.position'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_LiveEntry
    map ( entryKey as EntryKey, sessionKey as SessionKey, driverNumber as DriverNumber,
          code as Code, driverName as DriverName, team as Team, teamColour as TeamColour,
          position as Position, gapToLeader as GapToLeader, interval as Interval,
          lapNumber as LapNumber, lastLapSeconds as LastLapSeconds, sector1 as Sector1,
          sector2 as Sector2, sector3 as Sector3, speedTrap as SpeedTrap,
          compound as Compound, tyreAge as TyreAge, pitStops as PitStops );

  /*
   * `at` is a reserved word in DuckDB (it introduces time travel: FROM t AT
   * (VERSION => ...)), so an unquoted `at` in the select list is a parse error
   * — and the map clause cannot reference a quoted identifier either. Quote it
   * once and alias it to a name that is only a name.
   *
   * The key is row_number() rather than rowid, which read_csv does not expose:
   * a race control message has no natural id, and two identical yellow flags in
   * one session are a real possibility.
   */
  query GetLiveMessages
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || row_number() OVER () AS messageKey,
                  sessionKey, "at" AS atTime, category, flag, scope, lap, message
           FROM read_csv({dataDir} || ''/../live/live-messages.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''at'': ''VARCHAR'',
                                    ''category'': ''VARCHAR'', ''flag'': ''VARCHAR'',
                                    ''scope'': ''VARCHAR'', ''lap'': ''BIGINT'',
                                    ''message'': ''VARCHAR''})
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.messageKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.messageKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_LiveMessage
    map ( messageKey as MessageKey, sessionKey as SessionKey, atTime as At,
          category as Category, flag as Flag, scope as Scope, lap as Lap,
          message as Message );

  query GetLiveSession
    sql 'SELECT * FROM (
         SELECT s.sessionKey, s.sessionName, s.sessionType, s.location, s.countryName,
                  s.circuitName, s.dateStart, s.year, s.driverCount, s.leadLap, s.fetchedAt,
                  w.airTemperature, w.trackTemperature, w.humidity, w.rainfall, w.windSpeed
           FROM read_csv({dataDir} || ''/../live/live-session.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''sessionName'': ''VARCHAR'',
                                    ''sessionType'': ''VARCHAR'', ''location'': ''VARCHAR'',
                                    ''countryName'': ''VARCHAR'', ''circuitName'': ''VARCHAR'',
                                    ''dateStart'': ''VARCHAR'', ''year'': ''BIGINT'',
                                    ''driverCount'': ''BIGINT'', ''leadLap'': ''BIGINT'',
                                    ''fetchedAt'': ''VARCHAR''}) s
           LEFT JOIN read_csv({dataDir} || ''/../live/live-weather.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''at'': ''VARCHAR'',
                                    ''airTemperature'': ''DOUBLE'', ''trackTemperature'': ''DOUBLE'',
                                    ''humidity'': ''DOUBLE'', ''rainfall'': ''DOUBLE'',
                                    ''windSpeed'': ''DOUBLE''}) w
                  ON w.sessionKey = s.sessionKey
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.sessionKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.sessionKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
'
    parameter dataDir: string
    parameter keyFilter: string
    returns Formula1Backend.Stg_LiveSession
    map ( sessionKey as SessionKey, sessionName as SessionName, sessionType as SessionType,
          location as Location, countryName as CountryName, circuitName as CircuitName,
          dateStart as DateStart, year as Year, driverCount as DriverCount,
          leadLap as LeadLap, fetchedAt as FetchedAt, airTemperature as AirTemperature,
          trackTemperature as TrackTemperature, humidity as Humidity,
          rainfall as Rainfall, windSpeed as WindSpeed );

end;
