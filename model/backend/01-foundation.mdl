/*
 * Formula1Backend — the DuckDB read layer.
 *
 * Everything both OData services stand on: the connection to the CSV folder,
 * the non-persistable row shapes the connector maps results into, and one
 * query per resource.
 *
 * The CSVs are read in place. `read_csv({dataDir} || '/f1db-x.csv')` binds the
 * folder as a query parameter, so nothing absolute is baked into the model and
 * DataDir can be overridden per environment with MX_Formula1Backend_DataDir.
 */

create or modify constant Formula1Backend.DataDir type string
  default '/home/user/mxcli-formula1/data/f1db'
  comment 'Folder holding the f1db CSVs. Override per environment.';

create or modify constant Formula1Backend.DuckDbUrl type string
  default 'jdbc:duckdb:'
  comment 'In-memory DuckDB — no database file; read_csv() reads the CSVs per query.';

create or modify constant Formula1Backend.DuckDbUser type string default '';
create or modify constant Formula1Backend.DuckDbPassword type string default '' PRIVATE;

/* ---------------------------------------------------------------------------
 * Row shapes. Non-persistable, because that is what the External Database
 * Connector maps query results into. Flat: every join happens in DuckDB, so
 * there are no associations to resolve on the Mendix side.
 *
 * Whole numbers are `long`, not `integer`, on purpose. Mendix publishes a
 * Mendix `Integer` as Edm.Int64, but mxcli writes Edm.Int32 for it, and the
 * build then fails with "has type Integer, but is published as Edm.Int32" on
 * every such attribute. `long` maps to Edm.Int64 on both sides. See
 * FINDINGS.md §16.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_Season (
  Year: long,
  ChampionDriverName: string(120),
  ChampionConstructorName: string(120),
  RaceCount: long
);

create or modify non-persistent entity Formula1Backend.Stg_Circuit (
  CircuitId: string(60),
  Name: string(120),
  FullName: string(200),
  PlaceName: string(120),
  Country: string(60),
  Latitude: decimal,
  Longitude: decimal,
  Length: decimal,
  Turns: long,
  RacesHeld: long
);

create or modify non-persistent entity Formula1Backend.Stg_Constructor (
  ConstructorId: string(60),
  Name: string(120),
  FullName: string(200),
  Country: string(60),
  ChampionshipWins: long,
  RaceStarts: long,
  RaceWins: long,
  Podiums: long,
  Points: decimal,
  PolePositions: long
);

create or modify non-persistent entity Formula1Backend.Stg_Driver (
  DriverId: string(60),
  Name: string(120),
  FullName: string(200),
  Abbreviation: string(10),
  PermanentNumber: string(10),
  DateOfBirth: datetime,
  PlaceOfBirth: string(120),
  Nationality: string(60),
  ChampionshipWins: long,
  RaceStarts: long,
  RaceWins: long,
  Podiums: long,
  Points: decimal,
  PolePositions: long
);

create or modify non-persistent entity Formula1Backend.Stg_Race (
  RaceId: long,
  Year: long,
  Round: long,
  RaceDate: datetime,
  OfficialName: string(200),
  GrandPrixId: string(60),
  CircuitId: string(60),
  CircuitName: string(120),
  Laps: long,
  Distance: decimal
);

create or modify non-persistent entity Formula1Backend.Stg_RaceResult (
  RaceId: long,
  Year: long,
  Round: long,
  PositionOrder: long,
  PositionNumber: long,
  PositionText: string(20),
  DriverId: string(60),
  DriverName: string(120),
  ConstructorId: string(60),
  ConstructorName: string(120),
  DriverNumber: string(10),
  Laps: long,
  TimeText: string(60),
  Gap: string(60),
  ReasonRetired: string(120),
  Points: decimal,
  GridPosition: long,
  PositionsGained: long,
  FastestLap: boolean,
  PolePosition: boolean
);

/*
 * The standings carry a synthetic key because the natural one is not unique:
 * a driver appears once per season, so `driverId` alone identifies up to 77
 * rows. A published entity must have a key, and a key that matches many rows is
 * worse than none — the client re-reads a row it holds, gets the newest match,
 * and silently swaps one season for another. `<year>-<driverId>` is the pair
 * that actually identifies a standing. FINDINGS §37, §42.
 */
create or modify non-persistent entity Formula1Backend.Stg_DriverStanding (
  StandingKey: string(80),
  Year: long,
  PositionOrder: long,
  PositionNumber: long,
  PositionText: string(20),
  DriverId: string(60),
  DriverName: string(120),
  Points: decimal,
  ChampionshipWon: boolean
);

create or modify non-persistent entity Formula1Backend.Stg_ConstructorStanding (
  StandingKey: string(80),
  Year: long,
  PositionOrder: long,
  EngineManufacturer: string(60),
  PositionNumber: long,
  PositionText: string(20),
  ConstructorId: string(60),
  ConstructorName: string(120),
  Points: decimal,
  ChampionshipWon: boolean
);

/*
 * A row shape for count queries. The connector maps every result into an
 * entity, so "SELECT count(*)" needs one too. Used by the pushdown read
 * microflows to answer $count over the filtered set rather than the page.
 */
create or modify non-persistent entity Formula1Backend.Stg_Count (
  Total: long
);

/* ---------------------------------------------------------------------------
 * The fan-facing shapes. Everything above is a table; these five are questions.
 *
 * They exist because a browsing UI does not want rows, it wants an answer:
 * what did this driver's career look like, how did a season unfold, where does
 * this team keep breaking. Each one is a query DuckDB can answer in a single
 * pass over the CSVs, so none of it is materialised either.
 *
 * Each carries a synthesised key, because a grouped result has no natural id
 * and OData needs one per row.
 * ------------------------------------------------------------------------- */

/* One row per season a driver started, which is the spine of a career page. */
create or modify non-persistent entity Formula1Backend.Stg_DriverSeason (
  SeasonKey: string(80),
  DriverId: string(60),
  Year: long,
  Constructors: string(300),
  StandingPosition: string(20),
  StandingOrder: long,
  Points: decimal,
  Starts: long,
  Wins: long,
  Podiums: long,
  Poles: long,
  BestFinish: long,
  AvgQualifying: decimal,
  AvgFinish: decimal,
  Retirements: long,
  /*
   * The winning driver's points in the same season, carried on every row.
   *
   * A career page draws each season's points as a bar against the season's
   * best, and a bar needs its maximum next to its value — the row cannot see
   * its siblings, and 2024's 437 means nothing beside 1958's 42 without it.
   * Computing it here rather than in the client is also the only place it is
   * cheap: one grouped scan of the standings, joined by year.
   */
  SeasonBestPoints: decimal,
  /*
   * The same comparison as a percentage, 0–100, so a client can draw the bar
   * without doing arithmetic on two columns. Scoring systems changed six times;
   * the share is the only number that means the same thing in 1958 and 2024.
   */
  PointsShare: long
);

/*
 * One row per race a driver entered, carrying every session: three practices,
 * qualifying, the grid slot and the finish. Practice results only exist from
 * the era each session was timed, so the early columns are empty for most of
 * the sport's history — which is itself the answer to "how did they practise".
 */
create or modify non-persistent entity Formula1Backend.Stg_DriverRace (
  RaceKey: string(80),
  DriverId: string(60),
  Year: long,
  Round: long,
  RaceName: string(200),
  ConstructorName: string(120),
  Fp1Position: long,
  Fp2Position: long,
  Fp3Position: long,
  QualifyingPosition: long,
  GridPosition: long,
  FinishPosition: long,
  PositionText: string(20),
  PositionsGained: long,
  Points: decimal,
  ReasonRetired: string(120)
);

/*
 * A season's title fight as a chart: one row per round, carrying the running
 * points total of the five drivers who finished the championship on top.
 *
 * Wide rather than long — five name columns and five points columns — because
 * a Mendix chart series binds one Y attribute at author time. Long data would
 * need a series per driver created per season, which a static page cannot do.
 */
create or modify non-persistent entity Formula1Backend.Stg_SeasonProgress (
  ProgressKey: string(40),
  Year: long,
  Round: long,
  RaceName: string(200),
  D1Name: string(120),
  D2Name: string(120),
  D3Name: string(120),
  D4Name: string(120),
  D5Name: string(120),
  D1Points: decimal,
  D2Points: decimal,
  D3Points: decimal,
  D4Points: decimal,
  D5Points: decimal
);

/* Why a team's cars stopped, and how often. One row per constructor-reason. */
create or modify non-persistent entity Formula1Backend.Stg_Retirement (
  RetirementKey: string(200),
  ConstructorId: string(60),
  ConstructorName: string(120),
  ReasonRetired: string(120),
  Retirements: long,
  Entries: long,
  SharePercent: decimal,
  FirstYear: long,
  LastYear: long
);

/*
 * A constructor's season, round by round: what each of the two cars scored,
 * what the team scored, and where that left it in the championship.
 *
 * The two drivers are seats, not names — seat 1 is whoever scored more over the
 * season. A chart series binds its Y attribute when the page is authored, so a
 * column called "Norris" would only work for one team in one year; the names
 * travel as data and the panel says who they were.
 */
create or modify non-persistent entity Formula1Backend.Stg_TeamSeason (
  TeamSeasonKey: string(100),
  ConstructorId: string(60),
  ConstructorName: string(120),
  Year: long,
  Round: long,
  Code: string(10),
  RaceName: string(200),
  Driver1Name: string(120),
  Driver1Points: decimal,
  Driver2Name: string(120),
  Driver2Points: decimal,
  TeamPoints: decimal,
  StandingPosition: long
);

/*
 * The same two seats, over a whole season, as four comparisons: who
 * out-qualified whom, who finished ahead, who scored, who retired.
 *
 * One row, not four. The four labels are fixed — a page that draws them can
 * name them itself — and one row means one scan and no ordering to preserve.
 *
 * Every pair carries both values *and* both as a percentage of the pair,
 * because the page draws two bars growing away from a centre line and a bar
 * needs its share, not its value. Nineteen against five is a rout; 19px
 * against 5px is nothing.
 */
create or modify non-persistent entity Formula1Backend.Stg_TeamH2H (
  H2HKey: string(100),
  ConstructorId: string(60),
  Year: long,
  LeftName: string(120),
  RightName: string(120),
  QualLeft: long,
  QualRight: long,
  QualLeftShare: long,
  QualRightShare: long,
  RaceLeft: long,
  RaceRight: long,
  RaceLeftShare: long,
  RaceRightShare: long,
  PointsLeft: decimal,
  PointsRight: decimal,
  PointsLeftShare: long,
  PointsRightShare: long,
  DnfLeft: long,
  DnfRight: long,
  DnfLeftShare: long,
  DnfRightShare: long
);

/*
 * Prose, which no CSV in f1db has. Fetched from Wikipedia by
 * scripts/fetch-f1-facts.sh into data/facts/f1db-facts.csv and read the same
 * way as everything else. The licence and source URL travel with every row
 * because CC BY-SA requires attribution wherever the text is shown.
 */
create or modify non-persistent entity Formula1Backend.Stg_Fact (
  FactKey: string(80),
  Scope: string(20),
  EntityId: string(60),
  Title: string(200),
  Extract: string(4000),
  SourceUrl: string(300),
  License: string(60)
);

/* ---------------------------------------------------------------------------
 * The race weekend, and the lap traces behind it.
 *
 * f1db carries every session's result — three practices, qualifying, the race,
 * the fastest lap, every pit stop — with times and gaps. What it does not carry
 * is a row per driver per lap; that is fetched from Jolpica (the Ergast
 * successor) into data/laps/ and read the same way.
 *
 * The two chart shapes are wide on purpose, for the reason the season
 * progression is: a Mendix chart series binds its Y attribute when the page is
 * authored, so ten drivers means ten columns, not ten rows.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_RaceWeekend (
  WeekendKey: string(40),
  RaceId: long,
  Year: long,
  Round: long,
  RoundLabel: string(40),
  Name: string(200),
  CircuitName: string(120),
  CircuitId: string(60),
  RaceDate: datetime,
  Laps: long,
  Distance: decimal,
  WinnerName: string(120),
  WinnerTeam: string(120),
  PoleName: string(120),
  PoleTime: string(30),
  FastestLapName: string(120),
  FastestLapTime: string(30),
  Fp1LeaderName: string(120),
  Fp1LeaderTime: string(30),
  Fp2LeaderName: string(120),
  Fp2LeaderTime: string(30),
  Fp3LeaderName: string(120),
  Fp3LeaderTime: string(30)
);

/*
 * One row per driver per weekend, every session side by side, with each gap
 * expressed in seconds off that session's best — which is what makes the pace
 * chart comparable across sessions run in different conditions.
 */
create or modify non-persistent entity Formula1Backend.Stg_RaceSession (
  SessionKey: string(80),
  RaceId: long,
  Year: long,
  Round: long,
  DriverId: string(60),
  DriverName: string(120),
  Abbreviation: string(10),
  ConstructorName: string(120),
  Fp1Position: long,
  Fp1Time: string(30),
  Fp1Gap: decimal,
  Fp2Position: long,
  Fp2Time: string(30),
  Fp2Gap: decimal,
  Fp3Position: long,
  Fp3Time: string(30),
  Fp3Gap: decimal,
  QualPosition: long,
  QualTime: string(30),
  QualGap: decimal,
  Q1: string(30),
  Q2: string(30),
  Q3: string(30),
  GridPosition: long,
  FinishPosition: long,
  PositionText: string(20),
  PositionsGained: long,
  Points: decimal,
  ReasonRetired: string(120),
  BestLapTime: string(30),
  BestLapGap: decimal,
  BestLapRank: long,
  PitStops: long
);

/* The championship calendar: one row per round, with who won it. */
create or modify non-persistent entity Formula1Backend.Stg_Calendar (
  CalendarKey: string(40),
  RaceId: long,
  Year: long,
  Round: long,
  Code: string(10),
  Name: string(200),
  CircuitName: string(120),
  RaceDate: datetime,
  WinnerName: string(120),
  WinnerTeam: string(120)
);

/* Position across the weekend: five rows (FP1, FP2, FP3, Quali, Race), ten
 * drivers wide. */
create or modify non-persistent entity Formula1Backend.Stg_WeekendShape (
  ShapeKey: string(40),
  RaceId: long,
  SessionIndex: long,
  SessionLabel: string(20),
  S1Name: string(120),
  S2Name: string(120),
  S3Name: string(120),
  S4Name: string(120),
  S5Name: string(120),
  S6Name: string(120),
  S7Name: string(120),
  S8Name: string(120),
  S9Name: string(120),
  S10Name: string(120),
  S1Value: long,
  S2Value: long,
  S3Value: long,
  S4Value: long,
  S5Value: long,
  S6Value: long,
  S7Value: long,
  S8Value: long,
  S9Value: long,
  S10Value: long
);

/* Race position by lap, from the Jolpica traces: one row per lap, ten wide. */
create or modify non-persistent entity Formula1Backend.Stg_LapChart (
  LapKey: string(40),
  Year: long,
  Round: long,
  Lap: long,
  S1Name: string(120),
  S2Name: string(120),
  S3Name: string(120),
  S4Name: string(120),
  S5Name: string(120),
  S6Name: string(120),
  S7Name: string(120),
  S8Name: string(120),
  S9Name: string(120),
  S10Name: string(120),
  S1Value: long,
  S2Value: long,
  S3Value: long,
  S4Value: long,
  S5Value: long,
  S6Value: long,
  S7Value: long,
  S8Value: long,
  S9Value: long,
  S10Value: long
);

/* ---------------------------------------------------------------------------
 * Near-live timing, from OpenF1.
 *
 * A different source with a different contract: f1db is a file that changes
 * when someone publishes a release, OpenF1 is a service that changes during a
 * race. scripts/fetch-f1-live.sh snapshots one session into data/live/ and the
 * page reads whatever the last snapshot holds — so "live" here means "as fresh
 * as the last fetch", which on a race Sunday means running it on a timer.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_LiveEntry (
  EntryKey: string(40),
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  DriverName: string(120),
  Team: string(120),
  TeamColour: string(10),
  Position: long,
  GapToLeader: string(20),
  Interval: string(20),
  LapNumber: long,
  LastLapSeconds: decimal,
  Sector1: decimal,
  Sector2: decimal,
  Sector3: decimal,
  SpeedTrap: long,
  Compound: string(20),
  TyreAge: long,
  PitStops: long,
  Drs: string(10),
  Sector1Mark: string(1),
  Sector2Mark: string(1),
  Sector3Mark: string(1)
);

/*
 * The history behind the snapshot: one row per driver per lap.
 *
 * Stg_LiveEntry is where everyone stands now; this is how they got there, and
 * it is what the gap chart and the tower's position sparklines are drawn from.
 * OpenF1 hands out every endpoint as a time series, so keeping the series costs
 * nothing extra at the source — the fetch script resamples it onto laps, which
 * is the only x-axis a race page ever wants.
 *
 * GapToLeader is text, not a number, for the same reason it is on Stg_LiveEntry:
 * once a car is lapped OpenF1 stops reporting seconds and starts reporting
 * "+1 LAP".
 */
create or modify non-persistent entity Formula1Backend.Stg_LiveTrace (
  TraceKey: string(50),
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  LapNumber: long,
  Position: long,
  GapToLeader: string(20),
  GapSeconds: decimal,
  LapSeconds: decimal
);

/*
 * Every stint of every car, not only the one running.
 *
 * Stg_LiveEntry carries the current compound because that is what a standings
 * row shows. A strategy panel wants the whole set — which tyre, from which lap
 * to which — and OpenF1 hands all of them over in the same response the
 * snapshot was taken from, so keeping them costs nothing.
 *
 * LapEnd is empty for the stint a car is still on.
 */
create or modify non-persistent entity Formula1Backend.Stg_LiveStint (
  StintKey: string(50),
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  StintNumber: long,
  Compound: string(20),
  LapStart: long,
  LapEnd: long,
  TyreAgeAtStart: long
);

create or modify non-persistent entity Formula1Backend.Stg_LiveMessage (
  MessageKey: string(60),
  SessionKey: string(20),
  At: string(20),
  Category: string(40),
  Flag: string(30),
  Scope: string(30),
  Lap: long,
  Message: string(500)
);

create or modify non-persistent entity Formula1Backend.Stg_LiveSession (
  SessionKey: string(20),
  SessionName: string(60),
  SessionType: string(40),
  Location: string(120),
  CountryName: string(120),
  CircuitName: string(120),
  DateStart: string(40),
  Year: long,
  DriverCount: long,
  LeadLap: long,
  FetchedAt: string(40),
  AirTemperature: decimal,
  TrackTemperature: decimal,
  Humidity: decimal,
  Rainfall: decimal,
  WindSpeed: decimal
);

/* ---------------------------------------------------------------------------
 * The connection. Type 'BYOD' is Studio Pro's "Other" — bring your own driver.
 * It skips the driver-presence check, which is the only reason a JDBC driver
 * Mendix has no picker entry for can be used at all.
 *
 * Every query takes dataDir so the CSV folder stays a constant, not a literal.
 * ------------------------------------------------------------------------- */

/* ---------------------------------------------------------------------------
 * Circuit outlines.
 *
 * The shape of a track, as an SVG path, traced from OpenStreetMap way geometry
 * by scripts/fetch-circuit-outlines.py rather than copied from a diagram.
 *
 * The point of tracing geometry rather than an image is that the result can be
 * checked: every outline is measured against the length f1db records for that
 * circuit, and one that disagrees by more than a few per cent is left out
 * rather than shown. TracedKm and OfficialKm travel with the row so a page can
 * say how closely it matched, and so a bad outline is a visible number rather
 * than a picture nobody questions.
 *
 * OpenStreetMap is ODbL, which requires attribution. It rides along in the row
 * for the same reason the Wikipedia licence rides along on Stg_Fact: a licence
 * that lives in a comment is a licence the page cannot honour.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_CircuitOutline (
  CircuitId: string(60),
  Name: string(120),
  FullName: string(200),
  ViewBox: string(40),
  PathD: string(20000),
  Points: long,
  TracedKm: decimal,
  OfficialKm: decimal,
  DeltaPercent: decimal,
  Source: string(60),
  License: string(60),
  Attribution: string(120)
);

/*
 * The same outline again, one row per vertex.
 *
 * PathD above is what makes a circuit row self-contained and what the SVG files
 * are drawn from. This is the same measurement in the shape a chart can take:
 * this app draws through Vega, and a Vega mark consumes rows, not a path
 * string. Two representations of one thing, written by one pass of the fetcher,
 * rather than a page taught to parse SVG.
 *
 * X and Y are already projected into the 1000x1000 viewBox — the cos(latitude)
 * correction is applied at fetch time, so nothing downstream has to know where
 * on Earth the circuit is to draw it with the right proportions.
 */
create or modify non-persistent entity Formula1Backend.Stg_CircuitPoint (
  PointKey: string(70),
  CircuitId: string(60),
  Seq: long,
  X: decimal,
  Y: decimal
);

/* ---------------------------------------------------------------------------
 * Row shapes for the in-app live sync.
 *
 * Non-persistable, like every other Stg_ here: they are what the External
 * Database Connector hands back from a query, on their way into the persistent
 * tables in 19. Stg_SyncLap is the wide one -- a driver's lap with its
 * position, gap, sectors, tyre and stop count all on the same row, because that
 * is the grain the replay table stores and the grain OpenF1's endpoints join
 * to.
 * ------------------------------------------------------------------------- */

create or modify non-persistent entity Formula1Backend.Stg_SyncLap (
  SessionKey: string(20),
  DriverNumber: long,
  LapNumber: long,
  Position: long,
  GapToLeader: string(20),
  GapSeconds: decimal,
  LapSeconds: decimal,
  Sector1: decimal,
  Sector2: decimal,
  Sector3: decimal,
  SpeedTrap: long,
  Compound: string(20),
  TyreAge: long,
  PitStops: long
);

create or modify non-persistent entity Formula1Backend.Stg_SyncDriver (
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  DriverName: string(120),
  Team: string(120),
  TeamColour: string(10)
);

create or modify non-persistent entity Formula1Backend.Stg_SyncWeather (
  SessionKey: string(20),
  At: string(20),
  AirTemperature: decimal,
  TrackTemperature: decimal,
  Humidity: decimal,
  Rainfall: decimal,
  WindSpeed: decimal
);

create or modify non-persistent entity Formula1Backend.Stg_SyncSession (
  SessionKey: string(20),
  SessionName: string(60),
  SessionType: string(40),
  Location: string(120),
  CountryName: string(60),
  CircuitName: string(120),
  DateStart: string(40),
  Year: long,
  DriverCount: long,
  LeadLap: long
);

create or modify non-persistent entity Formula1Backend.Stg_SyncTelemetry (
  SessionKey: string(20), DriverNumber: long, LapNumber: long, TopSpeed: long,
  AvgThrottle: decimal, MaxGear: long, DrsOpenShare: decimal,
  BrakeShare: decimal, MaxRpm: long, Samples: long
);

create or modify non-persistent entity Formula1Backend.Stg_TokenParsed (
  AccessToken: string(4000), ExpiresIn: long
);

create or modify non-persistent entity Formula1Backend.Stg_SyncCarNow (
  SessionKey: string(20), DriverNumber: long, At: string(40), Speed: long,
  Throttle: long, Brake: long, Gear: long, Rpm: long, Drs: long
);

create or modify non-persistent entity Formula1Backend.Stg_SyncLocationNow (
  SessionKey: string(20), DriverNumber: long, At: string(40),
  X: decimal, Y: decimal, Z: decimal
);

create or modify non-persistent entity Formula1Backend.Stg_SyncOvertake (
  SessionKey: string(20), At: string(40), LapNumber: long,
  OvertakingDriver: long, OvertakenDriver: long, Position: long
);

create or modify non-persistent entity Formula1Backend.Stg_SyncRadio (
  SessionKey: string(20), At: string(40), DriverNumber: long,
  RecordingUrl: string(500)
);

create or modify non-persistent entity Formula1Backend.Stg_SyncLapWindow (
  DriverNumber: long, FromTs: string(40), ToTs: string(40)
);

create or modify non-persistent entity Formula1Backend.Stg_SyncTrackPoint (
  SessionKey: string(20), Seq: long, X: decimal, Y: decimal
);

create or modify database connection Formula1Backend.F1Warehouse
type 'BYOD'
connection string @Formula1Backend.DuckDbUrl
username @Formula1Backend.DuckDbUser
password @Formula1Backend.DuckDbPassword
begin
  /*
   * `keyFilter` is how this resource answers a lookup by its own key.
   *
   * A client holding one of these rows re-reads it by key on its own, and a
   * read that ignores the request answers with the whole collection instead —
   * whereupon the client adopts the first row as that object's identity and
   * keeps it. The guard is written as an OR so one query serves both callers:
   * empty means "the collection", anything else means "that row". Bound, not
   * interpolated, so it cannot carry SQL. FINDINGS §37, §42.
   */
  query GetSeasons
    sql 'SELECT * FROM (
           SELECT s.year AS year,
                  COALESCE(d.name, ''—'') AS championDriverName,
                  COALESCE(c.name, ''—'') AS championConstructorName,
                  (SELECT count(*) FROM read_csv({dataDir} || ''/f1db-races.csv'') r
                     WHERE r.year = s.year) AS raceCount
           FROM read_csv({dataDir} || ''/f1db-seasons.csv'') s
           LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
                  ON ds.year = s.year AND ds.championshipWon = true
           LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = ds.driverId
           LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-constructor-standings.csv'') cs
                  ON cs.year = s.year AND cs.championshipWon = true
           LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = cs.constructorId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.year AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.year AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''championDriver'' THEN t.championDriverName WHEN ''championConstructor'' THEN t.championConstructorName END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''championDriver'' THEN t.championDriverName WHEN ''championConstructor'' THEN t.championConstructorName END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''raceCount'' THEN CAST(t.raceCount AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''raceCount'' THEN CAST(t.raceCount AS DOUBLE) END) END DESC NULLS LAST,
           t.year DESC
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_Season
    map ( year as Year, championDriverName as ChampionDriverName,
          championConstructorName as ChampionConstructorName, raceCount as RaceCount );

  query GetCircuits
    sql 'SELECT * FROM (
           SELECT id, name, fullName, placeName, countryId, latitude, longitude,
                  length, turns, totalRacesHeld
           FROM read_csv({dataDir} || ''/f1db-circuits.csv'')
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''circuitId'' THEN t.id WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName WHEN ''placeName'' THEN t.placeName WHEN ''country'' THEN t.countryId END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''circuitId'' THEN t.id WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName WHEN ''placeName'' THEN t.placeName WHEN ''country'' THEN t.countryId END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''latitude'' THEN CAST(t.latitude AS DOUBLE) WHEN ''longitude'' THEN CAST(t.longitude AS DOUBLE) WHEN ''length'' THEN CAST(t.length AS DOUBLE) WHEN ''turns'' THEN CAST(t.turns AS DOUBLE) WHEN ''racesHeld'' THEN CAST(t.totalRacesHeld AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''latitude'' THEN CAST(t.latitude AS DOUBLE) WHEN ''longitude'' THEN CAST(t.longitude AS DOUBLE) WHEN ''length'' THEN CAST(t.length AS DOUBLE) WHEN ''turns'' THEN CAST(t.turns AS DOUBLE) WHEN ''racesHeld'' THEN CAST(t.totalRacesHeld AS DOUBLE) END) END DESC NULLS LAST,
           t.name
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_Circuit
    map ( id as CircuitId, name as Name, fullName as FullName, placeName as PlaceName,
          countryId as Country, latitude as Latitude, longitude as Longitude,
          length as Length, turns as Turns, totalRacesHeld as RacesHeld );

  query GetConstructors
    sql 'SELECT * FROM (
           SELECT id, name, fullName, countryId, totalChampionshipWins, totalRaceStarts,
                  totalRaceWins, totalPodiums, totalPoints, totalPolePositions
           FROM read_csv({dataDir} || ''/f1db-constructors.csv'')
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''constructorId'' THEN t.id WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName WHEN ''country'' THEN t.countryId END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''constructorId'' THEN t.id WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName WHEN ''country'' THEN t.countryId END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''championshipWins'' THEN CAST(t.totalChampionshipWins AS DOUBLE) WHEN ''raceStarts'' THEN CAST(t.totalRaceStarts AS DOUBLE) WHEN ''raceWins'' THEN CAST(t.totalRaceWins AS DOUBLE) WHEN ''podiums'' THEN CAST(t.totalPodiums AS DOUBLE) WHEN ''points'' THEN CAST(t.totalPoints AS DOUBLE) WHEN ''polePositions'' THEN CAST(t.totalPolePositions AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''championshipWins'' THEN CAST(t.totalChampionshipWins AS DOUBLE) WHEN ''raceStarts'' THEN CAST(t.totalRaceStarts AS DOUBLE) WHEN ''raceWins'' THEN CAST(t.totalRaceWins AS DOUBLE) WHEN ''podiums'' THEN CAST(t.totalPodiums AS DOUBLE) WHEN ''points'' THEN CAST(t.totalPoints AS DOUBLE) WHEN ''polePositions'' THEN CAST(t.totalPolePositions AS DOUBLE) END) END DESC NULLS LAST,
           t.name
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_Constructor
    map ( id as ConstructorId, name as Name, fullName as FullName, countryId as Country,
          totalChampionshipWins as ChampionshipWins, totalRaceStarts as RaceStarts,
          totalRaceWins as RaceWins, totalPodiums as Podiums, totalPoints as Points,
          totalPolePositions as PolePositions );

  query GetDrivers
    sql 'SELECT id, name, fullName, abbreviation, permanentNumber, dateOfBirth,
                placeOfBirth, nationalityCountryId, totalChampionshipWins,
                totalRaceStarts, totalRaceWins, totalPodiums, totalPoints,
                totalPolePositions
         FROM read_csv({dataDir} || ''/f1db-drivers.csv'') ORDER BY name'
    parameter dataDir: string
    returns Formula1Backend.Stg_Driver
    map ( id as DriverId, name as Name, fullName as FullName, abbreviation as Abbreviation,
          permanentNumber as PermanentNumber, dateOfBirth as DateOfBirth,
          placeOfBirth as PlaceOfBirth, nationalityCountryId as Nationality,
          totalChampionshipWins as ChampionshipWins, totalRaceStarts as RaceStarts,
          totalRaceWins as RaceWins, totalPodiums as Podiums, totalPoints as Points,
          totalPolePositions as PolePositions );

  query GetRaces
    sql 'SELECT * FROM (
           SELECT r.id, r.year, r.round, r.date, r.officialName, r.grandPrixId,
                  r.circuitId, c.name AS circuitName, r.laps, r.distance
           FROM read_csv({dataDir} || ''/f1db-races.csv'') r
           LEFT JOIN read_csv({dataDir} || ''/f1db-circuits.csv'') c ON c.id = r.circuitId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.id AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.id AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''raceDate'' THEN CAST(t.date AS VARCHAR) WHEN ''officialName'' THEN t.officialName WHEN ''grandPrixId'' THEN t.grandPrixId WHEN ''circuitId'' THEN t.circuitId WHEN ''circuitName'' THEN t.circuitName END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''raceDate'' THEN CAST(t.date AS VARCHAR) WHEN ''officialName'' THEN t.officialName WHEN ''grandPrixId'' THEN t.grandPrixId WHEN ''circuitId'' THEN t.circuitId WHEN ''circuitName'' THEN t.circuitName END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''raceId'' THEN CAST(t.id AS DOUBLE) WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''round'' THEN CAST(t.round AS DOUBLE) WHEN ''laps'' THEN CAST(t.laps AS DOUBLE) WHEN ''distance'' THEN CAST(t.distance AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''raceId'' THEN CAST(t.id AS DOUBLE) WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''round'' THEN CAST(t.round AS DOUBLE) WHEN ''laps'' THEN CAST(t.laps AS DOUBLE) WHEN ''distance'' THEN CAST(t.distance AS DOUBLE) END) END DESC NULLS LAST,
           t.year DESC, t.round
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_Race
    map ( id as RaceId, year as Year, round as Round, date as RaceDate,
          officialName as OfficialName, grandPrixId as GrandPrixId,
          circuitId as CircuitId, circuitName as CircuitName, laps as Laps,
          distance as Distance );

  -- Every race result, 27533 rows. The cached service materialises all of it;
  -- the live service overrides this SQL per season so a request stays bounded.
  query GetRaceResults
    sql 'SELECT rr.raceId, rr.year, rr.round, rr.positionDisplayOrder, rr.positionNumber,
                rr.positionText, rr.driverId, d.name AS driverName,
                rr.constructorId, c.name AS constructorName, rr.driverNumber,
                rr.laps, rr.time, rr.gap, rr.reasonRetired, rr.points,
                rr.gridPositionNumber, rr.positionsGained, rr.fastestLap, rr.polePosition
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         ORDER BY rr.year DESC, rr.round, rr.positionDisplayOrder'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceResult
    map ( raceId as RaceId, year as Year, round as Round,
          positionDisplayOrder as PositionOrder, positionNumber as PositionNumber,
          positionText as PositionText, driverId as DriverId, driverName as DriverName,
          constructorId as ConstructorId, constructorName as ConstructorName,
          driverNumber as DriverNumber, laps as Laps, time as TimeText, gap as Gap,
          reasonRetired as ReasonRetired, points as Points,
          gridPositionNumber as GridPosition, positionsGained as PositionsGained,
          fastestLap as FastestLap, polePosition as PolePosition );

  -- Count queries. The SQL here is a placeholder: callers override it with
  -- `dynamic` so the WHERE clause matches the page query.
  query GetDriverCount
    sql 'SELECT count(*) AS total FROM read_csv({dataDir} || ''/f1db-drivers.csv'')'
    parameter dataDir: string
    returns Formula1Backend.Stg_Count
    map ( total as Total );

  query GetRaceResultCount
    sql 'SELECT count(*) AS total FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'')'
    parameter dataDir: string
    returns Formula1Backend.Stg_Count
    map ( total as Total );

  query GetDriverStandings
    sql 'SELECT * FROM (
           SELECT ds.year || ''-'' || ds.driverId AS standingKey,
                  ds.year, ds.positionDisplayOrder, ds.positionNumber, ds.positionText,
                  ds.driverId, d.name AS driverName, ds.points, ds.championshipWon
           FROM read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
           LEFT JOIN read_csv({dataDir} || ''/f1db-drivers.csv'') d ON d.id = ds.driverId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.standingKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.standingKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''standingKey'' THEN t.standingKey WHEN ''driverId'' THEN t.driverId WHEN ''positionText'' THEN t.positionText WHEN ''driverName'' THEN t.driverName END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''standingKey'' THEN t.standingKey WHEN ''driverId'' THEN t.driverId WHEN ''positionText'' THEN t.positionText WHEN ''driverName'' THEN t.driverName END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''positionOrder'' THEN CAST(t.positionDisplayOrder AS DOUBLE) WHEN ''position'' THEN CAST(t.positionNumber AS DOUBLE) WHEN ''points'' THEN CAST(t.points AS DOUBLE) WHEN ''championshipWon'' THEN CAST(t.championshipWon AS INTEGER) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''positionOrder'' THEN CAST(t.positionDisplayOrder AS DOUBLE) WHEN ''position'' THEN CAST(t.positionNumber AS DOUBLE) WHEN ''points'' THEN CAST(t.points AS DOUBLE) WHEN ''championshipWon'' THEN CAST(t.championshipWon AS INTEGER) END) END DESC NULLS LAST,
           t.year DESC, t.positionDisplayOrder
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_DriverStanding
    map ( standingKey as StandingKey, year as Year,
          positionDisplayOrder as PositionOrder,
          positionNumber as PositionNumber, positionText as PositionText,
          driverId as DriverId, driverName as DriverName, points as Points,
          championshipWon as ChampionshipWon );

  query GetConstructorStandings
    sql 'SELECT * FROM (
           SELECT cs.year || ''-'' || cs.constructorId AS standingKey,
                  cs.year, cs.positionDisplayOrder, cs.positionNumber, cs.positionText,
                  cs.constructorId, c.name AS constructorName, cs.engineManufacturerId,
                  cs.points, cs.championshipWon
           FROM read_csv({dataDir} || ''/f1db-seasons-constructor-standings.csv'') cs
           LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = cs.constructorId
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.standingKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.standingKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''standingKey'' THEN t.standingKey WHEN ''constructorId'' THEN t.constructorId WHEN ''positionText'' THEN t.positionText WHEN ''constructorName'' THEN t.constructorName WHEN ''engineManufacturer'' THEN t.engineManufacturerId END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''standingKey'' THEN t.standingKey WHEN ''constructorId'' THEN t.constructorId WHEN ''positionText'' THEN t.positionText WHEN ''constructorName'' THEN t.constructorName WHEN ''engineManufacturer'' THEN t.engineManufacturerId END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''positionOrder'' THEN CAST(t.positionDisplayOrder AS DOUBLE) WHEN ''position'' THEN CAST(t.positionNumber AS DOUBLE) WHEN ''points'' THEN CAST(t.points AS DOUBLE) WHEN ''championshipWon'' THEN CAST(t.championshipWon AS INTEGER) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''positionOrder'' THEN CAST(t.positionDisplayOrder AS DOUBLE) WHEN ''position'' THEN CAST(t.positionNumber AS DOUBLE) WHEN ''points'' THEN CAST(t.points AS DOUBLE) WHEN ''championshipWon'' THEN CAST(t.championshipWon AS INTEGER) END) END DESC NULLS LAST,
           t.year DESC, t.positionDisplayOrder
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_ConstructorStanding
    map ( standingKey as StandingKey, year as Year,
          positionDisplayOrder as PositionOrder,
          positionNumber as PositionNumber, positionText as PositionText,
          constructorId as ConstructorId, constructorName as ConstructorName,
          engineManufacturerId as EngineManufacturer,
          points as Points, championshipWon as ChampionshipWon );

  /* -------------------------------------------------------------------------
   * The fan-page queries.
   *
   * The SQL below is the shape, not the query that runs: every one of these is
   * answered for a single driver, season or team, and the read microflow builds
   * the real statement with `dynamic`. What is written here fixes the column
   * list the connector maps, so it stays in step with the map clause; `LIMIT 1`
   * keeps the placeholder from scanning 27533 rows at build time.
   * ---------------------------------------------------------------------- */

  query GetDriverSeasons
    sql 'SELECT rr.year || ''-'' || rr.driverId AS seasonKey, rr.driverId AS driverId,
                rr.year AS year,
                COALESCE(string_agg(DISTINCT c.name, '', ''), ''-'') AS constructors,
                COALESCE(max(ds.positionText), ''-'') AS standingPosition,
                COALESCE(max(ds.positionDisplayOrder), 999) AS standingOrder,
                COALESCE(max(ds.points), sum(COALESCE(rr.points, 0))) AS points,
                count(*) AS starts,
                sum(CASE WHEN rr.positionNumber = 1 THEN 1 ELSE 0 END) AS wins,
                sum(CASE WHEN rr.positionNumber <= 3 THEN 1 ELSE 0 END) AS podiums,
                sum(CASE WHEN rr.polePosition THEN 1 ELSE 0 END) AS poles,
                min(rr.positionNumber) AS bestFinish,
                round(avg(rr.qualificationPositionNumber), 1) AS avgQualifying,
                round(avg(rr.positionNumber), 1) AS avgFinish,
                sum(CASE WHEN rr.positionNumber IS NULL THEN 1 ELSE 0 END) AS retirements,
                COALESCE(max(sb.bestPoints), 0) AS seasonBestPoints,
                CAST(round(COALESCE(max(ds.points), sum(COALESCE(rr.points, 0)))
                     / NULLIF(max(sb.bestPoints), 0) * 100) AS BIGINT) AS pointsShare
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         LEFT JOIN read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'') ds
                ON ds.year = rr.year AND ds.driverId = rr.driverId
         LEFT JOIN (SELECT year, max(points) AS bestPoints
                    FROM read_csv({dataDir} || ''/f1db-seasons-driver-standings.csv'')
                    GROUP BY year) sb ON sb.year = rr.year
         GROUP BY rr.year, rr.driverId
         ORDER BY rr.year DESC
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_DriverSeason
    map ( seasonKey as SeasonKey, driverId as DriverId, year as Year,
          constructors as Constructors, standingPosition as StandingPosition,
          standingOrder as StandingOrder, points as Points, starts as Starts,
          wins as Wins, podiums as Podiums, poles as Poles, bestFinish as BestFinish,
          avgQualifying as AvgQualifying, avgFinish as AvgFinish,
          retirements as Retirements, seasonBestPoints as SeasonBestPoints,
          pointsShare as PointsShare );

  query GetDriverRaces
    sql 'SELECT rr.raceId || ''-'' || rr.driverId AS raceKey, rr.driverId AS driverId,
                rr.year AS year, rr.round AS round,
                COALESCE(r.officialName, ''Round '' || rr.round) AS raceName,
                COALESCE(c.name, ''-'') AS constructorName,
                fp1.positionNumber AS fp1Position,
                fp2.positionNumber AS fp2Position,
                fp3.positionNumber AS fp3Position,
                rr.qualificationPositionNumber AS qualifyingPosition,
                rr.gridPositionNumber AS gridPosition,
                rr.positionNumber AS finishPosition,
                rr.positionText AS positionText,
                rr.positionsGained AS positionsGained,
                rr.points AS points,
                rr.reasonRetired AS reasonRetired
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-races.csv'') r ON r.id = rr.raceId
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-1-results.csv'') fp1
                ON fp1.raceId = rr.raceId AND fp1.driverId = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-2-results.csv'') fp2
                ON fp2.raceId = rr.raceId AND fp2.driverId = rr.driverId
         LEFT JOIN read_csv({dataDir} || ''/f1db-races-free-practice-3-results.csv'') fp3
                ON fp3.raceId = rr.raceId AND fp3.driverId = rr.driverId
         ORDER BY rr.year DESC, rr.round
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_DriverRace
    map ( raceKey as RaceKey, driverId as DriverId, year as Year, round as Round,
          raceName as RaceName, constructorName as ConstructorName,
          fp1Position as Fp1Position, fp2Position as Fp2Position, fp3Position as Fp3Position,
          qualifyingPosition as QualifyingPosition, gridPosition as GridPosition,
          finishPosition as FinishPosition, positionText as PositionText,
          positionsGained as PositionsGained, points as Points,
          reasonRetired as ReasonRetired );

  query GetSeasonProgress
    sql 'SELECT ''0-0'' AS progressKey, 0 AS year, 0 AS round, '''' AS raceName,
                '''' AS d1Name, '''' AS d2Name, '''' AS d3Name, '''' AS d4Name, '''' AS d5Name,
                0.0 AS d1Points, 0.0 AS d2Points, 0.0 AS d3Points,
                0.0 AS d4Points, 0.0 AS d5Points
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_SeasonProgress
    map ( progressKey as ProgressKey, year as Year, round as Round, raceName as RaceName,
          d1Name as D1Name, d2Name as D2Name, d3Name as D3Name, d4Name as D4Name,
          d5Name as D5Name, d1Points as D1Points, d2Points as D2Points,
          d3Points as D3Points, d4Points as D4Points, d5Points as D5Points );

  query GetRetirements
    sql 'SELECT rr.constructorId || ''|'' || COALESCE(rr.reasonRetired, ''Unknown'') AS retirementKey,
                rr.constructorId AS constructorId,
                COALESCE(c.name, rr.constructorId) AS constructorName,
                COALESCE(rr.reasonRetired, ''Unknown'') AS reasonRetired,
                count(*) AS retirements, 0 AS entries, 0.0 AS sharePercent,
                min(rr.year) AS firstYear, max(rr.year) AS lastYear
         FROM read_csv({dataDir} || ''/f1db-races-race-results.csv'') rr
         LEFT JOIN read_csv({dataDir} || ''/f1db-constructors.csv'') c ON c.id = rr.constructorId
         WHERE rr.positionNumber IS NULL
         GROUP BY rr.constructorId, c.name, rr.reasonRetired
         ORDER BY count(*) DESC
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Retirement
    map ( retirementKey as RetirementKey, constructorId as ConstructorId,
          constructorName as ConstructorName, reasonRetired as ReasonRetired,
          retirements as Retirements, entries as Entries, sharePercent as SharePercent,
          firstYear as FirstYear, lastYear as LastYear );

  /*
   * Facts. The file is written by scripts/fetch-f1-facts.sh and can legitimately
   * be header-only when the fetch could not reach Wikipedia, so the column types
   * are declared rather than sniffed: read_csv infers nothing from an empty file
   * and would fail on the column names instead of returning no rows.
   */
  query GetFacts
    sql 'SELECT scope || ''-'' || entityId AS factKey, scope AS scope,
                entityId AS entityId, title AS title, extract AS extract,
                sourceUrl AS sourceUrl, license AS license
         FROM read_csv({dataDir} || ''/../facts/f1db-facts.csv'', header = true,
                       columns = {''scope'': ''VARCHAR'', ''entityId'': ''VARCHAR'',
                                  ''title'': ''VARCHAR'', ''extract'': ''VARCHAR'',
                                  ''sourceUrl'': ''VARCHAR'', ''license'': ''VARCHAR''})
         LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Fact
    map ( factKey as FactKey, scope as Scope, entityId as EntityId, title as Title,
          extract as Extract, sourceUrl as SourceUrl, license as License );


  /* -------------------------------------------------------------------------
   * The weekend queries. Placeholders again: every one is answered for a single
   * race and built with `dynamic` by the read microflow. What is fixed here is
   * the column list the connector maps.
   * ---------------------------------------------------------------------- */

  query GetRaceWeekend
    sql 'SELECT '''' AS weekendKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS roundLabel, '''' AS name, '''' AS circuitName,
                '''' AS circuitId, CAST(NULL AS TIMESTAMP) AS raceDate,
                0 AS laps, 0.0 AS distance,
                '''' AS winnerName, '''' AS winnerTeam,
                '''' AS poleName, '''' AS poleTime,
                '''' AS fastestLapName, '''' AS fastestLapTime,
                '''' AS fp1LeaderName, '''' AS fp1LeaderTime,
                '''' AS fp2LeaderName, '''' AS fp2LeaderTime,
                '''' AS fp3LeaderName, '''' AS fp3LeaderTime
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceWeekend
    map ( weekendKey as WeekendKey, raceId as RaceId, year as Year, round as Round,
          roundLabel as RoundLabel, name as Name, circuitName as CircuitName,
          circuitId as CircuitId, raceDate as RaceDate, laps as Laps,
          distance as Distance, winnerName as WinnerName, winnerTeam as WinnerTeam,
          poleName as PoleName, poleTime as PoleTime,
          fastestLapName as FastestLapName, fastestLapTime as FastestLapTime,
          fp1LeaderName as Fp1LeaderName, fp1LeaderTime as Fp1LeaderTime,
          fp2LeaderName as Fp2LeaderName, fp2LeaderTime as Fp2LeaderTime,
          fp3LeaderName as Fp3LeaderName, fp3LeaderTime as Fp3LeaderTime );

  query GetRaceSessions
    sql 'SELECT '''' AS sessionKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS driverId, '''' AS driverName, '''' AS abbreviation,
                '''' AS constructorName,
                0 AS fp1Position, '''' AS fp1Time, 0.0 AS fp1Gap,
                0 AS fp2Position, '''' AS fp2Time, 0.0 AS fp2Gap,
                0 AS fp3Position, '''' AS fp3Time, 0.0 AS fp3Gap,
                0 AS qualPosition, '''' AS qualTime, 0.0 AS qualGap,
                '''' AS q1, '''' AS q2, '''' AS q3,
                0 AS gridPosition, 0 AS finishPosition, '''' AS positionText,
                0 AS positionsGained, 0.0 AS points, '''' AS reasonRetired,
                '''' AS bestLapTime, 0.0 AS bestLapGap, 0 AS bestLapRank,
                0 AS pitStops
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_RaceSession
    map ( sessionKey as SessionKey, raceId as RaceId, year as Year, round as Round,
          driverId as DriverId, driverName as DriverName, abbreviation as Abbreviation,
          constructorName as ConstructorName,
          fp1Position as Fp1Position, fp1Time as Fp1Time, fp1Gap as Fp1Gap,
          fp2Position as Fp2Position, fp2Time as Fp2Time, fp2Gap as Fp2Gap,
          fp3Position as Fp3Position, fp3Time as Fp3Time, fp3Gap as Fp3Gap,
          qualPosition as QualPosition, qualTime as QualTime, qualGap as QualGap,
          q1 as Q1, q2 as Q2, q3 as Q3,
          gridPosition as GridPosition, finishPosition as FinishPosition,
          positionText as PositionText, positionsGained as PositionsGained,
          points as Points, reasonRetired as ReasonRetired,
          bestLapTime as BestLapTime, bestLapGap as BestLapGap,
          bestLapRank as BestLapRank, pitStops as PitStops );

  query GetCalendar
    sql 'SELECT '''' AS calendarKey, 0 AS raceId, 0 AS year, 0 AS round,
                '''' AS code, '''' AS name, '''' AS circuitName,
                CAST(NULL AS TIMESTAMP) AS raceDate,
                '''' AS winnerName, '''' AS winnerTeam
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_Calendar
    map ( calendarKey as CalendarKey, raceId as RaceId, year as Year, round as Round,
          code as Code, name as Name, circuitName as CircuitName,
          raceDate as RaceDate, winnerName as WinnerName, winnerTeam as WinnerTeam );

  query GetWeekendShape
    sql 'SELECT '''' AS shapeKey, 0 AS raceId, 0 AS sessionIndex, '''' AS sessionLabel,
                '''' AS s1name,
                '''' AS s2name,
                '''' AS s3name,
                '''' AS s4name,
                '''' AS s5name,
                '''' AS s6name,
                '''' AS s7name,
                '''' AS s8name,
                '''' AS s9name,
                '''' AS s10name,
                0 AS s1value,
                0 AS s2value,
                0 AS s3value,
                0 AS s4value,
                0 AS s5value,
                0 AS s6value,
                0 AS s7value,
                0 AS s8value,
                0 AS s9value,
                0 AS s10value
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_WeekendShape
    map ( shapeKey as ShapeKey, raceId as RaceId, sessionIndex as SessionIndex,
          sessionLabel as SessionLabel,
          s1name as S1Name, s2name as S2Name, s3name as S3Name, s4name as S4Name, s5name as S5Name, s6name as S6Name, s7name as S7Name, s8name as S8Name, s9name as S9Name, s10name as S10Name,
          s1value as S1Value, s2value as S2Value, s3value as S3Value, s4value as S4Value, s5value as S5Value, s6value as S6Value, s7value as S7Value, s8value as S8Value, s9value as S9Value, s10value as S10Value );

  query GetLapChart
    sql 'SELECT '''' AS lapKey, 0 AS year, 0 AS round, 0 AS lap,
                '''' AS s1name,
                '''' AS s2name,
                '''' AS s3name,
                '''' AS s4name,
                '''' AS s5name,
                '''' AS s6name,
                '''' AS s7name,
                '''' AS s8name,
                '''' AS s9name,
                '''' AS s10name,
                0 AS s1value,
                0 AS s2value,
                0 AS s3value,
                0 AS s4value,
                0 AS s5value,
                0 AS s6value,
                0 AS s7value,
                0 AS s8value,
                0 AS s9value,
                0 AS s10value
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_LapChart
    map ( lapKey as LapKey, year as Year, round as Round, lap as Lap,
          s1name as S1Name, s2name as S2Name, s3name as S3Name, s4name as S4Name, s5name as S5Name, s6name as S6Name, s7name as S7Name, s8name as S8Name, s9name as S9Name, s10name as S10Name,
          s1value as S1Value, s2value as S2Value, s3value as S3Value, s4value as S4Value, s5value as S5Value, s6value as S6Value, s7value as S7Value, s8value as S8Value, s9value as S9Value, s10value as S10Value );


  query GetTeamSeason
    sql 'SELECT '''' AS teamSeasonKey, '''' AS constructorId,
                '''' AS constructorName, 0 AS year, 0 AS round,
                '''' AS code, '''' AS raceName,
                '''' AS driver1Name, 0.0 AS driver1Points,
                '''' AS driver2Name, 0.0 AS driver2Points,
                0.0 AS teamPoints, 0 AS standingPosition
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_TeamSeason
    map ( teamSeasonKey as TeamSeasonKey, constructorId as ConstructorId,
          constructorName as ConstructorName, year as Year, round as Round,
          code as Code, raceName as RaceName,
          driver1Name as Driver1Name, driver1Points as Driver1Points,
          driver2Name as Driver2Name, driver2Points as Driver2Points,
          teamPoints as TeamPoints, standingPosition as StandingPosition );

  query GetTeamH2H
    sql 'SELECT '''' AS h2hKey, '''' AS constructorId, 0 AS year,
                '''' AS leftName, '''' AS rightName,
                0 AS qualLeft, 0 AS qualRight, 0 AS qualLeftShare, 0 AS qualRightShare,
                0 AS raceLeft, 0 AS raceRight, 0 AS raceLeftShare, 0 AS raceRightShare,
                0.0 AS pointsLeft, 0.0 AS pointsRight,
                0 AS pointsLeftShare, 0 AS pointsRightShare,
                0 AS dnfLeft, 0 AS dnfRight, 0 AS dnfLeftShare, 0 AS dnfRightShare
         FROM read_csv({dataDir} || ''/f1db-seasons.csv'') LIMIT 1'
    parameter dataDir: string
    returns Formula1Backend.Stg_TeamH2H
    map ( h2hKey as H2HKey, constructorId as ConstructorId, year as Year,
          leftName as LeftName, rightName as RightName,
          qualLeft as QualLeft, qualRight as QualRight,
          qualLeftShare as QualLeftShare, qualRightShare as QualRightShare,
          raceLeft as RaceLeft, raceRight as RaceRight,
          raceLeftShare as RaceLeftShare, raceRightShare as RaceRightShare,
          pointsLeft as PointsLeft, pointsRight as PointsRight,
          pointsLeftShare as PointsLeftShare, pointsRightShare as PointsRightShare,
          dnfLeft as DnfLeft, dnfRight as DnfRight,
          dnfLeftShare as DnfLeftShare, dnfRightShare as DnfRightShare );

  /* -------------------------------------------------------------------------
   * The live snapshot. Columns are declared rather than sniffed: these files
   * are legitimately header-only before the first fetch, and read_csv infers
   * nothing from an empty file.
   * ---------------------------------------------------------------------- */

  query GetLiveOrder
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || driverNumber AS entryKey, sessionKey, driverNumber,
                  code, driverName, team, teamColour, position, gapToLeader, interval,
                  lapNumber, lastLapSeconds, sector1, sector2, sector3, speedTrap,
                  compound, tyreAge, pitStops, drs, sector1Mark, sector2Mark,
                  sector3Mark
           FROM read_csv({dataDir} || ''/../live/live-order.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''driverNumber'': ''BIGINT'',
                                    ''code'': ''VARCHAR'', ''driverName'': ''VARCHAR'',
                                    ''team'': ''VARCHAR'', ''teamColour'': ''VARCHAR'',
                                    ''position'': ''BIGINT'', ''gapToLeader'': ''VARCHAR'',
                                    ''interval'': ''VARCHAR'', ''lapNumber'': ''BIGINT'',
                                    ''lastLapSeconds'': ''DOUBLE'', ''sector1'': ''DOUBLE'',
                                    ''sector2'': ''DOUBLE'', ''sector3'': ''DOUBLE'',
                                    ''speedTrap'': ''BIGINT'', ''compound'': ''VARCHAR'',
                                    ''tyreAge'': ''BIGINT'', ''pitStops'': ''BIGINT'',
                                    ''drs'': ''VARCHAR'', ''sector1Mark'': ''VARCHAR'',
                                    ''sector2Mark'': ''VARCHAR'', ''sector3Mark'': ''VARCHAR''})
           ORDER BY position
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.entryKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.entryKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''entryKey'' THEN t.entryKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''driverName'' THEN t.driverName WHEN ''team'' THEN t.team WHEN ''teamColour'' THEN t.teamColour WHEN ''gapToLeader'' THEN t.gapToLeader WHEN ''interval'' THEN t.interval WHEN ''compound'' THEN t.compound END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''entryKey'' THEN t.entryKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''driverName'' THEN t.driverName WHEN ''team'' THEN t.team WHEN ''teamColour'' THEN t.teamColour WHEN ''gapToLeader'' THEN t.gapToLeader WHEN ''interval'' THEN t.interval WHEN ''compound'' THEN t.compound END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''position'' THEN CAST(t.position AS DOUBLE) WHEN ''lapNumber'' THEN CAST(t.lapNumber AS DOUBLE) WHEN ''lastLapSeconds'' THEN CAST(t.lastLapSeconds AS DOUBLE) WHEN ''sector1'' THEN CAST(t.sector1 AS DOUBLE) WHEN ''sector2'' THEN CAST(t.sector2 AS DOUBLE) WHEN ''sector3'' THEN CAST(t.sector3 AS DOUBLE) WHEN ''speedTrap'' THEN CAST(t.speedTrap AS DOUBLE) WHEN ''tyreAge'' THEN CAST(t.tyreAge AS DOUBLE) WHEN ''pitStops'' THEN CAST(t.pitStops AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''position'' THEN CAST(t.position AS DOUBLE) WHEN ''lapNumber'' THEN CAST(t.lapNumber AS DOUBLE) WHEN ''lastLapSeconds'' THEN CAST(t.lastLapSeconds AS DOUBLE) WHEN ''sector1'' THEN CAST(t.sector1 AS DOUBLE) WHEN ''sector2'' THEN CAST(t.sector2 AS DOUBLE) WHEN ''sector3'' THEN CAST(t.sector3 AS DOUBLE) WHEN ''speedTrap'' THEN CAST(t.speedTrap AS DOUBLE) WHEN ''tyreAge'' THEN CAST(t.tyreAge AS DOUBLE) WHEN ''pitStops'' THEN CAST(t.pitStops AS DOUBLE) END) END DESC NULLS LAST,
           t.position
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_LiveEntry
    map ( entryKey as EntryKey, sessionKey as SessionKey, driverNumber as DriverNumber,
          code as Code, driverName as DriverName, team as Team, teamColour as TeamColour,
          position as Position, gapToLeader as GapToLeader, interval as Interval,
          lapNumber as LapNumber, lastLapSeconds as LastLapSeconds, sector1 as Sector1,
          sector2 as Sector2, sector3 as Sector3, speedTrap as SpeedTrap,
          compound as Compound, tyreAge as TyreAge, pitStops as PitStops,
          drs as Drs, sector1Mark as Sector1Mark, sector2Mark as Sector2Mark,
          sector3Mark as Sector3Mark );

  /*
   * `at` is a reserved word in DuckDB (it introduces time travel: FROM t AT
   * (VERSION => ...)), so an unquoted `at` in the select list is a parse error
   * — and the map clause cannot reference a quoted identifier either. Quote it
   * once and alias it to a name that is only a name.
   *
   * The key is row_number() rather than rowid, which read_csv does not expose:
   * a race control message has no natural id, and two identical yellow flags in
   * one session are a real possibility.
   */
  query GetLiveMessages
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || row_number() OVER () AS messageKey,
                  sessionKey, "at" AS atTime, category, flag, scope, lap, message
           FROM read_csv({dataDir} || ''/../live/live-messages.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''at'': ''VARCHAR'',
                                    ''category'': ''VARCHAR'', ''flag'': ''VARCHAR'',
                                    ''scope'': ''VARCHAR'', ''lap'': ''BIGINT'',
                                    ''message'': ''VARCHAR''})
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.messageKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.messageKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''messageKey'' THEN t.messageKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''at'' THEN t.atTime WHEN ''category'' THEN t.category WHEN ''flag'' THEN t.flag WHEN ''scope'' THEN t.scope WHEN ''message'' THEN t.message END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''messageKey'' THEN t.messageKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''at'' THEN t.atTime WHEN ''category'' THEN t.category WHEN ''flag'' THEN t.flag WHEN ''scope'' THEN t.scope WHEN ''message'' THEN t.message END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''lap'' THEN CAST(t.lap AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''lap'' THEN CAST(t.lap AS DOUBLE) END) END DESC NULLS LAST
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_LiveMessage
    map ( messageKey as MessageKey, sessionKey as SessionKey, atTime as At,
          category as Category, flag as Flag, scope as Scope, lap as Lap,
          message as Message );

  query GetLiveSession
    sql 'SELECT * FROM (
         SELECT s.sessionKey, s.sessionName, s.sessionType, s.location, s.countryName,
                  s.circuitName, s.dateStart, s.year, s.driverCount, s.leadLap, s.fetchedAt,
                  w.airTemperature, w.trackTemperature, w.humidity, w.rainfall, w.windSpeed
           FROM read_csv({dataDir} || ''/../live/live-session.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''sessionName'': ''VARCHAR'',
                                    ''sessionType'': ''VARCHAR'', ''location'': ''VARCHAR'',
                                    ''countryName'': ''VARCHAR'', ''circuitName'': ''VARCHAR'',
                                    ''dateStart'': ''VARCHAR'', ''year'': ''BIGINT'',
                                    ''driverCount'': ''BIGINT'', ''leadLap'': ''BIGINT'',
                                    ''fetchedAt'': ''VARCHAR''}) s
           LEFT JOIN read_csv({dataDir} || ''/../live/live-weather.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''at'': ''VARCHAR'',
                                    ''airTemperature'': ''DOUBLE'', ''trackTemperature'': ''DOUBLE'',
                                    ''humidity'': ''DOUBLE'', ''rainfall'': ''DOUBLE'',
                                    ''windSpeed'': ''DOUBLE''}) w
                  ON w.sessionKey = s.sessionKey
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.sessionKey AS VARCHAR) = {keyFilter}
               OR TRY_CAST(t.sessionKey AS DOUBLE) = TRY_CAST({keyFilter} AS DOUBLE)
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''sessionKey'' THEN t.sessionKey WHEN ''sessionName'' THEN t.sessionName WHEN ''sessionType'' THEN t.sessionType WHEN ''location'' THEN t.location WHEN ''countryName'' THEN t.countryName WHEN ''circuitName'' THEN t.circuitName WHEN ''dateStart'' THEN t.dateStart WHEN ''fetchedAt'' THEN t.fetchedAt END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''sessionKey'' THEN t.sessionKey WHEN ''sessionName'' THEN t.sessionName WHEN ''sessionType'' THEN t.sessionType WHEN ''location'' THEN t.location WHEN ''countryName'' THEN t.countryName WHEN ''circuitName'' THEN t.circuitName WHEN ''dateStart'' THEN t.dateStart WHEN ''fetchedAt'' THEN t.fetchedAt END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''driverCount'' THEN CAST(t.driverCount AS DOUBLE) WHEN ''leadLap'' THEN CAST(t.leadLap AS DOUBLE) WHEN ''airTemperature'' THEN CAST(t.airTemperature AS DOUBLE) WHEN ''trackTemperature'' THEN CAST(t.trackTemperature AS DOUBLE) WHEN ''humidity'' THEN CAST(t.humidity AS DOUBLE) WHEN ''rainfall'' THEN CAST(t.rainfall AS DOUBLE) WHEN ''windSpeed'' THEN CAST(t.windSpeed AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''year'' THEN CAST(t.year AS DOUBLE) WHEN ''driverCount'' THEN CAST(t.driverCount AS DOUBLE) WHEN ''leadLap'' THEN CAST(t.leadLap AS DOUBLE) WHEN ''airTemperature'' THEN CAST(t.airTemperature AS DOUBLE) WHEN ''trackTemperature'' THEN CAST(t.trackTemperature AS DOUBLE) WHEN ''humidity'' THEN CAST(t.humidity AS DOUBLE) WHEN ''rainfall'' THEN CAST(t.rainfall AS DOUBLE) WHEN ''windSpeed'' THEN CAST(t.windSpeed AS DOUBLE) END) END DESC NULLS LAST
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_LiveSession
    map ( sessionKey as SessionKey, sessionName as SessionName, sessionType as SessionType,
          location as Location, countryName as CountryName, circuitName as CircuitName,
          dateStart as DateStart, year as Year, driverCount as DriverCount,
          leadLap as LeadLap, fetchedAt as FetchedAt, airTemperature as AirTemperature,
          trackTemperature as TrackTemperature, humidity as Humidity,
          rainfall as Rainfall, windSpeed as WindSpeed );

  /*
   * The lap-by-lap history. One row per driver per lap, already resampled onto
   * lap boundaries by the fetch script, so this query is a straight read.
   *
   * The key is sessionKey-driverNumber-lapNumber, which is genuinely unique
   * here -- unlike the race control messages next door, a driver completes a
   * given lap exactly once.
   */
  query GetLiveTrace
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || driverNumber || ''-'' || lapNumber AS traceKey,
                  sessionKey, driverNumber, code, lapNumber, position,
                  gapToLeader, gapSeconds, lapSeconds
           FROM read_csv({dataDir} || ''/../live/live-trace.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''driverNumber'': ''BIGINT'',
                                    ''code'': ''VARCHAR'', ''lapNumber'': ''BIGINT'',
                                    ''position'': ''BIGINT'', ''gapToLeader'': ''VARCHAR'',
                                    ''gapSeconds'': ''DOUBLE'', ''lapSeconds'': ''DOUBLE''})
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.traceKey AS VARCHAR) = {keyFilter}
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''traceKey'' THEN t.traceKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''gapToLeader'' THEN t.gapToLeader END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''traceKey'' THEN t.traceKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''gapToLeader'' THEN t.gapToLeader END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''lapNumber'' THEN CAST(t.lapNumber AS DOUBLE) WHEN ''position'' THEN CAST(t.position AS DOUBLE) WHEN ''gapSeconds'' THEN CAST(t.gapSeconds AS DOUBLE) WHEN ''lapSeconds'' THEN CAST(t.lapSeconds AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''lapNumber'' THEN CAST(t.lapNumber AS DOUBLE) WHEN ''position'' THEN CAST(t.position AS DOUBLE) WHEN ''gapSeconds'' THEN CAST(t.gapSeconds AS DOUBLE) WHEN ''lapSeconds'' THEN CAST(t.lapSeconds AS DOUBLE) END) END DESC NULLS LAST,
           t.lapNumber, t.position
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_LiveTrace
    map ( traceKey as TraceKey, sessionKey as SessionKey, driverNumber as DriverNumber,
          code as Code, lapNumber as LapNumber, position as Position,
          gapToLeader as GapToLeader, gapSeconds as GapSeconds,
          lapSeconds as LapSeconds );

  /* Every stint of every car. Ordered by driver then stint so a page can walk
   * it straight into per-driver bars without regrouping. */
  query GetLiveStints
    sql 'SELECT * FROM (
         SELECT sessionKey || ''-'' || driverNumber || ''-'' || stintNumber AS stintKey,
                  sessionKey, driverNumber, code, stintNumber, compound,
                  lapStart, lapEnd, tyreAgeAtStart
           FROM read_csv({dataDir} || ''/../live/live-stints.csv'', header = true,
                         columns = {''sessionKey'': ''VARCHAR'', ''driverNumber'': ''BIGINT'',
                                    ''code'': ''VARCHAR'', ''stintNumber'': ''BIGINT'',
                                    ''compound'': ''VARCHAR'', ''lapStart'': ''BIGINT'',
                                    ''lapEnd'': ''BIGINT'', ''tyreAgeAtStart'': ''BIGINT''})
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.stintKey AS VARCHAR) = {keyFilter}
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''stintKey'' THEN t.stintKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''compound'' THEN t.compound END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''stintKey'' THEN t.stintKey WHEN ''sessionKey'' THEN t.sessionKey WHEN ''code'' THEN t.code WHEN ''compound'' THEN t.compound END) END DESC NULLS LAST,
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''stintNumber'' THEN CAST(t.stintNumber AS DOUBLE) WHEN ''lapStart'' THEN CAST(t.lapStart AS DOUBLE) WHEN ''lapEnd'' THEN CAST(t.lapEnd AS DOUBLE) WHEN ''tyreAgeAtStart'' THEN CAST(t.tyreAgeAtStart AS DOUBLE) END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''driverNumber'' THEN CAST(t.driverNumber AS DOUBLE) WHEN ''stintNumber'' THEN CAST(t.stintNumber AS DOUBLE) WHEN ''lapStart'' THEN CAST(t.lapStart AS DOUBLE) WHEN ''lapEnd'' THEN CAST(t.lapEnd AS DOUBLE) WHEN ''tyreAgeAtStart'' THEN CAST(t.tyreAgeAtStart AS DOUBLE) END) END DESC NULLS LAST,
           t.driverNumber, t.stintNumber
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_LiveStint
    map ( stintKey as StintKey, sessionKey as SessionKey, driverNumber as DriverNumber,
          code as Code, stintNumber as StintNumber, compound as Compound,
          lapStart as LapStart, lapEnd as LapEnd, tyreAgeAtStart as TyreAgeAtStart );

  /* One outline per circuit, keyed by the circuit's own id. A weekend page asks
   * for the one circuit it is about; nothing here asks for all of them, but the
   * unfiltered read is 22 rows and costs nothing. */
  query GetCircuitOutlines
    sql 'SELECT * FROM (
         SELECT circuitId, name, fullName, viewBox, pathD, points,
                  tracedKm, officialKm, deltaPercent, source, license, attribution
           FROM read_csv({dataDir} || ''/../circuits/f1db-circuit-paths.csv'',
                         header = true,
                         columns = {''circuitId'': ''VARCHAR'', ''name'': ''VARCHAR'',
                                    ''fullName'': ''VARCHAR'', ''viewBox'': ''VARCHAR'',
                                    ''pathD'': ''VARCHAR'', ''points'': ''BIGINT'',
                                    ''tracedKm'': ''DOUBLE'', ''officialKm'': ''DOUBLE'',
                                    ''deltaPercent'': ''DOUBLE'', ''source'': ''VARCHAR'',
                                    ''license'': ''VARCHAR'', ''attribution'': ''VARCHAR''})
         ) t
         WHERE {keyFilter} = '''' OR CAST(t.circuitId AS VARCHAR) = {keyFilter}
         ORDER BY
           CASE WHEN {sortDir} = ''A'' THEN (CASE {sortCol} WHEN ''circuitId'' THEN t.circuitId WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName END) END ASC NULLS LAST,
           CASE WHEN {sortDir} = ''D'' THEN (CASE {sortCol} WHEN ''circuitId'' THEN t.circuitId WHEN ''name'' THEN t.name WHEN ''fullName'' THEN t.fullName END) END DESC NULLS LAST,
           t.circuitId
         LIMIT CAST({topN} AS BIGINT) OFFSET CAST({skipN} AS BIGINT)'
    parameter dataDir: string
    parameter keyFilter: string
    parameter topN: string
    parameter skipN: string
    parameter sortCol: string
    parameter sortDir: string
    returns Formula1Backend.Stg_CircuitOutline
    map ( circuitId as CircuitId, name as Name, fullName as FullName,
          viewBox as ViewBox, pathD as PathD, points as Points,
          tracedKm as TracedKm, officialKm as OfficialKm,
          deltaPercent as DeltaPercent, source as Source,
          license as License, attribution as Attribution );

  /* The outline as vertices. Called with dynamic SQL so a page's
   * ?$filter=circuitId eq 'zandvoort' is pushed into the scan rather than
   * pulling nine thousand points to keep four hundred. */
  query GetCircuitPoints
    sql 'SELECT circuitId || ''-'' || i AS pointKey, circuitId, i AS seq, x, y
           FROM read_csv({dataDir} || ''/../circuits/f1db-circuit-points.csv'',
                         header = true,
                         columns = {''circuitId'': ''VARCHAR'', ''i'': ''BIGINT'',
                                    ''x'': ''DOUBLE'', ''y'': ''DOUBLE''})
          ORDER BY circuitId, i'
    parameter dataDir: string
    returns Formula1Backend.Stg_CircuitPoint
    map ( pointKey as PointKey, circuitId as CircuitId, seq as Seq,
          x as X, y as Y );

  /* -------------------------------------------------------- OpenF1, live -- */

  /*
   * These five read OpenF1 over HTTPS instead of reading a file, and they are
   * always called with dynamic SQL: the session key and the base URL come from
   * the caller, and a token, when there is one, arrives as a CREATE SECRET
   * statement prepended to the text. The SQL below is a placeholder that fixes
   * the row shape and the column mapping; nothing executes it as written.
   *
   * DuckDB autoloads httpfs on first use, so no INSTALL or LOAD is needed.
   */

  /*
   * The live derivation, from JSON handed in rather than fetched here.
   *
   * An earlier version had DuckDB fetch the five endpoints itself with
   * read_json_auto('https://...'). It worked, and it was rate-limit fragile by
   * construction: DuckDB scans those sources in parallel, five at once against
   * OpenF1's three-requests-a-second, and reports the resulting 429 as
   * "HTTP 0 Internal Server Error" -- a message that names neither the rate
   * limit nor HTTP, and costs an afternoon.
   *
   * So the fetching moved to REST CALL activities, which run one at a time and
   * carry the bearer token in a header where it belongs, and the payloads
   * arrive here as bound parameters. That also makes this a plain parameterised
   * query rather than dynamic SQL: nothing is concatenated, so nothing can be
   * injected, and no CREATE SECRET or SET has to ride along as a second
   * statement -- which the JDBC driver would not prepare anyway.
   *
   * ASOF LEFT JOIN is the point of doing this in SQL at all. "The newest
   * position sample at or before this lap ended" is one join here and a
   * bisect-and-loop anywhere else.
   */
  query GetOpenF1Laps
    sql 'WITH laps AS (
           SELECT j.driver_number AS driver_number, j.lap_number AS lap_number,
                  j.lap_duration AS lap_duration, j.duration_sector_1 AS s1,
                  j.duration_sector_2 AS s2, j.duration_sector_3 AS s3,
                  j.i2_speed AS trap,
                  CAST(j.date_start AS TIMESTAMP)
                    + INTERVAL (COALESCE(j.lap_duration,0)) SECOND AS t1
             FROM (SELECT unnest(from_json({lapsJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT","lap_duration":"DOUBLE","duration_sector_1":"DOUBLE","duration_sector_2":"DOUBLE","duration_sector_3":"DOUBLE","i2_speed":"BIGINT","date_start":"VARCHAR"}]'')) AS j)
            WHERE j.date_start IS NOT NULL
         ), pos AS (
           SELECT j.driver_number AS driver_number, CAST(j.date AS TIMESTAMP) AS t,
                  j.position AS position
             FROM (SELECT unnest(from_json({posJson}::JSON,
                   ''[{"driver_number":"BIGINT","date":"VARCHAR","position":"BIGINT"}]'')) AS j)
            WHERE j.position IS NOT NULL
         ), itv AS (
           SELECT j.driver_number AS driver_number, CAST(j.date AS TIMESTAMP) AS t,
                  j.gap_to_leader AS gap_to_leader
             FROM (SELECT unnest(from_json({itvJson}::JSON,
                   ''[{"driver_number":"BIGINT","date":"VARCHAR","gap_to_leader":"VARCHAR"}]'')) AS j)
            WHERE j.gap_to_leader IS NOT NULL
         ), st AS (
           SELECT j.driver_number AS driver_number, j.stint_number AS stint_number,
                  j.compound AS compound, j.lap_start AS lap_start,
                  j.lap_end AS lap_end, j.tyre_age_at_start AS tyre_age_at_start
             FROM (SELECT unnest(from_json({stintsJson}::JSON,
                   ''[{"driver_number":"BIGINT","stint_number":"BIGINT","compound":"VARCHAR","lap_start":"BIGINT","lap_end":"BIGINT","tyre_age_at_start":"BIGINT"}]'')) AS j)
         ), pits AS (
           SELECT j.driver_number AS driver_number, j.lap_number AS lap_number
             FROM (SELECT unnest(from_json({pitJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT"}]'')) AS j)
         )
         SELECT {sessionKey} AS sessionKey, l.driver_number AS driverNumber,
                l.lap_number AS lapNumber, p.position AS position,
                i.gap_to_leader AS gapToLeader,
                TRY_CAST(i.gap_to_leader AS DOUBLE) AS gapSeconds,
                l.lap_duration AS lapSeconds, l.s1 AS sector1, l.s2 AS sector2,
                l.s3 AS sector3, l.trap AS speedTrap, s.compound AS compound,
                CASE WHEN s.lap_start IS NULL THEN NULL
                     ELSE COALESCE(s.tyre_age_at_start,0)
                          + (l.lap_number - s.lap_start) END AS tyreAge,
                (SELECT count(*) FROM pits x
                   WHERE x.driver_number = l.driver_number
                     AND x.lap_number <= l.lap_number) AS pitStops
           FROM laps l
           ASOF LEFT JOIN pos p ON p.driver_number = l.driver_number AND p.t <= l.t1
           ASOF LEFT JOIN itv i ON i.driver_number = l.driver_number AND i.t <= l.t1
           LEFT JOIN st s ON s.driver_number = l.driver_number
                AND l.lap_number >= s.lap_start
                AND l.lap_number <= COALESCE(s.lap_end, 9999)'
    parameter sessionKey: string
    parameter lapsJson: string
    parameter posJson: string
    parameter itvJson: string
    parameter stintsJson: string
    parameter pitJson: string
    returns Formula1Backend.Stg_SyncLap
    map ( sessionKey as SessionKey, driverNumber as DriverNumber,
          lapNumber as LapNumber, position as Position,
          gapToLeader as GapToLeader, gapSeconds as GapSeconds,
          lapSeconds as LapSeconds, sector1 as Sector1, sector2 as Sector2,
          sector3 as Sector3, speedTrap as SpeedTrap, compound as Compound,
          tyreAge as TyreAge, pitStops as PitStops );

  /*
   * The entry list.
   *
   * This was a stub -- `SELECT '' ... WHERE {dataDir} = 'never'`, a shape with
   * no rows behind it -- and nothing called it, so LiveDriver stayed empty
   * through every session captured. What that costs is not cosmetic: a lap
   * table keyed on driver_number and no entry list is a table of anonymous
   * numbers, and the only way to read it is to supply the mapping from memory.
   * Doing that put Verstappen third in the Zandvoort Sprint. He finished sixth;
   * car 1 is Norris this season and Verstappen is car 3, which OpenF1 says
   * plainly in a field we were not storing.
   *
   * team_colour comes back as bare hex with no '#', which is what the frontend
   * wants for a CSS custom property, so it is stored as sent.
   */
  query GetOpenF1Drivers
    sql 'SELECT {sessionKey} AS sessionKey, j.driver_number AS driverNumber,
                COALESCE(j.name_acronym, '''') AS code,
                COALESCE(j.full_name, j.broadcast_name, '''') AS driverName,
                COALESCE(j.team_name, '''') AS team,
                COALESCE(j.team_colour, '''') AS teamColour
           FROM (SELECT unnest(from_json({driversJson}::JSON,
                 ''[{"driver_number":"BIGINT","name_acronym":"VARCHAR","full_name":"VARCHAR","broadcast_name":"VARCHAR","team_name":"VARCHAR","team_colour":"VARCHAR"}]'')) AS j)
          WHERE j.driver_number IS NOT NULL'
    parameter sessionKey: string
    parameter driversJson: string
    returns Formula1Backend.Stg_SyncDriver
    map ( sessionKey as SessionKey, driverNumber as DriverNumber, code as Code,
          driverName as DriverName, team as Team, teamColour as TeamColour );

  query GetOpenF1Stints
    sql 'SELECT '''' AS stintKey, '''' AS sessionKey, 0 AS driverNumber,
                '''' AS code, 0 AS stintNumber, '''' AS compound,
                0 AS lapStart, 0 AS lapEnd, 0 AS tyreAgeAtStart
         WHERE {dataDir} = ''never'''
    parameter dataDir: string
    returns Formula1Backend.Stg_LiveStint
    map ( stintKey as StintKey, sessionKey as SessionKey,
          driverNumber as DriverNumber, code as Code, stintNumber as StintNumber,
          compound as Compound, lapStart as LapStart, lapEnd as LapEnd,
          tyreAgeAtStart as TyreAgeAtStart );

  /*
   * Race control: flags, safety cars, investigations, deleted lap times.
   *
   * Sixty-five messages in the Zandvoort sprint, and they are most of the story
   * a replay would want to tell -- four separate investigations, a deleted lap
   * for track limits, blue flags. All of it was being discarded.
   *
   * messageKey exists because two messages can share a second, so the timestamp
   * alone is not unique; the row number inside the ordering closes it.
   */
  query GetOpenF1Messages
    sql 'SELECT {sessionKey} AS sessionKey,
                {sessionKey} || ''-'' || strftime(CAST(j.date AS TIMESTAMP), ''%Y%m%d%H%M%S'')
                  || ''-'' || CAST(row_number() OVER (ORDER BY j.date) AS VARCHAR) AS messageKey,
                strftime(CAST(j.date AS TIMESTAMP), ''%Y-%m-%dT%H:%M:%S'') AS atTime,
                COALESCE(j.category, '''') AS category,
                COALESCE(j.flag, '''') AS flag,
                COALESCE(j.scope, '''') AS scope,
                COALESCE(j.lap_number, 0) AS lap,
                COALESCE(j.message, '''') AS message
           FROM (SELECT unnest(from_json({messagesJson}::JSON,
                 ''[{"date":"VARCHAR","category":"VARCHAR","flag":"VARCHAR","scope":"VARCHAR","lap_number":"BIGINT","message":"VARCHAR"}]'')) AS j)
          WHERE j.date IS NOT NULL'
    parameter sessionKey: string
    parameter messagesJson: string
    returns Formula1Backend.Stg_LiveMessage
    map ( messageKey as MessageKey, sessionKey as SessionKey, atTime as At,
          category as Category, flag as Flag, scope as Scope, lap as Lap,
          message as Message );

  /*
   * Weather as a series. Eighty readings across a sprint, one a minute, which
   * is what the header tiles show the latest of and what a chart would need
   * the rest of.
   */
  query GetOpenF1Weather
    sql 'SELECT {sessionKey} AS sessionKey,
                strftime(CAST(j.date AS TIMESTAMP), ''%Y-%m-%dT%H:%M:%S'') AS atTime,
                COALESCE(j.air_temperature, 0) AS airTemperature,
                COALESCE(j.track_temperature, 0) AS trackTemperature,
                COALESCE(j.humidity, 0) AS humidity,
                COALESCE(j.rainfall, 0) AS rainfall,
                COALESCE(j.wind_speed, 0) AS windSpeed
           FROM (SELECT unnest(from_json({weatherJson}::JSON,
                 ''[{"date":"VARCHAR","air_temperature":"DOUBLE","track_temperature":"DOUBLE","humidity":"DOUBLE","rainfall":"DOUBLE","wind_speed":"DOUBLE"}]'')) AS j)
          WHERE j.date IS NOT NULL'
    parameter sessionKey: string
    parameter weatherJson: string
    returns Formula1Backend.Stg_SyncWeather
    map ( sessionKey as SessionKey, atTime as At,
          airTemperature as AirTemperature, trackTemperature as TrackTemperature,
          humidity as Humidity, rainfall as Rainfall, windSpeed as WindSpeed );

  /*
   * The session itself: what it is, where, and how far it has run.
   *
   * Another stub that nothing called, so LiveSessionRow stayed empty and the
   * Narrate header had to come from a CSV. driverCount and leadLap are counted
   * out of the lap feed rather than taken from the session record, because the
   * session record does not carry them and the header wants both.
   */
  query GetOpenF1Session
    sql 'SELECT {sessionKey} AS sessionKey,
                COALESCE(j.session_name, '''') AS sessionName,
                COALESCE(j.session_type, '''') AS sessionType,
                COALESCE(j.location, '''') AS location,
                COALESCE(j.country_name, '''') AS countryName,
                COALESCE(j.circuit_short_name, '''') AS circuitName,
                COALESCE(j.date_start, '''') AS dateStart,
                COALESCE(j.year, 0) AS year,
                (SELECT COUNT(DISTINCT l.driver_number) FROM (SELECT unnest(from_json({lapsJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT"}]'')) AS l)) AS driverCount,
                (SELECT COALESCE(MAX(l.lap_number), 0) FROM (SELECT unnest(from_json({lapsJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT"}]'')) AS l)) AS leadLap
           FROM (SELECT unnest(from_json({sessionJson}::JSON,
                 ''[{"session_name":"VARCHAR","session_type":"VARCHAR","location":"VARCHAR","country_name":"VARCHAR","circuit_short_name":"VARCHAR","date_start":"VARCHAR","year":"BIGINT"}]'')) AS j)'
    parameter sessionKey: string
    parameter sessionJson: string
    parameter lapsJson: string
    returns Formula1Backend.Stg_SyncSession
    map ( sessionKey as SessionKey, sessionName as SessionName,
          sessionType as SessionType, location as Location,
          countryName as CountryName, circuitName as CircuitName,
          dateStart as DateStart, year as Year, driverCount as DriverCount,
          leadLap as LeadLap );

  /* ------------------------------------------------------ tiered retrieval -- */

  /*
   * Per-lap telemetry, from a window of samples.
   *
   * Only laps that fall entirely inside the fetched window are emitted. A lap
   * half-covered by the window would aggregate to a confident wrong answer --
   * a "top speed" from the three samples that happened to land inside it -- and
   * because each cycle overwrites the lap it computes, a partial row would
   * survive as though it were complete. Recomputing a whole lap on a later
   * cycle is idempotent; averaging half of one is not.
   *
   * DRS is a small integer whose values mean different things: 8 is "eligible",
   * 10, 12 and 14 are "open". The encoding is written down here rather than on
   * a page.
   */
  query GetOpenF1Telemetry
    sql 'WITH car AS (
           SELECT j.driver_number AS driver_number, CAST(j.date AS TIMESTAMP) AS t,
                  j.speed AS speed, j.throttle AS throttle, j.brake AS brake,
                  j.n_gear AS n_gear, j.rpm AS rpm, j.drs AS drs
             FROM (SELECT unnest(from_json({carJson}::JSON,
                   ''[{"driver_number":"BIGINT","date":"VARCHAR","speed":"BIGINT","throttle":"BIGINT","brake":"BIGINT","n_gear":"BIGINT","rpm":"BIGINT","drs":"BIGINT"}]'')) AS j)
         ), laps AS (
           SELECT j.driver_number AS driver_number, j.lap_number AS lap_number,
                  CAST(j.date_start AS TIMESTAMP) AS t0,
                  CAST(j.date_start AS TIMESTAMP)
                    + INTERVAL (COALESCE(j.lap_duration,0)) SECOND AS t1
             FROM (SELECT unnest(from_json({lapsJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT","lap_duration":"DOUBLE","date_start":"VARCHAR"}]'')) AS j)
            WHERE j.date_start IS NOT NULL
              AND CAST(j.date_start AS TIMESTAMP) >= CAST({fromTs} AS TIMESTAMP)
         )
         SELECT {sessionKey} AS sessionKey, l.driver_number AS driverNumber,
                l.lap_number AS lapNumber, max(c.speed) AS topSpeed,
                avg(c.throttle) AS avgThrottle, max(c.n_gear) AS maxGear,
                avg(CASE WHEN c.drs IN (10,12,14) THEN 1.0 ELSE 0.0 END) AS drsOpenShare,
                avg(CASE WHEN c.brake > 0 THEN 1.0 ELSE 0.0 END) AS brakeShare,
                max(c.rpm) AS maxRpm, count(*) AS samples
           FROM laps l
           JOIN car c ON c.driver_number = l.driver_number
                     AND c.t >= l.t0 AND c.t < l.t1
          GROUP BY l.driver_number, l.lap_number'
    parameter sessionKey: string
    parameter carJson: string
    parameter lapsJson: string
    parameter fromTs: string
    returns Formula1Backend.Stg_SyncTelemetry
    map ( sessionKey as SessionKey, driverNumber as DriverNumber,
          lapNumber as LapNumber, topSpeed as TopSpeed,
          avgThrottle as AvgThrottle, maxGear as MaxGear,
          drsOpenShare as DrsOpenShare, brakeShare as BrakeShare,
          maxRpm as MaxRpm, samples as Samples );

  /*
   * The rolling window, downsampled to one sample per car per second.
   *
   * The raw feed is roughly 3.7 Hz per car -- five thousand rows a minute for
   * car_data alone -- and inserting that into Mendix every cycle costs far more
   * than it shows. A track map and a speed trace read fine at 1 Hz, so one
   * sample per car per second is kept and the rest discarded at the database
   * rather than carried into the app.
   */
  /*
   * The OAuth2 token response, taken apart here rather than by an import
   * mapping.
   *
   * A JSON structure and an import mapping is the Mendix way to do this and it
   * does not survive being written from MDL: the runtime answers a valid
   * response with `key not found: Path(QName(None,),None,)`, both as the REST
   * call''s RETURNS MAPPING and as a standalone Import activity, from a mapping
   * whose paths read back correctly as `(Object)|access_token`.
   *
   * Every other OpenF1 response in this app is already parsed by passing the
   * body to DuckDB as a bound parameter. The token is one more, and it costs
   * nothing extra in exposure: it is written to LiveToken a few activities
   * later regardless.
   */
  query GetOpenF1Token
    sql 'SELECT s.access_token AS accessToken, s.expires_in AS expiresIn
           FROM (SELECT from_json({tokenJson}::JSON,
                 ''{"access_token":"VARCHAR","expires_in":"BIGINT"}'') AS s)'
    parameter tokenJson: string
    returns Formula1Backend.Stg_TokenParsed
    map ( accessToken as AccessToken, expiresIn as ExpiresIn );

  query GetOpenF1CarNow
    sql 'SELECT {sessionKey} AS sessionKey, driver_number AS driverNumber,
                strftime(t, ''%Y-%m-%dT%H:%M:%S'') AS atTime, speed, throttle,
                brake, n_gear AS gear, rpm, drs
           FROM (
             SELECT j.driver_number AS driver_number, CAST(j.date AS TIMESTAMP) AS t,
                    j.speed AS speed, j.throttle AS throttle, j.brake AS brake,
                    j.n_gear AS n_gear, j.rpm AS rpm, j.drs AS drs,
                    row_number() OVER (PARTITION BY j.driver_number,
                                       date_trunc(''second'', CAST(j.date AS TIMESTAMP))
                                       ORDER BY j.date) AS rn
               FROM (SELECT unnest(from_json({carJson}::JSON,
                     ''[{"driver_number":"BIGINT","date":"VARCHAR","speed":"BIGINT","throttle":"BIGINT","brake":"BIGINT","n_gear":"BIGINT","rpm":"BIGINT","drs":"BIGINT"}]'')) AS j)
           ) WHERE rn = 1'
    parameter sessionKey: string
    parameter carJson: string
    returns Formula1Backend.Stg_SyncCarNow
    map ( sessionKey as SessionKey, driverNumber as DriverNumber, atTime as At,
          speed as Speed, throttle as Throttle, brake as Brake, gear as Gear,
          rpm as Rpm, drs as Drs );

  /* Track position, downsampled the same way and for the same reason. */
  query GetOpenF1LocationNow
    sql 'SELECT {sessionKey} AS sessionKey, driver_number AS driverNumber,
                strftime(t, ''%Y-%m-%dT%H:%M:%S'') AS atTime, x, y, z
           FROM (
             SELECT j.driver_number AS driver_number, CAST(j.date AS TIMESTAMP) AS t,
                    j.x AS x, j.y AS y, j.z AS z,
                    row_number() OVER (PARTITION BY j.driver_number,
                                       date_trunc(''second'', CAST(j.date AS TIMESTAMP))
                                       ORDER BY j.date) AS rn
               FROM (SELECT unnest(from_json({locJson}::JSON,
                     ''[{"driver_number":"BIGINT","date":"VARCHAR","x":"DOUBLE","y":"DOUBLE","z":"DOUBLE"}]'')) AS j)
              WHERE NOT (j.x = 0 AND j.y = 0)
           ) WHERE rn = 1'
    parameter sessionKey: string
    parameter locJson: string
    returns Formula1Backend.Stg_SyncLocationNow
    map ( sessionKey as SessionKey, driverNumber as DriverNumber, atTime as At,
          x as X, y as Y, z as Z );

  /* Overtakes and radio: small, and pass straight through. */
  query GetOpenF1Overtakes
    sql 'SELECT {sessionKey} AS sessionKey,
                j.date AS atTime, j.lap_number AS lapNumber,
                j.overtaking_driver_number AS overtaking,
                j.overtaken_driver_number AS overtaken, j.position AS position
           FROM (SELECT unnest(from_json({json}::JSON,
                 ''[{"date":"VARCHAR","lap_number":"BIGINT","overtaking_driver_number":"BIGINT","overtaken_driver_number":"BIGINT","position":"BIGINT"}]'')) AS j)'
    parameter sessionKey: string
    parameter json: string
    returns Formula1Backend.Stg_SyncOvertake
    map ( sessionKey as SessionKey, atTime as At, lapNumber as LapNumber,
          overtaking as OvertakingDriver, overtaken as OvertakenDriver,
          position as Position );

  query GetOpenF1Radio
    sql 'SELECT {sessionKey} AS sessionKey, j.date AS atTime,
                j.driver_number AS driverNumber, j.recording_url AS recordingUrl
           FROM (SELECT unnest(from_json({json}::JSON,
                 ''[{"date":"VARCHAR","driver_number":"BIGINT","recording_url":"VARCHAR"}]'')) AS j)'
    parameter sessionKey: string
    parameter json: string
    returns Formula1Backend.Stg_SyncRadio
    map ( sessionKey as SessionKey, atTime as At, driverNumber as DriverNumber,
          recordingUrl as RecordingUrl );

  /* ------------------------------------------------------------ track map -- */

  /*
   * Pick one representative lap to trace the circuit from.
   *
   * The driver with the most laps, and their median lap by duration -- median
   * rather than fastest because the quickest lap of a race is often a late one
   * on an empty track with a different line, and rather than first because lap
   * one is the only lap that does not start on the start-finish straight.
   *
   * A lap under thirty seconds is a formation or in-lap fragment and is skipped;
   * anything over five minutes is a safety-car crawl that would trace the pit
   * lane as often as the circuit.
   */
  query GetOpenF1LapWindow
    sql 'WITH laps AS (
           SELECT j.driver_number AS driver_number, j.lap_duration AS dur,
                  CAST(j.date_start AS TIMESTAMP) AS t0
             FROM (SELECT unnest(from_json({lapsJson}::JSON,
                   ''[{"driver_number":"BIGINT","lap_number":"BIGINT","lap_duration":"DOUBLE","date_start":"VARCHAR"}]'')) AS j)
            WHERE j.date_start IS NOT NULL AND j.lap_duration IS NOT NULL
              AND j.lap_duration BETWEEN 30 AND 300
         ), busiest AS (
           SELECT driver_number FROM laps
            GROUP BY driver_number ORDER BY count(*) DESC LIMIT 1
         ), ranked AS (
           /* Integer division. DuckDB''s / is float division, so (n+1)/2 over
            * seventy laps is 35.5 and rn never equals it -- the query returned
            * no window at all and the outline came back empty. // is the
            * integer one. */
           SELECT l.driver_number, l.dur, l.t0,
                  row_number() OVER (ORDER BY l.dur) AS rn,
                  count(*) OVER () AS n
             FROM laps l JOIN busiest b ON b.driver_number = l.driver_number
         )
         SELECT driver_number AS driverNumber,
                strftime(t0, ''%Y-%m-%dT%H:%M:%S'') AS fromTs,
                strftime(t0 + INTERVAL (CAST(dur AS INTEGER) + 2) SECOND,
                         ''%Y-%m-%dT%H:%M:%S'') AS toTs
           FROM ranked WHERE rn = (n + 1) // 2'
    parameter lapsJson: string
    returns Formula1Backend.Stg_SyncLapWindow
    map ( driverNumber as DriverNumber, fromTs as FromTs, toTs as ToTs );

  /*
   * The circuit, traced from one car's way round it.
   *
   * Not downsampled: this runs once per session and the shape is the whole
   * point, so every sample the lap produced is kept. At roughly 3.7 Hz a
   * Hungaroring lap is about three hundred points, which is a smooth outline
   * and a small table.
   */
  query GetOpenF1TrackOutline
    sql 'SELECT {sessionKey} AS sessionKey,
                row_number() OVER (ORDER BY j.date) - 1 AS seq,
                j.x AS x, j.y AS y
           FROM (SELECT unnest(from_json({locJson}::JSON,
                 ''[{"date":"VARCHAR","x":"DOUBLE","y":"DOUBLE"}]'')) AS j)
          WHERE j.x IS NOT NULL AND j.y IS NOT NULL
            AND NOT (j.x = 0 AND j.y = 0)'
    parameter sessionKey: string
    parameter locJson: string
    returns Formula1Backend.Stg_SyncTrackPoint
    map ( sessionKey as SessionKey, seq as Seq, x as X, y as Y );

end;
