CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveStints (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveStint AS $Rows
BEGIN
  /* One parse of the request; the query binds what comes back. */
  DECLARE $Cols String = 'stintKey:stintKey:text,sessionKey:sessionKey:text,'
    + 'driverNumber:driverNumber:number,code:code:text,'
    + 'stintNumber:stintNumber:number,compound:compound:text,'
    + 'lapStart:lapStart:number,lapEnd:lapEnd:number,'
    + 'tyreAgeAtStart:tyreAgeAtStart:number';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'stintKey', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveStints
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveStints
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_TrackOutline (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.LiveTrackOutline AS $Rows
BEGIN
  RETRIEVE $Rows FROM Formula1Backend.LiveTrackOutline SORT BY Seq ASC;
  IF $Response != empty THEN
    $Total = COUNT($Rows);
    CHANGE $Response (Count = $Total);
  END IF;
  RETURN $Rows;
END;

/*
 * Where each car is now: the newest location sample per driver.
 *
 * The rolling window holds three minutes at one sample a second, so "now" is
 * the last row per driver rather than the whole table -- twenty rows out of
 * four thousand.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_CarPositions (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.LiveLocationNow AS $Rows
BEGIN
  RETRIEVE $All FROM Formula1Backend.LiveLocationNow SORT BY At DESC;
  $Rows = CREATE LIST OF Formula1Backend.LiveLocationNow;
  DECLARE $Seen String = '|';
  LOOP $L IN $All BEGIN
    IF contains($Seen, '|' + toString($L/DriverNumber) + '|') = false THEN
      SET $Seen = $Seen + toString($L/DriverNumber) + '|';
      ADD $L TO $Rows;
    END IF;
  END LOOP;
  IF $Response != empty THEN
    $Total = COUNT($Rows);
    CHANGE $Response (Count = $Total);
  END IF;
  RETURN $Rows;
END;

create or modify odata service Formula1Backend.F1LiveNowApi (
  path: 'odata/f1-now/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Formula1Backend.Now'
)
authentication microflow Formula1Backend.AuthenticateApiClient
{
  publish entity Formula1Backend.Stg_LiveEntry as 'Order' (
    ReadMode: microflow Formula1Backend.Read_LiveOrder,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    EntryKey as 'entryKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    Code as 'code' (Filterable, Sortable),
    DriverName as 'driverName' (Filterable, Sortable),
    Team as 'team' (Filterable, Sortable),
    TeamColour as 'teamColour' (Filterable, Sortable),
    Position as 'position' (Filterable, Sortable),
    GapToLeader as 'gapToLeader' (Filterable, Sortable),
    Interval as 'interval' (Filterable, Sortable),
    LapNumber as 'lapNumber' (Filterable, Sortable),
    LastLapSeconds as 'lastLapSeconds' (Filterable, Sortable),
    Sector1 as 'sector1' (Filterable, Sortable),
    Sector2 as 'sector2' (Filterable, Sortable),
    Sector3 as 'sector3' (Filterable, Sortable),
    SpeedTrap as 'speedTrap' (Filterable, Sortable),
    Compound as 'compound' (Filterable, Sortable),
    TyreAge as 'tyreAge' (Filterable, Sortable),
    PitStops as 'pitStops' (Filterable, Sortable),
    Drs as 'drs' (Filterable, Sortable),
    Sector1Mark as 'sector1Mark' (Filterable, Sortable),
    Sector2Mark as 'sector2Mark' (Filterable, Sortable),
    Sector3Mark as 'sector3Mark' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_LiveMessage as 'Messages' (
    ReadMode: microflow Formula1Backend.Read_LiveMessages,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    MessageKey as 'messageKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    At as 'at' (Filterable, Sortable),
    Category as 'category' (Filterable, Sortable),
    Flag as 'flag' (Filterable, Sortable),
    Scope as 'scope' (Filterable, Sortable),
    Lap as 'lap' (Filterable, Sortable),
    Message as 'message' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_LiveSession as 'Session' (
    ReadMode: microflow Formula1Backend.Read_LiveSession,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    SessionKey as 'sessionKey' (KEY, Filterable, Sortable),
    SessionName as 'sessionName' (Filterable, Sortable),
    SessionType as 'sessionType' (Filterable, Sortable),
    Location as 'location' (Filterable, Sortable),
    CountryName as 'countryName' (Filterable, Sortable),
    CircuitName as 'circuitName' (Filterable, Sortable),
    DateStart as 'dateStart' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    DriverCount as 'driverCount' (Filterable, Sortable),
    LeadLap as 'leadLap' (Filterable, Sortable),
    FetchedAt as 'fetchedAt' (Filterable, Sortable),
    AirTemperature as 'airTemperature' (Filterable, Sortable),
    TrackTemperature as 'trackTemperature' (Filterable, Sortable),
    Humidity as 'humidity' (Filterable, Sortable),
    Rainfall as 'rainfall' (Filterable, Sortable),
    WindSpeed as 'windSpeed' (Filterable, Sortable)
  );

  /*
   * The history behind the other three. A page drawing a gap chart asks for
   * the whole session at once and shapes it client-side, so this resource is
   * filterable on lapNumber and code but does no aggregating of its own.
   */
  publish entity Formula1Backend.Stg_LiveTrace as 'Trace' (
    ReadMode: microflow Formula1Backend.Read_LiveTrace,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    TraceKey as 'traceKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    Code as 'code' (Filterable, Sortable),
    LapNumber as 'lapNumber' (Filterable, Sortable),
    Position as 'position' (Filterable, Sortable),
    GapToLeader as 'gapToLeader' (Filterable, Sortable),
    GapSeconds as 'gapSeconds' (Filterable, Sortable),
    LapSeconds as 'lapSeconds' (Filterable, Sortable)
  );

  /*
   * The circuit, traced from one car's lap, and where every car is on it now.
   *
   * Both are in OpenF1's track-local frame rather than in degrees, which is
   * what lets a page draw a dot on the line without projecting anything: the
   * outline and the cars came from the same feed in the same units.
   */
  publish entity Formula1Backend.LiveTrackOutline as 'TrackOutline' (
    ReadMode: microflow Formula1Backend.Read_TrackOutline,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    PointKey as 'pointKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    Seq as 'seq' (Filterable, Sortable),
    X as 'x' (Filterable, Sortable),
    Y as 'y' (Filterable, Sortable)
  );

  publish entity Formula1Backend.LiveLocationNow as 'CarPositions' (
    ReadMode: microflow Formula1Backend.Read_CarPositions,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    SampleKey as 'sampleKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    At as 'at' (Filterable, Sortable),
    X as 'x' (Filterable, Sortable),
    Y as 'y' (Filterable, Sortable)
  );

  /* Every stint of every car. LapEnd is empty for the one still running. */
  publish entity Formula1Backend.Stg_LiveStint as 'Stints' (
    ReadMode: microflow Formula1Backend.Read_LiveStints,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    StintKey as 'stintKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    Code as 'code' (Filterable, Sortable),
    StintNumber as 'stintNumber' (Filterable, Sortable),
    Compound as 'compound' (Filterable, Sortable),
    LapStart as 'lapStart' (Filterable, Sortable),
    LapEnd as 'lapEnd' (Filterable, Sortable),
    TyreAgeAtStart as 'tyreAgeAtStart' (Filterable, Sortable)
  );
};

/* A read microflow a published service calls needs its own role, and the
 * service grants have to follow the declaration — a modify drops them. §26. */
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveOrder TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveMessages TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveSession TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveOrder TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveMessages TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveSession TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveTrace TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveTrace TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveStints TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveStints TO Formula1Backend.DataAdmin;
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1LiveNowApi TO Formula1Backend.ApiUser;
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1LiveNowApi TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TrackOutline TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TrackOutline TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_CarPositions TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_CarPositions TO Formula1Backend.DataAdmin;
