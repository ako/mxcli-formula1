    + 'dateStart:dateStart:text,year:year:number,'
    + 'driverCount:driverCount:number,leadLap:leadLap:number,'
    + 'fetchedAt:fetchedAt:text,airTemperature:airTemperature:number,'
    + 'trackTemperature:trackTemperature:number,'
    + 'humidity:humidity:number,rainfall:rainfall:number,'
    + 'windSpeed:windSpeed:number';
