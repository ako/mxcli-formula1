/*
 * Service 4 of 4 — F1LiveNowApi: near-live timing from OpenF1.
 *
 * Its own service rather than more resources on F1FanApi, and not only to keep
 * the modify small: this data has a different source (openf1.org, unofficial),
 * a different licence, and a different freshness contract. Everything else in
 * this app is a file that changes when someone publishes a release. This is a
 * snapshot of a session that was moving when it was taken, and the page says
 * when it was taken.
 *
 * scripts/fetch-f1-live.sh writes data/live/. Re-run it to refresh; on a race
 * Sunday, run it on a timer with SESSION=latest.
 *
 * No `$filter` plumbing here: a snapshot is one session, so each resource
 * returns the file. The session key travels as data so the page can show which
 * session it is looking at.
 *
 * All five reads call ODataPushdown.Parse once and hand the answer to their
 * query — the module's bind style, the same as 02. See the header there for
 * what `Columns`, the types and `RejectUnsupported` are doing.
 *
 * Three of the five are the snapshot: Order, Messages, Session. The other two
 * are the history it was taken from — Trace, one row per driver per lap, and
 * Stints, every set of tyres rather than only the one running. They are what
 * turn a table of standings into a chart of how the race got there.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveOrder (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveEntry AS $Rows
BEGIN
  /* One parse of the request; the query binds what comes back. */
  DECLARE $Cols String = 'entryKey:entryKey:text,sessionKey:sessionKey:text,'
    + 'driverNumber:driverNumber:number,code:code:text,'
    + 'driverName:driverName:text,team:team:text,'
    + 'teamColour:teamColour:text,position:position:number,'
    + 'gapToLeader:gapToLeader:text,interval:interval:text,'
    + 'lapNumber:lapNumber:number,'
    + 'lastLapSeconds:lastLapSeconds:number,sector1:sector1:number,'
    + 'sector2:sector2:number,sector3:sector3:number,'
    + 'speedTrap:speedTrap:number,compound:compound:text,'
    + 'tyreAge:tyreAge:number,pitStops:pitStops:number,'
    + 'drs:drs:text,sector1Mark:sector1Mark:text,'
    + 'sector2Mark:sector2Mark:text,sector3Mark:sector3Mark:text';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'entryKey', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveOrder
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveOrder
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveMessages (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveMessage AS $Rows
BEGIN
  /* One parse of the request; the query binds what comes back. */
  DECLARE $Cols String = 'messageKey:messageKey:text,sessionKey:sessionKey:text,'
    + 'at:at:text,category:category:text,flag:flag:text,'
    + 'scope:scope:text,lap:lap:number,message:message:text';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'messageKey', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveMessages
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveMessages
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

