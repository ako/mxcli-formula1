/*
 * Service 4 of 4 — F1LiveNowApi: near-live timing from OpenF1.
 *
 * Its own service rather than more resources on F1FanApi, and not only to keep
 * the modify small: this data has a different source (openf1.org, unofficial),
 * a different licence, and a different freshness contract. Everything else in
 * this app is a file that changes when someone publishes a release. This is a
 * snapshot of a session that was moving when it was taken, and the page says
 * when it was taken.
 *
 * scripts/fetch-f1-live.sh writes data/live/. Re-run it to refresh; on a race
 * Sunday, run it on a timer with SESSION=latest.
 *
 * No `$filter` plumbing here: a snapshot is one session, so each resource
 * returns the file. The session key travels as data so the page can show which
 * session it is looking at.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveOrder (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveEntry AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'entryKey');

  /*
   * The page. Mendix applies no query options to a read microflow, so $top and
   * $skip are only a page if this asks for them — and the fallback is the whole
   * list, because that is what this resource returned before it could page.
   */
  $Top = CALL JAVA ACTION Formula1Backend.ODataTop(
    Uri = $Request/Uri, Fallback = 1000000, MaxTop = 1000000);
  $Skip = CALL JAVA ACTION Formula1Backend.ODataSkip(Uri = $Request/Uri);

  /*
   * The sort. The query orders by a CASE over these same names, so this list is
   * the only thing that decides what a client can sort by — an unknown name
   * sorts by nothing and the query's own order stands.
   */
  DECLARE $Sortable String = 'entryKey:entryKey,sessionKey:sessionKey,driverNumber:driverNumber,'
    + 'code:code,driverName:driverName,team:team,teamColour:teamColour,'
    + 'position:position,gapToLeader:gapToLeader,interval:interval,'
    + 'lapNumber:lapNumber,lastLapSeconds:lastLapSeconds,sector1:sector1,'
    + 'sector2:sector2,sector3:sector3,speedTrap:speedTrap,compound:compound,'
    + 'tyreAge:tyreAge,pitStops:pitStops';
  $SortCol = CALL JAVA ACTION Formula1Backend.ODataSortColumn(
    Uri = $Request/Uri, ColumnMap = $Sortable);
  $SortDir = CALL JAVA ACTION Formula1Backend.ODataSortDirection(Uri = $Request/Uri);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveOrder
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
     topN = toString($Top), skipN = toString($Skip),
     sortCol = $SortCol, sortDir = $SortDir);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  $WantsCount = CALL JAVA ACTION Formula1Backend.ODataWantsCount(Uri = $Request/Uri);
  IF $WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveOrder
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveMessages (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveMessage AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'messageKey');

  /*
   * The page. Mendix applies no query options to a read microflow, so $top and
   * $skip are only a page if this asks for them — and the fallback is the whole
   * list, because that is what this resource returned before it could page.
   */
  $Top = CALL JAVA ACTION Formula1Backend.ODataTop(
    Uri = $Request/Uri, Fallback = 1000000, MaxTop = 1000000);
  $Skip = CALL JAVA ACTION Formula1Backend.ODataSkip(Uri = $Request/Uri);

  /*
   * The sort. The query orders by a CASE over these same names, so this list is
   * the only thing that decides what a client can sort by — an unknown name
   * sorts by nothing and the query's own order stands.
   */
  DECLARE $Sortable String = 'messageKey:messageKey,sessionKey:sessionKey,at:at,category:category,'
    + 'flag:flag,scope:scope,lap:lap,message:message';
  $SortCol = CALL JAVA ACTION Formula1Backend.ODataSortColumn(
    Uri = $Request/Uri, ColumnMap = $Sortable);
  $SortDir = CALL JAVA ACTION Formula1Backend.ODataSortDirection(Uri = $Request/Uri);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveMessages
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
     topN = toString($Top), skipN = toString($Skip),
     sortCol = $SortCol, sortDir = $SortDir);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  $WantsCount = CALL JAVA ACTION Formula1Backend.ODataWantsCount(Uri = $Request/Uri);
  IF $WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveMessages
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_LiveSession (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_LiveSession AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'sessionKey');

  /*
   * The page. Mendix applies no query options to a read microflow, so $top and
   * $skip are only a page if this asks for them — and the fallback is the whole
   * list, because that is what this resource returned before it could page.
   */
  $Top = CALL JAVA ACTION Formula1Backend.ODataTop(
    Uri = $Request/Uri, Fallback = 1000000, MaxTop = 1000000);
  $Skip = CALL JAVA ACTION Formula1Backend.ODataSkip(Uri = $Request/Uri);

  /*
   * The sort. The query orders by a CASE over these same names, so this list is
   * the only thing that decides what a client can sort by — an unknown name
   * sorts by nothing and the query's own order stands.
   */
  DECLARE $Sortable String = 'sessionKey:sessionKey,sessionName:sessionName,sessionType:sessionType,'
    + 'location:location,countryName:countryName,circuitName:circuitName,'
    + 'dateStart:dateStart,year:year,driverCount:driverCount,leadLap:leadLap,'
    + 'fetchedAt:fetchedAt,airTemperature:airTemperature,'
    + 'trackTemperature:trackTemperature,humidity:humidity,rainfall:rainfall,'
    + 'windSpeed:windSpeed';
  $SortCol = CALL JAVA ACTION Formula1Backend.ODataSortColumn(
    Uri = $Request/Uri, ColumnMap = $Sortable);
  $SortDir = CALL JAVA ACTION Formula1Backend.ODataSortDirection(Uri = $Request/Uri);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetLiveSession
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
     topN = toString($Top), skipN = toString($Skip),
     sortCol = $SortCol, sortDir = $SortDir);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  $WantsCount = CALL JAVA ACTION Formula1Backend.ODataWantsCount(Uri = $Request/Uri);
  IF $WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetLiveSession
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

create or modify odata service Formula1Backend.F1LiveNowApi (
  path: 'odata/f1-now/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Formula1Backend.Now'
)
authentication basic, session
{
  publish entity Formula1Backend.Stg_LiveEntry as 'Order' (
    ReadMode: microflow Formula1Backend.Read_LiveOrder,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    EntryKey as 'entryKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    Code as 'code' (Filterable, Sortable),
    DriverName as 'driverName' (Filterable, Sortable),
    Team as 'team' (Filterable, Sortable),
    TeamColour as 'teamColour' (Filterable, Sortable),
    Position as 'position' (Filterable, Sortable),
    GapToLeader as 'gapToLeader' (Filterable, Sortable),
    Interval as 'interval' (Filterable, Sortable),
    LapNumber as 'lapNumber' (Filterable, Sortable),
    LastLapSeconds as 'lastLapSeconds' (Filterable, Sortable),
    Sector1 as 'sector1' (Filterable, Sortable),
    Sector2 as 'sector2' (Filterable, Sortable),
    Sector3 as 'sector3' (Filterable, Sortable),
    SpeedTrap as 'speedTrap' (Filterable, Sortable),
    Compound as 'compound' (Filterable, Sortable),
    TyreAge as 'tyreAge' (Filterable, Sortable),
    PitStops as 'pitStops' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_LiveMessage as 'Messages' (
    ReadMode: microflow Formula1Backend.Read_LiveMessages,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    MessageKey as 'messageKey' (KEY, Filterable, Sortable),
    SessionKey as 'sessionKey' (Filterable, Sortable),
    At as 'at' (Filterable, Sortable),
    Category as 'category' (Filterable, Sortable),
    Flag as 'flag' (Filterable, Sortable),
    Scope as 'scope' (Filterable, Sortable),
    Lap as 'lap' (Filterable, Sortable),
    Message as 'message' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_LiveSession as 'Session' (
    ReadMode: microflow Formula1Backend.Read_LiveSession,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    SessionKey as 'sessionKey' (KEY, Filterable, Sortable),
    SessionName as 'sessionName' (Filterable, Sortable),
    SessionType as 'sessionType' (Filterable, Sortable),
    Location as 'location' (Filterable, Sortable),
    CountryName as 'countryName' (Filterable, Sortable),
    CircuitName as 'circuitName' (Filterable, Sortable),
    DateStart as 'dateStart' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    DriverCount as 'driverCount' (Filterable, Sortable),
    LeadLap as 'leadLap' (Filterable, Sortable),
    FetchedAt as 'fetchedAt' (Filterable, Sortable),
    AirTemperature as 'airTemperature' (Filterable, Sortable),
    TrackTemperature as 'trackTemperature' (Filterable, Sortable),
    Humidity as 'humidity' (Filterable, Sortable),
    Rainfall as 'rainfall' (Filterable, Sortable),
    WindSpeed as 'windSpeed' (Filterable, Sortable)
  );
};

/* A read microflow a published service calls needs its own role, and the
 * service grants have to follow the declaration — a modify drops them. §26. */
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveOrder TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveMessages TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveSession TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveOrder TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveMessages TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_LiveSession TO Formula1Backend.DataAdmin;
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1LiveNowApi TO Formula1Backend.ApiUser;
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1LiveNowApi TO Formula1Backend.DataAdmin;
