mdl 1;
/*
 * Backend security.
 *
 * The whole solution is read-only over a historical dataset, so there is one
 * consumer role with read rights and nothing else, plus an admin who can
 * trigger the refresh. The frontend authenticates as the consumer.
 */

alter app security ( SecurityLevel: prototype );

create or modify module role Formula1Backend.ApiUser
  description 'Read the published OData services. Nothing else. This is who Formula1Frontend logs in as.';

create or modify module role Formula1Backend.DataAdmin
  description 'Read everything, and run ACT_RefreshAll to reload the cached service from the CSVs.';

/* Cached-service entities: both roles read, only the admin can do anything else
 * — and there is nothing else, because every resource is published read-only. */
grant READ * on entity Formula1Backend.Season to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Circuit to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Constructor to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Driver to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Race to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.RaceResult to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.DriverStanding to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.ConstructorStanding to Formula1Backend.ApiUser;

grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.Season to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.Circuit to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.Constructor to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.Driver to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.Race to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.RaceResult to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.DriverStanding to Formula1Backend.DataAdmin;
grant CREATE, DELETE, READ *, WRITE * on entity Formula1Backend.ConstructorStanding to Formula1Backend.DataAdmin;

/* Live-service row shapes. Non-persistable entities still need read rights for
 * the OData layer to serialise them. */
grant READ * on entity Formula1Backend.Stg_Season to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_Circuit to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_Constructor to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_Driver to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_Race to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_RaceResult to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_DriverStanding to Formula1Backend.ApiUser;
grant READ * on entity Formula1Backend.Stg_ConstructorStanding to Formula1Backend.ApiUser;

grant READ * on entity Formula1Backend.Stg_Season to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_Circuit to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_Constructor to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_Driver to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_Race to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_RaceResult to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_DriverStanding to Formula1Backend.DataAdmin;
grant READ * on entity Formula1Backend.Stg_ConstructorStanding to Formula1Backend.DataAdmin;

/* The read microflows are what the live service invokes, so the consumer must
 * be allowed to execute them. Only the admin may kick off a reload. */
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Seasons TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Circuits TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Constructors TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Drivers TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Races TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_RaceResults TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverStandings TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_ConstructorStandings TO Formula1Backend.ApiUser;

GRANT EXECUTE ON MICROFLOW Formula1Backend.ACT_RefreshAll TO Formula1Backend.DataAdmin;

grant access on published odata service Formula1Backend.F1LiveApi to Formula1Backend.ApiUser;
grant access on published odata service Formula1Backend.F1CachedApi to Formula1Backend.ApiUser;

-- Every user role needs a System module role; System.User is the base one.
create or modify user role ApiConsumer ( ModuleRoles: (Formula1Backend.ApiUser, System.User) );
alter user role Administrator add module roles (Formula1Backend.DataAdmin);
