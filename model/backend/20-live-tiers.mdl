/*
 * Tiered retrieval, watermarks, and the telemetry split.
 * =====================================================
 *
 * 19 fetches five endpoints and rebuilds the lap table. This adds the rest of
 * the session and the budget to pay for it.
 *
 * ------------------------------------------------------------- the budget --
 *
 * An authenticated account allows 60 requests a minute -- one a second
 * sustained, with six a second of burst. A race is about ninety minutes, so
 * roughly 5400 requests to spend.
 *
 * Three things make that comfortable rather than tight:
 *
 *   Never filter by driver_number. `car_data?session_key=X&date>=T` returns all
 *   twenty cars in one request; asking per driver costs twenty requests for the
 *   same rows.
 *
 *   Every endpoint takes a `date>=` filter, so each poll asks only for what is
 *   new. Polling faster therefore buys *latency*, not completeness -- the same
 *   rows arrive either way, just sooner. Replay is complete at any affordable
 *   rate; freshness is a separate, tunable spend.
 *
 *   Mendix schedules no finer than a minute, which would cap latency at sixty
 *   seconds if the event were a tick. It is a worker instead: it fires every
 *   minute and loops inside for most of that minute, so a ten-second cycle runs
 *   under a one-minute scheduler.
 *
 * What that buys, per minute:
 *
 *   tier A  every 10s   intervals, position, race_control          18
 *   tier B  every 20s   laps, car_data, location                    9
 *   tier C  every 60s   stints, pit, weather, team_radio, overtakes 5
 *   tier D  once        drivers, session                            -
 *                                                                 ---
 *                                                                  32
 *
 * leaving nearly half the allowance for retries, the hourly token, and the
 * burst a slow cycle causes.
 *
 * ---------------------------------------------------------- the real cost --
 *
 * The request budget is not the scarce thing. Measured against session 11342,
 * every endpoint except two is under five megabytes for a whole race. car_data
 * and location are about a hundred and forty between them, and at full rate
 * they are some eight thousand eight hundred rows a minute -- around eight
 * hundred thousand rows per race. That is a database problem, not an API one.
 *
 * So telemetry is not stored as it arrives. It becomes two products:
 *
 *   a rolling window of the last minute, which is what a track map and a speed
 *   trace read, pruned every cycle so it stays a few thousand rows;
 *
 *   per-lap aggregates -- top speed, average throttle, share of the lap with
 *   DRS open, highest gear -- computed in DuckDB as the rows arrive, so the app
 *   never holds five thousand samples to find one maximum. Twenty-two rows a
 *   lap instead of five thousand, and that is what makes telemetry replayable.
 *
 * Everything else is stored in full: a few thousand rows a race, and it is the
 * part a replay is actually about.
 */

/* --------------------------------------------------------- the watermark -- */

/*
 * How far each endpoint has been read.
 *
 * One row per session per endpoint, holding the timestamp of the newest sample
 * seen. The next poll asks for `date>=` that, so nothing is fetched twice and
 * nothing is missed.
 *
 * The window deliberately overlaps: a poll asks from the watermark minus a
 * minute, not from the watermark. The lap derivation joins each lap to the
 * newest position sample at or before it ended, and a lap that ended just after
 * the last watermark would otherwise have no sample to join to -- the overlap
 * costs a few duplicate rows, which the promote step discards anyway, and buys
 * a derivation that cannot fall through a boundary.
 */
create or modify persistent entity Formula1Backend.LiveWatermark (
  SessionKey: string(20),
  Endpoint: string(40),
  LastSeen: string(40),
  LastRunAt: datetime,
  RowsLastRun: long
) index (SessionKey, Endpoint);

/* ------------------------------------------------------- the story, cont -- */

/* Who passed whom, and on which lap. Small, and the single most replay-worthy
 * thing OpenF1 publishes after the lap table itself. */
create or modify persistent entity Formula1Backend.LiveOvertake (
  SessionKey: string(20),
  At: string(40),
  LapNumber: long,
  OvertakingDriver: long,
  OvertakenDriver: long,
  Position: long
) index (SessionKey, At);

/* Team radio. A URL to an audio clip rather than the audio, which is what makes
 * it cheap to keep. */
create or modify persistent entity Formula1Backend.LiveRadio (
  SessionKey: string(20),
  At: string(40),
  DriverNumber: long,
  RecordingUrl: string(500)
) index (SessionKey, At);

/* ---------------------------------------------------------- the telemetry -- */

/*
 * One row per driver per lap, standing in for roughly five thousand samples.
 *
 * DrsOpenShare is the fraction of the lap's samples with the flap open. OpenF1
 * encodes DRS as a small integer whose values mean different things -- 8 is
 * "eligible", 10, 12 and 14 are "open" -- so the arithmetic happens in SQL
 * where the encoding is written down once, rather than on a page.
 */
create or modify persistent entity Formula1Backend.LiveLapTelemetry (
  SessionKey: string(20),
  DriverNumber: long,
  LapNumber: long,
  TopSpeed: long,
  AvgThrottle: decimal,
  MaxGear: long,
  DrsOpenShare: decimal,
  BrakeShare: decimal,
  MaxRpm: long,
  Samples: long
) index (SessionKey, DriverNumber, LapNumber);

/*
 * The last minute of telemetry, and nothing older.
 *
 * This is what a track map and a live speed trace read. It is pruned every
 * cycle by a single OQL delete, so it stays in the low thousands of rows
 * whatever the length of the race -- the one table here that is a window rather
 * than a record.
 */
create or modify persistent entity Formula1Backend.LiveCarNow (
  SessionKey: string(20),
  DriverNumber: long,
  At: string(40),
  Speed: long,
  Throttle: long,
  Brake: long,
  Gear: long,
  Rpm: long,
  Drs: long
) index (SessionKey, At);

create or modify persistent entity Formula1Backend.LiveLocationNow (
  /* Keyed for publication: one car, one second. Unique because the key of a
   * published entity has to be, and because the downsample guarantees it. */
  SampleKey: string(60) unique error 'Location sample key must be unique',
  SessionKey: string(20),
  DriverNumber: long,
  At: string(40),
  X: decimal,
  Y: decimal,
  Z: decimal
) index (SessionKey, At);

/* ------------------------------------------------------------ the worker -- */

/*
 * Wait, so that a scheduled event can be a worker rather than a tick.
 *
 * Mendix schedules no finer than a minute. A cycle that wants to run every ten
 * seconds therefore cannot be a schedule -- it has to be a loop inside one, and
 * a loop that polls an API needs to pause between passes. There is no activity
 * for that, so this is the smallest possible Java action.
 *
 * Capped at sixty seconds. An unbounded sleep inside a scheduled event is a way
 * to occupy a runtime thread indefinitely, and the cap makes that a typo rather
 * than an outage.
 */
create or replace java action Formula1Backend.Sync_Sleep (
  Seconds: Integer NOT NULL
) RETURNS Boolean
AS $$
    long s = Seconds == null ? 0L : Seconds.longValue();
    if (s < 0) s = 0;
    if (s > 60) s = 60;
    try {
        Thread.sleep(s * 1000L);
        return true;
    } catch (InterruptedException e) {
        Thread.currentThread().interrupt();
        return false;
    }
$$;

/* ----------------------------------------------------------- the telemetry -- */

/*
 * car_data and location: the two endpoints that cannot be stored as they
 * arrive.
 *
 * Both are fetched for a window ending now and starting a couple of minutes
 * back, which is long enough that every lap completed since the last cycle
 * falls entirely inside it -- the aggregate query only emits laps it fully
 * covers, so a short window would silently skip laps rather than get them
 * wrong.
 *
 * Two products come out. Per-lap aggregates are kept for good: twenty-two rows
 * a lap instead of five thousand. The rolling window is kept for a minute and
 * then deleted, because that is all a track map reads.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_Telemetry (
  $Key: String,
  $Token: String
)
  RETURNS String AS $Result
BEGIN
  DECLARE $Result String = '';

  /*
   * The window follows the session's clock when there is one.
   *
   * A live race and the wall clock agree, so "the last three minutes" is right
   * and the cursor stays empty. A finished race does not agree at all -- three
   * minutes ago is a month after the flag -- so backfilling one means walking a
   * cursor forward through it. car_data and location answer 404 rather than
   * with an empty list when a window holds nothing, which the fetch treats as
   * no rows, so running off the end of a session is harmless.
   */
  $St = CALL MICROFLOW Formula1Backend.Sync_State();
  DECLARE $Window String = formatDateTimeUTC(
    addMinutes([%CurrentDateTime%], -3), 'yyyy-MM-dd''T''HH:mm:ss');
  IF $St/TelemetryCursor != empty THEN
    SET $Window = formatDateTimeUTC($St/TelemetryCursor, 'yyyy-MM-dd''T''HH:mm:ss');
  END IF;

  /*
   * Bounded at both ends.
   *
   * `date>=` alone is a lower bound, and a lower bound on a finished session
   * means "everything from here to the flag" -- a cursor three minutes into the
   * race pulled twenty-five minutes of telemetry and the rolling window came
   * back with twenty-six thousand rows instead of three thousand. Live, the two
   * spellings look identical, because there is nothing after "now" to fetch;
   * the difference only shows on a backfill, which is exactly where it is
   * hardest to notice.
   */
  DECLARE $Until String = formatDateTimeUTC(
    [%CurrentDateTime%], 'yyyy-MM-dd''T''HH:mm:ss');
  IF $St/TelemetryCursor != empty THEN
    SET $Until = formatDateTimeUTC(
      addMinutes($St/TelemetryCursor, 3), 'yyyy-MM-dd''T''HH:mm:ss');
  END IF;
  DECLARE $Range String = '&date%3E=' + $Window + '&date%3C=' + $Until;

  $CarJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'car_data?session_key=' + $Key + $Range, Token = $Token);
  $LocJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'location?session_key=' + $Key + $Range, Token = $Token);
  $LapsJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'laps?session_key=' + $Key, Token = $Token);

  /* Per-lap aggregates. Recomputing a lap is idempotent, so the old row is
   * removed and the new one written rather than reconciled field by field. */
  $Agg = execute database query Formula1Backend.F1Warehouse.GetOpenF1Telemetry
    (sessionKey = $Key, carJson = $CarJson, lapsJson = $LapsJson,
     fromTs = $Window);

  DECLARE $Laps Long = 0;
  LOOP $A IN $Agg BEGIN
    $Gone = CALL JAVA ACTION Formula1Backend.OQL_ExecuteWith(
      Statement = 'delete from Formula1Backend.LiveLapTelemetry'
        + ' where SessionKey = $k and DriverNumber = $d and LapNumber = $l',
      Name1 = 'k', Value1 = $A/SessionKey, Type1 = 'String',
      Name2 = 'd', Value2 = toString($A/DriverNumber), Type2 = 'Integer',
      Name3 = 'l', Value3 = toString($A/LapNumber), Type3 = 'Integer');
    $Kept = CREATE Formula1Backend.LiveLapTelemetry (
      SessionKey = $A/SessionKey, DriverNumber = $A/DriverNumber,
      LapNumber = $A/LapNumber, TopSpeed = $A/TopSpeed,
      AvgThrottle = $A/AvgThrottle, MaxGear = $A/MaxGear,
      DrsOpenShare = $A/DrsOpenShare, BrakeShare = $A/BrakeShare,
      MaxRpm = $A/MaxRpm, Samples = $A/Samples) COMMIT;
    SET $Laps = $Laps + 1;
  END LOOP;

  /*
   * The rolling window. Cleared and refilled rather than appended to, because
   * "the last minute" is a shape, not a history -- and one delete is cheaper
   * than working out which rows aged out.
   */
  $ClearedCar = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'delete from Formula1Backend.LiveCarNow');
  $CarRows = execute database query Formula1Backend.F1Warehouse.GetOpenF1CarNow
    (sessionKey = $Key, carJson = $CarJson);
  DECLARE $Cars Long = 0;
  LOOP $C IN $CarRows BEGIN
    $NewCar = CREATE Formula1Backend.LiveCarNow (
      SessionKey = $C/SessionKey, DriverNumber = $C/DriverNumber, At = $C/At,
      Speed = $C/Speed, Throttle = $C/Throttle, Brake = $C/Brake,
      Gear = $C/Gear, Rpm = $C/Rpm, Drs = $C/Drs) COMMIT;
    SET $Cars = $Cars + 1;
  END LOOP;

  $ClearedLoc = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'delete from Formula1Backend.LiveLocationNow');
  $LocRows = execute database query Formula1Backend.F1Warehouse.GetOpenF1LocationNow
    (sessionKey = $Key, locJson = $LocJson);
  DECLARE $Locs Long = 0;
  LOOP $L IN $LocRows BEGIN
    $NewLoc = CREATE Formula1Backend.LiveLocationNow (
      SampleKey = $L/SessionKey + '-' + toString($L/DriverNumber) + '-' + $L/At,
      SessionKey = $L/SessionKey, DriverNumber = $L/DriverNumber, At = $L/At,
      X = $L/X, Y = $L/Y, Z = $L/Z) COMMIT;
    SET $Locs = $Locs + 1;
  END LOOP;

  /* Advance the cursor only when it is being used, and only by the window it
   * just covered, so a backfill walks rather than jumps. */
  IF $St/TelemetryCursor != empty THEN
    CHANGE $St (TelemetryCursor = addMinutes($St/TelemetryCursor, 3)) COMMIT;
  END IF;

  SET $Result = 'telemetry: ' + toString($Laps) + ' lap rows, '
    + toString($Cars) + ' car, ' + toString($Locs) + ' location, from ' + $Window;
  LOG INFO NODE 'F1LiveSync' $Result;
  RETURN $Result;
END;

/* ----------------------------------------------------------- the slow tier -- */

/*
 * Once a minute: the things that change on an event rather than continuously.
 *
 * Overtakes and radio are append-only and matched on their timestamp, which is
 * unique enough per driver to serve as a key. Both are small enough that
 * re-fetching the session and inserting only what is missing costs less than
 * tracking a watermark for them.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_Slow (
  $Key: String,
  $Token: String
)
  RETURNS String AS $Result
BEGIN
  DECLARE $Result String = '';

  $OvJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'overtakes?session_key=' + $Key, Token = $Token);
  $OvRows = execute database query Formula1Backend.F1Warehouse.GetOpenF1Overtakes
    (sessionKey = $Key, json = $OvJson);
  $WipeOv = CALL JAVA ACTION Formula1Backend.OQL_ExecuteWith(
    Statement = 'delete from Formula1Backend.LiveOvertake where SessionKey = $k',
    Name1 = 'k', Value1 = $Key, Type1 = 'String');
  DECLARE $Ov Long = 0;
  LOOP $O IN $OvRows BEGIN
    $NewOv = CREATE Formula1Backend.LiveOvertake (
      SessionKey = $O/SessionKey, At = $O/At, LapNumber = $O/LapNumber,
      OvertakingDriver = $O/OvertakingDriver,
      OvertakenDriver = $O/OvertakenDriver, Position = $O/Position) COMMIT;
    SET $Ov = $Ov + 1;
  END LOOP;

  $RadJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'team_radio?session_key=' + $Key, Token = $Token);
  $RadRows = execute database query Formula1Backend.F1Warehouse.GetOpenF1Radio
    (sessionKey = $Key, json = $RadJson);
  $WipeRad = CALL JAVA ACTION Formula1Backend.OQL_ExecuteWith(
    Statement = 'delete from Formula1Backend.LiveRadio where SessionKey = $k',
    Name1 = 'k', Value1 = $Key, Type1 = 'String');
  DECLARE $Rad Long = 0;
  LOOP $R IN $RadRows BEGIN
    $NewRad = CREATE Formula1Backend.LiveRadio (
      SessionKey = $R/SessionKey, At = $R/At, DriverNumber = $R/DriverNumber,
      RecordingUrl = $R/RecordingUrl) COMMIT;
    SET $Rad = $Rad + 1;
  END LOOP;

  SET $Result = 'slow: ' + toString($Ov) + ' overtakes, ' + toString($Rad) + ' radio';
  LOG INFO NODE 'F1LiveSync' $Result;
  RETURN $Result;
END;

/* ------------------------------------------------------------- the cycle -- */

/*
 * What the scheduled event actually runs.
 *
 * Mendix fires it once a minute; it works for most of that minute rather than
 * returning immediately, which is how a ten- or twenty-second cadence exists
 * under a one-minute scheduler.
 *
 * Three passes, twenty seconds apart:
 *
 *   every pass    the lap derivation (5 requests) and telemetry (3)
 *   first pass    the slow tier as well (2)
 *
 * which is 26 requests a minute against an allowance of 60 -- deliberately
 * under half, because a pass that runs long overlaps the next minute's event
 * and both are then in flight. The headroom is what keeps that from becoming a
 * rate-limit failure.
 *
 * The token is fetched once and handed down, rather than each tier asking: an
 * hourly token looked up three times a minute is three lookups a minute for one
 * answer.
 *
 * A pass that throws does not take the cycle with it. A minute of a race is
 * worth losing; the rest of the race is not.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_Cycle ()
  RETURNS String AS $Result
BEGIN
  DECLARE $Result String = '';

  $State = CALL MICROFLOW Formula1Backend.Sync_State();
  IF $State/Enabled != true THEN
    SET $Result = 'disabled';
    RETURN $Result;
  END IF;

  DECLARE $Key String = 'latest';
  IF trim($State/SessionKey) != '' THEN
    SET $Key = trim($State/SessionKey);
  END IF;

  $Token = CALL MICROFLOW Formula1Backend.Sync_EnsureToken();

  DECLARE $Pass Integer = 0;
  DECLARE $Notes String = '';
  WHILE $Pass < 3 BEGIN
    SET $Pass = $Pass + 1;

    /* Rollback rather than Continue: Mendix requires it inside a loop, and it
     * is the right semantic anyway -- a pass that failed part way through
     * leaves nothing half-written behind for the next pass to trip over. */
    $Core = CALL MICROFLOW Formula1Backend.Sync_Live() ON ERROR ROLLBACK;
    $Tele = CALL MICROFLOW Formula1Backend.Sync_Telemetry(Key = $Key, Token = $Token)
      ON ERROR ROLLBACK;

    IF $Pass = 1 THEN
      $Slow = CALL MICROFLOW Formula1Backend.Sync_Slow(Key = $Key, Token = $Token)
        ON ERROR ROLLBACK;
      /* Returns immediately once the session has an outline, so this costs two
       * requests on the first cycle of a session and nothing thereafter. */
      $Track = CALL MICROFLOW Formula1Backend.Sync_TrackMap(Key = $Key, Token = $Token)
        ON ERROR ROLLBACK;
    END IF;

    SET $Notes = $Notes + ' | pass ' + toString($Pass);

    /* No wait after the last pass: the next scheduled event is the wait. */
    IF $Pass < 3 THEN
      $Waited = CALL JAVA ACTION Formula1Backend.Sync_Sleep(Seconds = 20);
    END IF;
  END WHILE;

  SET $Result = 'cycle for ' + $Key + $Notes;
  LOG INFO NODE 'F1LiveSync' $Result;
  RETURN $Result;
END;

/*
 * Point the schedule at the cycle rather than at a single sync.
 */
CREATE OR MODIFY SCHEDULED EVENT Formula1Backend.SE_LiveSync (
  Microflow: Formula1Backend.Sync_Cycle,
  Enabled: true,
  Repeat: Minutely,
  Multiplier: 1,
  TimeZone: Server
);

/* ------------------------------------------------------------- track map -- */

/*
 * The circuit, and where the cars are on it.
 *
 * The outline is not drawn from a map. OpenF1's location feed is in a
 * track-local frame -- x and y in some tens of thousands of units centred on
 * the circuit, with no relation to latitude and longitude -- so the
 * OpenStreetMap outlines in data/circuits/ cannot be used here: the cars and
 * that outline would be in two coordinate systems with no transform between
 * them.
 *
 * Tracing one car's way round instead solves the alignment by not having any.
 * The circuit and the cars come from the same feed in the same units, so a dot
 * at (x, y) is on the line by construction rather than by fitting.
 *
 * Captured once per session, because a circuit does not change during a race.
 */
create or modify persistent entity Formula1Backend.LiveTrackOutline (
  /* A published resource needs a key, and Mendix will only accept an attribute
   * as one if it carries a unique validation rule. sessionKey-seq is the
   * natural key here: one point, one position on one session's outline. */
  PointKey: string(40) unique error 'Track outline point key must be unique',
  SessionKey: string(20),
  Seq: long,
  X: decimal,
  Y: decimal
) index (SessionKey, Seq);

CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_TrackMap (
  $Key: String,
  $Token: String
)
  RETURNS String AS $Result
BEGIN
  DECLARE $Result String = '';

  /* Once per session. The outline is the shape of the tarmac, not of the race. */
  RETRIEVE $Have FROM Formula1Backend.LiveTrackOutline
    WHERE SessionKey = $Key LIMIT 1;
  IF $Have != empty THEN
    SET $Result = 'track outline already captured';
    RETURN $Result;
  END IF;

  $LapsJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'laps?session_key=' + $Key, Token = $Token);
  $Windows = execute database query Formula1Backend.F1Warehouse.GetOpenF1LapWindow
    (lapsJson = $LapsJson);

  DECLARE $Points Long = 0;
  LOOP $W IN $Windows BEGIN
    /*
     * The one place a driver_number filter is right. Everywhere else it
     * multiplies requests twentyfold for the same rows; here it is the point --
     * one car's lap is the outline, and twenty cars' would be a smear.
     */
    $LocJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
      Path = 'location?session_key=' + $Key
        + '&driver_number=' + toString($W/DriverNumber)
        + '&date%3E=' + $W/FromTs + '&date%3C=' + $W/ToTs,
      Token = $Token);

    $Pts = execute database query Formula1Backend.F1Warehouse.GetOpenF1TrackOutline
      (sessionKey = $Key, locJson = $LocJson);
    LOOP $P IN $Pts BEGIN
      $New = CREATE Formula1Backend.LiveTrackOutline (
        PointKey = $P/SessionKey + '-' + toString($P/Seq),
        SessionKey = $P/SessionKey, Seq = $P/Seq, X = $P/X, Y = $P/Y) COMMIT;
      SET $Points = $Points + 1;
    END LOOP;
  END LOOP;

  SET $Result = 'track outline: ' + toString($Points) + ' points';
  LOG INFO NODE 'F1LiveSync' $Result;
  RETURN $Result;
END;
