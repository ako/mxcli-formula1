/*
 * Service 1 of 2 — F1LiveApi: the CSVs, served straight through.
 *
 * Non-persistable entities published over OData v4, each backed by a read
 * microflow that runs a DuckDB query at request time. Nothing is stored, so
 * there is no refresh to run and no way for the service to be stale.
 *
 * What it gives up, and why:
 *   - No paging. Mendix refuses UsePaging together with a read microflow, so
 *     every resource returns its whole list.
 *   - No $filter / $orderby pushdown. The microflow gets the request, not the
 *     query options, so ordering is whatever the SQL says.
 *   - No navigation properties. The rows are flat; DuckDB did the joins.
 *   - Everything is Countable, so every read microflow takes
 *     System.ODataResponse. These resources return their whole list anyway, so
 *     the count is COUNT of what was just fetched — no second scan. It also
 *     keeps the contract honest: `CREATE EXTERNAL ENTITIES FROM` defaults every
 *     capability to true, so a resource declaring Countable=false generates an
 *     external entity Mendix then refuses to build (FINDINGS §24).
 *
 * Two resources escape those limits: Drivers and RaceResults. Their read
 * microflows translate the query options into SQL themselves — see
 * 10-live-pushdown.mdl, which OWNS those two microflows; do not redefine them
 * here. Everything else in this file still returns its whole list.
 *
 * Every read below now takes System.HttpRequest, for one reason: a client that
 * is holding one of these rows re-reads it by key on its own, and a read that
 * ignores the request answers with the whole collection — whereupon the client
 * adopts the first row as that object's identity and keeps it. That is §37,
 * which shipped, and `mxcli check` (MDL-ODATA02) now names it. FINDINGS §42.
 *
 * These resources still advertise $top and $skip they do not apply, which
 * MDL-ODATA03 rightly flags. The declaration that would make them honest —
 * `TopSupported: No, SkipSupported: No` — cannot be used: the external-entity
 * generator hardcodes both capabilities to true regardless of the contract
 * (`cmd_contract.go:1214`), and Mendix then refuses the frontend with CE6630
 * "marked supports $top=False in the OData service, but True in the app".
 * Tried, reverted, filed. FINDINGS §42.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Seasons (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Season AS $Rows
BEGIN
  /*
   * Read the key both ways. A text key arrives quoted (`year eq '…'`) and a
   * numeric one bare (`year eq 1957`); the identifier reader only sees the
   * first, so a numeric key would fall through to the whole collection — which
   * is the failure this resource is being fixed for.
   */
  $KeyText = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'year');
  $KeyNumber = CALL JAVA ACTION Formula1Backend.ODataFilterYear(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);

  DECLARE $Key String = $KeyText;
  IF $Key = '' AND $KeyNumber != 0 THEN
    SET $Key = toString($KeyNumber);
  END IF;

  $Rows = execute database query Formula1Backend.F1Warehouse.GetSeasons
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Circuits (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Circuit AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'circuitId');

  $Rows = execute database query Formula1Backend.F1Warehouse.GetCircuits
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Constructors (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Constructor AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'constructorId');

  $Rows = execute database query Formula1Backend.F1Warehouse.GetConstructors
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Races (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Race AS $Rows
BEGIN
  /*
   * Read the key both ways. A text key arrives quoted (`raceId eq '…'`) and a
   * numeric one bare (`raceId eq 1957`); the identifier reader only sees the
   * first, so a numeric key would fall through to the whole collection — which
   * is the failure this resource is being fixed for.
   */
  $KeyText = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'raceId');
  $KeyNumber = CALL JAVA ACTION Formula1Backend.ODataFilterYear(
    Uri = $Request/Uri, Field = 'raceId', Fallback = 0);

  DECLARE $Key String = $KeyText;
  IF $Key = '' AND $KeyNumber != 0 THEN
    SET $Key = toString($KeyNumber);
  END IF;

  $Rows = execute database query Formula1Backend.F1Warehouse.GetRaces
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_DriverStandings (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_DriverStanding AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'standingKey');

  $Rows = execute database query Formula1Backend.F1Warehouse.GetDriverStandings
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_ConstructorStandings (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_ConstructorStanding AS $Rows
BEGIN
  $Key = CALL JAVA ACTION Formula1Backend.ODataFilterId(
    Uri = $Request/Uri, Field = 'standingKey');

  $Rows = execute database query Formula1Backend.F1Warehouse.GetConstructorStandings
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Key);
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/* ------------------------------------------------------------------------- */

create or modify odata service Formula1Backend.F1LiveApi (
  path: 'odata/f1-live/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Formula1Backend.Live'
)
authentication basic, session
{
  publish entity Formula1Backend.Stg_Season as 'Seasons' (
    ReadMode: microflow Formula1Backend.Read_Seasons,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    Year as 'year' (KEY, Filterable, Sortable),
    ChampionDriverName as 'championDriver' (Filterable, Sortable),
    ChampionConstructorName as 'championConstructor' (Filterable, Sortable),
    RaceCount as 'raceCount' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_Circuit as 'Circuits' (
    ReadMode: microflow Formula1Backend.Read_Circuits,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    CircuitId as 'circuitId' (KEY, Filterable, Sortable),
    Name as 'name' (Filterable, Sortable),
    FullName as 'fullName' (Filterable, Sortable),
    PlaceName as 'placeName' (Filterable, Sortable),
    Country as 'country' (Filterable, Sortable),
    Latitude as 'latitude' (Filterable, Sortable),
    Longitude as 'longitude' (Filterable, Sortable),
    Length as 'length' (Filterable, Sortable),
    Turns as 'turns' (Filterable, Sortable),
    RacesHeld as 'racesHeld' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_Constructor as 'Constructors' (
    ReadMode: microflow Formula1Backend.Read_Constructors,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    ConstructorId as 'constructorId' (KEY, Filterable, Sortable),
    Name as 'name' (Filterable, Sortable),
    FullName as 'fullName' (Filterable, Sortable),
    Country as 'country' (Filterable, Sortable),
    ChampionshipWins as 'championshipWins' (Filterable, Sortable),
    RaceStarts as 'raceStarts' (Filterable, Sortable),
    RaceWins as 'raceWins' (Filterable, Sortable),
    Podiums as 'podiums' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    PolePositions as 'polePositions' (Filterable, Sortable)
  );

  -- Drivers is the pushdown resource: its read microflow translates $skip /
  -- $top / $orderby / $filter into SQL (see 10-live-pushdown.mdl), so it is
  -- Countable and its microflow takes System.ODataResponse to answer $count
  -- over the whole filtered set rather than the page.
  publish entity Formula1Backend.Stg_Driver as 'Drivers' (
    ReadMode: microflow Formula1Backend.Read_Drivers,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    DriverId as 'driverId' (KEY, Filterable, Sortable),
    Name as 'name' (Filterable, Sortable),
    FullName as 'fullName' (Filterable, Sortable),
    Abbreviation as 'abbreviation' (Filterable, Sortable),
    PermanentNumber as 'permanentNumber' (Filterable, Sortable),
    DateOfBirth as 'dateOfBirth' (Filterable, Sortable),
    PlaceOfBirth as 'placeOfBirth' (Filterable, Sortable),
    Nationality as 'nationality' (Filterable, Sortable),
    ChampionshipWins as 'championshipWins' (Filterable, Sortable),
    RaceStarts as 'raceStarts' (Filterable, Sortable),
    RaceWins as 'raceWins' (Filterable, Sortable),
    Podiums as 'podiums' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    PolePositions as 'polePositions' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_Race as 'Races' (
    ReadMode: microflow Formula1Backend.Read_Races,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    RaceId as 'raceId' (KEY, Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    Round as 'round' (Filterable, Sortable),
    RaceDate as 'raceDate' (Filterable, Sortable),
    OfficialName as 'officialName' (Filterable, Sortable),
    GrandPrixId as 'grandPrixId' (Filterable, Sortable),
    CircuitId as 'circuitId' (Filterable, Sortable),
    CircuitName as 'circuitName' (Filterable, Sortable),
    Laps as 'laps' (Filterable, Sortable),
    Distance as 'distance' (Filterable, Sortable)
  );

  -- The full 27533 rows, from the CSVs, one page at a time. Before pushdown
  -- this had to be LatestRaceResults (one season) because every call returned
  -- everything; see 10-live-pushdown.mdl.
  publish entity Formula1Backend.Stg_RaceResult as 'RaceResults' (
    ReadMode: microflow Formula1Backend.Read_RaceResults,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    PositionOrder as 'positionOrder' (KEY, Filterable, Sortable),
    RaceId as 'raceId' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    Round as 'round' (Filterable, Sortable),
    PositionNumber as 'position' (Filterable, Sortable),
    PositionText as 'positionText' (Filterable, Sortable),
    DriverId as 'driverId' (Filterable, Sortable),
    DriverName as 'driverName' (Filterable, Sortable),
    ConstructorId as 'constructorId' (Filterable, Sortable),
    ConstructorName as 'constructorName' (Filterable, Sortable),
    DriverNumber as 'driverNumber' (Filterable, Sortable),
    Laps as 'laps' (Filterable, Sortable),
    TimeText as 'time' (Filterable, Sortable),
    Gap as 'gap' (Filterable, Sortable),
    ReasonRetired as 'reasonRetired' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    GridPosition as 'gridPosition' (Filterable, Sortable),
    PositionsGained as 'positionsGained' (Filterable, Sortable),
    FastestLap as 'fastestLap' (Filterable, Sortable),
    PolePosition as 'polePosition' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_DriverStanding as 'DriverStandings' (
    ReadMode: microflow Formula1Backend.Read_DriverStandings,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    StandingKey as 'standingKey' (KEY, Filterable, Sortable),
    DriverId as 'driverId' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    PositionOrder as 'positionOrder' (Filterable, Sortable),
    PositionNumber as 'position' (Filterable, Sortable),
    PositionText as 'positionText' (Filterable, Sortable),
    DriverName as 'driverName' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    ChampionshipWon as 'championshipWon' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_ConstructorStanding as 'ConstructorStandings' (
    ReadMode: microflow Formula1Backend.Read_ConstructorStandings,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    StandingKey as 'standingKey' (KEY, Filterable, Sortable),
    ConstructorId as 'constructorId' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    PositionOrder as 'positionOrder' (Filterable, Sortable),
    PositionNumber as 'position' (Filterable, Sortable),
    PositionText as 'positionText' (Filterable, Sortable),
    ConstructorName as 'constructorName' (Filterable, Sortable),
    EngineManufacturer as 'engineManufacturer' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    ChampionshipWon as 'championshipWon' (Filterable, Sortable)
  );
};

/*
 * Re-grant, because the statement above revoked it.
 *
 * `create or modify odata service` drops the service's role grants, so a file
 * that modifies a service has to put them back or the next build fails with
 * CE0307 "At least one allowed role must be selected". 06-security.mdl is where
 * this grant is declared, but 06 is not re-runnable — `create module role` has
 * no `or modify` form — so re-running it is not the recovery.
 *
 * mxcli `b4a825e` carries a fix for this (`28ce821`) in `sdk/mpr/writer_odata.go`;
 * the writer this project's path uses has no grant handling at all, so the
 * behaviour is unchanged here. Re-verified on `b4a825e`. FINDINGS §41.
 */
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1LiveApi TO Formula1Backend.ApiUser;
