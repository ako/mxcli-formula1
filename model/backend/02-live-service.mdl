  DECLARE $Cols String = 'raceId:raceId:number,year:year:number,round:round:number,'
    + 'raceDate:raceDate:date,officialName:officialName:text,'
    + 'grandPrixId:grandPrixId:text,circuitId:circuitId:text,'
    + 'circuitName:circuitName:text,laps:laps:number,'
    + 'distance:distance:number';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'raceId', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetRaces
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetRaces
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

