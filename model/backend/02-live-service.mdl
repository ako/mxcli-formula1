/*
 * Service 1 of 2 — F1LiveApi: the CSVs, served straight through.
 *
 * Non-persistable entities published over OData v4, each backed by a read
 * microflow that runs a DuckDB query at request time. Nothing is stored, so
 * there is no refresh to run and no way for the service to be stale.
 *
 * What it gives up, and why:
 *   - No paging. Mendix refuses UsePaging together with a read microflow, so
 *     every resource returns its whole list.
 *   - No $filter / $orderby pushdown. The microflow gets the request, not the
 *     query options, so ordering is whatever the SQL says.
 *   - No navigation properties. The rows are flat; DuckDB did the joins.
 *   - Everything is Countable, so every read microflow takes
 *     System.ODataResponse. These resources return their whole list anyway, so
 *     the count is COUNT of what was just fetched — no second scan. It also
 *     keeps the contract honest: `CREATE EXTERNAL ENTITIES FROM` defaults every
 *     capability to true, so a resource declaring Countable=false generates an
 *     external entity Mendix then refuses to build (FINDINGS §24).
 *
 * Two resources escape those limits: Drivers and RaceResults. Their read
 * microflows translate the query options into SQL themselves — see
 * 10-live-pushdown.mdl, which OWNS those two microflows; do not redefine them
 * here. Everything else in this file still returns its whole list.
 *
 * Every read below now takes System.HttpRequest, for one reason: a client that
 * is holding one of these rows re-reads it by key on its own, and a read that
 * ignores the request answers with the whole collection — whereupon the client
 * adopts the first row as that object's identity and keeps it. That is §37,
 * which shipped, and `mxcli check` (MDL-ODATA02) now names it. FINDINGS §42.
 *
 *
 * HOW EACH READ ANSWERS THE REQUEST
 *
 * All six call ODataPushdown.Parse once and hand the answer to the query. This
 * is the module's BIND style: the SQL lives on the connection in 01, where it
 * can be read and changed as SQL, so what crosses into it are values — the key,
 * the page, the sort — never a clause. Nothing derived from the request text
 * reaches the parser on the far side.
 *
 * `Columns` maps each exposed name to itself, because the sort travels as a
 * bound name that the query's own CASE matches on. The types are still declared,
 * and they earn their place: they are what makes `year eq '1957'` from a combo
 * box and `year eq 1957` from a grid header mean the same thing. FINDINGS §42.
 *
 * `RejectUnsupported` is false throughout. These resources apply no $filter
 * beyond their key, so failing a request over a filter they were never going to
 * honour trades one wrong answer for another. The two resources that DO apply
 * $filter — Drivers and RaceResults, in 10 — pass true, because for them an
 * untranslated filter means an empty WHERE and every row in the table.
 * FINDINGS §46 records what is still owed here.
 *
 * Before the module there were seven Java action calls at the top of each of
 * these microflows, each re-reading and re-splitting the same URI to answer one
 * question about it. Six resources × seven parses of the same string, and the
 * seven answers could disagree.
 *
 * These resources still advertise $top and $skip they do not apply, which
 * MDL-ODATA03 rightly flags. The declaration that would make them honest —
 * `TopSupported: No, SkipSupported: No` — cannot be used: the external-entity
 * generator hardcodes both capabilities to true regardless of the contract
 * (`cmd_contract.go:1214`), and Mendix then refuses the frontend with CE6630
 * "marked supports $top=False in the OData service, but True in the app".
 * Tried, reverted, filed. FINDINGS §42.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Seasons (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Season AS $Rows
BEGIN
  /* One parse of the request; the query binds what comes back. */
  DECLARE $Cols String = 'year:year:number,championDriver:championDriver:text,'
    + 'championConstructor:championConstructor:text,'
    + 'raceCount:raceCount:number';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'year', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetSeasons
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetSeasons
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Circuits (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Circuit AS $Rows
BEGIN
  /* One parse of the request; the query binds what comes back. */
  DECLARE $Cols String = 'circuitId:circuitId:text,name:name:text,'
    + 'fullName:fullName:text,placeName:placeName:text,'
    + 'country:country:text,latitude:latitude:number,'
    + 'longitude:longitude:number,length:length:number,'
    + 'turns:turns:number,racesHeld:racesHeld:number';
  $Q = CALL JAVA ACTION ODataPushdown.Parse(
    Uri = $Request/Uri, Columns = $Cols, Dialect = 'duckdb',
    MaxTop = 1000000, DefaultTop = 1000000, DefaultOrderBy = '',
    KeyField = 'circuitId', RejectUnsupported = false);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetCircuits
    (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
     topN = toString($Q/Top), skipN = toString($Q/Skip),
     sortCol = $Q/SortColumn1, sortDir = $Q/SortDirection1);

  /*
   * $count is the size of the whole filtered set, not of the page — a grid
   * draws its scrollbar from it. Only computed when the client asks, so an
   * unpaged read still costs one scan.
   */
  IF $Q/WantsCount = true THEN
    $AllRows = execute database query Formula1Backend.F1Warehouse.GetCircuits
      (dataDir = @Formula1Backend.DataDir, keyFilter = $Q/Key,
       topN = '1000000', skipN = '0',
       sortCol = '', sortDir = 'A');
    $Total = COUNT($AllRows);
    CHANGE $Response (Count = $Total);
  END IF;

  RETURN $Rows;
END;

