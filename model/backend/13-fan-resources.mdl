/*
 * Service 3 of 3 — F1FanApi: the questions a fan asks, not the tables.
 *
 * The other two services publish the dataset: drivers, races, results. This one
 * publishes answers — what a driver's career looked like, how a season's title
 * fight unfolded, where a team's cars keep breaking — each computed by DuckDB in
 * one pass over the CSVs, and none of it materialised.
 *
 * Why a third service rather than five more resources on F1LiveApi: 02 owns
 * F1LiveApi's definition, and a second file modifying the same service is the
 * split-ownership trap 10 already documents for two microflows. Here the read
 * microflows, the service and the grants live in one file.
 *
 * Every resource is answered *for one thing*: a driver, a season, a team. The
 * id arrives as `$filter=driverId eq 'ayrton-senna'`, which the read microflow
 * lifts out of the URL and interpolates, because the value does not go into a
 * WHERE clause — it shapes the query. Interpolation is why the id comes back
 * through ODataPushdown.Key, which whitelists the shape of a key rather than
 * escaping it. Asking without a filter is not "give me everything":
 * DriverSeasons and DriverRaces return nothing, because a career page with no
 * driver is a bug, not a request for all 27533 results.
 *
 * This file used to open with seven Java action declarations of its own —
 * ODataFilterId, ODataFilterYear, ODataTop, ODataSkip, ODataSortColumn,
 * ODataSortDirection, ODataEntityKeyId — each a thin wrapper over one method of
 * one class in javasource/formula1backend. They are gone: all seven are now the
 * ODataPushdown module (model/odatapushdown/), which is the same code with
 * nothing about Formula 1 left in it.
 */

/* ----------------------------------------------------------------- microflows */

/*
 * A driver's career, one row per season: who they drove for, where they
 * finished, and the averages that say how the year actually went.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_DriverSeasons (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_DriverSeason AS $Rows
BEGIN
  $DriverId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'driverId');

  -- A career page asks for every season; the banner asks for one of them. Both
  -- are the same request with one more conjunct.
  $Year = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);

  -- No driver, no career. 1=0 costs one scan of nothing rather than grouping
  -- every result the sport has ever recorded.
  DECLARE $Where String = ' WHERE 1=0';
  IF $DriverId != '' THEN
    SET $Where = ' WHERE rr.driverId = ''' + $DriverId + '''';
    IF $Year != 0 THEN
      SET $Where = $Where + ' AND rr.year = ' + toString($Year);
    END IF;
  END IF;

  DECLARE $Sql String = 'SELECT rr.year || ''-'' || rr.driverId AS seasonKey,'
    + ' rr.driverId AS driverId, rr.year AS year,'
    + ' COALESCE(string_agg(DISTINCT c.name, '', ''), ''-'') AS constructors,'
    + ' COALESCE(max(ds.positionText), ''-'') AS standingPosition,'
    + ' COALESCE(max(ds.positionDisplayOrder), 999) AS standingOrder,'
    + ' COALESCE(max(ds.points), sum(COALESCE(rr.points, 0))) AS points,'
    + ' count(*) AS starts,'
    + ' sum(CASE WHEN rr.positionNumber = 1 THEN 1 ELSE 0 END) AS wins,'
    + ' sum(CASE WHEN rr.positionNumber <= 3 THEN 1 ELSE 0 END) AS podiums,'
    + ' sum(CASE WHEN rr.polePosition THEN 1 ELSE 0 END) AS poles,'
    + ' min(rr.positionNumber) AS bestFinish,'
    + ' round(avg(rr.qualificationPositionNumber), 1) AS avgQualifying,'
    + ' round(avg(rr.positionNumber), 1) AS avgFinish,'
    + ' sum(CASE WHEN rr.positionNumber IS NULL THEN 1 ELSE 0 END) AS retirements,'
    + ' COALESCE(max(sb.bestPoints), 0) AS seasonBestPoints,'
    + ' CAST(round(COALESCE(max(ds.points), sum(COALESCE(rr.points, 0)))'
    + '      / NULLIF(max(sb.bestPoints), 0) * 100) AS BIGINT) AS pointsShare'
    + ' FROM read_csv(''' + @Formula1Backend.DataDir + '/f1db-races-race-results.csv'') rr'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir + '/f1db-constructors.csv'') c'
    + '   ON c.id = rr.constructorId'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-seasons-driver-standings.csv'') ds'
    + '   ON ds.year = rr.year AND ds.driverId = rr.driverId'
    -- The season's winning score, joined by year. One grouped scan of the
    -- standings, so the career page can draw each year against its own best.
    + ' LEFT JOIN (SELECT year, max(points) AS bestPoints FROM read_csv('''
    + @Formula1Backend.DataDir + '/f1db-seasons-driver-standings.csv'')'
    + '            GROUP BY year) sb ON sb.year = rr.year'
    + $Where
    + ' GROUP BY rr.year, rr.driverId ORDER BY rr.year DESC';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetDriverSeasons
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  -- A career is tens of rows, so the count is what was just fetched. No second
  -- scan, unlike the paged resources in 10.
  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * Every race a driver entered, with each session beside the next: three
 * practices, qualifying, the grid slot, the finish.
 *
 * The practice columns are empty for most of the sport's history because timed
 * practice results only exist from the era they were recorded — that gap is
 * data, not a fault, and the page says so.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_DriverRaces (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_DriverRace AS $Rows
BEGIN
  $DriverId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'driverId');

  -- A career page reads every round the driver ever started; the round-by-round
  -- strip reads one season of them. Both arrive as the same request with one
  -- more conjunct, so the year is lifted out here rather than costing a whole
  -- career's rows to draw twenty-four cells.
  $Year = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);

  DECLARE $Where String = ' WHERE 1=0';
  IF $DriverId != '' THEN
    SET $Where = ' WHERE rr.driverId = ''' + $DriverId + '''';
    IF $Year != 0 THEN
      SET $Where = $Where + ' AND rr.year = ' + toString($Year);
    END IF;
  END IF;

  DECLARE $Sql String = 'SELECT rr.raceId || ''-'' || rr.driverId AS raceKey,'
    + ' rr.driverId AS driverId, rr.year AS year, rr.round AS round,'
    + ' COALESCE(r.officialName, ''Round '' || rr.round) AS raceName,'
    + ' COALESCE(c.name, ''-'') AS constructorName,'
    + ' fp1.positionNumber AS fp1Position, fp2.positionNumber AS fp2Position,'
    + ' fp3.positionNumber AS fp3Position,'
    + ' rr.qualificationPositionNumber AS qualifyingPosition,'
    + ' rr.gridPositionNumber AS gridPosition,'
    + ' rr.positionNumber AS finishPosition, rr.positionText AS positionText,'
    + ' rr.positionsGained AS positionsGained, rr.points AS points,'
    + ' rr.reasonRetired AS reasonRetired'
    + ' FROM read_csv(''' + @Formula1Backend.DataDir + '/f1db-races-race-results.csv'') rr'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir + '/f1db-races.csv'') r'
    + '   ON r.id = rr.raceId'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir + '/f1db-constructors.csv'') c'
    + '   ON c.id = rr.constructorId'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-races-free-practice-1-results.csv'') fp1'
    + '   ON fp1.raceId = rr.raceId AND fp1.driverId = rr.driverId'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-races-free-practice-2-results.csv'') fp2'
    + '   ON fp2.raceId = rr.raceId AND fp2.driverId = rr.driverId'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-races-free-practice-3-results.csv'') fp3'
    + '   ON fp3.raceId = rr.raceId AND fp3.driverId = rr.driverId'
    + $Where
    + ' ORDER BY rr.year DESC, rr.round';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetDriverRaces
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * A season's title fight, round by round: the running points total of the five
 * drivers who ended the year on top of the championship.
 *
 * The window function is the whole trick — `sum(points) OVER (PARTITION BY
 * driver ORDER BY round)` turns per-race points into a curve. Rounds are
 * CROSS JOINed against the five drivers first, so a driver who missed a race
 * holds their total instead of leaving a hole in the line.
 *
 * Positions, not names, decide the five series: a chart series binds its Y
 * attribute when the page is authored, so the columns have to mean the same
 * thing in every season. The names travel as data and the page shows them.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_SeasonProgress (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_SeasonProgress AS $Rows
BEGIN
  -- No year means the most recent season, so the page has something to draw
  -- before a user has chosen anything.
  $Year = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);

  -- The target year is resolved in SQL rather than here, so "no filter" means
  -- "the latest season the data has" without a second round trip.
  DECLARE $YearWhere String = '';
  IF $Year != 0 THEN
    SET $YearWhere = ' WHERE year = ' + toString($Year);
  END IF;

  DECLARE $Results String = 'read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-races-race-results.csv'')';
  DECLARE $Races String = 'read_csv(''' + @Formula1Backend.DataDir + '/f1db-races.csv'')';
  DECLARE $Standings String = 'read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-seasons-driver-standings.csv'')';
  DECLARE $Drivers String = 'read_csv(''' + @Formula1Backend.DataDir + '/f1db-drivers.csv'')';

  DECLARE $Sql String = 'WITH target AS ('
    + ' SELECT max(year) AS year FROM ' + $Races + $YearWhere + '),'
    + ' top5 AS ('
    + '   SELECT row_number() OVER (ORDER BY ds.positionDisplayOrder) AS rk,'
    + '          ds.driverId AS driverId, d.name AS driverName'
    + '   FROM ' + $Standings + ' ds'
    + '   JOIN ' + $Drivers + ' d ON d.id = ds.driverId'
    + '   WHERE ds.year = (SELECT year FROM target)'
    + '   ORDER BY ds.positionDisplayOrder LIMIT 5),'
    + ' rounds AS ('
    + '   SELECT r.round AS round,'
    + '          COALESCE(r.officialName, ''Round '' || r.round) AS raceName'
    + '   FROM ' + $Races + ' r WHERE r.year = (SELECT year FROM target)),'
    + ' scored AS ('
    + '   SELECT rr.round AS round, rr.driverId AS driverId,'
    + '          sum(COALESCE(rr.points, 0)) AS pts'
    + '   FROM ' + $Results + ' rr WHERE rr.year = (SELECT year FROM target)'
    + '   GROUP BY rr.round, rr.driverId),'
    + ' grid AS ('
    + '   SELECT rounds.round, rounds.raceName, top5.rk, top5.driverId, top5.driverName'
    + '   FROM rounds CROSS JOIN top5),'
    + ' cumulative AS ('
    + '   SELECT g.round, g.raceName, g.rk, g.driverName,'
    + '          sum(COALESCE(s.pts, 0)) OVER ('
    + '            PARTITION BY g.driverId ORDER BY g.round) AS cumPoints'
    + '   FROM grid g LEFT JOIN scored s'
    + '     ON s.round = g.round AND s.driverId = g.driverId)'
    + ' SELECT (SELECT year FROM target) || ''-'' || round AS progressKey,'
    + '        (SELECT year FROM target) AS year, round, raceName,'
    + '        max(CASE WHEN rk = 1 THEN driverName END) AS d1Name,'
    + '        max(CASE WHEN rk = 2 THEN driverName END) AS d2Name,'
    + '        max(CASE WHEN rk = 3 THEN driverName END) AS d3Name,'
    + '        max(CASE WHEN rk = 4 THEN driverName END) AS d4Name,'
    + '        max(CASE WHEN rk = 5 THEN driverName END) AS d5Name,'
    + '        max(CASE WHEN rk = 1 THEN cumPoints END) AS d1Points,'
    + '        max(CASE WHEN rk = 2 THEN cumPoints END) AS d2Points,'
    + '        max(CASE WHEN rk = 3 THEN cumPoints END) AS d3Points,'
    + '        max(CASE WHEN rk = 4 THEN cumPoints END) AS d4Points,'
    + '        max(CASE WHEN rk = 5 THEN cumPoints END) AS d5Points'
    + ' FROM cumulative GROUP BY round, raceName ORDER BY round';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetSeasonProgress
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * Why a team's cars stopped, and how often — every reason f1db records, with
 * the share of that team's entries it accounts for.
 *
 * Unfiltered this is the whole grid's reliability history, which is a real
 * question ("who breaks most, and how?"), so it is allowed — capped at 500 rows
 * so an unfiltered call cannot become the expensive one.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Retirements (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Retirement AS $Rows
BEGIN
  $ConstructorId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'constructorId');

  DECLARE $Where String = '';
  IF $ConstructorId != '' THEN
    SET $Where = ' AND rr.constructorId = ''' + $ConstructorId + '''';
  END IF;

  DECLARE $Results String = 'read_csv(''' + @Formula1Backend.DataDir
    + '/f1db-races-race-results.csv'')';

  DECLARE $Sql String = 'WITH entries AS ('
    + '   SELECT constructorId, count(*) AS entries FROM ' + $Results
    + '   GROUP BY constructorId)'
    + ' SELECT rr.constructorId || ''|'' || COALESCE(rr.reasonRetired, ''Unknown'')'
    + '          AS retirementKey,'
    + '        rr.constructorId AS constructorId,'
    + '        COALESCE(c.name, rr.constructorId) AS constructorName,'
    + '        COALESCE(rr.reasonRetired, ''Unknown'') AS reasonRetired,'
    + '        count(*) AS retirements,'
    + '        max(e.entries) AS entries,'
    + '        round(100.0 * count(*) / max(e.entries), 1) AS sharePercent,'
    + '        min(rr.year) AS firstYear, max(rr.year) AS lastYear'
    + ' FROM ' + $Results + ' rr'
    + ' LEFT JOIN read_csv(''' + @Formula1Backend.DataDir + '/f1db-constructors.csv'') c'
    + '   ON c.id = rr.constructorId'
    + ' LEFT JOIN entries e ON e.constructorId = rr.constructorId'
    + ' WHERE rr.positionNumber IS NULL' + $Where
    + ' GROUP BY rr.constructorId, c.name, rr.reasonRetired'
    + ' ORDER BY count(*) DESC LIMIT 500';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetRetirements
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * The prose. Filtered by scope and id from the page that shows it; unfiltered it
 * is the whole set, which is 224 rows and useful for checking coverage.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_Facts (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_Fact AS $Rows
BEGIN
  $Scope = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'scope');
  $EntityId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'entityId');

  DECLARE $Where String = '';
  IF $Scope != '' THEN
    SET $Where = ' WHERE scope = ''' + $Scope + '''';
  END IF;
  IF $EntityId != '' THEN
    IF $Where = '' THEN
      SET $Where = ' WHERE entityId = ''' + $EntityId + '''';
    ELSE
      SET $Where = $Where + ' AND entityId = ''' + $EntityId + '''';
    END IF;
  END IF;

  DECLARE $Sql String = 'SELECT scope || ''-'' || entityId AS factKey, scope AS scope,'
    + ' entityId AS entityId, title AS title, extract AS extract,'
    + ' sourceUrl AS sourceUrl, license AS license'
    + ' FROM read_csv(''' + @Formula1Backend.DataDir + '/../facts/f1db-facts.csv'','
    + '   header = true,'
    + '   columns = {''scope'': ''VARCHAR'', ''entityId'': ''VARCHAR'','
    + '              ''title'': ''VARCHAR'', ''extract'': ''VARCHAR'','
    + '              ''sourceUrl'': ''VARCHAR'', ''license'': ''VARCHAR''})'
    + $Where
    + ' ORDER BY scope, entityId';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetFacts
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/* ------------------------------------------------------- a team's season -- */

/*
 * A constructor's season round by round, and the season's team-mate record.
 *
 * Both start from the same idea: a team fields two cars, and almost everything
 * interesting about its year is one car against the other. So both open with
 * the same CTE — rank the season's drivers by points and call the top two seat
 * 1 and seat 2. Seats rather than names, because a chart series binds its Y
 * attribute at authoring time and a column called "Norris" serves one team in
 * one year. The names travel as data.
 *
 * Third and fourth drivers (a mid-season replacement, a one-off stand-in) fall
 * outside both seats. Their points still count in teamPoints, which is the
 * honest total; they are just not in the two-car comparison, because there is
 * no third bar to put them in.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_TeamSeason (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_TeamSeason AS $Rows
BEGIN
  $ConstructorId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'constructorId');
  $Year = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);
  $Round = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'round', Fallback = 0);

  DECLARE $Dir String = @Formula1Backend.DataDir;
  DECLARE $Res String = 'read_csv(''' + $Dir + '/f1db-races-race-results.csv'')';
  DECLARE $Drv String = 'read_csv(''' + $Dir + '/f1db-drivers.csv'')';
  DECLARE $Races String = 'read_csv(''' + $Dir + '/f1db-races.csv'')';
  DECLARE $Gp String = 'read_csv(''' + $Dir + '/f1db-grands-prix.csv'')';
  DECLARE $Teams String = 'read_csv(''' + $Dir + '/f1db-constructors.csv'')';
  DECLARE $Cstand String = 'read_csv(''' + $Dir
    + '/f1db-races-constructor-standings.csv'')';

  -- No team, no season. The year defaults to the last one the team raced, so
  -- the page has something to draw before anything is chosen.
  --
  -- Two spellings of the same predicate: the seat CTE reads one table and takes
  -- the bare column names, the outer query has both rr and the seat table in
  -- scope and needs them qualified or DuckDB refuses the reference.
  DECLARE $Scope String = ' WHERE 1=0';
  DECLARE $ScopeRr String = ' WHERE 1=0';
  IF $ConstructorId != '' THEN
    DECLARE $Yr String = '(SELECT max(year) FROM ' + $Res
      + ' WHERE constructorId = ''' + $ConstructorId + ''')';
    IF $Year != 0 THEN
      SET $Yr = toString($Year);
    END IF;
    SET $Scope = ' WHERE constructorId = ''' + $ConstructorId
      + ''' AND year = ' + $Yr;
    SET $ScopeRr = ' WHERE rr.constructorId = ''' + $ConstructorId
      + ''' AND rr.year = ' + $Yr;

    -- One round of it, for a page that wants where the season ended rather
    -- than how it got there. The seat CTE keeps the whole season: which car is
    -- seat 1 is a season-long fact, and ranking it on one round would swap the
    -- two whenever the slower car had a good afternoon.
    IF $Round != 0 THEN
      SET $ScopeRr = $ScopeRr + ' AND rr.round = ' + toString($Round);
    END IF;
  END IF;

  DECLARE $Seats String = 'WITH seats AS ('
    + ' SELECT constructorId, year, driverId,'
    + '        row_number() OVER (PARTITION BY constructorId, year'
    + '          ORDER BY sum(COALESCE(points, 0)) DESC, count(*) DESC, driverId) AS seat'
    + ' FROM ' + $Res + $Scope
    + ' GROUP BY constructorId, year, driverId)';

  DECLARE $Sql String = $Seats
    + ' SELECT rr.constructorId || ''-'' || rr.year || ''-'' || rr.round AS teamSeasonKey,'
    + '        rr.constructorId AS constructorId,'
    + '        COALESCE(max(c.name), rr.constructorId) AS constructorName,'
    + '        rr.year AS year, rr.round AS round,'
    + '        upper(COALESCE(max(g.abbreviation), ''R'' || rr.round)) AS code,'
    + '        COALESCE(max(r.officialName), ''Round '' || rr.round) AS raceName,'
    -- Season-constant, not per-round: taken from the seat table rather than
    -- from this round's rows, so a race one of them sat out does not blank the
    -- name the panel prints.
    + '        (SELECT COALESCE(d1.name, s1.driverId) FROM seats s1'
    + '           LEFT JOIN ' + $Drv + ' d1 ON d1.id = s1.driverId'
    + '          WHERE s1.seat = 1 LIMIT 1) AS driver1Name,'
    + '        COALESCE(sum(CASE WHEN s.seat = 1 THEN rr.points END), 0) AS driver1Points,'
    + '        (SELECT COALESCE(d2.name, s2.driverId) FROM seats s2'
    + '           LEFT JOIN ' + $Drv + ' d2 ON d2.id = s2.driverId'
    + '          WHERE s2.seat = 2 LIMIT 1) AS driver2Name,'
    + '        COALESCE(sum(CASE WHEN s.seat = 2 THEN rr.points END), 0) AS driver2Points,'
    + '        COALESCE(sum(rr.points), 0) AS teamPoints,'
    + '        max(cs.positionNumber) AS standingPosition'
    + ' FROM ' + $Res + ' rr'
    + ' LEFT JOIN seats s ON s.constructorId = rr.constructorId'
    + '   AND s.year = rr.year AND s.driverId = rr.driverId'
    + ' LEFT JOIN ' + $Races + ' r ON r.id = rr.raceId'
    + ' LEFT JOIN ' + $Gp + ' g ON g.id = r.grandPrixId'
    + ' LEFT JOIN ' + $Teams + ' c ON c.id = rr.constructorId'
    + ' LEFT JOIN ' + $Cstand + ' cs ON cs.raceId = rr.raceId'
    + '   AND cs.constructorId = rr.constructorId'
    + $ScopeRr
    + ' GROUP BY rr.constructorId, rr.year, rr.round ORDER BY rr.round';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetTeamSeason
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * The team-mate record: one row, four comparisons.
 *
 * A round is pivoted to one row carrying both seats' qualifying slot, finish
 * and points, and then the four counts fall out of comparing the two columns.
 * A round where only one car has a number in a column counts for neither — a
 * team-mate comparison needs a team-mate on track.
 *
 * The shares are computed here because the page draws bars and a bar needs a
 * percentage; 19 against 5 is a rout, 19px against 5px is nothing.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Read_TeamH2H (
  $Request: System.HttpRequest,
  $Response: System.ODataResponse
)
  RETURNS List of Formula1Backend.Stg_TeamH2H AS $Rows
BEGIN
  $ConstructorId = CALL JAVA ACTION ODataPushdown.Key(
    Uri = $Request/Uri, KeyField = 'constructorId');
  $Year = CALL JAVA ACTION ODataPushdown.FilterNumber(
    Uri = $Request/Uri, Field = 'year', Fallback = 0);

  DECLARE $Dir String = @Formula1Backend.DataDir;
  DECLARE $Res String = 'read_csv(''' + $Dir + '/f1db-races-race-results.csv'')';
  DECLARE $Drv String = 'read_csv(''' + $Dir + '/f1db-drivers.csv'')';

  DECLARE $Scope String = ' WHERE 1=0';
  DECLARE $ScopeRr String = ' WHERE 1=0';
  IF $ConstructorId != '' THEN
    DECLARE $Yr String = '(SELECT max(year) FROM ' + $Res
      + ' WHERE constructorId = ''' + $ConstructorId + ''')';
    IF $Year != 0 THEN
      SET $Yr = toString($Year);
    END IF;
    SET $Scope = ' WHERE constructorId = ''' + $ConstructorId
      + ''' AND year = ' + $Yr;
    SET $ScopeRr = ' WHERE rr.constructorId = ''' + $ConstructorId
      + ''' AND rr.year = ' + $Yr;
  END IF;

  DECLARE $Sql String = 'WITH seats AS ('
    + ' SELECT constructorId, year, driverId,'
    + '        row_number() OVER (PARTITION BY constructorId, year'
    + '          ORDER BY sum(COALESCE(points, 0)) DESC, count(*) DESC, driverId) AS seat'
    + ' FROM ' + $Res + $Scope
    + ' GROUP BY constructorId, year, driverId),'
    + ' per AS ('
    + ' SELECT rr.constructorId AS cid, rr.year AS yr, rr.round AS rnd,'
    + '   max(CASE WHEN s.seat = 1 THEN rr.qualificationPositionNumber END) AS q1,'
    + '   max(CASE WHEN s.seat = 2 THEN rr.qualificationPositionNumber END) AS q2,'
    + '   max(CASE WHEN s.seat = 1 THEN rr.positionNumber END) AS p1,'
    + '   max(CASE WHEN s.seat = 2 THEN rr.positionNumber END) AS p2,'
    + '   COALESCE(sum(CASE WHEN s.seat = 1 THEN rr.points END), 0) AS pt1,'
    + '   COALESCE(sum(CASE WHEN s.seat = 2 THEN rr.points END), 0) AS pt2,'
    + '   max(CASE WHEN s.seat = 1 AND rr.positionNumber IS NULL THEN 1 ELSE 0 END) AS x1,'
    + '   max(CASE WHEN s.seat = 2 AND rr.positionNumber IS NULL THEN 1 ELSE 0 END) AS x2'
    + ' FROM ' + $Res + ' rr'
    + ' LEFT JOIN seats s ON s.constructorId = rr.constructorId'
    + '   AND s.year = rr.year AND s.driverId = rr.driverId'
    + $ScopeRr
    + ' GROUP BY rr.constructorId, rr.year, rr.round),'
    + ' agg AS ('
    + ' SELECT max(cid) AS cid, max(yr) AS yr,'
    + '   sum(CASE WHEN q1 IS NOT NULL AND q2 IS NOT NULL AND q1 < q2 THEN 1 ELSE 0 END) AS ql,'
    + '   sum(CASE WHEN q1 IS NOT NULL AND q2 IS NOT NULL AND q2 < q1 THEN 1 ELSE 0 END) AS qr,'
    + '   sum(CASE WHEN p1 IS NOT NULL AND p2 IS NOT NULL AND p1 < p2 THEN 1 ELSE 0 END) AS rl,'
    + '   sum(CASE WHEN p1 IS NOT NULL AND p2 IS NOT NULL AND p2 < p1 THEN 1 ELSE 0 END) AS rrr,'
    + '   sum(pt1) AS pl, sum(pt2) AS pr, sum(x1) AS dl, sum(x2) AS dr'
    + ' FROM per)'
    + ' SELECT a.cid || ''-'' || a.yr || ''-h'' AS h2hKey, a.cid AS constructorId,'
    + '   a.yr AS year,'
    + '   (SELECT COALESCE(d1.name, s1.driverId) FROM seats s1'
    + '      LEFT JOIN ' + $Drv + ' d1 ON d1.id = s1.driverId'
    + '     WHERE s1.seat = 1 LIMIT 1) AS leftName,'
    + '   (SELECT COALESCE(d2.name, s2.driverId) FROM seats s2'
    + '      LEFT JOIN ' + $Drv + ' d2 ON d2.id = s2.driverId'
    + '     WHERE s2.seat = 2 LIMIT 1) AS rightName,'
    + '   a.ql AS qualLeft, a.qr AS qualRight,'
    + '   CAST(COALESCE(round(a.ql * 100.0 / NULLIF(a.ql + a.qr, 0)), 0) AS BIGINT) AS qualLeftShare,'
    + '   CAST(COALESCE(round(a.qr * 100.0 / NULLIF(a.ql + a.qr, 0)), 0) AS BIGINT) AS qualRightShare,'
    + '   a.rl AS raceLeft, a.rrr AS raceRight,'
    + '   CAST(COALESCE(round(a.rl * 100.0 / NULLIF(a.rl + a.rrr, 0)), 0) AS BIGINT) AS raceLeftShare,'
    + '   CAST(COALESCE(round(a.rrr * 100.0 / NULLIF(a.rl + a.rrr, 0)), 0) AS BIGINT) AS raceRightShare,'
    + '   a.pl AS pointsLeft, a.pr AS pointsRight,'
    + '   CAST(COALESCE(round(a.pl * 100.0 / NULLIF(a.pl + a.pr, 0)), 0) AS BIGINT) AS pointsLeftShare,'
    + '   CAST(COALESCE(round(a.pr * 100.0 / NULLIF(a.pl + a.pr, 0)), 0) AS BIGINT) AS pointsRightShare,'
    + '   a.dl AS dnfLeft, a.dr AS dnfRight,'
    + '   CAST(COALESCE(round(a.dl * 100.0 / NULLIF(a.dl + a.dr, 0)), 0) AS BIGINT) AS dnfLeftShare,'
    + '   CAST(COALESCE(round(a.dr * 100.0 / NULLIF(a.dl + a.dr, 0)), 0) AS BIGINT) AS dnfRightShare'
    + ' FROM agg a WHERE a.cid IS NOT NULL';

  $Rows = execute database query Formula1Backend.F1Warehouse.GetTeamH2H
    dynamic $Sql
    (dataDir = @Formula1Backend.DataDir);

  $Total = COUNT($Rows);
  CHANGE $Response (Count = $Total);
  RETURN $Rows;
END;

/*
 * The service itself moved to 14-weekend.mdl when the weekend resources were
 * added. `create or modify odata service` takes the whole surface, so one file
 * has to declare all ten resources — splitting it across two would be the same
 * ownership trap 10 documents for microflows. The five microflows above are
 * still owned here; only the publication moved.
 */

GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverSeasons TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverRaces TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_SeasonProgress TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Retirements TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TeamSeason TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TeamH2H TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Facts TO Formula1Backend.ApiUser;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverSeasons TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_DriverRaces TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_SeasonProgress TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Retirements TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TeamSeason TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_TeamH2H TO Formula1Backend.DataAdmin;
GRANT EXECUTE ON MICROFLOW Formula1Backend.Read_Facts TO Formula1Backend.DataAdmin;

GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1FanApi TO Formula1Backend.ApiUser;
GRANT ACCESS ON ODATA SERVICE Formula1Backend.F1FanApi TO Formula1Backend.DataAdmin;
