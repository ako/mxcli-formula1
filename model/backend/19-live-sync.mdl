/*
 * The live sync, in the app.
 * =========================
 *
 * scripts/fetch-f1-live.sh cannot run on Mendix Cloud and cannot run on a
 * Windows developer's machine, which makes it the wrong place for the one job
 * that has to happen while the app is serving: keeping the timing current. This
 * moves it inside — a scheduled event, the app's own DuckDB connection reading
 * OpenF1 over HTTPS, and OQL statements doing the set work.
 *
 * Nothing here touches the filesystem. The script stays for offline use and for
 * seeding a snapshot without an account, but it is no longer the only way.
 *
 * ---------------------------------------------------------------- replay ----
 *
 * The storage is append-only, and that is the whole design decision.
 *
 * The CSV snapshot could only answer "where is everyone now", because each
 * fetch overwrote the last. Keeping every lap instead means the same rows
 * answer "where was everyone on lap 30", and a race can be replayed rather than
 * only watched. So:
 *
 *   LiveLap is one row per driver per lap and is never cleared. It is both the
 *   history and the present: "now" is simply its highest lap, which is what the
 *   old Order file held and nothing more. A running order is therefore no
 *   longer stored at all -- it is LiveLap at a chosen lap, and the chosen lap
 *   is what a replay scrubber moves.
 *
 *   LiveWeather is kept as a series for the same reason. Track temperature
 *   falling across a race is part of the story of it.
 *
 *   LiveStint and LiveSession are small and mutable -- a stint's LapEnd fills
 *   in when the car pits, the session's LeadLap climbs -- so those are
 *   reconciled per sync rather than appended.
 *
 * Appending is made idempotent by the natural key rather than by clearing:
 * a sync inserts the laps it does not already have. Re-running it changes
 * nothing, which is what lets it run every minute without coordination.
 */

/* ------------------------------------------------------------- the tables -- */

/*
 * One row per driver per lap: the replay table.
 *
 * Carries what the old Stg_LiveEntry carried per driver *and* what
 * Stg_LiveTrace carried per lap, because they were the same measurement seen at
 * two resolutions -- the entry file was this table filtered to its last lap.
 *
 * GapToLeader is text and GapSeconds is the same value as a number, or nothing.
 * OpenF1 reports seconds until a car is lapped and then switches to "+1 LAP",
 * so the text column is the one a page shows and the number is the one a chart
 * plots; a chart that coerced "+1 LAP" would draw the car at the front.
 */
create or modify persistent entity Formula1Backend.LiveLap (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveLap row id must be unique',
  SessionKey: string(20),
  DriverNumber: long,
  LapNumber: long,
  Position: long,
  GapToLeader: string(20),
  GapSeconds: decimal,
  LapSeconds: decimal,
  Sector1: decimal,
  Sector2: decimal,
  Sector3: decimal,
  SpeedTrap: long,
  Compound: string(20),
  TyreAge: long,
  PitStops: long
) index (SessionKey, DriverNumber, LapNumber);

/*
 * Who was driving what, per session. Separate from the laps because it does not
 * change lap to lap, and repeating a team colour fourteen hundred times to
 * avoid one join is not a saving.
 */
create or modify persistent entity Formula1Backend.LiveDriver (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveDriver row id must be unique',
  SessionKey: string(20),
  DriverNumber: long,
  Code: string(10),
  DriverName: string(120),
  Team: string(120),
  TeamColour: string(10)
) index (SessionKey, DriverNumber);

/* Every stint, reconciled per sync: LapEnd is empty until the car pits. */
create or modify persistent entity Formula1Backend.LiveStintRow (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveStintRow row id must be unique',
  SessionKey: string(20),
  DriverNumber: long,
  StintNumber: long,
  Compound: string(20),
  LapStart: long,
  LapEnd: long,
  TyreAgeAtStart: long
) index (SessionKey, DriverNumber, StintNumber);

/* Race control, append-only. */
create or modify persistent entity Formula1Backend.LiveMessageRow (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveMessageRow row id must be unique',
  SessionKey: string(20),
  At: string(20),
  Category: string(40),
  Flag: string(20),
  Scope: string(40),
  Lap: long,
  Message: string(500)
) index (SessionKey, At);

/*
 * Weather as a series rather than a reading. The snapshot kept only the latest
 * sample; a replay wants the curve, and it is one row a minute.
 */
create or modify persistent entity Formula1Backend.LiveWeatherRow (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveWeatherRow row id must be unique',
  SessionKey: string(20),
  At: string(20),
  AirTemperature: decimal,
  TrackTemperature: decimal,
  Humidity: decimal,
  Rainfall: decimal,
  WindSpeed: decimal
) index (SessionKey, At);

/* One row per session, reconciled per sync. */
create or modify persistent entity Formula1Backend.LiveSessionRow (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveSessionRow row id must be unique',
  SessionKey: string(20),
  SessionName: string(60),
  SessionType: string(40),
  Location: string(120),
  CountryName: string(60),
  CircuitName: string(120),
  DateStart: string(40),
  Year: long,
  DriverCount: long,
  LeadLap: long,
  FetchedAt: string(30)
) index (SessionKey);

/* ------------------------------------------------------------- the state -- */

/*
 * The bearer token, and when it stops working.
 *
 * A row rather than a constant because it is minted at runtime and replaced
 * roughly hourly. AccessToken is PRIVATE-by-convention: nothing publishes this
 * entity, and the ops resource that reports sync health exposes ExpiresAt
 * without it.
 */
create or modify persistent entity Formula1Backend.LiveToken (
  AccessToken: string(4000),
  ExpiresAt: datetime
);

/*
 * What the scheduled event is doing, and whether it should be.
 *
 * Enabled defaults to false. A scheduled event that starts polling a paid API
 * the moment someone runs the model scripts is a surprise, and on Mendix Cloud
 * it would be a surprise that costs money; switching it on is a deliberate act.
 *
 * SessionKey empty means "the session OpenF1 calls latest".
 */
create or modify persistent entity Formula1Backend.LiveSyncState (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveSyncState row id must be unique',
  Enabled: boolean,
  SessionKey: string(20),
  /*
   * Where telemetry has been read up to, on the *session's* clock.
   *
   * Empty means "follow the wall clock", which is what a live race wants. Set
   * it and the sync walks a finished session forward from that point instead,
   * which is the only way to backfill telemetry for a race that has already
   * happened -- car_data three minutes ago is nothing at all if the race was
   * last month.
   */
  TelemetryCursor: datetime,
  LastRunAt: datetime,
  LastResult: string(500),
  LapsWritten: long,
  RunCount: long
);

/* -------------------------------------------------------------- the state -- */

/*
 * The one LiveSyncState row, created if it is not there.
 *
 * There is exactly one of these, and until this existed there were two: both
 * Sync_Live and Ops_LiveSyncSet created a row when they found none, and running
 * them in either order produced a pair. Nothing failed loudly -- `RETRIEVE ...
 * LIMIT 1` simply returned whichever the database offered, so switching the
 * sync on could update one row while the cycle read the other and stayed off.
 *
 * A singleton has to be created in one place to be a singleton. Everything that
 * wants the state calls this, and the surplus rows are cleared on the way past
 * so an app that already has two converges on one.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_State ()
  RETURNS Formula1Backend.LiveSyncState AS $State
BEGIN
  RETRIEVE $Rows FROM Formula1Backend.LiveSyncState;
  DECLARE $Seen Long = 0;
  LOOP $R IN $Rows BEGIN
    SET $Seen = $Seen + 1;
    IF $Seen > 1 THEN
      DELETE $R;
    END IF;
  END LOOP;

  /* The retrieve binds $State and the create binds $Created: a microflow's
   * variable names are unique flow-wide, so one name cannot be filled by both. */
  RETRIEVE $State FROM Formula1Backend.LiveSyncState LIMIT 1;
  IF $State = empty THEN
    $Created = CREATE Formula1Backend.LiveSyncState (
      Enabled = false, SessionKey = '', LapsWritten = 0, RunCount = 0) COMMIT;
    LOG INFO NODE 'F1LiveSync' 'live sync state created, disabled';
    RETURN $Created;
  END IF;
  RETURN $State;
END;

/* --------------------------------------------------------------- the key -- */

/*
 * Credentials, as constants rather than as a file.
 *
 * Constants are what Mendix Cloud gives you a place to set per environment,
 * which is the whole point of moving off the shell script: the same model
 * deploys to a laptop and to a cloud node and neither needs a dotfile. Empty by
 * default, and empty is a working configuration -- OpenF1 serves historical
 * sessions unauthenticated and only closes the door while a session is running.
 */
create or modify constant Formula1Backend.OpenF1BaseUrl type string
  default 'https://api.openf1.org/v1'
  comment 'OpenF1 REST base. Override to point at a mirror or a recording.';

create or modify constant Formula1Backend.OpenF1TokenUrl type string
  default 'https://api.openf1.org/token'
  comment 'OpenF1 OAuth2 token endpoint (password grant).';

create or modify constant Formula1Backend.OpenF1Username type string default ''
  comment 'OpenF1 account. Leave empty to run unauthenticated (historical only).';

create or modify constant Formula1Backend.OpenF1Password type string default '' PRIVATE;

/*
 * The token response is parsed by the warehouse, not by an import mapping.
 *
 * A JSON structure plus an import mapping is the Mendix way to do this, and it
 * does not survive being written from MDL. The runtime answers a valid 975-char
 * response with
 *
 *   key not found: Path(QName(None,),None,)
 *
 * -- an empty element name -- both as the REST call''s RETURNS MAPPING and as a
 * standalone Import activity, from a mapping whose model reads back correctly
 * (`(Object)|access_token`, root `(Object)`). `mx check` passes. Two ways of
 * invoking it, one failure, so the mapping is the broken part rather than the
 * call. Filed as an mxcli defect.
 *
 * `GetOpenF1Token` in 01-foundation takes its place, which is how every other
 * OpenF1 response in this app is already parsed.
 */

CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_EnsureToken ()
  RETURNS String AS $Token
BEGIN
  DECLARE $Token String = '';

  RETRIEVE $Stored FROM Formula1Backend.LiveToken LIMIT 1;
  IF $Stored != empty AND $Stored/ExpiresAt != empty
     AND $Stored/ExpiresAt > addMinutes([%CurrentDateTime%], 5) THEN
    SET $Token = $Stored/AccessToken;
    RETURN $Token;
  END IF;

  IF trim(@Formula1Backend.OpenF1Username) = ''
     OR trim(@Formula1Backend.OpenF1Password) = '' THEN
    RETURN $Token;
  END IF;

  $Raw = REST CALL POST '{1}'
    WITH ({1} = @Formula1Backend.OpenF1TokenUrl)
    HEADER 'Content-Type' = 'application/x-www-form-urlencoded'
    BODY 'username={1}&password={2}'
      WITH ({1} = urlEncode(@Formula1Backend.OpenF1Username),
            {2} = urlEncode(@Formula1Backend.OpenF1Password))
    TIMEOUT 30
    RETURNS String
    ON ERROR CONTINUE;

  IF trim($Raw) = '' THEN
    LOG WARNING NODE 'F1LiveSync' 'OpenF1 token request returned nothing';
    RETURN $Token;
  END IF;

  /*
   * Mapped as its own activity rather than as the REST call's RETURNS MAPPING.
   *
   * The same mapping, applied the second way, fails on a perfectly good
   * response with `key not found: Path(QName(None,),None,)` -- an empty element
   * name, from a structure whose paths read back correctly as `(Object)|access_token`.
   * Fetching the body as text and mapping it in the next activity is the same
   * two steps in the same order, and it works.
   */
  $Parsed = execute database query Formula1Backend.F1Warehouse.GetOpenF1Token
    (tokenJson = $Raw);

  /* One row, but a query returns a list, and a list is read with a loop. */
  DECLARE $Access String = '';
  DECLARE $Ttl Integer = 3600;
  LOOP $R IN $Parsed BEGIN
    SET $Access = $R/AccessToken;
    IF $R/ExpiresIn != empty AND $R/ExpiresIn > 0 THEN
      SET $Ttl = $R/ExpiresIn;
    END IF;
  END LOOP;

  /* A body that parsed but carries no token is a rejection -- a wrong password,
   * or an account that is not a sponsor. Say which, rather than returning empty
   * and letting the sync quietly carry on at the free tier. */
  IF trim($Access) = '' THEN
    LOG WARNING NODE 'F1LiveSync'
      'OpenF1 token response carried no access_token ('
      + toString(length($Raw)) + ' chars); check the credentials';
    RETURN $Token;
  END IF;

  SET $Token = $Access;

  IF $Stored = empty THEN
    $New = CREATE Formula1Backend.LiveToken (
      AccessToken = $Token,
      ExpiresAt = addSeconds([%CurrentDateTime%], $Ttl)
    ) COMMIT;
  ELSE
    CHANGE $Stored (
      AccessToken = $Token,
      ExpiresAt = addSeconds([%CurrentDateTime%], $Ttl)
    ) COMMIT;
  END IF;

  LOG INFO NODE 'F1LiveSync' 'OpenF1 token minted, valid for '
    + toString($Ttl div 60) + ' minutes';
  RETURN $Token;
END;

/* ------------------------------------------------------------- the stage -- */

/*
 * Where a sync lands before anything is kept.
 *
 * The same shape as LiveLap, persistent so an OQL statement can see it. A sync
 * writes every lap it fetched here, promotes the ones that are new in one
 * statement, and empties it. That is the skill pack's stage-and-promote
 * pattern, and it is what makes "append only what is missing" a single
 * statement instead of fourteen hundred existence checks.
 */
create or modify persistent entity Formula1Backend.LiveLapStage (
  /* An OData key. Composite natural keys are what these tables actually have,
   * and Mendix will not publish one, so the runtime supplies a surrogate.
   * `default 1` is the seed; without it the build fails CE7247. */
  RowId: autonumber default 1 unique error 'LiveLapStage row id must be unique',
  SessionKey: string(20),
  DriverNumber: long,
  LapNumber: long,
  Position: long,
  GapToLeader: string(20),
  GapSeconds: decimal,
  LapSeconds: decimal,
  Sector1: decimal,
  Sector2: decimal,
  Sector3: decimal,
  SpeedTrap: long,
  Compound: string(20),
  TyreAge: long,
  PitStops: long
) index (SessionKey, DriverNumber, LapNumber);

/*
 * Wait, so that a scheduled event can be a worker rather than a tick.
 *
 * Mendix schedules no finer than a minute. A cycle that wants to run every ten
 * seconds therefore cannot be a schedule -- it has to be a loop inside one, and
 * a loop that polls an API needs to pause between passes. There is no activity
 * for that, so this is the smallest possible Java action.
 *
 * Milliseconds rather than seconds, because the other thing that needs to wait
 * is the gap between two API calls, and that gap is a fraction of a second.
 *
 * Capped at sixty seconds. An unbounded sleep inside a scheduled event is a way
 * to occupy a runtime thread indefinitely, and the cap makes that a typo rather
 * than an outage.
 */
create or replace java action Formula1Backend.Sync_Sleep (
  Millis: Integer NOT NULL
) RETURNS Boolean
AS $$
    long ms = Millis == null ? 0L : Millis.longValue();
    if (ms < 0) ms = 0;
    if (ms > 60000) ms = 60000;
    try {
        Thread.sleep(ms);
        return true;
    } catch (InterruptedException e) {
        Thread.currentThread().interrupt();
        return false;
    }
$$;

/*
 * One OpenF1 GET, paced.
 *
 * Its own microflow so the bearer-or-not branch is written once rather than
 * five times, and so the five calls are unmistakably sequential: OpenF1 allows
 * three requests a second, and the previous design's parallel scans are exactly
 * what tripped that.
 *
 * Sequential turned out not to be enough. Mendix issues these back to back --
 * a pass fired nine requests in 240ms -- and OpenF1 answers the fourth onward
 * with 429 "Max 3 requests/second". `ON ERROR CONTINUE` turns each 429 into an
 * empty body, `[]` is valid JSON, and the derivation reads it as a session with
 * no data in it. Nothing failed: the laps table filled and every other table
 * stayed empty, which looks exactly like an API that has nothing to give.
 *
 * So the gap is explicit. 700ms unauthenticated (1.4/s against an allowance of
 * 3) and 250ms with a bearer (4/s against 6) -- both comfortably under, because
 * the cost of being wrong is silence rather than an error.
 *
 * Returns the body as text. Nothing parses it here -- it goes to DuckDB as a
 * bound parameter and is taken apart there.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_Fetch (
  $Path: String,
  $Token: String
)
  RETURNS String AS $Body
BEGIN
  DECLARE $Body String = '';
  DECLARE $Url String = @Formula1Backend.OpenF1BaseUrl + '/' + $Path;

  DECLARE $Gap Integer = 700;
  IF trim($Token) != '' THEN
    SET $Gap = 250;
  END IF;
  $Paced = CALL JAVA ACTION Formula1Backend.Sync_Sleep(Millis = $Gap);

  IF trim($Token) != '' THEN
    $Authed = REST CALL GET '{1}'
      WITH ({1} = $Url)
      HEADER 'Accept' = 'application/json'
      HEADER 'Authorization' = 'Bearer ' + $Token
      TIMEOUT 120
      RETURNS String
      ON ERROR CONTINUE;
    SET $Body = $Authed;
  ELSE
    $Plain = REST CALL GET '{1}'
      WITH ({1} = $Url)
      HEADER 'Accept' = 'application/json'
      TIMEOUT 120
      RETURNS String
      ON ERROR CONTINUE;
    SET $Body = $Plain;
  END IF;

  /*
   * An empty body is ambiguous, and the two things it means want opposite
   * treatment: a 404 (the window genuinely holds no samples) is the end of the
   * matter, and a 429 (we asked too fast) means the data is there and we threw
   * it away. One retry after a second and a half tells them apart for the price
   * of a single request, and it is the difference between a race captured and a
   * race missed.
   */
  IF trim($Body) = '' THEN
    $Backoff = CALL JAVA ACTION Formula1Backend.Sync_Sleep(Millis = 1500);
    IF trim($Token) != '' THEN
      $Retry = REST CALL GET '{1}'
        WITH ({1} = $Url)
        HEADER 'Accept' = 'application/json'
        HEADER 'Authorization' = 'Bearer ' + $Token
        TIMEOUT 120
        RETURNS String
        ON ERROR CONTINUE;
      SET $Body = $Retry;
    ELSE
      $RetryPlain = REST CALL GET '{1}'
        WITH ({1} = $Url)
        HEADER 'Accept' = 'application/json'
        TIMEOUT 120
        RETURNS String
        ON ERROR CONTINUE;
      SET $Body = $RetryPlain;
    END IF;
  END IF;

  /*
   * Still empty: a real 404. car_data and location answer that way when the
   * requested window holds no samples rather than returning an empty list, and
   * that is a normal answer -- between sessions, during a red flag, or when the
   * window has run past the end of the race. An empty array is a shape from_json
   * can read and the derivation simply yields nothing.
   */
  IF trim($Body) = '' THEN
    SET $Body = '[]';
  END IF;
  LOG INFO NODE 'F1LiveSync' 'fetch ' + $Url + ' -> ' + toString(length($Body)) + ' chars';
  RETURN $Body;
END;

/* --------------------------------------------------------------- the run -- */

/*
 * One sync.
 *
 * Reads OpenF1 through the app's own DuckDB connection -- no shell, no
 * filesystem, so it runs the same on a Windows laptop and on a Mendix Cloud
 * node -- derives the lap table in SQL, and keeps what is new.
 *
 * Every fetch asks for the whole session and the result is merged over what is
 * already stored, so a cycle that misses -- a 429, a restart, a session that
 * started before the sync was pointed at it -- is repaired by the next one.
 * Laps are re-read rather than appended to because a lap already stored can
 * still be revised: the gap to the leader arrives after the lap does.
 */
CREATE OR REPLACE MICROFLOW Formula1Backend.Sync_Live ()
  RETURNS String AS $Result
BEGIN
  DECLARE $Result String = '';

  /*
   * First run creates the row switched off. A scheduled event that starts
   * polling a paid API the moment the model is applied is a surprise, and on
   * Mendix Cloud a surprise that bills; switching it on is a deliberate act.
   */
  $State = CALL MICROFLOW Formula1Backend.Sync_State();
  IF $State/Enabled != true THEN
    SET $Result = 'disabled';
    RETURN $Result;
  END IF;

  DECLARE $Key String = 'latest';
  IF trim($State/SessionKey) != '' THEN
    SET $Key = trim($State/SessionKey);
  END IF;

  $Token = CALL MICROFLOW Formula1Backend.Sync_EnsureToken();

  /*
   * Five GETs, one at a time, in a fixed order.
   *
   * The first version of this let DuckDB fetch the URLs itself. It worked and
   * it was fragile: DuckDB scans sources in parallel, so five requests left at
   * once against OpenF1's three-a-second, and the refusal came back as
   * "HTTP 0 Internal Server Error" -- which names neither the rate limit nor
   * HTTP. Sequential activities cannot burst, and each one carries the token in
   * a header instead of a DuckDB secret.
   *
   * All five are asked for the whole session.
   *
   * The laps read used to be narrowed to `lap_number >= (highest lap stored) -
   * 1`, on the reasoning that a race asks for the last two laps rather than the
   * whole race. The flaw is that "highest lap stored" is a maximum across all
   * cars, and cars are not all on the same lap. The moment one car's lap number
   * runs ahead, the window closes over everyone behind it and those laps are
   * never requested again -- the watermark only rises, so they are lost
   * permanently rather than late.
   *
   * It is not theoretical. Saturday's qualifying is the extreme case: two cars
   * reached lap 25 while the rest were on lap 9, and the stored session holds
   * 255 of the 377 laps that ran -- every car that was still running when the
   * watermark passed it is cut off mid-session. The sprint is the ordinary
   * case and lost 21 rows the same way, twenty of them one lapped car's entire
   * race after lap 1. Both were captured live and both looked complete.
   *
   * Fetching the whole lap table instead costs very little, because the
   * narrowing never saved much: intervals is unfiltered at 29,593 rows for a
   * full grand prix, against 1,423 laps. Laps were 13% of the bytes and 100%
   * of the data loss.
   *
   * The other four need their full history anyway: a position sample from
   * before this lap is exactly what the ASOF join is looking for, so trimming
   * them would break the derivation rather than speed it up.
   */
  $LapsJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'laps?session_key=' + $Key, Token = $Token);
  $PosJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'position?session_key=' + $Key, Token = $Token);
  $ItvJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'intervals?session_key=' + $Key, Token = $Token);
  $StintsJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'stints?session_key=' + $Key, Token = $Token);
  $PitJson = CALL MICROFLOW Formula1Backend.Sync_Fetch(
    Path = 'pit?session_key=' + $Key, Token = $Token);

  $Rows = execute database query Formula1Backend.F1Warehouse.GetOpenF1Laps
    (sessionKey = $Key, lapsJson = $LapsJson, posJson = $PosJson,
     itvJson = $ItvJson, stintsJson = $StintsJson, pitJson = $PitJson);

  /* Empty the stage before filling it: a previous run that died half way
   * through would otherwise promote its leftovers alongside this one's. */
  $Cleared = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'delete from Formula1Backend.LiveLapStage');

  LOOP $R IN $Rows BEGIN
    $Staged = CREATE Formula1Backend.LiveLapStage (
      SessionKey = $R/SessionKey, DriverNumber = $R/DriverNumber,
      LapNumber = $R/LapNumber, Position = $R/Position,
      GapToLeader = $R/GapToLeader, GapSeconds = $R/GapSeconds,
      LapSeconds = $R/LapSeconds, Sector1 = $R/Sector1, Sector2 = $R/Sector2,
      Sector3 = $R/Sector3, SpeedTrap = $R/SpeedTrap, Compound = $R/Compound,
      TyreAge = $R/TyreAge, PitStops = $R/PitStops) COMMIT;
  END LOOP;

  /*
   * A lap already stored is replaced rather than skipped, because the numbers
   * on it improve: a gap and a sector time arrive after the lap does, so the
   * row written the minute a car crossed the line is the least complete version
   * of it. Delete what the stage is about to supersede, then insert the lot --
   * two statements, whatever the row count.
   */
  $Superseded = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'delete from Formula1Backend.LiveLap where exists ('
      + 'select 1 from Formula1Backend.LiveLapStage as s'
      + ' where s.SessionKey = Formula1Backend.LiveLap/SessionKey'
      + ' and s.DriverNumber = Formula1Backend.LiveLap/DriverNumber'
      + ' and s.LapNumber = Formula1Backend.LiveLap/LapNumber)');

  $Kept = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'insert into Formula1Backend.LiveLap (SessionKey, DriverNumber,'
      + ' LapNumber, Position, GapToLeader, GapSeconds, LapSeconds, Sector1,'
      + ' Sector2, Sector3, SpeedTrap, Compound, TyreAge, PitStops)'
      + ' select s.SessionKey, s.DriverNumber, s.LapNumber, s.Position,'
      + ' s.GapToLeader, s.GapSeconds, s.LapSeconds, s.Sector1, s.Sector2,'
      + ' s.Sector3, s.SpeedTrap, s.Compound, s.TyreAge, s.PitStops'
      + ' from Formula1Backend.LiveLapStage as s');

  $Emptied = CALL JAVA ACTION Formula1Backend.OQL_Execute(
    Statement = 'delete from Formula1Backend.LiveLapStage');

  $Fetched = COUNT($Rows);
  SET $Result = 'session ' + $Key + ': fetched ' + toString($Fetched)
    + ', replaced ' + toString($Superseded) + ', kept ' + toString($Kept);
  IF trim($Token) = '' THEN
    SET $Result = $Result + ' (unauthenticated)';
  END IF;

  CHANGE $State (
    LastRunAt = [%CurrentDateTime%],
    LastResult = $Result,
    LapsWritten = $Kept,
    RunCount = $State/RunCount + 1
  ) COMMIT;

  LOG INFO NODE 'F1LiveSync' $Result;
  RETURN $Result;
END;

/* -------------------------------------------------------------- the timer -- */

/*
 * The scheduled event lives in 20, not here.
 *
 * It used to be defined in both, pointing at Sync_Live here and at Sync_Cycle
 * there, so whichever script ran last decided which tiers a race captured. The
 * cycle is the one that should be scheduled; the core sync is one tier of it.
 */
