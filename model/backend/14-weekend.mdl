    S2Value as 's2value' (Filterable, Sortable),
    S3Value as 's3value' (Filterable, Sortable),
    S4Value as 's4value' (Filterable, Sortable),
    S5Value as 's5value' (Filterable, Sortable),
    S6Value as 's6value' (Filterable, Sortable),
    S7Value as 's7value' (Filterable, Sortable),
    S8Value as 's8value' (Filterable, Sortable),
    S9Value as 's9value' (Filterable, Sortable),
    S10Value as 's10value' (Filterable, Sortable)
