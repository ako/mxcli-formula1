    Fp1LeaderTime as 'fp1LeaderTime' (Filterable, Sortable),
    Fp2LeaderName as 'fp2LeaderName' (Filterable, Sortable),
    Fp2LeaderTime as 'fp2LeaderTime' (Filterable, Sortable),
    Fp3LeaderName as 'fp3LeaderName' (Filterable, Sortable),
    Fp3LeaderTime as 'fp3LeaderTime' (Filterable, Sortable)
  );

  publish entity Formula1Backend.Stg_RaceSession as 'RaceSessions' (
    ReadMode: microflow Formula1Backend.Read_RaceSessions,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    SessionKey as 'sessionKey' (KEY, Filterable, Sortable),
    RaceId as 'raceId' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    Round as 'round' (Filterable, Sortable),
    DriverId as 'driverId' (Filterable, Sortable),
