  publish entity Formula1Backend.Stg_DriverSeason as 'DriverSeasons' (
    ReadMode: microflow Formula1Backend.Read_DriverSeasons,
    InsertMode: not_supported, UpdateMode: not_supported, DeleteMode: not_supported,
    Countable: Yes
  )
  expose (
    SeasonKey as 'seasonKey' (KEY, Filterable, Sortable),
    DriverId as 'driverId' (Filterable, Sortable),
    Year as 'year' (Filterable, Sortable),
    Constructors as 'constructors' (Filterable, Sortable),
    StandingPosition as 'standingPosition' (Filterable, Sortable),
    StandingOrder as 'standingOrder' (Filterable, Sortable),
    Points as 'points' (Filterable, Sortable),
    Starts as 'starts' (Filterable, Sortable),
    Wins as 'wins' (Filterable, Sortable),
    Podiums as 'podiums' (Filterable, Sortable),
    Poles as 'poles' (Filterable, Sortable),
