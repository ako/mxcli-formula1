    Fp2Gap as 'fp2Gap' (Filterable, Sortable),
    Fp3Position as 'fp3Position' (Filterable, Sortable),
    Fp3Time as 'fp3Time' (Filterable, Sortable),
    Fp3Gap as 'fp3Gap' (Filterable, Sortable),
    QualPosition as 'qualPosition' (Filterable, Sortable),
    QualTime as 'qualTime' (Filterable, Sortable),
    QualGap as 'qualGap' (Filterable, Sortable),
    Q1 as 'q1' (Filterable, Sortable),
    Q2 as 'q2' (Filterable, Sortable),
    Q3 as 'q3' (Filterable, Sortable),
    GridPosition as 'gridPosition' (Filterable, Sortable),
    FinishPosition as 'finishPosition' (Filterable, Sortable),
    PositionText as 'positionText' (Filterable, Sortable),
