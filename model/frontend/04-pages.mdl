/*
 * The browsing UI.
 *
 * Every grid sits on an external entity, so every scroll, sort and filter is an
 * OData request to the backend. That is the point: the Drivers pages exist twice,
 * once per service, so the two data paths can be compared in a real UI rather
 * than with curl.
 *
 * Grids use paging buttons and a PageSize, which is what becomes
 * $skip / $top / $orderby / $count on the wire. Text filters become $filter.
 *
 * No navigation snippet here. The Responsive navigation profile (05) already
 * renders a menu rail, and an in-page menu was a second copy of it taking 2/12
 * of the width away from the grid.
 */
/* ----------------------------------------------------------------- drivers -- */

/*
 * The comparison pair. Identical grids, different datasource module.
 *
 * Sorting a column here emits $orderby, turning a page emits $skip/$top, and the
 * row count in the pager comes from $count. On the live page all of that lands
 * in Read_Drivers and becomes ORDER BY / LIMIT / OFFSET against a CSV.
 */
create or replace page Formula1Frontend.Drivers_Live
(
  title: 'Drivers — live from the CSVs',
  layout: Atlas_Core.Atlas_Default,
  url: 'drivers-live'
)
{
  container pageBody {
        dynamictext heading (content: 'Drivers — live from the CSVs', rendermode: H2)
        container note (class: 'mx-spacing-bottom-medium') {
          dynamictext noteText (content: 'Served by F1LiveApi. Each page of this grid is one DuckDB scan of f1db-drivers.csv; the sort and the page window are pushed into the SQL.')
        }
        datagrid dgDriversLive (
          datasource: database F1Live.Drivers,
          PageSize: 20,
          PagingPosition: both
        ) {
          column colName (attribute: name, caption: 'Driver') {
            textfilter fName (attribute: name)
          }
          column colNationality (attribute: nationality, caption: 'Nationality') {
            textfilter fNat (attribute: nationality)
          }
          column colWins (attribute: raceWins, caption: 'Wins', Alignment: right)
          column colPodiums (attribute: podiums, caption: 'Podiums', Alignment: right)
          column colPoles (attribute: polePositions, caption: 'Poles', Alignment: right)
          column colStarts (attribute: raceStarts, caption: 'Starts', Alignment: right)
          column colTitles (attribute: championshipWins, caption: 'Titles', Alignment: right)
          column colOpen (caption: '') {
            linkbutton btnCareer (Caption: 'Career',
              Action: SHOW_PAGE Formula1Frontend.Driver_Career(Driver: $currentObject))
          }
        }
  }
}

create or replace page Formula1Frontend.Drivers_Cached
(
  title: 'Drivers — cached',
  layout: Atlas_Core.Atlas_Default,
  url: 'drivers'
)
{
  container pageBody {
        dynamictext heading (content: 'Drivers — cached', rendermode: H2)
        container note (class: 'mx-spacing-bottom-medium') {
          dynamictext noteText (content: 'Served by F1CachedApi out of the backend database. Same 917 rows as the live page; Mendix does the paging and filtering in SQL against Postgres.')
        }
        datagrid dgDriversCached (
          datasource: database F1Cached.Drivers,
          PageSize: 20,
          PagingPosition: both
        ) {
          column colName (attribute: name, caption: 'Driver') {
            textfilter fName (attribute: name)
          }
          column colNationality (attribute: nationality, caption: 'Nationality') {
            textfilter fNat (attribute: nationality)
          }
          column colWins (attribute: raceWins, caption: 'Wins', Alignment: right)
          column colPodiums (attribute: podiums, caption: 'Podiums', Alignment: right)
          column colPoles (attribute: polePositions, caption: 'Poles', Alignment: right)
          column colStarts (attribute: raceStarts, caption: 'Starts', Alignment: right)
          column colTitles (attribute: championshipWins, caption: 'Titles', Alignment: right)
        }
  }
}

/* ----------------------------------------------------------------- seasons -- */

create or replace page Formula1Frontend.Seasons_Overview
(
  title: 'Seasons',
  layout: Atlas_Core.Atlas_Default,
  url: 'seasons'
)
{
  container pageBody {
        dynamictext heading (content: 'Seasons', rendermode: H2)
        datagrid dgSeasons (
          datasource: database F1Cached.Seasons,
          PageSize: 20,
          PagingPosition: both,
          selection: single
        ) {
          column colYear (attribute: year, caption: 'Season')
          column colChampion (attribute: championDriver, caption: 'Champion') {
            textfilter fChampion (attribute: championDriver)
          }
          column colConstructor (attribute: championConstructor, caption: 'Constructors champion')
          column colRaces (attribute: raceCount, caption: 'Races', Alignment: right)
          column colOpenSeason (caption: '') {
            linkbutton btnSeason (Caption: 'Summary',
              Action: SHOW_PAGE Formula1Frontend.Season_Summary(Season: $currentObject))
          }
        }
  }
}

/* ------------------------------------------------------------ constructors -- */

create or replace page Formula1Frontend.Constructors_Overview
(
  title: 'Constructors',
  layout: Atlas_Core.Atlas_Default,
  url: 'constructors'
)
{
  container pageBody {
        dynamictext heading (content: 'Constructors', rendermode: H2)
        datagrid dgConstructors (
          datasource: database F1Cached.Constructors,
          PageSize: 20,
          PagingPosition: both
        ) {
          column colName (attribute: name, caption: 'Constructor') {
            textfilter fName (attribute: name)
          }
          column colCountry (attribute: country, caption: 'Country') {
            textfilter fCountry (attribute: country)
          }
          column colWins (attribute: raceWins, caption: 'Wins', Alignment: right)
          column colPodiums (attribute: podiums, caption: 'Podiums', Alignment: right)
          column colTitles (attribute: championshipWins, caption: 'Titles', Alignment: right)
          column colPoints (attribute: points, caption: 'Points', Alignment: right)
          column colOpenTeam (caption: '') {
            linkbutton btnTeam (Caption: 'Reliability',
              Action: SHOW_PAGE Formula1Frontend.Constructor_Detail(Constructor: $currentObject))
          }
        }
  }
}

/* ---------------------------------------------------------------- circuits -- */

create or replace page Formula1Frontend.Circuits_Overview
(
  title: 'Circuits',
  layout: Atlas_Core.Atlas_Default,
  url: 'circuits'
)
{
  container pageBody {
        dynamictext heading (content: 'Circuits', rendermode: H2)
        datagrid dgCircuits (
          datasource: database F1Cached.Circuits,
          PageSize: 20,
          PagingPosition: both
        ) {
          column colName (attribute: name, caption: 'Circuit') {
            textfilter fName (attribute: name)
          }
          column colPlace (attribute: placeName, caption: 'Place') {
            textfilter fPlace (attribute: placeName)
          }
          column colCountry (attribute: country, caption: 'Country') {
            textfilter fCountry (attribute: country)
          }
          column colLength (attribute: length, caption: 'Length (km)', Alignment: right)
          column colTurns (attribute: turns, caption: 'Turns', Alignment: right)
          column colHeld (attribute: racesHeld, caption: 'Races held', Alignment: right)
        }
  }
}

/* ------------------------------------------------------------ race results -- */

/*
 * 27533 rows. This grid only works because both services page — it is the
 * resource the live service could not publish at all before pushdown.
 */
create or replace page Formula1Frontend.RaceResults_Overview
(
  title: 'Race results',
  layout: Atlas_Core.Atlas_Default,
  url: 'results'
)
{
  container pageBody {
        dynamictext heading (content: 'Race results', rendermode: H2)
        container note (class: 'mx-spacing-bottom-medium') {
          dynamictext noteText (content: '27533 results across every season. Filter by driver or constructor; the filter becomes an OData $filter and, on the live service, a SQL WHERE against the CSVs.')
        }
        datagrid dgResults (
          datasource: database F1Cached.RaceResults,
          PageSize: 25,
          PagingPosition: both
        ) {
          column colYear (attribute: year, caption: 'Season')
          column colRound (attribute: round, caption: 'Round', Alignment: right)
          column colPos (attribute: positionText, caption: 'Pos')
          column colDriver (attribute: driverName, caption: 'Driver') {
            textfilter fDriver (attribute: driverName)
          }
          column colConstructor (attribute: constructorName, caption: 'Constructor') {
            textfilter fConstructor (attribute: constructorName)
          }
          column colGrid (attribute: gridPosition, caption: 'Grid', Alignment: right)
          column colPoints (attribute: points, caption: 'Points', Alignment: right)
          column colRetired (attribute: reasonRetired, caption: 'Retired')
        }
  }
}

/*
 * Home last of the pages, because its two cards link to the Drivers pages and a
 * page reference has to already exist when the referring page is built.
 */

create or replace page Formula1Frontend.Home
(
  title: 'Formula 1 — historical data',
  layout: Atlas_Core.Atlas_Default,
  url: 'home'
)
{
  container pageBody {
        dynamictext heading (content: 'Formula 1 — every season since 1950', rendermode: H1)
        container intro (class: 'mx-spacing-bottom-large') {
          dynamictext introText (content: 'Drivers, constructors, circuits, races and 27533 race results, read from CSV files by DuckDB and served over OData. Nothing here is typed in by hand.')
        }

        layoutgrid cards {
          row cardRow {
            column colLive (desktopwidth: 6) {
              container liveCard (class: 'card') {
                dynamictext liveHead (content: 'Live — read from the CSVs', rendermode: H3)
                container liveBody {
                  dynamictext liveText (content: 'Every request runs a DuckDB query against the CSV files. Nothing is stored, so it can never be stale. Sorting and paging are translated into SQL by the read microflow.')
                }
                actionbutton btnLive (caption: 'Browse drivers (live)', action: show_page Formula1Frontend.Drivers_Live, buttonstyle: primary)
              }
            }
            column colCached (desktopwidth: 6) {
              container cachedCard (class: 'card') {
                dynamictext cachedHead (content: 'Cached — materialised in Postgres', rendermode: H3)
                container cachedBody {
                  dynamictext cachedText (content: 'The same data loaded into the backend database by a refresh job. Mendix pages and filters it natively, and it carries navigation properties the live service cannot.')
                }
                actionbutton btnCached (caption: 'Browse drivers (cached)', action: show_page Formula1Frontend.Drivers_Cached, buttonstyle: primary)
              }
            }
          }
        }
  }
}
