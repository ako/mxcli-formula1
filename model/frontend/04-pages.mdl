/* ---------------------------------------------------------------- circuits -- */

create or replace page Formula1Frontend.Circuits_Overview
(
  title: 'Circuits',
  layout: Atlas_Core.Atlas_Default,
  url: 'circuits'
)
{
  container pageBody {
    container head (class: 'pagehead') {
      container headMain (class: 'pagehead-main') {
        dynamictext eyebrow (content: 'Browse', class: 'pagehead-eyebrow')
        dynamictext title (content: 'Circuits', rendermode: H2, class: 'pagehead-title')
        dynamictext sub (content: 'every venue the championship has visited', class: 'pagehead-sub')
      }
    }

    container panel (class: 'panel grid-dense') {
        datagrid dgCircuits (
          datasource: database F1Cached.Circuits,
          PageSize: 20,
          PagingPosition: both
        ) {
          column colName (attribute: name, caption: 'Circuit') {
            textfilter fName (attribute: name)
          }
          column colPlace (attribute: placeName, caption: 'Place') {
            textfilter fPlace (attribute: placeName)
          }
          column colCountry (attribute: country, caption: 'Country') {
            textfilter fCountry (attribute: country)
          }
          column colLength (attribute: length, caption: 'Length (km)', Alignment: right)
          column colTurns (attribute: turns, caption: 'Turns', Alignment: right)
          column colHeld (attribute: racesHeld, caption: 'Races held', Alignment: right)
        }
    }
  }
}

/* ------------------------------------------------------------ race results -- */

/*
 * 27533 rows. This grid only works because both services page — it is the
 * resource the live service could not publish at all before pushdown.
 */
create or replace page Formula1Frontend.RaceResults_Overview
(
  title: 'Race results',
  layout: Atlas_Core.Atlas_Default,
  url: 'results'
)
{
  container pageBody {
    container head (class: 'pagehead') {
      container headMain (class: 'pagehead-main') {
        dynamictext eyebrow (content: 'Browse', class: 'pagehead-eyebrow')
        dynamictext title (content: 'Race results', rendermode: H2, class: 'pagehead-title')
        dynamictext sub (content: '27533 classifications, one page at a time', class: 'pagehead-sub')
      }
    }

    container panel (class: 'panel grid-dense') {
        datagrid dgResults (
          datasource: database F1Cached.RaceResults,
          PageSize: 25,
          PagingPosition: both
        ) {
          column colYear (attribute: year, caption: 'Season')
          column colRound (attribute: round, caption: 'Round', Alignment: right)
          column colPos (attribute: positionText, caption: 'Pos')
          column colDriver (attribute: driverName, caption: 'Driver') {
            textfilter fDriver (attribute: driverName)
          }
          column colConstructor (attribute: constructorName, caption: 'Constructor') {
            textfilter fConstructor (attribute: constructorName)
          }
          column colGrid (attribute: gridPosition, caption: 'Grid', Alignment: right)
          column colPoints (attribute: points, caption: 'Points', Alignment: right)
          column colRetired (attribute: reasonRetired, caption: 'Retired')
        }
    }
  }
}

/*
 * Home last of the pages, because its cards link to the Drivers pages and a
 * page reference has to already exist when the referring page is built.
 */

create or replace page Formula1Frontend.Home
(
  title: 'Formula 1 — historical data',
  layout: Atlas_Core.Atlas_Default,
  url: 'home'
)
{
  container pageBody {
    container head (class: 'pagehead') {
      container headMain (class: 'pagehead-main') {
        dynamictext eyebrow (content: 'Formula 1', class: 'pagehead-eyebrow')
        dynamictext title (content: 'Every season since 1950', rendermode: H1,
                           class: 'pagehead-title')
        dynamictext sub (
          content: 'Drivers, constructors, circuits, races and race results, read from CSV files by DuckDB and served over OData. Nothing here is typed in by hand.',
          class: 'pagehead-sub')
      }
      container headBadge (class: 'pagehead-badge') {
        dynamictext seasons (content: '77')
      }
    }

    container kpis (class: 'kpis') {
      container kRaces (class: 'kpi') {
        dynamictext kRacesL (content: 'Races', class: 'kpi-label')
        dynamictext kRacesV (content: '1171', class: 'kpi-value')
      }
      container kDrivers (class: 'kpi') {
        dynamictext kDriversL (content: 'Drivers', class: 'kpi-label')
        dynamictext kDriversV (content: '917', class: 'kpi-value')
      }
      container kTeams (class: 'kpi') {
        dynamictext kTeamsL (content: 'Constructors', class: 'kpi-label')
        dynamictext kTeamsV (content: '187', class: 'kpi-value')
      }
      container kCircuits (class: 'kpi') {
        dynamictext kCircuitsL (content: 'Circuits', class: 'kpi-label')
        dynamictext kCircuitsV (content: '78', class: 'kpi-value')
      }
      container kResults (class: 'kpi kpi-accent') {
        dynamictext kResultsL (content: 'Classifications', class: 'kpi-label')
        dynamictext kResultsV (content: '27533', class: 'kpi-value')
      }
    }

    container ways (class: 'split-even') {
      container liveCard (class: 'panel') {
        container liveHead (class: 'panel-head') {
          dynamictext liveTitle (content: 'Live', class: 'panel-title')
          dynamictext liveSub (content: 'read from the CSVs', class: 'panel-sub')
        }
        container liveBody {
          dynamictext liveText (content: 'Every request runs a DuckDB query against the CSV files. Nothing is stored, so it can never be stale. Sorting and paging are translated into SQL by the read microflow.')
        }
        container liveActions (class: 'section-gap') {
          actionbutton btnLive (caption: 'Browse drivers (live)',
            action: show_page Formula1Frontend.Drivers_Live, buttonstyle: primary)
        }
      }
      container cachedCard (class: 'panel') {
        container cachedHead (class: 'panel-head') {
          dynamictext cachedTitle (content: 'Cached', class: 'panel-title')
          dynamictext cachedSub (content: 'materialised in Postgres', class: 'panel-sub')
        }
        container cachedBody {
          dynamictext cachedText (content: 'The same data loaded into the backend database by a refresh job. Mendix pages and filters it natively, and it carries navigation properties the live service cannot.')
        }
        container cachedActions (class: 'section-gap') {
          actionbutton btnCached (caption: 'Browse drivers (cached)',
            action: show_page Formula1Frontend.Drivers_Cached, buttonstyle: primary)
        }
      }
    }

    container startPanel (class: 'panel') {
      container startHead (class: 'panel-head') {
        dynamictext startTitle (content: 'Where to start', class: 'panel-title')
        dynamictext startSub (content: 'every overview opens a detail page',
                              class: 'panel-sub')
      }
      container startLegend (class: 'legend') {
        dynamictext c1 (content: 'Seasons → the title fight, round by round', class: 'chip')
        dynamictext c2 (content: 'Drivers → a career, session by session', class: 'chip')
        dynamictext c3 (content: 'Constructors → what stopped the cars', class: 'chip')
      }
    }
  }
}
