/*
 * Screen 1 of 5 — Narrate.
 * ========================
 *
 * The race as it stands, and how it got there.
 *
 * Everything else in this app reads a file that changes when someone publishes
 * a release. This screen reads a snapshot of a session that was moving when it
 * was taken, so it says when it was taken and where it came from — both are on
 * the page, not in a comment.
 *
 * "Live" is bounded honestly: the backend serves whatever
 * scripts/fetch-f1-live.sh last wrote. Re-run that and reload for the next
 * snapshot; on a race Sunday run it on a timer with SESSION=latest, and
 * OpenF1's ~3s delay is the floor. Note that OpenF1 turns off unauthenticated
 * access *while a session is running*, so the timer needs a paid key to be
 * worth setting — the script says so when it hits it.
 *
 * One thing in the comp is still not here, and its absence is deliberate
 * rather than pending: the story panel wants precedents and streaks read out of
 * seventy-five years of results by an agent pass. There is no such resource,
 * and inventing the sentences on the page is exactly the failure the panel's
 * own comp warns about — "read the provenance line before you say it out loud".
 *
 * The track map used to be on that list, on the grounds that the snapshot
 * carried positions in the running order rather than positions in space. That
 * stopped being true when the in-app sync began storing OpenF1's location feed,
 * and the panel below is built from it.
 */

create or replace page Formula1Frontend.Narrate
(
  title: 'Narrate',
  layout: Atlas_Core.Atlas_Default,
  url: 'narrate'
)
{
  container pageBody (class: 'narrate-dense') {

    dataview dvSession (datasource: MICROFLOW Formula1Frontend.DS_LiveSession) {

      /*
       * Identity and conditions on one line.
       *
       * They were two full-width bands stacked -- the circuit name over a
       * six-across tile grid -- which is two rows of chrome before any data.
       * The comp puts them on one: what this is on the left, what the air and
       * track are doing on the right, one hairline under both.
       *
       * The Lead lap tile went with the merge: the LAP badge two inches to its
       * left carried the same number.
       */
      container liveBar (class: 'live-bar') {
        container head (class: 'pagehead') {
          container headMain (class: 'pagehead-main') {
            dynamictext eyebrow (content: '{1} · {2}',
              contentparams: [{1} = sessionType, {2} = countryName],
              class: 'pagehead-eyebrow')
            dynamictext title (content: '{1}', contentparams: [{1} = circuitName],
                               rendermode: H2, class: 'pagehead-title')
            /*
             * The provenance line the comp puts in the header bar. It is one
             * sentence and it does the whole job of the badge: which source,
             * how fresh, and therefore how much to trust the numbers below.
             */
            dynamictext sub (content: 'openf1.org · snapshot taken {1}',
              contentparams: [{1} = fetchedAt], class: 'pagehead-sub')
          }
          container headBadge (class: 'pagehead-badge') {
            dynamictext lap (content: 'LAP {1}', contentparams: [{1} = leadLap])
          }
        }

        container kpis (class: 'kpis') {
          container kCars (class: 'kpi') {
            dynamictext kCarsL (content: 'Cars', class: 'kpi-label')
            dynamictext kCarsV (content: '{1}', contentparams: [{1} = driverCount],
                                class: 'kpi-value')
          }
          container kAir (class: 'kpi') {
            dynamictext kAirL (content: 'Air', class: 'kpi-label')
            dynamictext kAirV (content: '{1}°C', contentparams: [{1} = airTemperature],
                               class: 'kpi-value')
          }
          container kTrack (class: 'kpi') {
            dynamictext kTrackL (content: 'Track', class: 'kpi-label')
            dynamictext kTrackV (content: '{1}°C', contentparams: [{1} = trackTemperature],
                                 class: 'kpi-value')
          }
          container kRain (class: 'kpi') {
            dynamictext kRainL (content: 'Rain', class: 'kpi-label')
            dynamictext kRainV (content: '{1}', contentparams: [{1} = rainfall],
                                class: 'kpi-value')
            dynamictext kRainS (content: '0 = dry', class: 'kpi-sub')
          }
          container kWind (class: 'kpi') {
            dynamictext kWindL (content: 'Wind', class: 'kpi-label')
            dynamictext kWindV (content: '{1}', contentparams: [{1} = windSpeed],
                                class: 'kpi-value')
            dynamictext kWindS (content: 'm/s', class: 'kpi-sub')
          }
        }
      }
    }

    /*
     * Above the fold: the two things you look at while a race runs.
     *
     * These were five full-width panels stacked down the page, and the track
     * map alone was a 450px band holding one small figure -- so the
     * classification, which is the screen's whole reason to exist, started
     * below the fold. The comp does not do that: it is a fixed viewport with a
     * main column and a 336px rail beside it.
     *
     * Classification takes the width it needs for twenty cars and ten columns;
     * the circuit sits in the rail at the size a circuit actually needs.
     */
    /*
     * The race on the left, the talk about it on the right.
     *
     * Left is what the cars are doing; right is a reading column, full height
     * and sticky, because a race control message needs a line of prose rather
     * than a table cell it gets truncated in.
     */
    container liveMain (class: 'live-main') {

      container liveLeft (class: 'live-left') {

        /*
         * The order and the circuit, side by side. They are the two things you
         * look at while a race runs and both are about a screen-half wide --
         * twenty-two rows of ten columns, and a drawing. Stacking them cost a
         * scroll to see either.
         */
        container liveFold (class: 'live-fold') {
          /*
           * The classification.
           *
           * The comp puts a position sparkline in every row. A Mendix data grid
           * column holds an attribute, not a widget, so that is drawn once for
           * everybody as the chart below instead.
           *
           * The three sector marks are cells rather than glyphs, coloured by
           * DynamicCellClass: purple for the best anybody has set this session,
           * green for the best this driver has. On a finished race they are all
           * blank, and correctly so — the last lap is rarely anyone's best.
           */
          container orderPanel (class: 'panel') {
            container orderHead (class: 'panel-head') {
              dynamictext orderTitle (content: 'Classification', class: 'panel-title')
              dynamictext orderSub (
                content: 'gap to leader and to the car ahead · last lap and its three sectors · tyre, age and stops',
                class: 'panel-sub')
            }
            container orderGrid (class: 'grid-dense') {
              datagrid dgOrder (
                datasource: MICROFLOW Formula1Frontend.DS_LiveOrder,
                PageSize: 24,
                PagingPosition: bottom
              ) {
                column colPos (attribute: position, caption: 'P', Alignment: right)
                column colCode (attribute: code, caption: 'Code')
                column colDriver (attribute: driverName, caption: 'Driver')
                column colTeam (attribute: team, caption: 'Team')
                column colGap (attribute: gapToLeader, caption: 'Gap', Alignment: right)
                column colInt (attribute: interval, caption: 'Int', Alignment: right)
                column colLast (attribute: lastLapSeconds, caption: 'Last', Alignment: right)
                column colS1 (attribute: sector1, caption: 'S1', Alignment: right,
                  DynamicCellClass:
                    'if $currentObject/sector1Mark = ''p'' then ''sec-best''
                     else if $currentObject/sector1Mark = ''g'' then ''sec-personal'' else ''''')
                column colS2 (attribute: sector2, caption: 'S2', Alignment: right,
                  DynamicCellClass:
                    'if $currentObject/sector2Mark = ''p'' then ''sec-best''
                     else if $currentObject/sector2Mark = ''g'' then ''sec-personal'' else ''''')
                column colS3 (attribute: sector3, caption: 'S3', Alignment: right,
                  DynamicCellClass:
                    'if $currentObject/sector3Mark = ''p'' then ''sec-best''
                     else if $currentObject/sector3Mark = ''g'' then ''sec-personal'' else ''''')
                column colTrap (attribute: speedTrap, caption: 'Trap', Alignment: right)
                column colTyre (attribute: compound, caption: 'Tyre')
                column colAge (attribute: tyreAge, caption: 'Age', Alignment: right)
                column colStops (attribute: pitStops, caption: 'St', Alignment: right)
              }
            }
            container orderKey (class: 'legend-key') {
              dynamictext okBest (content: 'Session best sector', class: 'legend-item legend-podium')
              dynamictext okPers (content: 'Personal best sector', class: 'legend-item legend-points')
            }
          }

          /*
           * Track position.
           *
           * The circuit is not drawn from a map. OpenF1 reports position in a
           * track-local frame with no relation to latitude and longitude, so an
           * outline from OpenStreetMap could not carry these dots -- the two would be
           * in different coordinate systems with no transform between them. The
           * outline here is traced from one car's lap of the same feed, which puts
           * the cars on the line by construction rather than by fitting.
           *
           * Captured once per session by Sync_TrackMap and served with the current
           * position of every car that has one.
           */
          container trackPanel (class: 'panel') {
            container trackHead (class: 'panel-head') {
              dynamictext trackTitle (content: 'Track position', class: 'panel-title')
              dynamictext trackSub (
                content: 'the circuit traced from one car''s lap · a dot per car, numbered · as of the last snapshot',
                class: 'panel-sub')
            }
            container trackFigure (class: 'circuit-figure') {
              dataview dvTrackMap (datasource: MICROFLOW Formula1Frontend.DSJ_TrackMap) {
                pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartTrackMap (
                  chartData: json,
                  datasetName: 'table',
                  chartHeight: 0,
                  renderer: 'svg',
                  showActions: false,
                  spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","legend":{"disable":true}},"width":430,"height":430,"layer":[{"transform":[{"filter":"datum.kind === ''track''"}],"mark":{"type":"line","strokeWidth":10,"color":"#2E3743","strokeJoin":"round","strokeCap":"round"},"encoding":{"x":{"field":"x","type":"quantitative","axis":null,"scale":{"domain":[0,1000],"nice":false,"zero":false}},"y":{"field":"y","type":"quantitative","axis":null,"scale":{"domain":[0,1000],"nice":false,"zero":false}},"order":{"field":"seq","type":"quantitative"}}},{"transform":[{"filter":"datum.kind === ''track''"}],"mark":{"type":"line","strokeWidth":2,"color":"#2DD4BF","strokeJoin":"round","strokeCap":"round"},"encoding":{"x":{"field":"x","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"y":{"field":"y","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"order":{"field":"seq","type":"quantitative"}}},{"transform":[{"filter":"datum.kind === ''car''"}],"mark":{"type":"point","filled":true,"size":120,"color":"#E3B341","stroke":"#0E1116","strokeWidth":1.5},"encoding":{"x":{"field":"x","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"y":{"field":"y","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"tooltip":[{"field":"car","title":"Car"}]}},{"transform":[{"filter":"datum.kind === ''car''"}],"mark":{"type":"text","fontSize":8,"font":"JetBrains Mono","color":"#06231F","dy":1},"encoding":{"x":{"field":"x","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"y":{"field":"y","type":"quantitative","scale":{"domain":[0,1000],"nice":false,"zero":false}},"text":{"field":"car","type":"nominal"}}}]}')
              }
            }
          }
        }

        /*
         * The three series on one row. Each reads the same lap axis a different
         * way -- gap, position, tyre -- which makes them small multiples, and
         * small multiples belong beside each other.
         */
        container liveTraces (class: 'live-traces') {
          /*
           * Gap to leader. The comp's headline chart and the one that carries the
           * shape of the race — a pit stop is a step, a safety car is every line
           * collapsing at once.
           */
          container gapPanel (class: 'panel') {
            container gapHead (class: 'panel-head') {
              dynamictext gapTitle (content: 'Gap to leader', class: 'panel-title')
              dynamictext gapSub (
                content: 'the five cars at the front · seconds · a lapped car stops having a gap, so its line ends',
                class: 'panel-sub')
            }
            dataview dvGaps (datasource: MICROFLOW Formula1Frontend.DSJ_LiveGaps) {
              pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartGaps (
                chartData: json,
                datasetName: 'table',
                chartHeight: 0,
                renderer: 'svg',
                showActions: false,
                spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":9,"titleFontSize":10,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":10,"symbolType":"stroke","symbolStrokeWidth":3}},"height":210,"layer":[{"mark":{"type":"line","strokeWidth":10,"interpolate":"monotone","opacity":0.001},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"gap","type":"quantitative","title":"Gap to leader (s)","scale":{"reverse":true,"zero":true}},"color":{"field":"code","type":"nominal","title":null,"scale":{"range":["#2DD4BF","#FF8000","#3671C6","#E8002D","#A78BFA"]},"legend":{"orient":"top","columns":5,"offset":4}}},"params":[{"name":"pick","select":{"type":"point","fields":["code"]},"bind":"legend"},{"name":"hover","select":{"type":"point","fields":["code"],"on":"pointerover","clear":"pointerout"}}]},{"mark":{"type":"line","strokeWidth":1.3,"interpolate":"monotone"},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"gap","type":"quantitative","title":"Gap to leader (s)","scale":{"reverse":true,"zero":true}},"color":{"field":"code","type":"nominal","title":null,"scale":{"range":["#2DD4BF","#FF8000","#3671C6","#E8002D","#A78BFA"]},"legend":{"orient":"top","columns":5,"offset":4}},"tooltip":[{"field":"code","title":"Driver"},{"field":"lap","title":"Lap"},{"field":"gap","title":"Gap (s)"}],"opacity":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":1},"value":0.14},"strokeWidth":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":2.6},"value":1.1}}}]}')
            }
          }

          container posPanel (class: 'panel') {
            container posHead (class: 'panel-head') {
              dynamictext posTitle (content: 'Position by lap', class: 'panel-title')
              dynamictext posSub (
                content: 'every car, lap one to now · first place at the top · the crossings are the race',
                class: 'panel-sub')
            }
            dataview dvPositions (datasource: MICROFLOW Formula1Frontend.DSJ_LivePositions) {
              pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartPositions (
                chartData: json,
                datasetName: 'table',
                chartHeight: 0,
                renderer: 'svg',
                showActions: false,
                spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":9,"titleFontSize":10,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":10,"symbolType":"stroke","symbolStrokeWidth":3}},"height":210,"layer":[{"mark":{"type":"line","strokeWidth":10,"interpolate":"monotone","opacity":0.001},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"pos","type":"quantitative","title":"Position","scale":{"reverse":true,"zero":false,"nice":false},"axis":{"format":"d","tickMinStep":1}},"color":{"field":"code","type":"nominal","title":null,"scale":{"scheme":"turbo"},"legend":{"orient":"right","columns":1,"offset":6}}},"params":[{"name":"pick","select":{"type":"point","fields":["code"]},"bind":"legend"},{"name":"hover","select":{"type":"point","fields":["code"],"on":"pointerover","clear":"pointerout"}}]},{"mark":{"type":"line","strokeWidth":1.2,"interpolate":"monotone"},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"pos","type":"quantitative","title":"Position","scale":{"reverse":true,"zero":false,"nice":false},"axis":{"format":"d","tickMinStep":1}},"color":{"field":"code","type":"nominal","title":null,"scale":{"scheme":"turbo"},"legend":{"orient":"right","columns":1,"offset":6}},"tooltip":[{"field":"code","title":"Driver"},{"field":"lap","title":"Lap"},{"field":"pos","title":"Position"}],"opacity":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":1},"value":0.14},"strokeWidth":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":2.6},"value":1.1}}}]}')
            }
          }

          container stintPanel (class: 'panel') {
            container stintHead (class: 'panel-head') {
              dynamictext stintTitle (content: 'Strategy', class: 'panel-title')
              dynamictext stintSub (
                content: 'one bar per stint, coloured by compound · a stint still running is closed at the lead lap',
                class: 'panel-sub')
            }
            dataview dvStints (datasource: MICROFLOW Formula1Frontend.DSJ_LiveStints) {
              pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartStints (
                chartData: json,
                datasetName: 'table',
                chartHeight: 0,
                renderer: 'svg',
                showActions: false,
                spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":9,"titleFontSize":10,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":11}},"height":210,"mark":{"type":"bar","height":4,"cornerRadius":1},"encoding":{"x":{"field":"from","type":"quantitative","title":"Lap","scale":{"zero":true,"nice":false},"axis":{"format":"d","tickMinStep":1}},"x2":{"field":"to"},"y":{"field":"code","type":"nominal","title":null,"sort":null},"color":{"field":"compound","type":"nominal","title":null,"scale":{"domain":["SOFT","MEDIUM","HARD","INTERMEDIATE","WET"],"range":["#F85149","#E3B341","#8B949E","#3FB950","#58A6FF"]},"legend":{"orient":"top","offset":4}},"tooltip":[{"field":"code","title":"Driver"},{"field":"compound","title":"Tyre"},{"field":"from","title":"From lap"},{"field":"to","title":"To lap"}]}}')
            }
          }
        }

        /*
         * Where it ends.
         *
         * Every other panel on this page reports something that has happened.
         * This one is the only thing on the screen that is not a fact, so it
         * says how it was made and how much of the race it has had to learn
         * from, and the two panels are placed together rather than mixed in
         * among the timing.
         *
         * Left is the forecast moving: one line per car that has ever had a
         * real chance, so a pit stop or a safety car is visible as the moment
         * the lines crossed. Right is where it stands, in predicted order,
         * with the 10th-to-90th percentile band beside each car because a
         * single predicted position is a claim the model cannot support.
         */
        container liveForecast (class: 'live-forecast') {

          container fcChartPanel (class: 'panel') {
            container fcChartHead (class: 'panel-head') {
              dynamictext fcChartTitle (content: 'Win probability', class: 'panel-title')
              dynamictext fcChartSub (
                content: 'how the forecast has moved · one line per car that has ever been above 2%',
                class: 'panel-sub')
            }
            dataview dvFcWin (datasource: MICROFLOW Formula1Frontend.DSJ_ForecastWin) {
              pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartForecastWin (
                chartData: json,
                datasetName: 'table',
                chartHeight: 0,
                renderer: 'svg',
                showActions: false,
                spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":9,"titleFontSize":10,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":10,"symbolType":"stroke","symbolStrokeWidth":3}},"height":210,"layer":[{"mark":{"type":"line","strokeWidth":10,"interpolate":"monotone","opacity":0.001},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"p","type":"quantitative","title":"Win probability (%)","scale":{"domain":[0,100],"nice":false}},"color":{"field":"code","type":"nominal","title":null,"scale":{"range":["#2DD4BF","#FF8000","#3671C6","#E8002D","#A78BFA","#E3B341","#3FB950","#F85149"]},"legend":{"orient":"top","columns":8,"offset":4}}},"params":[{"name":"pick","select":{"type":"point","fields":["code"]},"bind":"legend"},{"name":"hover","select":{"type":"point","fields":["code"],"on":"pointerover","clear":"pointerout"}}]},{"mark":{"type":"line","strokeWidth":1.6,"interpolate":"monotone"},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"p","type":"quantitative","title":"Win probability (%)","scale":{"domain":[0,100],"nice":false}},"color":{"field":"code","type":"nominal","title":null,"scale":{"range":["#2DD4BF","#FF8000","#3671C6","#E8002D","#A78BFA","#E3B341","#3FB950","#F85149"]},"legend":{"orient":"top","columns":8,"offset":4}},"tooltip":[{"field":"code","title":"Driver"},{"field":"lap","title":"Lap"},{"field":"p","title":"Win %","format":".1f"}],"opacity":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":1},"value":0.14},"strokeWidth":{"condition":{"test":{"or":[{"param":"pick"},{"param":"hover"}]},"value":3},"value":1.4}}}]}')
            }
          }

          container fcGridPanel (class: 'panel') {
            container fcGridHead (class: 'panel-head') {
              dynamictext fcGridTitle (content: 'Predicted finish', class: 'panel-title')
              dynamictext fcGridSub (
                content: 'two thousand simulations of the laps that are left · pace, tyre life and the stops still owed · 10-90% range',
                class: 'panel-sub')
            }
            container fcGrid (class: 'grid-dense') {
              datagrid dgForecast (
                datasource: MICROFLOW Formula1Frontend.DS_LiveForecast,
                PageSize: 24,
                PagingPosition: bottom
              ) {
                column fcPos (attribute: medianPosition, caption: 'P', Alignment: right)
                column fcCode (attribute: code, caption: 'Code')
                column fcDriver (attribute: driverName, caption: 'Driver')
                column fcBest (attribute: bestCase, caption: 'Best', Alignment: right)
                column fcWorst (attribute: worstCase, caption: 'Worst', Alignment: right)
                column fcWin (attribute: pWin, caption: 'Win', Alignment: right)
                column fcPod (attribute: pPodium, caption: 'Podium', Alignment: right)
                column fcPts (attribute: pPoints, caption: 'Points', Alignment: right)
                column fcStops (attribute: stopsLeft, caption: 'Stops', Alignment: right)
                column fcLaps (attribute: lapsUsed, caption: 'Laps fitted', Alignment: right)
              }
            }
            container fcNote (class: 'legend-key') {
              dynamictext fcNoteText (
                content: 'Ranked on pace, so it assumes a quicker car gets past. Under about eight fitted laps it is a guess.',
                class: 'legend-item')
            }
          }
        }

      }

      container liveRail (class: 'live-rail') {
        /*
         * The story. Overtakes joined to the entry list, and the stewards with
         * the sector chatter stripped out -- both already captured and never
         * read until now. The comp's fuller narrative, the one that wants
         * precedents read out of seventy-five years of results, still has no
         * resource behind it; this is what the race itself says.
         */
        container storyPanel (class: 'panel rail-panel') {
          container storyHead (class: 'panel-head') {
            dynamictext storyTitle (content: 'Story', class: 'panel-title')
            dynamictext storySub (content: 'overtakes and the stewards · newest first',
                                  class: 'panel-sub')
          }
          container storyList (class: 'card-list') {
            listview lvStory (datasource: MICROFLOW Formula1Frontend.DS_LiveStory,
                              PageSize: 60) {
              container storyCard (
                class: 'story-card',
                dynamicclasses: '''story-'' + $currentObject/kind'
              ) {
                container storyCardTop (class: 'card-meta') {
                  dynamictext storyKind (content: '{1}', contentparams: [{1} = kind],
                                         class: 'card-kind')
                  dynamictext storyLap (content: 'lap {1}', contentparams: [{1} = lap],
                                        class: 'card-lap')
                }
                dynamictext storyLine (content: '{1}', contentparams: [{1} = headline],
                                       class: 'card-line')
                dynamictext storyDetail (content: '{1}', contentparams: [{1} = detail],
                                         class: 'card-detail')
              }
            }
          }
        }

        /*
         * Race control in full. The story panel above is the edited version;
         * this is everything, sector flags included, for when the question is
         * "what exactly did they say".
         */
        container rcPanel (class: 'panel rail-panel') {
          container rcHead (class: 'panel-head') {
            dynamictext rcTitle (content: 'Race control', class: 'panel-title')
            dynamictext rcSub (content: 'every message, newest first', class: 'panel-sub')
          }
          container rcList (class: 'card-list') {
            listview lvMessages (datasource: MICROFLOW Formula1Frontend.DS_LiveMessages,
                                 PageSize: 60) {
              container rcCard (class: 'story-card story-rc') {
                container rcCardTop (class: 'card-meta') {
                  dynamictext rcFlag (content: '{1}', contentparams: [{1} = category],
                                      class: 'card-kind')
                  dynamictext rcAt (content: '{1}', contentparams: [{1} = at],
                                    class: 'card-lap')
                }
                dynamictext rcLine (content: '{1}', contentparams: [{1} = message],
                                    class: 'card-line')
              }
            }
          }
        }
      }
    }

    container note (class: 'data-note') {
      dynamictext noteLead (content: 'Where this comes from', class: 'data-note-lead')
      dynamictext noteBody (
        content: 'Timing, tyres and race control are OpenF1 (openf1.org), an unofficial free API with a documented ~3 second delay during a session. This screen reads the tables the in-app sync writes, so it follows the session the sync is following and shows the last cycle''s state; the header says when that was. Everything on the other four screens comes from f1db instead, and is official.')
    }
  }
}
