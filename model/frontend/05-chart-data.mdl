mdl 1;
/*
 * Vega charts: the data side.
 * ===========================
 *
 * This runs ahead of the pages rather than after them, because every chart on
 * every screen binds a dataview to one of these microflows. A page that
 * referenced a DSJ_ that did not exist yet would be a forward reference
 * resolved by luck.
 *
 * The Vega widget takes two things — a specification, authored once and
 * committed, and a *string* holding a JSON array of rows. That split is the
 * reason to move: the model emits a table of facts and the specification
 * decides what the table looks like, so a chart change is a spec edit and not
 * a microflow edit.
 *
 * It also fixes three things the Mendix chart widgets could not do here, all
 * recorded in FINDINGS §51:
 *
 *   * a legend could not carry data, because `StaticName` is the one series
 *     text template that is not bound to the series datasource. The resources
 *     have carried `d1Name`…`d5Name` and `s1name`…`s10name` all along and no
 *     chart could read them. In long form the label IS a column;
 *   * per-bar colour needed a *dynamic* series, because `StaticBarColor` is an
 *     expression bound to the datasource that resolves once, against the first
 *     row;
 *   * a wide resource cost one datasource call per series. `WeekendShape` and
 *     `LapChart` are ten series each and were fetched ten times each; the pace
 *     chart five. Thirty-eight datasource invocations across ten charts become
 *     ten microflow calls, which is most of the 28× re-fetch §52 measured on
 *     the race weekend page.
 *
 * Long format is what makes all three fall out: one row per (x, series, value)
 * rather than one row per x with a column per series.
 *
 * Numbers are written with `toString(round($x, n))`, never `formatDecimal`.
 * `formatDecimal` formats in the *user's* language, so a Dutch session emits
 * `12,50` and the whole array stops being JSON — for that user only, which is
 * why it survived here until `mxcli check` grew MDL-JSONNUM01 and reported 25
 * of them (FINDINGS §91). `toString(round(…))` is locale-independent and
 * writes no exponent. A value that could be empty is emitted as `null` and
 * never as `0`: a zero plots as a real measurement at the bottom of the scale,
 * which is a lie the chart tells convincingly.
 */

create or modify non-persistent entity Formula1Frontend.Chart (
  json: string
);


/* ------------------------------------------------------------------ the lake -- */

/*
 * DuckGraphLake, read over its PostgreSQL endpoint: the frontend's own route to
 * the data, without the backend in between (docs/datalake/architecture.html).
 *
 * Charts move here one at a time. Each one is a query that returns the chart's
 * JSON array already built: the lake's gold.* views hold the rows in long form,
 * and DuckDB serialises them, so the DSJ_ microflow that used to loop over an
 * external entity and concatenate strings becomes one call. That also retires
 * MDL-JSONNUM01's trap at the root -- no microflow formats a number into JSON.
 *
 * Type 'PostgreSQL', not BYOD: the lake speaks the PostgreSQL wire protocol,
 * whatever runs behind it. The SQL dialect is DuckDB's, which Mendix does not
 * parse -- it passes the text through.
 *
 * Every Mendix query parameter is a string, so the SQL casts.
 */
alter module Formula1Frontend
  add jar dependency if not exists (
    group    = 'org.postgresql',
    artifact = 'postgresql',
    version  = '42.7.4',
    included = true,
  );
/*
 * The driver, for the reasons the backend's 00-dependencies.mdl spells out: a
 * 'PostgreSQL' connection fails the build (CE5278) without it, and the External
 * Database Connector resolves drivers from the APP's classpath, so it has to be
 * `included`.
 */

/** The lake's PostgreSQL endpoint. Override per environment. */
create or modify constant Formula1Frontend.LakeUrl ( Type: string, DefaultValue: 'jdbc:postgresql://127.0.0.1:5433/lake?sslmode=disable' );
/** Any user name works; the password is the lake's token. */
create or modify constant Formula1Frontend.LakeUser ( Type: string, DefaultValue: 'frontend' );
/** 'duckgraphlake' is the lake's default token on a loopback address. */
create or modify constant Formula1Frontend.LakePassword ( Type: string, DefaultValue: 'duckgraphlake' );

create or modify database connection Formula1Frontend.F1Lake (
Type: 'PostgreSQL',
ConnectionString: @Formula1Frontend.LakeUrl,
Username: @Formula1Frontend.LakeUser,
Password: @Formula1Frontend.LakePassword )
{
  /*
   * A season's title fight as the Vega chart's rows: one {round, driver, pts}
   * per round and driver, the five who finished on top, ordered by round and
   * then by championship position -- the order DSJ_SeasonProgress used to emit.
   * Always exactly one row: the aggregate over an unknown year is '[]'.
   */
  query GetSeasonProgress (
    Sql: 'SELECT COALESCE(CAST(to_json(list(
            {''round'': round, ''driver'': driver_name, ''pts'': round(points, 2)}
            ORDER BY round, rk)) AS VARCHAR), ''[]'') AS json
         FROM gold.season_progress
         WHERE year = CAST({year} AS INTEGER)',
    Parameters: ( year: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * The constructors' championship: a bar per team in its colour, in the final
   * order. The colours are the lake's (f1.constructor_colours), the same map
   * DS_SeasonTeamRows still uses for the table beside the chart.
   */
  query GetSeasonTeams (
    Sql: 'SELECT COALESCE(CAST(to_json(list(
            {''team'': team, ''pts'': round(points, 2), ''colour'': colour}
            ORDER BY position_order)) AS VARCHAR), ''[]'') AS json
         FROM gold.season_teams
         WHERE year = CAST({year} AS INTEGER)',
    Parameters: ( year: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * Finishing position by round for the season's top ten. A retirement is
   * pos null and dnf 1, never pos 0: a zero would plot as a result.
   */
  query GetSeasonMultiples (
    Sql: 'SELECT COALESCE(CAST(to_json(list(
            {''driver'': driver_name, ''round'': round, ''pos'': pos, ''dnf'': dnf}
            ORDER BY driver_name, round)) AS VARCHAR), ''[]'') AS json
         FROM gold.season_multiples
         WHERE year = CAST({year} AS INTEGER)',
    Parameters: ( year: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * A team's points per round, split by seat, in its latest season (gold.team_season).
   * Race points only, as before: sprints are not in that view yet.
   * The SQL is the one scripts/datalake/compare-people-charts.py runs.
   */
  query GetTeamPoints (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''code'': code, ''round'': round, ''driver'': driver, ''seat'': seat, ''pts'': round(pts, 2)}
       ORDER BY round, seat)) AS VARCHAR), ''[]'') AS json
FROM (SELECT code, round, driver1_name AS driver, ''Seat 1'' AS seat, driver1_points AS pts
      FROM gold.team_latest_season WHERE constructor_id = {constructorId} AND driver1_name IS NOT NULL
      UNION ALL
      SELECT code, round, driver2_name, ''Seat 2'', driver2_points
      FROM gold.team_latest_season WHERE constructor_id = {constructorId} AND driver2_name IS NOT NULL) p',
    Parameters: ( constructorId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * The team's championship position after each round of its latest season.
   * The SQL is the one scripts/datalake/compare-people-charts.py runs.
   */
  query GetTeamPosition (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''code'': code, ''round'': round, ''race'': race_name, ''pos'': standing_position}
       ORDER BY round)) AS VARCHAR), ''[]'') AS json
FROM gold.team_latest_season WHERE constructor_id = {constructorId} AND standing_position IS NOT NULL',
    Parameters: ( constructorId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * A career: points per season, and the championship finish where there was one.
   * f1db's sentinel order for an unclassified season (999) is left out, as before.
   * The SQL is the one scripts/datalake/compare-people-charts.py runs.
   */
  query GetCareer (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''year'': year, ''s'': s, ''v'': v} ORDER BY year, s)) AS VARCHAR), ''[]'') AS json
FROM (SELECT year, ''Points'' AS s, round(points, 2) AS v FROM gold.driver_seasons WHERE driver_id = {driverId}
      UNION ALL
      SELECT year, ''Finish'', standing_order FROM gold.driver_seasons
      WHERE driver_id = {driverId} AND standing_position <> ''-'' AND standing_order < 100) p',
    Parameters: ( driverId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * Qualifying against finishing position, every race of the driver's latest season
   * where both are known.
   * The SQL is the one scripts/datalake/compare-people-charts.py runs.
   */
  query GetQualRace (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''q'': qualifying_position, ''r'': finish_position, ''race'': race_name, ''round'': round}
       ORDER BY round)) AS VARCHAR), ''[]'') AS json
FROM gold.driver_latest_races
WHERE driver_id = {driverId} AND qualifying_position IS NOT NULL AND finish_position IS NOT NULL',
    Parameters: ( driverId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * Where the race's top ten placed in each session of the weekend (gold.weekend_shape).
   * Each parameter is compared with a column, CAST to its type (FINDINGS §115).
   * The SQL is the one scripts/datalake/compare-weekend-charts.py runs.
   */
  query GetWeekendShape (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''i'': session_index, ''session'': session_label, ''driver'': driver, ''pos'': pos}
       ORDER BY session_index, rk)) AS VARCHAR), ''[]'') AS json
FROM gold.weekend_shape
WHERE race_id = CAST({raceId} AS BIGINT) AND pos IS NOT NULL',
    Parameters: ( raceId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * Each driver's gap to the fastest of each session, the columns unpivoted to rows
   * as DSJ_WeekendPace did (gold.race_sessions). The key is "driver", which the
   * chart's spec reads; the old microflow wrote "drv", and the chart drew every
   * point on one "undefined" row (FINDINGS §116).
   * Each parameter is compared with a column, CAST to its type (FINDINGS §115).
   * The SQL is the one scripts/datalake/compare-weekend-charts.py runs.
   */
  query GetWeekendPace (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''driver'': drv, ''session'': session, ''gap'': gap}
       ORDER BY o, k)) AS VARCHAR), ''[]'') AS json
FROM (SELECT position_order AS o, 1 AS k, abbreviation AS drv, ''FP1'' AS session, fp1_gap AS gap
      FROM gold.race_sessions WHERE race_id = CAST({raceId} AS BIGINT) AND fp1_gap IS NOT NULL
      UNION ALL SELECT position_order, 2, abbreviation, ''FP2'', fp2_gap
      FROM gold.race_sessions WHERE race_id = CAST({raceId} AS BIGINT) AND fp2_gap IS NOT NULL
      UNION ALL SELECT position_order, 3, abbreviation, ''FP3'', fp3_gap
      FROM gold.race_sessions WHERE race_id = CAST({raceId} AS BIGINT) AND fp3_gap IS NOT NULL
      UNION ALL SELECT position_order, 4, abbreviation, ''Qualifying'', qual_gap
      FROM gold.race_sessions WHERE race_id = CAST({raceId} AS BIGINT) AND qual_gap IS NOT NULL
      UNION ALL SELECT position_order, 5, abbreviation, ''Best race lap'', best_lap_gap
      FROM gold.race_sessions WHERE race_id = CAST({raceId} AS BIGINT) AND best_lap_gap IS NOT NULL) p',
    Parameters: ( raceId: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
  /*
   * Position by lap for the last lap's top ten (gold.lap_chart, from the Jolpica lap file).
   * Each parameter is compared with a column, CAST to its type (FINDINGS §115).
   * The SQL is the one scripts/datalake/compare-weekend-charts.py runs.
   */
  query GetLapChart (
    Sql: 'SELECT COALESCE(CAST(to_json(list({''lap'': lap, ''driver'': driver, ''pos'': pos}
       ORDER BY lap, rk)) AS VARCHAR), ''[]'') AS json
FROM gold.lap_chart
WHERE year = CAST({year} AS BIGINT) AND round = CAST({round} AS BIGINT) AND pos IS NOT NULL',
    Parameters: ( year: string, round: string ),
    Returns: Formula1Frontend.Chart,
    Map: ( json = json ) )
};

/* -------------------------------------------------------------- driver -- */

/*
 * Career: points per season, and championship finish on its own scale.
 *
 * Two measures that share an x and nothing else — points climb, finishing
 * position is better when lower. They travel as one long table and the spec
 * layers them with independent y scales, which is what the second Plotly axis
 * used to do.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_Career (
  $Driver: F1Live.Drivers)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.driver_seasons). It used to retrieve F1Fan.DriverSeasons
   * and loop. Identical for all 917 drivers: compare-people-charts.py career.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetCareer
    (driverId = $Driver/driverId)
    on error without rollback begin
      log warning node 'F1Lake' 'Career chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * Qualifying against race, one point per round.
 *
 * The diagonal is the identity line and everything under it is places gained,
 * so both axes are reversed — position 1 belongs at the top left. In Plotly
 * that was a layout shape plus a reversed axis; here the rule is a spec layer
 * and the round comes along so the tooltip can name the race.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_QualRace (
  $Driver: F1Live.Drivers)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.driver_races). It used to find the latest season in
   * F1Fan.DriverSeasons, then retrieve F1Fan.DriverRaces. Identical for all 917
   * drivers: compare-people-charts.py qualrace.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetQualRace
    (driverId = $Driver/driverId)
    on error without rollback begin
      log warning node 'F1Lake' 'Qualifying vs race chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/* -------------------------------------------------------------- season -- */

/*
 * Championship progression, five drivers, cumulative points by round.
 *
 * This is the chart FINDINGS §51 could not finish. The five names were in
 * `d1Name`…`d5Name` the whole time and `StaticName` could not read them, so
 * the legend said "1st".."5th" and an explicit name strip was built beside the
 * chart to say who they were. In long form the name is the series column, so
 * the legend and the tooltip both carry it and the strip is redundant.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_SeasonProgress (
  $Season: F1Cached.Seasons)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * The first chart read from the lake. It used to retrieve F1Fan.SeasonProgress
   * -- the backend computing one season per request and pivoting it into
   * d1..d5 columns -- and then unpivot that here, five IFs per round, into the
   * long form the spec wants. gold.season_progress is long form already, and
   * the query returns the array built.
   *
   * Equal to the old chart in all 77 seasons, except that sprint points now
   * count (lake/init.sql): from 2021 the old curves fell short of the
   * championship. scripts/datalake/compare-season-progress.py is the check.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetSeasonProgress
    (year = toString($Season/year))
    on error without rollback begin
      log warning node 'F1Lake' 'Season progress chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * Constructors' championship, one bar per team, in the team's own colour.
 *
 * `DS_SeasonTeamRows` already carries the colour per row — it had to, because
 * the only way to get twelve colours out of one Mendix series was a *dynamic*
 * series grouped by name. Here the colour is just a column and the scale reads
 * it, so the grouping is no longer load-bearing.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_SeasonTeams (
  $Season: F1Cached.Seasons)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.season_teams). It used to loop over DS_SeasonTeamRows,
   * the backend's cached ConstructorStandings, and concatenate. Identical in all
   * 77 seasons: scripts/datalake/compare-season-charts.py teams.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetSeasonTeams
    (year = toString($Season/year))
    on error without rollback begin
      log warning node 'F1Lake' 'Season teams chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/* --------------------------------------------------------- constructor -- */

/*
 * Points per round, split by seat, with the driver who scored them.
 *
 * The seats were two static series called "Seat 1" and "Seat 2" because the
 * name could not come from the data. `driver1Name`/`driver2Name` are on every
 * row, so the stack is now labelled with who was actually in the car — which
 * changes mid-season more often than the old chart could admit.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_TeamPoints (
  $Constructor: F1Cached.Constructors)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.team_season). It used to retrieve F1Fan.TeamSeason
   * -- the backend computing the latest season per request -- and concatenate.
   * Identical for all 187 constructors: compare-people-charts.py teampoints.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetTeamPoints
    (constructorId = $Constructor/constructorId)
    on error without rollback begin
      log warning node 'F1Lake' 'Team points chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * Championship position through the season. Lower is better, so the scale is
 * reversed and the domain starts at 1 rather than 0.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_TeamPosition (
  $Constructor: F1Cached.Constructors)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.team_season). Identical for all 187 constructors:
   * compare-people-charts.py teamposition.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetTeamPosition
    (constructorId = $Constructor/constructorId)
    on error without rollback begin
      log warning node 'F1Lake' 'Team position chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * Why the cars stopped. One bar per reason, with the share as a tooltip figure
 * so the bar length and the percentage cannot disagree.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_Retirements (
  $Constructor: F1Cached.Constructors)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Rows = CALL MICROFLOW Formula1Frontend.DS_Retirements (Constructor = $Constructor);

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $R IN $Rows BEGIN
    SET $Json = $Json + $Sep
      + '{"reason":"' + $R/reasonRetired + '"'
      + ',"n":' + toString($R/retirements)
      + ',"share":' + toString(round($R/sharePercent, 2)) + '}';
    SET $Sep = ',';
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/* -------------------------------------------------------- race weekend -- */

/*
 * How the weekend's order changed session by session — ten drivers, five
 * sessions.
 *
 * This resource was fetched **ten times** to draw one chart, once per series,
 * and the legend said P1..P10 because the names in `s1name`…`s10name` could
 * not reach it. One call now, and the lines are labelled with drivers.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_WeekendShape (
  $Race: F1Fan.Calendar)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.weekend_shape). It used to retrieve F1Fan.WeekendShape,
   * the backend's pivot to ten series, and unpivot it with ten IFs per session.
   * Identical for all 1,171 races: compare-weekend-charts.py shape.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetWeekendShape
    (raceId = toString($Race/raceId))
    on error without rollback begin
      log warning node 'F1Lake' 'Weekend shape chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * The lap chart — position by lap, ten drivers. The other resource that was
 * fetched ten times for one picture.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_LapChart (
  $Race: F1Fan.Calendar)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.lap_chart). It used to retrieve F1Fan.LapChart and
   * unpivot ten series per lap. Identical for all 24 races in the lap file:
   * compare-weekend-charts.py laps.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetLapChart
    (year = toString($Race/year), round = toString($Race/round))
    on error without rollback begin
      log warning node 'F1Lake' 'Lap chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/*
 * Pace across the weekend — gap to the session's best, per driver, per session.
 *
 * Five static series over one resource, fetched five times. The session is a
 * column now, so it is one call and the spec decides whether the sessions sit
 * side by side or stack.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_WeekendPace (
  $Race: F1Fan.Calendar)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.race_sessions). It used to retrieve F1Fan.RaceSessions
   * and emit five gaps per driver. Identical for all 1,171 races:
   * compare-weekend-charts.py pace.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetWeekendPace
    (raceId = toString($Race/raceId))
    on error without rollback begin
      log warning node 'F1Lake' 'Weekend pace chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;


/* ----------------------------------------------------------------- live -- */

/*
 * Three charts off one session.
 *
 * All three read the trace — one row per driver per lap — so they are as
 * honest about a race as the snapshot they were taken from. Before the trace
 * existed this screen could only show where everyone stood; now it can show
 * how they got there, which is the whole difference between a table and a
 * race.
 */

/*
 * Gap to leader, lap by lap, for the five cars at the front.
 *
 * `gapSeconds` rather than `gapToLeader`: the text column carries "+1 LAP"
 * once a car is lapped, and a chart that coerced that would draw the car at
 * the front of the race. A lapped car simply stops having a point, which is
 * the truthful shape — the line ends where the measurement does.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_LiveGaps ()
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Codes = CALL MICROFLOW Formula1Frontend.DS_LiveLeaderCodes ();
  $Rows  = CALL MICROFLOW Formula1Frontend.DS_LiveTrace ();

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $R IN $Rows BEGIN
    IF $R/gapSeconds != empty AND $R/code != empty
       AND contains($Codes, '|' + $R/code + '|') THEN
      SET $Json = $Json + $Sep
        + '{"code":"' + $R/code + '","lap":' + toString($R/lapNumber)
        + ',"gap":' + toString(round($R/gapSeconds, 3)) + '}';
      SET $Sep = ',';
    END IF;
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/*
 * Position, lap by lap, for everyone.
 *
 * The comp draws this as a sparkline inside each row of the classification.
 * A Mendix data grid column holds an attribute and not a widget, so twenty
 * one-line charts are not on offer; one chart of twenty lines carries the same
 * information and reads better, because the crossings are the story and a
 * sparkline cuts every one of them out.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_LivePositions ()
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Rows = CALL MICROFLOW Formula1Frontend.DS_LiveTrace ();

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $R IN $Rows BEGIN
    IF $R/position != empty AND $R/code != empty THEN
      SET $Json = $Json + $Sep
        + '{"code":"' + $R/code + '","lap":' + toString($R/lapNumber)
        + ',"pos":' + toString($R/position) + '}';
      SET $Sep = ',';
    END IF;
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/*
 * Strategy: which tyre, from which lap to which.
 *
 * A bar per stint, one row per driver, coloured by compound — the comp's
 * strategy panel, drawn as ranges rather than as one cell per lap. A stint
 * still running has no lapEnd, so it is closed at the leader's lap: an open
 * range would draw as nothing at all, which reads as a car that has not run.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_LiveStints ()
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Rows    = CALL MICROFLOW Formula1Frontend.DS_LiveStints ();
  $Session = CALL MICROFLOW Formula1Frontend.DS_LiveSession ();

  DECLARE $LeadLap Long = 0;
  IF $Session != empty AND $Session/leadLap != empty THEN
    SET $LeadLap = $Session/leadLap;
  END IF;

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $R IN $Rows BEGIN
    IF $R/code != empty AND $R/lapStart != empty THEN
      DECLARE $End Long = $LeadLap;
      IF $R/lapEnd != empty THEN
        SET $End = $R/lapEnd;
      END IF;
      IF $End >= $R/lapStart THEN
        SET $Json = $Json + $Sep
          + '{"code":"' + $R/code + '","stint":' + toString($R/stintNumber)
          + ',"compound":"' + $R/compound + '"'
          + ',"from":' + toString($R/lapStart)
          + ',"to":' + toString($End) + '}';
        SET $Sep = ',';
      END IF;
    END IF;
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/* --------------------------------------------------------------- season -- */

/*
 * Finishing position by round, for the ten drivers at the top — the comp's
 * small multiples.
 *
 * One read of the season's results rather than one read per driver: a season
 * is about five hundred rows, and ten constrained reads to answer one question
 * is the shape §52 measured and this app has spent its time removing. The top
 * ten come from the standings, and membership is tested against a pipe-wrapped
 * string for the same reason the gap chart does it.
 *
 * A retirement has no finishing position. It travels as a row with `dnf` set
 * and no `pos`, so the spec can mark it without the line pretending the driver
 * finished last.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_SeasonMultiples (
  $Season: F1Cached.Seasons)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  /*
   * Read from the lake (gold.season_multiples). It used to retrieve the top ten
   * from F1Cached.DriverStandings and every F1Cached.RaceResults row of the year,
   * then match them by name in a loop. Identical in all 77 seasons:
   * scripts/datalake/compare-season-charts.py multiples.
   */
  $Rows = execute database query Formula1Frontend.F1Lake.GetSeasonMultiples
    (year = toString($Season/year))
    on error without rollback begin
      log warning node 'F1Lake' 'Season multiples chart: the lake did not answer: {1}'
        with ({1} = $latestError/Message);
      $NoData = create Formula1Frontend.Chart (json = '[]');
      return $NoData;
    end error;
  $Chart = head $Rows;
  RETURN $Chart;
END;

/* ------------------------------------------------------- circuit outline -- */

/*
 * The track, as a closed line.
 *
 * Points arrive already projected into a 1000x1000 box, so this does no
 * geometry — it emits what it was given, in order. The spec fixes the chart
 * square and pins both scales to the same domain, which is what keeps Monaco
 * from being stretched into the shape of Monza.
 *
 * The first point is repeated at the end. A circuit is a loop and the fetcher
 * stores it as one, but a line mark draws what it is handed: without the
 * closing point there is a gap on the start-finish straight, which reads as a
 * track that does not join up.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_CircuitOutline (
  $Outline: F1Fan.CircuitOutlines)
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Rows = CALL MICROFLOW Formula1Frontend.DS_CircuitPoints (Outline = $Outline);

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  DECLARE $FirstX String = '';
  DECLARE $FirstY String = '';
  DECLARE $Last Long = 0;
  LOOP $P IN $Rows BEGIN
    IF $P/x != empty AND $P/y != empty THEN
      IF $FirstX = '' THEN
        SET $FirstX = toString(round($P/x, 1));
        SET $FirstY = toString(round($P/y, 1));
      END IF;
      SET $Json = $Json + $Sep
        + '{"i":' + toString($P/seq)
        + ',"x":' + toString(round($P/x, 1))
        + ',"y":' + toString(round($P/y, 1)) + '}';
      SET $Sep = ',';
      SET $Last = $P/seq + 1;
    END IF;
  END LOOP;
  IF $FirstX != '' THEN
    SET $Json = $Json + ',{"i":' + toString($Last)
      + ',"x":' + $FirstX + ',"y":' + $FirstY + '}';
  END IF;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/* ----------------------------------------------------------- track map -- */

/*
 * The circuit and the cars, in one table.
 *
 * Both are normalised here rather than in the spec, into a square thousand-unit
 * box, because the two axes do not span the same distance -- roughly ten
 * thousand units across against twelve thousand up at the Hungaroring -- and a
 * chart that scaled each axis to its own extent would stretch the circuit into
 * a shape the track is not. One scale factor for both, computed over the
 * outline and the cars together so a car cannot fall outside the frame.
 *
 * `kind` separates the two layers: the outline draws as a line ordered by seq,
 * the cars as points. A car with no position sits at the origin in the feed and
 * is dropped at the backend, so anything arriving here is really on track.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_TrackMap ()
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Track = CALL MICROFLOW Formula1Frontend.DS_TrackOutline ();
  $Cars  = CALL MICROFLOW Formula1Frontend.DS_CarPositions ();

  DECLARE $MinX Decimal = 0.0;
  DECLARE $MaxX Decimal = 0.0;
  DECLARE $MinY Decimal = 0.0;
  DECLARE $MaxY Decimal = 0.0;
  DECLARE $Seen Boolean = false;

  LOOP $P IN $Track BEGIN
    IF $P/x != empty AND $P/y != empty THEN
      IF $Seen = false THEN
        SET $MinX = $P/x; SET $MaxX = $P/x;
        SET $MinY = $P/y; SET $MaxY = $P/y;
        SET $Seen = true;
      END IF;
      IF $P/x < $MinX THEN SET $MinX = $P/x; END IF;
      IF $P/x > $MaxX THEN SET $MaxX = $P/x; END IF;
      IF $P/y < $MinY THEN SET $MinY = $P/y; END IF;
      IF $P/y > $MaxY THEN SET $MaxY = $P/y; END IF;
    END IF;
  END LOOP;
  LOOP $C IN $Cars BEGIN
    IF $C/x != empty AND $C/y != empty AND $Seen = true THEN
      IF $C/x < $MinX THEN SET $MinX = $C/x; END IF;
      IF $C/x > $MaxX THEN SET $MaxX = $C/x; END IF;
      IF $C/y < $MinY THEN SET $MinY = $C/y; END IF;
      IF $C/y > $MaxY THEN SET $MaxY = $C/y; END IF;
    END IF;
  END LOOP;

  /* One factor for both axes: the wider span decides, so the narrower one is
   * centred rather than stretched. */
  DECLARE $Span Decimal = $MaxX - $MinX;
  IF ($MaxY - $MinY) > $Span THEN SET $Span = $MaxY - $MinY; END IF;
  IF $Span <= 0 THEN SET $Span = 1.0; END IF;
  DECLARE $Scale Decimal = 960.0 div $Span;
  DECLARE $OffX Decimal = 20.0 + ($Span - ($MaxX - $MinX)) * $Scale div 2.0;
  DECLARE $OffY Decimal = 20.0 + ($Span - ($MaxY - $MinY)) * $Scale div 2.0;

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $Pt IN $Track BEGIN
    IF $Pt/x != empty AND $Pt/y != empty THEN
      SET $Json = $Json + $Sep + '{"kind":"track","seq":' + toString($Pt/seq)
        + ',"x":' + toString(round(($Pt/x - $MinX) * $Scale + $OffX, 1))
        + ',"y":' + toString(round(($Pt/y - $MinY) * $Scale + $OffY, 1))
        + ',"car":""}';
      SET $Sep = ',';
    END IF;
  END LOOP;
  LOOP $Car IN $Cars BEGIN
    IF $Car/x != empty AND $Car/y != empty THEN
      SET $Json = $Json + $Sep + '{"kind":"car","seq":0'
        + ',"x":' + toString(round(($Car/x - $MinX) * $Scale + $OffX, 1))
        + ',"y":' + toString(round(($Car/y - $MinY) * $Scale + $OffY, 1))
        + ',"car":"' + toString($Car/driverNumber) + '"}';
      SET $Sep = ',';
    END IF;
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;

/*
 * Win probability, lap by lap.
 *
 * The forecaster writes one row per car per lap and never overwrites an
 * earlier lap, so the history is already there; this is the shape of it that a
 * chart wants. It is the chart that makes the forecast worth having: a table
 * of probabilities tells you what the model thinks, and this tells you when it
 * changed its mind — a stop, a safety car, a tyre going away.
 *
 * Cars that never get above 2% are dropped. Twenty-two lines of which fifteen
 * are flat against the axis is fifteen lines of ink saying nothing, and they
 * make the six that matter unreadable.
 */
CREATE OR MODIFY MICROFLOW Formula1Frontend.DSJ_ForecastWin ()
  RETURNS Formula1Frontend.Chart AS $Chart
BEGIN
  $Rows = CALL MICROFLOW Formula1Frontend.DS_ForecastTrace ();

  /* Who is worth drawing: anyone the model has ever given a real chance. */
  DECLARE $Keep String = '|';
  LOOP $R IN $Rows BEGIN
    IF $R/pWin != empty AND $R/pWin > 0.02 AND $R/code != empty
       AND contains($Keep, '|' + $R/code + '|') = false THEN
      SET $Keep = $Keep + $R/code + '|';
    END IF;
  END LOOP;

  DECLARE $Json String = '[';
  DECLARE $Sep String = '';
  LOOP $P IN $Rows BEGIN
    IF $P/code != empty AND $P/pWin != empty
       AND contains($Keep, '|' + $P/code + '|') THEN
      SET $Json = $Json + $Sep
        + '{"code":"' + $P/code + '","lap":' + toString($P/atLap)
        + ',"p":' + toString(round($P/pWin * 100, 2)) + '}';
      SET $Sep = ',';
    END IF;
  END LOOP;
  SET $Json = $Json + ']';

  $Chart = CREATE Formula1Frontend.Chart (json = $Json);
  RETURN $Chart;
END;
