/*
 * Screen 6 of 6 — Admin.
 * ======================
 *
 * Every raw table the backend stores, one grid each, nothing derived.
 *
 * The other five screens are answers. This one is evidence. When the Narrate
 * screen shows a race that looks wrong, the question is always "what is
 * actually in the table", and the only way to ask it used to be psql on the
 * backend's database -- not available on Mendix Cloud, and not available at all
 * to anyone but whoever holds the connection string.
 *
 * Grouped across five pages rather than one, because sixteen grids on a single
 * page is sixteen OData reads on open. Each page carries a link row to the
 * other four: the navigation rail holds one Admin item, and MDL has no tab
 * container, so without those links four of the five pages could only be
 * reached by typing a URL.
 *
 * The heads use `panel-head`/`panel-title`/`panel-sub`, which the theme styles
 * as a flex row with a gap. An earlier version invented `page-head`/`page-title`
 * /`page-sub`, which the theme does not define -- so the two spans rendered
 * inline with nothing between them and the screen read "Admin . SyncWhat the
 * sync has been doing." `mxcli exec` warns about exactly this (MDL-WIDGET15)
 * and the warning was right.
 *
 * LiveToken has no grid because it is not published. It holds a bearer token,
 * and an admin screen is exactly the sort of convenience that ends up shared.
 */

create or replace page Formula1Frontend.Admin_Sync
(
  title: 'Admin — Sync',
  layout: Atlas_Core.Atlas_Default,
  url: 'admin/sync'
)
{
  container pageBody {
    container hdrSync (class: 'panel-head') {
      dynamictext ttlSync (content: 'Admin · Sync', class: 'panel-title')
      dynamictext subSync (content: 'What the sync has been doing.', class: 'panel-sub')
    }

    /* Five pages, one rail item. Without this the other four are reachable
     * only by typing their URL, which is how they shipped the first time. */
    container navAdmin_Sync (class: 'admin-nav') {
      container navToAdmin_SyncSync (class: 'chip-pick is-picked', OnClick: SHOW_PAGE Formula1Frontend.Admin_Sync) {
        dynamictext navTxtAdmin_SyncSync (content: 'Sync')
      }
      container navToAdmin_SyncLaps (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Laps) {
        dynamictext navTxtAdmin_SyncLaps (content: 'Laps')
      }
      container navToAdmin_SyncTelemetry (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Telemetry) {
        dynamictext navTxtAdmin_SyncTelemetry (content: 'Telemetry')
      }
      container navToAdmin_SyncSession (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Session) {
        dynamictext navTxtAdmin_SyncSession (content: 'Session')
      }
      container navToAdmin_SyncEvents (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Events) {
        dynamictext navTxtAdmin_SyncEvents (content: 'Events')
      }
    }

    container pnlSyncRuns (class: 'panel') {
      container hdSyncRuns (class: 'panel-head') {
        dynamictext tSyncRuns (content: 'Cycle runs', class: 'panel-title')
        dynamictext sSyncRuns (content: 'one row per completed cycle · a cycle that threw leaves no row', class: 'panel-sub')
      }
      container gSyncRuns (class: 'grid-dense') {
        datagrid dgSyncRuns (
          datasource: DATABASE F1Admin.SyncRuns,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cSyncRunsRunId (attribute: runId, caption: '#', Alignment: right)
          column cSyncRunsStartedAt (attribute: startedAt, caption: 'Started')
          column cSyncRunsFinishedAt (attribute: finishedAt, caption: 'Finished')
          column cSyncRunsDurationMs (attribute: durationMs, caption: 'ms', Alignment: right)
          column cSyncRunsSessionKey (attribute: sessionKey, caption: 'Session')
          column cSyncRunsPasses (attribute: passes, caption: 'Passes')
          column cSyncRunsOutcome (attribute: outcome, caption: 'Outcome')
          column cSyncRunsDetail (attribute: detail, caption: 'Detail')
          column cSyncRunsLapsWritten (attribute: lapsWritten, caption: 'Laps')
          column cSyncRunsAuthenticated (attribute: authenticated, caption: 'Authenticated')
        }
      }
    }

    container pnlSyncState (class: 'panel') {
      container hdSyncState (class: 'panel-head') {
        dynamictext tSyncState (content: 'Sync state', class: 'panel-title')
        dynamictext sSyncState (content: 'the singleton · an empty telemetry cursor means live, following the wall clock', class: 'panel-sub')
      }
      container gSyncState (class: 'grid-dense') {
        datagrid dgSyncState (
          datasource: DATABASE F1Admin.SyncState,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cSyncStateRowId (attribute: rowId, caption: '#', Alignment: right)
          column cSyncStateEnabled (attribute: enabled, caption: 'Enabled')
          column cSyncStateSessionKey (attribute: sessionKey, caption: 'Session')
          column cSyncStateTelemetryCursor (attribute: telemetryCursor, caption: 'Telemetry cursor')
          column cSyncStateLastRunAt (attribute: lastRunAt, caption: 'Last run at')
          column cSyncStateLastResult (attribute: lastResult, caption: 'Last result')
          column cSyncStateLapsWritten (attribute: lapsWritten, caption: 'Laps')
          column cSyncStateRunCount (attribute: runCount, caption: 'Run count')
        }
      }
    }

    container pnlWatermarks (class: 'panel') {
      container hdWatermarks (class: 'panel-head') {
        dynamictext tWatermarks (content: 'Watermarks', class: 'panel-title')
        dynamictext sWatermarks (content: 'per-endpoint high water marks, so a poll asks only for what is new', class: 'panel-sub')
      }
      container gWatermarks (class: 'grid-dense') {
        datagrid dgWatermarks (
          datasource: DATABASE F1Admin.Watermarks,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cWatermarksRowId (attribute: rowId, caption: '#', Alignment: right)
          column cWatermarksSessionKey (attribute: sessionKey, caption: 'Session')
          column cWatermarksEndpoint (attribute: endpoint, caption: 'Endpoint')
          column cWatermarksLastSeen (attribute: lastSeen, caption: 'Last seen')
          column cWatermarksLastRunAt (attribute: lastRunAt, caption: 'Last run at')
          column cWatermarksRowsLastRun (attribute: rowsLastRun, caption: 'Rows last run')
        }
      }
    }
  }
};

create or replace page Formula1Frontend.Admin_Laps
(
  title: 'Admin — Laps',
  layout: Atlas_Core.Atlas_Default,
  url: 'admin/laps'
)
{
  container pageBody {
    container hdrLaps (class: 'panel-head') {
      dynamictext ttlLaps (content: 'Admin · Laps', class: 'panel-title')
      dynamictext subLaps (content: 'The lap table and what was derived from it.', class: 'panel-sub')
    }

    /* Five pages, one rail item. Without this the other four are reachable
     * only by typing their URL, which is how they shipped the first time. */
    container navAdmin_Laps (class: 'admin-nav') {
      container navToAdmin_LapsSync (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Sync) {
        dynamictext navTxtAdmin_LapsSync (content: 'Sync')
      }
      container navToAdmin_LapsLaps (class: 'chip-pick is-picked', OnClick: SHOW_PAGE Formula1Frontend.Admin_Laps) {
        dynamictext navTxtAdmin_LapsLaps (content: 'Laps')
      }
      container navToAdmin_LapsTelemetry (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Telemetry) {
        dynamictext navTxtAdmin_LapsTelemetry (content: 'Telemetry')
      }
      container navToAdmin_LapsSession (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Session) {
        dynamictext navTxtAdmin_LapsSession (content: 'Session')
      }
      container navToAdmin_LapsEvents (class: 'chip-pick', OnClick: SHOW_PAGE Formula1Frontend.Admin_Events) {
        dynamictext navTxtAdmin_LapsEvents (content: 'Events')
      }
    }

    container pnlLaps (class: 'panel') {
      container hdLaps (class: 'panel-head') {
        dynamictext tLaps (content: 'Laps', class: 'panel-title')
        dynamictext sLaps (content: 'one row per driver per lap · this is the replay', class: 'panel-sub')
      }
      container gLaps (class: 'grid-dense') {
        datagrid dgLaps (
          datasource: DATABASE F1Admin.Laps,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cLapsRowId (attribute: rowId, caption: '#', Alignment: right)
          column cLapsSessionKey (attribute: sessionKey, caption: 'Session')
          column cLapsDriverNumber (attribute: driverNumber, caption: 'No', Alignment: right)
          column cLapsLapNumber (attribute: lapNumber, caption: 'Lap', Alignment: right)
          column cLapsPosition (attribute: position, caption: 'Position', Alignment: right)
          column cLapsGapToLeader (attribute: gapToLeader, caption: 'Gap to leader')
          column cLapsGapSeconds (attribute: gapSeconds, caption: 'Gap seconds')
          column cLapsLapSeconds (attribute: lapSeconds, caption: 'Lap seconds')
          column cLapsSector1 (attribute: sector1, caption: 'Sector1')
          column cLapsSector2 (attribute: sector2, caption: 'Sector2')
          column cLapsSector3 (attribute: sector3, caption: 'Sector3')
          column cLapsSpeedTrap (attribute: speedTrap, caption: 'Speed trap')
          column cLapsCompound (attribute: compound, caption: 'Compound')
          column cLapsTyreAge (attribute: tyreAge, caption: 'Tyre age')
          column cLapsPitStops (attribute: pitStops, caption: 'Pit stops')
        }
      }
    }

    container pnlLapTelemetry (class: 'panel') {
      container hdLapTelemetry (class: 'panel-head') {
        dynamictext tLapTelemetry (content: 'Lap telemetry', class: 'panel-title')
        dynamictext sLapTelemetry (content: 'per-lap aggregates from car_data', class: 'panel-sub')
      }
      container gLapTelemetry (class: 'grid-dense') {
        datagrid dgLapTelemetry (
          datasource: DATABASE F1Admin.LapTelemetry,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cLapTelemetryRowId (attribute: rowId, caption: '#', Alignment: right)
          column cLapTelemetrySessionKey (attribute: sessionKey, caption: 'Session')
          column cLapTelemetryDriverNumber (attribute: driverNumber, caption: 'No', Alignment: right)
          column cLapTelemetryLapNumber (attribute: lapNumber, caption: 'Lap', Alignment: right)
          column cLapTelemetryTopSpeed (attribute: topSpeed, caption: 'Top speed')
          column cLapTelemetryAvgThrottle (attribute: avgThrottle, caption: 'Avg throttle')
          column cLapTelemetryMaxGear (attribute: maxGear, caption: 'Max gear')
          column cLapTelemetryDrsOpenShare (attribute: drsOpenShare, caption: 'Drs open share')
          column cLapTelemetryBrakeShare (attribute: brakeShare, caption: 'Brake share')
          column cLapTelemetryMaxRpm (attribute: maxRpm, caption: 'Max rpm')
          column cLapTelemetrySamples (attribute: samples, caption: 'Samples', Alignment: right)
        }
      }
    }

    container pnlLapStage (class: 'panel') {
      container hdLapStage (class: 'panel-head') {
        dynamictext tLapStage (content: 'Lap stage', class: 'panel-title')
        dynamictext sLapStage (content: 'the loader table · rows here between a fetch and its promotion', class: 'panel-sub')
      }
      container gLapStage (class: 'grid-dense') {
        datagrid dgLapStage (
          datasource: DATABASE F1Admin.LapStage,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cLapStageRowId (attribute: rowId, caption: '#', Alignment: right)
          column cLapStageSessionKey (attribute: sessionKey, caption: 'Session')
          column cLapStageDriverNumber (attribute: driverNumber, caption: 'No', Alignment: right)
          column cLapStageLapNumber (attribute: lapNumber, caption: 'Lap', Alignment: right)
          column cLapStagePosition (attribute: position, caption: 'Position', Alignment: right)
          column cLapStageGapToLeader (attribute: gapToLeader, caption: 'Gap to leader')
          column cLapStageGapSeconds (attribute: gapSeconds, caption: 'Gap seconds')
          column cLapStageLapSeconds (attribute: lapSeconds, caption: 'Lap seconds')
          column cLapStageSector1 (attribute: sector1, caption: 'Sector1')
          column cLapStageSector2 (attribute: sector2, caption: 'Sector2')
          column cLapStageSector3 (attribute: sector3, caption: 'Sector3')
          column cLapStageSpeedTrap (attribute: speedTrap, caption: 'Speed trap')
          column cLapStageCompound (attribute: compound, caption: 'Compound')
          column cLapStageTyreAge (attribute: tyreAge, caption: 'Tyre age')
          column cLapStagePitStops (attribute: pitStops, caption: 'Pit stops')
        }
      }
    }
  }
};

create or replace page Formula1Frontend.Admin_Telemetry
