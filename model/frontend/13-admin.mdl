          column cWeatherTrackTemperature (attribute: trackTemperature, caption: 'Track temperature')
          column cWeatherHumidity (attribute: humidity, caption: 'Humidity')
          column cWeatherRainfall (attribute: rainfall, caption: 'Rainfall')
          column cWeatherWindSpeed (attribute: windSpeed, caption: 'Wind speed')
