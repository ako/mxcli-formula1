          column cMessagesCategory (attribute: category, caption: 'Category')
          column cMessagesFlag (attribute: flag, caption: 'Flag')
          column cMessagesScope (attribute: scope, caption: 'Scope')
          column cMessagesLap (attribute: lap, caption: 'Lap', Alignment: right)
          column cMessagesMessage (attribute: message, caption: 'Message')
        }
      }
    }

    container pnlOvertakes (class: 'panel') {
      container hdOvertakes (class: 'panel-head') {
        dynamictext tOvertakes (content: 'Overtakes', class: 'panel-title')
        dynamictext sOvertakes (content: 'OpenF1''s own detection · practice sessions have none', class: 'panel-sub')
      }
      container gOvertakes (class: 'grid-dense') {
        datagrid dgOvertakes (
          datasource: DATABASE F1Admin.Overtakes,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cOvertakesRowId (attribute: rowId, caption: '#', Alignment: right)
          column cOvertakesSessionKey (attribute: sessionKey, caption: 'Session')
          column cOvertakesAt (attribute: at, caption: 'At')
          column cOvertakesLapNumber (attribute: lapNumber, caption: 'Lap', Alignment: right)
          column cOvertakesOvertakingDriver (attribute: overtakingDriver, caption: 'Overtaking driver')
          column cOvertakesOvertakenDriver (attribute: overtakenDriver, caption: 'Overtaken driver')
          column cOvertakesPosition (attribute: position, caption: 'Position', Alignment: right)
        }
      }
    }

    container pnlRadio (class: 'panel') {
      container hdRadio (class: 'panel-head') {
        dynamictext tRadio (content: 'Team radio', class: 'panel-title')
        dynamictext sRadio (content: 'RecordingUrl points at OpenF1, not at us', class: 'panel-sub')
      }
      container gRadio (class: 'grid-dense') {
        datagrid dgRadio (
          datasource: DATABASE F1Admin.Radio,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cRadioRowId (attribute: rowId, caption: '#', Alignment: right)
          column cRadioSessionKey (attribute: sessionKey, caption: 'Session')
          column cRadioAt (attribute: at, caption: 'At')
          column cRadioDriverNumber (attribute: driverNumber, caption: 'No', Alignment: right)
          column cRadioRecordingUrl (attribute: recordingUrl, caption: 'Recording url')
        }
      }
    }
  }
};

/* ------------------------------------------------------------------ tests -- */

/*
 * The admin path is four hops -- external entity, OData client, published
 * resource, Postgres -- and a break in any of them looks the same from the
 * screen: an empty grid. These count rows so an empty grid can be told from a
 * broken one.
 */

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_AdminSyncRuns ()
  RETURNS Integer AS $Count
BEGIN
  RETRIEVE $Runs FROM F1Admin.SyncRuns;
  DECLARE $Count Integer = 0;
  LOOP $R IN $Runs BEGIN
    SET $Count = $Count + 1;
  END LOOP;
  RETURN $Count;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_AdminLaps ()
  RETURNS Integer AS $Count
BEGIN
  RETRIEVE $Laps FROM F1Admin.Laps;
  DECLARE $Count Integer = 0;
  LOOP $L IN $Laps BEGIN
    SET $Count = $Count + 1;
  END LOOP;
  RETURN $Count;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_AdminTrackOutline ()
  RETURNS Integer AS $Count
BEGIN
  RETRIEVE $Pts FROM F1Admin.TrackOutline;
  DECLARE $Count Integer = 0;
  LOOP $P IN $Pts BEGIN
    SET $Count = $Count + 1;
  END LOOP;
  RETURN $Count;
END;

GRANT EXECUTE ON MICROFLOW Formula1Frontend.Test_AdminSyncRuns TO Formula1Frontend.Administrator;
GRANT EXECUTE ON MICROFLOW Formula1Frontend.Test_AdminLaps TO Formula1Frontend.Administrator;
GRANT EXECUTE ON MICROFLOW Formula1Frontend.Test_AdminTrackOutline TO Formula1Frontend.Administrator;
