          column cCarNowThrottle (attribute: throttle, caption: 'Throttle', Alignment: right)
          column cCarNowBrake (attribute: brake, caption: 'Brake', Alignment: right)
          column cCarNowGear (attribute: gear, caption: 'Gear', Alignment: right)
          column cCarNowRpm (attribute: rpm, caption: 'Rpm', Alignment: right)
          column cCarNowDrs (attribute: drs, caption: 'Drs', Alignment: right)
        }
      }
    }

    container pnlCarPositions (class: 'panel') {
      container hdCarPositions (class: 'panel-head') {
        dynamictext tCarPositions (content: 'Car positions', class: 'panel-title')
        dynamictext sCarPositions (content: 'track-local coordinates, same frame as the outline', class: 'panel-sub')
      }
      container gCarPositions (class: 'grid-dense') {
        datagrid dgCarPositions (
          datasource: DATABASE F1Admin.CarPositions,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cCarPositionsSampleKey (attribute: sampleKey, caption: 'Sample key')
          column cCarPositionsSessionKey (attribute: sessionKey, caption: 'Session')
          column cCarPositionsDriverNumber (attribute: driverNumber, caption: 'No', Alignment: right)
          column cCarPositionsAt (attribute: at, caption: 'At')
          column cCarPositionsX (attribute: x, caption: 'X', Alignment: right)
          column cCarPositionsY (attribute: y, caption: 'Y', Alignment: right)
          column cCarPositionsZ (attribute: z, caption: 'Z', Alignment: right)
        }
      }
    }

    container pnlTrackOutline (class: 'panel') {
      container hdTrackOutline (class: 'panel-head') {
        dynamictext tTrackOutline (content: 'Track outline', class: 'panel-title')
        dynamictext sTrackOutline (content: 'traced from one car''s own lap, captured once per session', class: 'panel-sub')
      }
      container gTrackOutline (class: 'grid-dense') {
        datagrid dgTrackOutline (
          datasource: DATABASE F1Admin.TrackOutline,
          PageSize: 20,
          PagingPosition: bottom
        ) {
          column cTrackOutlinePointKey (attribute: pointKey, caption: 'Point key')
          column cTrackOutlineSessionKey (attribute: sessionKey, caption: 'Session')
          column cTrackOutlineSeq (attribute: seq, caption: 'Seq', Alignment: right)
          column cTrackOutlineX (attribute: x, caption: 'X', Alignment: right)
          column cTrackOutlineY (attribute: y, caption: 'Y', Alignment: right)
        }
      }
    }
  }
};

create or replace page Formula1Frontend.Admin_Session
