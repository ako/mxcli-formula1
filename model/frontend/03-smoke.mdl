/*
 * Retrieval smoke tests over the external entities.
 *
 * A build only proves the contract parsed. These prove the frontend can
 * actually reach the backend, authenticate as ApiConsumer, and get rows back
 * through both clients.
 */

CREATE OR REPLACE MICROFLOW Formula1Frontend.Count_Live_Drivers ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Rows FROM F1Live.Drivers;
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Count_Cached_Drivers ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Rows FROM F1Cached.Drivers;
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Live_SennaWins ()
  RETURNS Long AS $Wins
BEGIN
  -- LIMIT 1 yields a single object, not a list, so there is no HEAD() here.
  RETRIEVE $Row FROM F1Live.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  DECLARE $Wins Long = 0;
  IF $Row != empty THEN
    SET $Wins = $Row/raceWins;
  END IF;
  RETURN $Wins;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Cached_SennaWins ()
  RETURNS Long AS $Wins
BEGIN
  -- LIMIT 1 yields a single object, not a list, so there is no HEAD() here.
  RETRIEVE $Row FROM F1Cached.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  DECLARE $Wins Long = 0;
  IF $Row != empty THEN
    SET $Wins = $Row/raceWins;
  END IF;
  RETURN $Wins;
END;

/*
 * The `name` attribute, on both clients.
 *
 * These existed only in the .mpr until now — written by hand while §28 was
 * being diagnosed, when the generator prefixed the attribute with its remote
 * type (`Stg_Drivername` live, `Drivername` cached) and the question was
 * whether the mangled attribute still mapped to the remote `name`. mxcli
 * c76d4b7 stopped renaming it, so they now read `name` on both sides and are
 * recorded here, where a rebuild will recreate them. FINDINGS §28, §34.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Live_SennaName ()
  RETURNS String AS $Name
BEGIN
  RETRIEVE $Row FROM F1Live.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  DECLARE $Name String = '';
  IF $Row != empty THEN
    SET $Name = $Row/name;
  END IF;
  RETURN $Name;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Cached_SennaName ()
  RETURNS String AS $Name
BEGIN
  RETRIEVE $Row FROM F1Cached.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  DECLARE $Name String = '';
  IF $Row != empty THEN
    SET $Name = $Row/name;
  END IF;
  RETURN $Name;
END;

/*
 * The fan pages, reached the way the pages reach them.
 *
 * Each of these retrieves the page's parameter object and calls the same
 * datasource microflow the page binds, so a test failing here means a page is
 * broken — not merely that the backend answered.
 *
 * No empty-guard around the call: `SET` inside an IF is treated as a second
 * declaration of the return variable and the build fails with "Duplicate
 * variable name". These ids exist; if one did not, the datasource would return
 * nothing and the count would be 0, which the assertion catches anyway.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_SennaSeasons ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Driver FROM F1Live.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_DriverSeasons (Driver = $Driver);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_SennaRaces ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Driver FROM F1Live.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_DriverRaces (Driver = $Driver);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1988Rounds ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1988 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_SeasonProgress (Season = $Season);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_FerrariReasons ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Team FROM F1Cached.Constructors WHERE constructorId = 'ferrari' LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_Retirements (Constructor = $Team);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_SennaFactTitle ()
  RETURNS String AS $Title
BEGIN
  RETRIEVE $Driver FROM F1Live.Drivers WHERE driverId = 'ayrton-senna' LIMIT 1;
  $Fact = CALL MICROFLOW Formula1Frontend.DS_DriverFact (Driver = $Driver);
  DECLARE $Title String = $Fact/title;
  RETURN $Title;
END;

/*
 * 1957, which is the season that caught the bug: the standings grids were bound
 * to the live service, whose read microflow ignores $filter, so every season
 * showed the newest rows. 22 is the number of drivers classified in 1957.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1957Standings ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1957 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_SeasonDriverStandings (Season = $Season);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1957Rounds ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1957 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_SeasonProgress (Season = $Season);
  $N = COUNT($Rows);
  RETURN $N;
END;

/*
 * The race weekend, through the microflows the page binds. Bahrain 2024 is
 * round 1: 20 drivers classified, five sessions in the shape chart, 57 laps of
 * Jolpica traces.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_WeekendSessions ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE year = 2024 and round = 1 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_WeekendSessions (Race = $Race);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_WeekendShape ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE year = 2024 and round = 1 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_WeekendShape (Race = $Race);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LapChart ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE year = 2024 and round = 1 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_LapChart (Race = $Race);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_WeekendWinner ()
  RETURNS String AS $Who
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE year = 2024 and round = 1 LIMIT 1;
  $Weekend = CALL MICROFLOW Formula1Frontend.DS_Weekend (Race = $Race);
  DECLARE $Who String = $Weekend/winnerName;
  RETURN $Who;
END;

/*
 * The live overview. Asserts on the shape, not on values: the snapshot changes
 * every time scripts/fetch-f1-live.sh runs, so pinning Norris on 70 laps would
 * be a test that fails on the next race.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LiveOrder ()
  RETURNS Long AS $N
BEGIN
  -- Parens are required in a microflow CALL even with no arguments; a page
  -- datasource is the opposite and rejects them.
  $Rows = CALL MICROFLOW Formula1Frontend.DS_LiveOrder();
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LiveHasLeader ()
  RETURNS Boolean AS $Ok
BEGIN
  RETRIEVE $Leader FROM F1Now.Order WHERE position = 1 LIMIT 1;
  DECLARE $Ok Boolean = $Leader != empty;
  RETURN $Ok;
END;

/*
 * The regression for FINDINGS §37.
 *
 * A client holding a Calendar row re-reads it by key, and Read_Calendar used to
 * ignore that request and answer with the most recent season instead. The
 * client then adopted the first row of that answer as the object's identity, so
 * every calendar row in every season resolved to the same race and the weekend
 * page opened round 1 of 2026 whatever was clicked.
 *
 * This is the read the client makes: by key, nothing else. `1036-c` is Bahrain
 * 2021, and 2021 is the assertion — before the fix it came back 2026.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_CalendarByKey ()
  RETURNS Long AS $Year
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE calendarKey = '1036-c' LIMIT 1;
  DECLARE $Year Long = $Race/year;
  RETURN $Year;
END;

/*
 * And the same lookup arriving the way the page does it: pick a row out of a
 * season, hand it to the weekend datasource, and check the weekend that comes
 * back is the round that was asked for rather than the newest race.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_WeekendIsTheRaceClicked ()
  RETURNS String AS $Name
BEGIN
  RETRIEVE $Race FROM F1Fan.Calendar WHERE calendarKey = '1036-c' LIMIT 1;
  $Weekend = CALL MICROFLOW Formula1Frontend.DS_Weekend (Race = $Race);
  DECLARE $Name String = $Weekend/circuitName;
  RETURN $Name;
END;

/*
 * The regression for FINDINGS §42 — the same shape as §37, on the resources
 * that had it latent.
 *
 * Six F1Live resources and three F1Now ones declared a KEY their read microflow
 * never saw, so a lookup by key fell through to the collection and the client
 * took the first row. 1957 is the assertion because the wrong answer is the
 * newest season: before the fix this returned 2026.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LiveSeasonByKey ()
  RETURNS Long AS $Year
BEGIN
  RETRIEVE $Season FROM F1Live.Seasons WHERE year = 1957 LIMIT 1;
  DECLARE $Year Long = $Season/year;
  RETURN $Year;
END;

/*
 * And the standings, which had the subtler version: the key was `driverId`,
 * which is not unique — one driver has up to 77 standings — so even a lookup
 * that reached the backend could only return the newest. The key is now
 * `<year>-<driverId>`.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LiveStandingByKey ()
  RETURNS Long AS $Year
BEGIN
  RETRIEVE $Standing FROM F1Live.DriverStandings
    WHERE standingKey = '1957-juan-manuel-fangio' LIMIT 1;
  DECLARE $Year Long = $Standing/year;
  RETURN $Year;
END;

/* ---------------------------------------------------- the redesign's new -- */

/*
 * The drivers' championship table joins two resources — DriverStandings for
 * who finished where, DriverSeasons for wins, podiums and poles — matched on
 * driverId. These two check that the join lands: the row count comes from the
 * standings, and the champion's win count only exists if the other side
 * matched.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1988DriverRows ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1988 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_SeasonDriverRows (Season = $Season);
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1988ChampionWins ()
  RETURNS Long AS $N
BEGIN
  DECLARE $N Long = -1;
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1988 LIMIT 1;
  $Rows = CALL MICROFLOW Formula1Frontend.DS_SeasonDriverRows (Season = $Season);
  LOOP $R IN $Rows BEGIN
    IF $R/PositionOrder = 1 AND $R/Wins != empty THEN
      SET $N = $R/Wins;
    END IF;
  END LOOP;
  RETURN $N;
END;

/*
 * The small multiples read a whole season of results in one call and keep the
 * ten drivers who finished highest. Sixteen rounds times ten drivers is the
 * number of points on the grid — minus nobody, because a retirement still
 * travels as a row so the panel can mark it.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_1988Multiples ()
  RETURNS Long AS $N
BEGIN
  DECLARE $N Long = 0;
  RETRIEVE $Season FROM F1Cached.Seasons WHERE year = 1988 LIMIT 1;
  $Chart = CALL MICROFLOW Formula1Frontend.DSJ_SeasonMultiples (Season = $Season);
  IF $Chart != empty THEN
    SET $N = length($Chart/json);
  END IF;
  RETURN $N;
END;

/*
 * The three live charts.
 *
 * They assert shape, not size: the snapshot in data/live/ is whatever the last
 * successful fetch wrote, and OpenF1 refuses unauthenticated requests while a
 * session is running, so a count here would fail for a reason that has nothing
 * to do with the code. An empty session yields '[]', which is two characters
 * and still valid JSON — what these catch is a microflow that threw or built a
 * string the widget cannot parse.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_LiveChartsBuild ()
  RETURNS Long AS $N
BEGIN
  DECLARE $N Long = 0;
  $Gaps = CALL MICROFLOW Formula1Frontend.DSJ_LiveGaps ();
  $Pos  = CALL MICROFLOW Formula1Frontend.DSJ_LivePositions ();
  $Stints = CALL MICROFLOW Formula1Frontend.DSJ_LiveStints ();
  IF $Gaps != empty AND length($Gaps/json) >= 2 THEN
    SET $N = $N + 1;
  END IF;
  IF $Pos != empty AND length($Pos/json) >= 2 THEN
    SET $N = $N + 1;
  END IF;
  IF $Stints != empty AND length($Stints/json) >= 2 THEN
    SET $N = $N + 1;
  END IF;
  RETURN $N;
END;

/*
 * The circuit outline. Austin is on the current calendar and OpenStreetMap maps
 * it as a clean closed loop, so it is the one to assert on; a circuit whose
 * trace did not measure up is absent from the resource by design, which is what
 * the second of these checks.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_CircuitOutlinePoints ()
  RETURNS Long AS $N
BEGIN
  /*
   * Read straight off the resource rather than through DS_CircuitPoints, so
   * this also proves the circuitId filter is pushed down: unconstrained, the
   * file holds every circuit's vertices, and a count that came back with all
   * of them would mean the term was dropped on the way to the scan.
   */
  RETRIEVE $Rows FROM F1Fan.CircuitPoints WHERE circuitId = 'austin';
  $N = COUNT($Rows);
  RETURN $N;
END;

/*
 * Traced against recorded: the number that says an outline is the circuit and
 * not a pit lane or an old layout.
 *
 * Counts the ones that fall short rather than the ones that pass, so the
 * expectation is zero however many circuits have been fetched. A test pinned to
 * a count would fail the next time somebody widened the calendar, which teaches
 * people to edit the number rather than read the failure.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_CircuitOutlinesSuspect ()
  RETURNS Long AS $N
BEGIN
  DECLARE $N Long = 0;
  RETRIEVE $All FROM F1Fan.CircuitOutlines;
  LOOP $O IN $All BEGIN
    IF $O/deltaPercent = empty OR $O/deltaPercent > 6.0
       OR $O/pathD = empty OR $O/attribution = empty THEN
      SET $N = $N + 1;
    END IF;
  END LOOP;
  RETURN $N;
END;

/*
 * The track map. Asserts the two halves separately, because they fail
 * differently: an outline of nothing means the capture never ran, and cars
 * without an outline means the map draws dots in a void.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_TrackOutlinePoints ()
  RETURNS Long AS $N
BEGIN
  RETRIEVE $Rows FROM F1Now.TrackOutline;
  $N = COUNT($Rows);
  RETURN $N;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.Test_TrackMapBuilds ()
  RETURNS Long AS $N
BEGIN
  DECLARE $N Long = 0;
  $Chart = CALL MICROFLOW Formula1Frontend.DSJ_TrackMap ();
  IF $Chart != empty THEN
    SET $N = length($Chart/json);
  END IF;
  RETURN $N;
END;
