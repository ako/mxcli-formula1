/* --------------------------------------------------------- race weekend -- */

/*
 * The fourth screen: one Grand Prix, every session.
 *
 * The page parameter is a Calendar row rather than a race id, so the round nav
 * and the season page can both hand it over as an object. Everything else is
 * looked up from its raceId.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.DS_Weekend ($Race: F1Fan.Calendar)
  RETURNS F1Fan.RaceWeekend AS $Weekend
BEGIN
  RETRIEVE $Weekend FROM F1Fan.RaceWeekend WHERE raceId = $Race/raceId LIMIT 1;
  RETURN $Weekend;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.DS_WeekendSessions ($Race: F1Fan.Calendar)
  RETURNS List of F1Fan.RaceSessions AS $Rows
BEGIN
  RETRIEVE $Rows FROM F1Fan.RaceSessions WHERE raceId = $Race/raceId;
  RETURN $Rows;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.DS_WeekendShape ($Race: F1Fan.Calendar)
  RETURNS List of F1Fan.WeekendShape AS $Rows
BEGIN
  RETRIEVE $Rows FROM F1Fan.WeekendShape WHERE raceId = $Race/raceId;
  RETURN $Rows;
END;

/*
 * The lap traces. Both filters have to reach the backend or it returns nothing
 * on purpose — every lap of every fetched season is not a chart.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.DS_LapChart ($Race: F1Fan.Calendar)
  RETURNS List of F1Fan.LapChart AS $Rows
BEGIN
  RETRIEVE $Rows FROM F1Fan.LapChart
    WHERE year = $Race/year and round = $Race/round;
  RETURN $Rows;
END;

/*
 * The season's rounds, for the chip row across the top: one chip per Grand
 * Prix, the one being shown outlined. `year` is pushed down, so this is the
 * season and not the calendar.
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.DS_WeekendRounds ($Race: F1Fan.Calendar)
  RETURNS List of F1Fan.Calendar AS $Rows
BEGIN
  RETRIEVE $Rows FROM F1Fan.Calendar WHERE year = $Race/year SORT BY round ASC;
  RETURN $Rows;
END;

/*
 * Prev and Next. `round` is pushed down on Calendar now, so each is one row
 * over the wire rather than a season fetched to pick one out of it.
 *
 * At either end the neighbour does not exist and the button does nothing —
 * the comp greys them out, which a Mendix button can only do from a page
 * variable, and there is none here to hold "is this the first round".
 */
CREATE OR REPLACE MICROFLOW Formula1Frontend.ACT_PrevRound ($Race: F1Fan.Calendar)
BEGIN
  DECLARE $Target Long = $Race/round - 1;
  RETRIEVE $Prev FROM F1Fan.Calendar
    WHERE year = $Race/year and round = $Target LIMIT 1;
  IF $Prev != empty THEN
    SHOW PAGE Formula1Frontend.Race_Weekend (Race: $Prev);
  END IF;
END;

CREATE OR REPLACE MICROFLOW Formula1Frontend.ACT_NextRound ($Race: F1Fan.Calendar)
BEGIN
  DECLARE $Target Long = $Race/round + 1;
  RETRIEVE $Next FROM F1Fan.Calendar
    WHERE year = $Race/year and round = $Target LIMIT 1;
  IF $Next != empty THEN
    SHOW PAGE Formula1Frontend.Race_Weekend (Race: $Next);
  END IF;
END;

/*
 * The URL carries the race, so a weekend can be linked to. That only works
 * because Read_Calendar answers a lookup by key — resolving `{Race}` back into
 * an object is exactly the read that used to fall through to the collection
 * default. FINDINGS §37.
 */
create or replace page Formula1Frontend.Race_Weekend
(
  title: 'Race weekend',
  layout: Atlas_Core.Atlas_Default,
  url: 'weekend/{Race}',
  Params: { $Race: F1Fan.Calendar }
)
{
  container pageBody {
    /*
     * The comp's round nav: two step buttons and then a chip per Grand Prix,
     * the one on screen outlined. Both are the season in one line, so a
     * weekend can be left in either direction without going back to a list.
     */
    container roundNav (class: 'round-nav') {
      actionbutton btnPrev (caption: '← Prev', class: 'nav-step',
        action: microflow Formula1Frontend.ACT_PrevRound(Race: $Race))
      actionbutton btnNext (caption: 'Next →', class: 'nav-step',
        action: microflow Formula1Frontend.ACT_NextRound(Race: $Race))
      container roundChips (class: 'chips-row chips-inline') {
        listview lvRounds (
          datasource: MICROFLOW Formula1Frontend.DS_WeekendRounds(Race: $Race),
          PageSize: 40
        ) {
          container chipRound (
            class: 'chip-pick',
            dynamicclasses: 'if $currentObject/round = $Race/round then ''is-picked'' else ''''',
            OnClick: SHOW_PAGE Formula1Frontend.Race_Weekend(Race: $currentObject)
          ) {
            dynamictext chipCode (content: '{1}', contentparams: [{1} = code])
          }
        }
      }
    }

    dataview dvWeekend (datasource: MICROFLOW Formula1Frontend.DS_Weekend(Race: $Race),
                        class: 'hero') {
      container heroRow (class: 'hero-row') {
        container heroId (class: 'hero-id') {
          dynamictext heroRound (content: 'Round {1} of {2}',
            contentparams: [{1} = round, {2} = year], class: 'hero-eyebrow')
          dynamictext heroName (content: '{1}', contentparams: [{1} = name],
                                rendermode: H2, class: 'hero-name')
          dynamictext heroCircuit (content: '{1}', contentparams: [{1} = circuitName],
                                   class: 'hero-sub')
          dynamictext heroLaps (content: '{1} laps · {2} km',
            contentparams: [{1} = laps, {2} = distance], class: 'hero-sub')
        }

        /*
         * The comp's three highlight cards, each tinted by what it is about:
         * practice on the plain surface, pole on the accent, the win on the
         * brand. Practice is empty before 1986 and FP3 before 2003, so a card
         * can legitimately read as a dash — that is data, not a fault.
         */
        container hlCards (class: 'hl-cards') {
          container hlPractice (class: 'hl-card') {
            dynamictext hlPracticeL (content: 'Fastest in practice', class: 'hl-label')
            dynamictext hlPracticeV (content: '{1}', contentparams: [{1} = fp3LeaderTime],
                                     class: 'hl-value')
            dynamictext hlPracticeS (content: 'FP3 · {1}',
                                     contentparams: [{1} = fp3LeaderName],
                                     class: 'hl-sub')
          }
          container hlPole (class: 'hl-card hl-card-pole') {
            dynamictext hlPoleL (content: 'Pole position', class: 'hl-label')
            dynamictext hlPoleV (content: '{1}', contentparams: [{1} = poleTime],
                                 class: 'hl-value')
            dynamictext hlPoleS (content: '{1}', contentparams: [{1} = poleName],
                                 class: 'hl-sub')
          }
          container hlWin (class: 'hl-card hl-card-win') {
            dynamictext hlWinL (content: 'Race winner', class: 'hl-label')
            dynamictext hlWinV (content: '{1}', contentparams: [{1} = winnerName],
                                class: 'hl-value hl-value-name')
            dynamictext hlWinS (content: '{1} · fastest lap {2}',
              contentparams: [{1} = winnerTeam, {2} = fastestLapName],
              class: 'hl-sub')
          }
        }
      }
    }

    container charts (class: 'split-even') {
      container shapePanel (class: 'panel') {
        container shapeHead (class: 'panel-head') {
          dynamictext shapeTitle (content: 'Position across the weekend',
                                  class: 'panel-title')
          dynamictext shapeSub (content: 'FP1 → FP2 → FP3 → Qualifying → Race, top 10',
                                class: 'panel-sub')
        }
        dataview dvChartShape (datasource: MICROFLOW Formula1Frontend.DSJ_WeekendShape(Race: $Race)) {
          pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartShape (
            chartData: json,
            datasetName: 'table',
            chartHeight: 0,
            renderer: 'svg',
            showActions: false,
            spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":10,"titleFontSize":11,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":11,"symbolType":"stroke","symbolStrokeWidth":3}},"height":280,"mark":{"type":"line","strokeWidth":2,"point":{"filled":true,"size":40}},"encoding":{"x":{"field":"session","type":"nominal","title":null,"sort":{"field":"i","op":"min"}},"y":{"field":"pos","type":"quantitative","title":"Position","scale":{"reverse":true,"zero":false,"nice":false},"axis":{"format":"d","tickMinStep":1}},"color":{"field":"driver","type":"nominal","title":null,"scale":{"scheme":"tableau10"},"legend":{"orient":"right","symbolLimit":10}},"tooltip":[{"field":"driver","title":"Driver"},{"field":"session","title":"Session"},{"field":"pos","title":"Position"}]}}')
        }
      }

      container lapPanel (class: 'panel') {
        container lapHead (class: 'panel-head') {
          dynamictext lapTitle (content: 'Race position by lap', class: 'panel-title')
          dynamictext lapSub (content: 'lap-by-lap traces · 2024 only',
                              class: 'panel-sub')
        }
        dataview dvChartLaps (datasource: MICROFLOW Formula1Frontend.DSJ_LapChart(Race: $Race)) {
          pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartLaps (
            chartData: json,
            datasetName: 'table',
            chartHeight: 0,
            renderer: 'svg',
            showActions: false,
            spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":10,"titleFontSize":11,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":11,"symbolType":"stroke","symbolStrokeWidth":3}},"height":300,"mark":{"type":"line","strokeWidth":1.5,"interpolate":"step-after"},"encoding":{"x":{"field":"lap","type":"quantitative","title":"Lap","axis":{"format":"d","tickMinStep":1},"scale":{"zero":false,"nice":false}},"y":{"field":"pos","type":"quantitative","title":"Position","scale":{"reverse":true,"zero":false,"nice":false},"axis":{"format":"d","tickMinStep":1}},"color":{"field":"driver","type":"nominal","title":null,"scale":{"scheme":"tableau10"},"legend":{"orient":"right","symbolLimit":10}},"tooltip":[{"field":"driver","title":"Driver"},{"field":"lap","title":"Lap"},{"field":"pos","title":"Position"}]}}')
        }
        container lapLegend (class: 'legend') {
          dynamictext lapCredit (
            content: 'Lap traces from Jolpica-F1, the community successor to Ergast. f1db has every session result but not a row per lap.',
            class: 'chip')
        }
      }
    }

    container pacePanel (class: 'panel') {
      container paceHead (class: 'panel-head') {
        dynamictext paceTitle (content: 'Session pace', class: 'panel-title')
        dynamictext paceSub (content: 'gap to that session''s best, in seconds',
                             class: 'panel-sub')
      }
      dataview dvChartPace (datasource: MICROFLOW Formula1Frontend.DSJ_WeekendPace(Race: $Race)) {
        pluggablewidget 'f1.widget.web.vegachart.VegaChart' chartPace (
          chartData: json,
          datasetName: 'table',
          chartHeight: 0,
          renderer: 'svg',
          showActions: false,
          spec: '{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","width":"container","data":{"name":"table"},"config":{"background":null,"view":{"stroke":null},"font":"Space Grotesk","axis":{"labelColor":"#8B949E","titleColor":"#8B949E","gridColor":"#21262D","domainColor":"#30363D","tickColor":"#30363D","labelFontSize":10,"titleFontSize":11,"labelFont":"JetBrains Mono"},"legend":{"labelColor":"#C9D1D9","titleColor":"#8B949E","labelFontSize":11,"symbolType":"stroke","symbolStrokeWidth":3}},"height":280,"mark":{"type":"bar"},"encoding":{"x":{"field":"drv","type":"nominal","title":null,"sort":null},"y":{"field":"gap","type":"quantitative","title":"Gap to best (s)","axis":{"format":".2f"}},"xOffset":{"field":"session","type":"nominal"},"color":{"field":"session","type":"nominal","title":null,"scale":{"range":["#58A6FF","#3FB950","#D29922","#F778BA","#FF8000"]},"legend":{"orient":"top","offset":4}},"tooltip":[{"field":"drv","title":"Driver"},{"field":"session","title":"Session"},{"field":"gap","title":"Gap (s)"}]}}')
      }
    }

    container tablePanel (class: 'panel') {
      container tableHead (class: 'panel-head') {
        dynamictext tableTitle (content: 'Practice vs qualifying vs race',
                                class: 'panel-title')
        dynamictext tableSub (content: 'Δ = grid position gained or lost in the race',
                              class: 'panel-sub')
      }
      container tableGrid (class: 'grid-dense') {
        datagrid dgSessions (
          datasource: MICROFLOW Formula1Frontend.DS_WeekendSessions(Race: $Race),
          PageSize: 22,
          PagingPosition: bottom
        ) {
          column colPos (attribute: positionText, caption: '#', Alignment: right)
          column colAbbr (attribute: abbreviation, caption: 'Code')
          column colDriver (attribute: driverName, caption: 'Driver')
          column colTeam (attribute: constructorName, caption: 'Team')
          column colFp1 (attribute: fp1Position, caption: 'FP1', Alignment: right)
          column colFp2 (attribute: fp2Position, caption: 'FP2', Alignment: right)
          column colFp3 (attribute: fp3Position, caption: 'FP3', Alignment: right)
          column colQual (attribute: qualPosition, caption: 'Quali', Alignment: right)
          column colQualT (attribute: qualTime, caption: 'Quali lap', Alignment: right)
          column colGrid (attribute: gridPosition, caption: 'Grid', Alignment: right)
          /*
           * The comp draws the delta as an arrow, green for places gained and
           * red for places lost, and a dash where nothing moved. The arrow is
           * a cell class rather than a value, so the number stays a number and
           * stays sortable; the zero case collapses the digit and the rule
           * draws the dash in its place.
           */
          column colDelta (
            attribute: positionsGained, caption: 'Δ', Alignment: right,
            DynamicCellClass: 'if $currentObject/positionsGained = empty then ''delta-flat'' else if $currentObject/positionsGained > 0 then ''delta-up'' else if $currentObject/positionsGained < 0 then ''delta-down'' else ''delta-flat'''
          )
          column colBest (attribute: bestLapTime, caption: 'Best lap', Alignment: right)
          column colPits (attribute: pitStops, caption: 'Pits', Alignment: right)
          column colPts (attribute: points, caption: 'Pts', Alignment: right)
          column colOut (attribute: reasonRetired, caption: 'Retired')
        }
      }
    }

    container dataNote (class: 'data-note') {
      dynamictext noteLead (content: 'Data note.', class: 'data-note-lead')
      dynamictext noteBody (content: ' Every session classification, lap time and grid slot is f1db, read from the CSVs on each request. Practice columns are empty before the era each session was timed — FP1 and FP2 from 1986, FP3 from 2003 — and a highlight card reads as a dash for the same reason. The lap traces come from Jolpica-F1: f1db has every session result but not a row per lap.')
    }
  }
}
