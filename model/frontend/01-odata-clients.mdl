/*
 * Formula1Frontend — the two OData clients.
 *
 * The backend publishes the same eight resources twice, so the frontend
 * consumes both and each gets its own module. They have to: every resource is
 * named identically in the two services (Drivers, Races, …), so importing both
 * into one module would collide.
 *
 *   F1Live    -> /odata/f1-live/  CSVs read per request, query options pushed
 *                                 into DuckDB SQL by the read microflows
 *   F1Cached  -> /odata/f1/       Postgres, paged and filtered by Mendix
 *
 * ServiceUrl is a constant, not a literal, so the address is environment
 * -overridable — it will not stay backend.local.
 *
 * MetadataUrl points at a FILE, not at the service. `CREATE ODATA CLIENT`
 * fetches $metadata over plain HTTP with no credentials, so against these
 * services it gets 401 and leaves the client unvalidated with no external
 * entities to import (FINDINGS §23). The contracts under contracts/ were
 * fetched authenticated with curl and are committed, which also means this
 * script runs without the backend up.
 *
 * Refresh them when the backend's published surface changes:
 *   curl -H 'X-Api-Key: <key>' 'http://backend.local:8080/odata/f1-live/$metadata' \
 *     -o contracts/f1-live-metadata.xml
 *
 *
 * A KEY IN A HEADER, NOT A PASSWORD
 *
 * These clients used to send HTTP basic credentials, which meant the backend ran
 * a full BCrypt verification on every request — 60-80% of a cached page turn
 * (FINDINGS §31). The answer taken at the time was to weaken the work factor
 * from 12 to 8, because the real fix could not be written: MDL accepted
 * `authentication microflow` and silently dropped the microflow name.
 *
 * mxcli `715bac5` fixed that, so all five backend services now authenticate
 * through Formula1Backend.AuthenticateApiClient and these clients present a key
 * instead. No password is verified per request, so the work factor is back at
 * the Mendix default and stops mattering. FINDINGS §40, §48.
 *
 * The key is a constant reference rather than a literal, so it is not baked into
 * the model and is overridable per environment. A shared key is the right shape
 * for machine-to-machine and the wrong shape for anything with human users.
 */

/* ------------------------------------------------------------------ live -- */

create module F1Live;

create or modify constant F1Live.ServiceUrl type string
  default 'http://backend.local:8080/odata/f1-live/'
  comment 'Base URL of the backend live service. Override per environment.';

create or modify constant F1Live.ApiKey type string
  default 'f1-ops-key-2f8a1c' PRIVATE;

create or modify odata client F1Live.LiveApi (
  Version: '1.0',
  ODataVersion: OData4,
  MetadataUrl: './contracts/f1-live-metadata.xml',
  Timeout: 300,
  ServiceUrl: @F1Live.ServiceUrl
)
HEADERS ('X-Api-Key': @F1Live.ApiKey);

/* ---------------------------------------------------------------- cached -- */

create module F1Cached;

create or modify constant F1Cached.ServiceUrl type string
  default 'http://backend.local:8080/odata/f1/'
  comment 'Base URL of the backend cached service. Override per environment.';

create or modify constant F1Cached.ApiKey type string
  default 'f1-ops-key-2f8a1c' PRIVATE;

create or modify odata client F1Cached.CachedApi (
  Version: '1.0',
  ODataVersion: OData4,
  MetadataUrl: './contracts/f1-metadata.xml',
  Timeout: 300,
  ServiceUrl: @F1Cached.ServiceUrl
)
HEADERS ('X-Api-Key': @F1Cached.ApiKey);

/* ------------------------------------------------------------------- fan -- */

/*
 * The third service, and the one the browsing pages are actually built on:
 * careers, season progressions, reliability, and the sourced prose. Its own
 * module for the same reason as the other two — `Facts` and `DriverSeasons`
 * would otherwise have to share a namespace with the raw tables.
 */

create module F1Fan;

create or modify constant F1Fan.ServiceUrl type string
  default 'http://backend.local:8080/odata/f1-fan/'
  comment 'Base URL of the backend fan service. Override per environment.';

create or modify constant F1Fan.ApiKey type string
  default 'f1-ops-key-2f8a1c' PRIVATE;

create or modify odata client F1Fan.FanApi (
  Version: '1.0',
  ODataVersion: OData4,
  MetadataUrl: './contracts/f1-fan-metadata.xml',
  Timeout: 300,
  ServiceUrl: @F1Fan.ServiceUrl
)
HEADERS ('X-Api-Key': @F1Fan.ApiKey);

/* --------------------------------------------------------------- live now -- */

/*
 * The fourth service, and the only one that is not a file: near-live timing
 * from OpenF1, as fresh as the last run of scripts/fetch-f1-live.sh.
 */

create module F1Now;

create or modify constant F1Now.ServiceUrl type string
  default 'http://backend.local:8080/odata/f1-now/'
  comment 'Base URL of the backend near-live service. Override per environment.';

create or modify constant F1Now.ApiKey type string
  default 'f1-ops-key-2f8a1c' PRIVATE;

create or modify odata client F1Now.NowApi (
  Version: '1.0',
  ODataVersion: OData4,
  MetadataUrl: './contracts/f1-now-metadata.xml',
  Timeout: 300,
  ServiceUrl: @F1Now.ServiceUrl
)
HEADERS ('X-Api-Key': @F1Now.ApiKey);
