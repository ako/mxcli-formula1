/*
 * Demo user, split out of 05 because that script is not re-runnable —
 * `create module role` has no `or modify` form, so re-executing 05 stops at the
 * first role that already exists. This file is safe on its own.
 */

CREATE DEMO USER 'fan' PASSWORD 'F1Enthusiast!2345' (Enthusiast);

/* The Admin screen's user. Same app, one more role. */
CREATE DEMO USER 'admin' PASSWORD 'F1Paddock!2345' (Administrator);
